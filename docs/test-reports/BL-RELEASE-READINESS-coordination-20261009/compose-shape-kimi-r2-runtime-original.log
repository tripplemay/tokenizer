{"role":"assistant","tool_calls":[{"type":"function","id":"tool_js8GnGj0aMw9OVStZFywVFgf","function":{"name":"Write","arguments":"{\"path\":\"tests/evaluator/compose-shape-r2-support.test.ts\",\"content\":\"// Fresh Kimi-family r2 supporting evaluator controls for BL-COMPOSE-VERSION-SHAPE.\\n// Independent synthetic controls beyond the existing 43+32+47: own data tables,\\n// own canaries, own boundary rows, own mechanical git-diff pins. Read-only: no\\n// source/spec/old-test mutation, no network/SSH/Docker/credential access.\\nimport { spawnSync } from 'node:child_process';\\nimport { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\\n\\nconst base = '917b60c99af1f733103e307b41925d858b696bb4';\\nconst sha = 'd'.repeat(40);\\nconst scriptPath = 'scripts/ci/vps-host-preflight.sh';\\nconst workflowPath = '.github/workflows/deploy-vps.yml';\\nconst script = readFileSync(scriptPath, 'utf8');\\nconst workflow = readFileSync(workflowPath, 'utf8');\\nconst canary = 'R2_EVALUATOR_CANARY_NEVER_DISCLOSE_7f3a';\\nlet root: string, bin: string, deploy: string;\\n\\ntype Shape = {\\n  prefix: string; core_present: boolean; tail_bytes: number | null; tail_charset: string;\\n  has_cr: boolean; has_lf: boolean; has_horizontal_space: boolean; has_escape: boolean; has_non_ascii: boolean;\\n};\\nconst shape = (prefix: string, core_present = false, tail_bytes: number | null = null, tail_charset = 'not_parsed', flags: Partial<Shape> = {}): Shape => ({\\n  prefix, core_present, tail_bytes, tail_charset, has_cr: false, has_lf: false,\\n  has_horizontal_space: false, has_escape: false, has_non_ascii: false, ...flags\\n});\\n\\nfunction original(path: string) {\\n  const result = spawnSync('git', ['show', `${base}:${path}`], { encoding: 'utf8' });\\n  if (result.status !== 0) throw new Error(result.stderr);\\n  return result.stdout;\\n}\\n\\nfunction filter(source = workflow) {\\n  const marker = \\\"          if ! jq -e --arg source \\\\\\\"$GITHUB_SHA\\\\\\\" '\\\\n\\\";\\n  const start = source.indexOf(marker) + marker.length;\\n  const end = source.indexOf(\\\"          ' \\\\\\\"$work/inventory.json\\\\\\\" >/dev/null 2>&1; then\\\", start);\\n  if (start < marker.length || end < start) throw new Error('missing workflow validator');\\n  return { jq: source.slice(start, end), outside: `${source.slice(0, start)}<V>${source.slice(end)}` };\\n}\\n\\nfunction gate(body: unknown) {\\n  return spawnSync('jq', ['-e', '--arg', 'source', sha, filter().jq], {\\n    input: JSON.stringify(body), encoding: 'utf8', env: { PATH: '/usr/bin:/bin', NODE_ENV: 'test' }\\n  });\\n}\\n\\nfunction fixtureTool(name: string, body: string) {\\n  const path = join(bin, name);\\n  writeFileSync(path, `#!${process.execPath}\\\\nconst fs=require('node:fs'),args=process.argv.slice(2),env=process.env;\\\\nfs.appendFileSync(env.CALLS,JSON.stringify([${JSON.stringify(name)},...args])+'\\\\\\\\n');\\\\nif(env.LOCALES)fs.appendFileSync(env.LOCALES,JSON.stringify(String(env.LC_ALL))+'\\\\\\\\n');\\\\n${body}\\\\n`);\\n  chmodSync(path, 0o755);\\n}\\n\\nfunction snapshot(directory = deploy): unknown {\\n  return readdirSync(directory).sort().map((name) => {\\n    const path = join(directory, name), stat = statSync(path);\\n    return [name, stat.mode, stat.isDirectory() ? snapshot(path) : readFileSync(path).toString('hex')];\\n  });\\n}\\n\\nfunction execute(output: string | Buffer, options: { pipelineCode?: number; hang?: boolean; source?: string; locale?: string } = {}) {\\n  const callPath = join(root, 'calls'), localePath = join(root, 'locales');\\n  if (existsSync(callPath)) rmSync(callPath);\\n  if (existsSync(localePath)) rmSync(localePath);\\n  const env: NodeJS.ProcessEnv = {\\n    NODE_ENV: 'test', PATH: `${bin}:/usr/bin:/bin`, CALLS: callPath, LOCALES: localePath, CANARY: canary,\\n    OUTPUT: Buffer.from(output).toString('base64'), CODE: '0',\\n    PIPELINE_CODE: options.pipelineCode === undefined ? '' : String(options.pipelineCode),\\n    HANG: options.hang ? '1' : '', LC_ALL: options.locale ?? 'C'\\n  };\\n  const before = snapshot();\\n  const result = spawnSync('/bin/bash', [options.source ?? join(process.cwd(), scriptPath), deploy, sha], { encoding: 'utf8', env, timeout: 15_000 });\\n  expect(result.error).toBeUndefined();\\n  expect(result.stderr).toBe('');\\n  expect(result.stdout).not.toContain(canary);\\n  expect(snapshot()).toEqual(before);\\n  const body = JSON.parse(result.stdout);\\n  const calls: string[][] = existsSync(callPath) ? readFileSync(callPath, 'utf8').trim().split('\\\\n').map((line) => JSON.parse(line)) : [];\\n  if (existsSync(localePath)) expect(readFileSync(localePath, 'utf8').trim().split('\\\\n').map((line) => JSON.parse(line)))\\n    .toEqual(Array.from({ length: calls.length }, () => env.LC_ALL));\\n  if (!options.source) expect(gate(body).status, `${gate(body).stderr}\\\\n${result.stdout}`).toBe(0);\\n  return { result, body, calls };\\n}\\n\\nfunction refused(value: ReturnType<typeof execute>) {\\n  expect(value.result.status).toBe(1);\\n  expect(value.body).toMatchObject({ outcome: 'refused', reason: 'compose_unavailable', versions: { compose: 'unknown' } });\\n  expect(value.calls.filter(([tool]) => tool === 'docker')).toEqual([\\n    ['docker', 'version', '--format', '{{.Server.Version}}'], ['docker', 'compose', 'version', '--short']\\n  ]);\\n  expect(value.calls.some(([tool]) => ['curl', 'stat', 'sha256sum'].includes(tool))).toBe(false);\\n}\\n\\ndescribe.skipIf(process.platform === 'win32')('r2 independent classification matrix', () => {\\n  beforeEach(() => {\\n    root = mkdtempSync(join(tmpdir(), 'csr2-')); bin = join(root, 'bin'); deploy = join(root, 'deploy');\\n    mkdirSync(bin); mkdirSync(deploy);\\n    writeFileSync(join(deploy, '.env'), `AUTH_SECRET=${canary}\\\\n`);\\n    writeFileSync(join(deploy, 'docker-compose.yml'), `# ${canary}\\\\nservices: {}\\\\n`);\\n    fixtureTool('timeout', `const {spawnSync}=require('node:child_process');\\n      if(args.shift()!=='--signal=KILL'||args.shift()!=='5s')process.exit(99);\\n      const command=args.shift(),child=spawnSync(command,args,{timeout:5000,killSignal:'SIGKILL'});\\n      const code=command==='docker'&&args[0]==='compose'&&env.PIPELINE_CODE!==''?Number(env.PIPELINE_CODE):child.error?.code==='ETIMEDOUT'?124:child.status??1;\\n      process.stdout.on('error',()=>process.exit(code));\\n      process.stdout.write(child.stdout||Buffer.alloc(0),()=>process.exit(code));`);\\n    fixtureTool('head', `const data=fs.readFileSync(0);if(JSON.stringify(args)!==JSON.stringify(['-c','16385']))process.exit(99);process.stdout.write(data.subarray(0,16385));`);\\n    fixtureTool('uname', `console.log(args[0]==='-s'?'Linux':'x86_64');`);\\n    fixtureTool('df', `console.log('Filesystem 1024-blocks Used Available Capacity Mounted on\\\\\\\\nfixture 100000 100 99900 1% /scope');`);\\n    fixtureTool('docker', `process.stderr.write(env.CANARY);\\n      if(JSON.stringify(args)===JSON.stringify(['version','--format','{{.Server.Version}}'])){console.log('29.1.3');return;}\\n      if(JSON.stringify(args)===JSON.stringify(['compose','version','--short'])){\\n        if(env.HANG){setTimeout(()=>process.exit(0),60000);return;}\\n        process.stdout.write(Buffer.from(env.OUTPUT,'base64'),()=>process.exit(Number(env.CODE)));return;\\n      }\\n      process.exit(99);`);\\n  });\\n  afterEach(() => rmSync(root, { recursive: true, force: true }));\\n\\n  it.each([\\n    // Own prefix discriminators: exact-vendor-glob and byte-zero rules.\\n    ['v', shape('other')], ['vv2.35.1', shape('other')], ['v-2.35.1', shape('other')],\\n    ['docker compose version 2.35.1', shape('other', false, null, 'not_parsed', { has_horizontal_space: true })],\\n    ['Docker Compose version', shape('other', false, null, 'not_parsed', { has_horizontal_space: true })],\\n    ['Docker Compose version\\\\t2.35.1', shape('other', false, null, 'not_parsed', { has_horizontal_space: true })],\\n    ['Docker Compose version  v2.35.1', shape('docker_compose_version', false, null, 'not_parsed', { has_horizontal_space: true })],\\n    ['Docker Compose version v', shape('docker_compose_version', false, null, 'not_parsed', { has_horizontal_space: true })],\\n    ['\\\\r2.35.1', shape('other', false, null, 'not_parsed', { has_cr: true })],\\n    [' 2.35.1', shape('other', false, null, 'not_parsed', { has_horizontal_space: true })],\\n    // Own core-boundary rows: partial cores never parse.\\n    ['2.35', shape('numeric')], ['2.35.', shape('numeric')], ['2.35.x', shape('numeric')],\\n    ['v2.35', shape('v_numeric')], ['2..35.1', shape('numeric')], ['2.35.1.x y', shape('numeric', true, 4, 'other', { has_horizontal_space: true })]\\n  ])('classifies own prefix/core boundary %j %#', (output, expected) => {\\n    const value = execute(output as string);\\n    expect(value.body.compose_version_shape).toEqual(expected);\\n    refused(value);\\n  });\\n\\n  it.each([\\n    ['0.0.0', shape('numeric', true, 0, 'empty')],\\n    ['02.003.0004\\\\n', shape('numeric', true, 0, 'empty')],\\n    ['2.35.1.', shape('numeric', true, 1, 'legacy')],\\n    ['v2.35.1+', shape('v_numeric', true, 1, 'legacy')],\\n    ['2.35.1-', shape('numeric', true, 1, 'legacy')],\\n    ['2.35.1-rc1+build.5', shape('numeric', true, 14, 'legacy')],\\n    ['v2.35.1' + 'a'.repeat(32), shape('v_numeric', true, 32, 'legacy')]\\n  ])('keeps accepted own boundary versions observable %#', (output, expected) => {\\n    const value = execute(output as string);\\n    expect(value.body.compose_version_shape).toEqual(expected);\\n    expect(value.body.compose_probe.status).toBe('ok');\\n    expect(value.body.versions.compose).toBe((output as string).replace(/\\\\n+$/, ''));\\n    expect(value.body.compose_probe.captured_bytes).toBe(Buffer.byteLength((output as string).replace(/\\\\n+$/, '')));\\n  });\\n\\n  it.each([\\n    ['2.35.1~', shape('numeric', true, 1, 'legacy_plus_tilde')],\\n    ['2.35.1~~', shape('numeric', true, 2, 'legacy_plus_tilde')],\\n    ['2.35.1~rc~1', shape('numeric', true, 5, 'legacy_plus_tilde')],\\n    ['2.35.1_', shape('numeric', true, 1, 'legacy_plus_underscore')],\\n    ['2.35.1__a', shape('numeric', true, 3, 'legacy_plus_underscore')],\\n    ['2.35.1~_', shape('numeric', true, 2, 'legacy_plus_tilde_underscore')],\\n    ['2.35.1_~', shape('numeric', true, 2, 'legacy_plus_tilde_underscore')],\\n    ['v2.35.1+build~x_y', shape('v_numeric', true, 9, 'legacy_plus_tilde_underscore')],\\n    ['2.35.1!', shape('numeric', true, 1, 'other')],\\n    ['2.35.1\\\\x7f', shape('numeric', true, 1, 'other')],\\n    ['Docker Compose version 2.35.1~deb9', shape('docker_compose_version', true, 5, 'legacy_plus_tilde', { has_horizontal_space: true })]\\n  ])('classifies own tail alphabet rows without relaxing refusal %#', (output, expected) => {\\n    const value = execute(output as string);\\n    expect(value.body.compose_version_shape).toEqual(expected);\\n    refused(value);\\n  });\\n\\n  it.each([\\n    ['2.35.1\\\\x7f', { has_non_ascii: false }], // 0x7f is inside 0x00..0x7f\\n    ['2.35.1\\\\x80', { has_non_ascii: true }],\\n    ['2.35.1\\\\xff', { has_non_ascii: true }],\\n    ['2.35.1\\\\xc3', { has_non_ascii: true }], // truncated UTF-8 lead byte\\n    ['2.35.1\\\\t2', { has_horizontal_space: true }],\\n    ['2.35.1\\\\x1b', { has_escape: true }],\\n    ['2.35.1\\\\n2.35.2', { has_lf: true }],\\n    ['2.35.1\\\\t\\\\r\\\\x1b\\\\xc3\\\\xa9 ', { has_cr: true, has_horizontal_space: true, has_escape: true, has_non_ascii: true }]\\n  ])('flags own byte-edge rows over the retained string %#', (output, flags) => {\\n    const value = execute(output as string);\\n    const expected = shape('numeric', true, Buffer.byteLength(output as string) - 6, 'other', flags as Partial<Shape>);\\n    expect(value.body.compose_version_shape).toEqual(expected);\\n    refused(value);\\n  });\\n\\n  it.each(['C', 'en_US.UTF-8', 'zh_CN.UTF-8', 'tr_TR.UTF-8'])('counts multibyte tails in bytes under %s with unchanged ambient query locale', (locale) => {\\n    const value = execute('2.35.1éß中', { locale }); // 2+2+3 = 7 tail bytes\\n    expect(value.body.compose_version_shape).toEqual(shape('numeric', true, 7, 'other', { has_non_ascii: true }));\\n    expect(value.body.compose_probe.captured_bytes).toBe(13);\\n    refused(value);\\n  });\\n\\n  it.each([\\n    ['2.35.1\\\\n\\\\n\\\\n', '2.35.1', 6, false],\\n    ['v2.35.1\\\\r\\\\n', 'v2.35.1\\\\r', 8, true],\\n    ['2.35.1\\\\r\\\\n\\\\r\\\\n', '2.35.1\\\\r', 7, true]\\n  ])('applies trailing-newline stripping but retains interior CR bytes %#', (output, retained, bytes, cr) => {\\n    const value = execute(output as string);\\n    expect(value.body.compose_probe.captured_bytes).toBe(bytes);\\n    expect(value.body.compose_version_shape).toEqual(shape(retained.startsWith('v') ? 'v_numeric' : 'numeric', true,\\n      bytes - (retained.startsWith('v') ? 7 : 6), cr ? 'other' : 'empty', cr ? { has_cr: true } : {}));\\n    if (cr) refused(value);\\n  });\\n\\n  it('keeps null shape at the exact 16385-byte overflow boundary with a clean pipeline', () => {\\n    const value = execute('2.35.1' + 'é'.repeat(8189) + 'x'); // 6 + 16378 + 1 = 16385 bytes\\n    expect(value.body.compose_probe).toMatchObject({ status: 'output_bound_exceeded', pipeline_exit_status: 0, captured_bytes: 16385 });\\n    expect(value.body.compose_version_shape).toBeNull();\\n    refused(value);\\n  });\\n\\n  it('keeps an at-boundary 16384-byte retained string classifiable without overflow', () => {\\n    const value = execute('2.35.1' + 'a'.repeat(16378));\\n    expect(value.body.compose_probe).toMatchObject({ status: 'invalid_version', captured_bytes: 16384 });\\n    expect(value.body.compose_version_shape).toEqual(shape('numeric', true, 16378, 'legacy'));\\n    refused(value);\\n  });\\n\\n  it.each([2, 126, 130, 143])('keeps null shape on own failed-pipeline code %i', (pipelineCode) => {\\n    const value = execute('v2.35.1+' + canary, { pipelineCode });\\n    expect(value.body.compose_probe).toMatchObject({ status: 'command_failed', pipeline_exit_status: pipelineCode });\\n    expect(value.body.compose_version_shape).toBeNull();\\n    refused(value);\\n  });\\n\\n  it('prioritizes the overflow detector over a failed pipeline and keeps null shape', () => {\\n    const value = execute('z'.repeat(20000), { pipelineCode: 2 });\\n    expect(value.body.compose_probe).toMatchObject({ status: 'output_bound_exceeded', pipeline_exit_status: 2, captured_bytes: 16385 });\\n    expect(value.body.compose_version_shape).toBeNull();\\n    refused(value);\\n  });\\n\\n  it('bounds a hung capture at five seconds with null shape and unchanged refusal', () => {\\n    const start = Date.now(), value = execute('', { hang: true });\\n    expect(Date.now() - start).toBeLessThan(9_000);\\n    expect(value.body.compose_probe).toMatchObject({ status: 'command_failed', pipeline_exit_status: 124, captured_bytes: 0 });\\n    expect(value.body.compose_version_shape).toBeNull();\\n    refused(value);\\n  }, 15_000);\\n\\n  it('keeps the missing-jq minimal report byte-identical to the base with no shape key', () => {\\n    fixtureTool('date', 'console.log(\\\"2026-10-09T00:00:00Z\\\");');\\n    const run = (source: string) => spawnSync('/bin/bash', [source, deploy, sha], {\\n      encoding: 'utf8', timeout: 10_000, env: { NODE_ENV: 'test', PATH: bin, CALLS: join(root, 'calls') }\\n    });\\n    const baseline = join(root, 'base.sh'); writeFileSync(baseline, original(scriptPath));\\n    const candidate = run(join(process.cwd(), scriptPath)), old = run(baseline);\\n    expect(candidate.stdout).toBe(old.stdout);\\n    expect(candidate.stdout).not.toContain('shape');\\n    expect(JSON.parse(candidate.stdout)).toEqual({ schema_version: 1, operation: 'host-preflight', o