{"role":"tool","tool_call_id":"tool_Crd31xBIs85sZOEniysU227C","content":"1\timport { spawnSync } from 'node:child_process';\n2\timport { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } from 'node:fs';\n3\timport { tmpdir } from 'node:os';\n4\timport { join } from 'node:path';\n5\timport { afterEach, beforeEach, describe, expect, it } from 'vitest';\n6\t\n7\tconst base = '917b60c99af1f733103e307b41925d858b696bb4';\n8\tconst sha = 'c'.repeat(40);\n9\tconst scriptPath = 'scripts/ci/vps-host-preflight.sh';\n10\tconst workflowPath = '.github/workflows/deploy-vps.yml';\n11\tconst script = readFileSync(scriptPath, 'utf8');\n12\tconst workflow = readFileSync(workflowPath, 'utf8');\n13\tconst canary = 'SHAPE_SECRET_CANARY_NEVER_DISCLOSE';\n14\tconst homeCanary = '/synthetic/SHAPE_HOME_CANARY_NEVER_DISCLOSE';\n15\tlet root: string, bin: string, deploy: string;\n16\t\n17\ttype Shape = {\n18\t  prefix: string; core_present: boolean; tail_bytes: number | null; tail_charset: string;\n19\t  has_cr: boolean; has_lf: boolean; has_horizontal_space: boolean; has_escape: boolean; has_non_ascii: boolean;\n20\t};\n21\tconst shape = (prefix: string, core_present = false, tail_bytes: number | null = null, tail_charset = 'not_parsed', flags: Partial<Shape> = {}): Shape => ({\n22\t  prefix, core_present, tail_bytes, tail_charset, has_cr: false, has_lf: false,\n23\t  has_horizontal_space: false, has_escape: false, has_non_ascii: false, ...flags\n24\t});\n25\t\n26\tfunction original(path: string) {\n27\t  const result = spawnSync('git', ['show', `${base}:${path}`], { encoding: 'utf8' });\n28\t  if (result.status !== 0) throw new Error(result.stderr);\n29\t  return result.stdout;\n30\t}\n31\t\n32\tfunction filter(source = workflow) {\n33\t  const marker = \"          if ! jq -e --arg source \\\"$GITHUB_SHA\\\" '\\n\";\n34\t  const start = source.indexOf(marker) + marker.length;\n35\t  const end = source.indexOf(\"          ' \\\"$work/inventory.json\\\" >/dev/null 2>&1; then\", start);\n36\t  if (start < marker.length || end < start) throw new Error('missing workflow validator');\n37\t  return { jq: source.slice(start, end), outside: `${source.slice(0, start)}<VALIDATOR>${source.slice(end)}` };\n38\t}\n39\t\n40\tfunction gate(body: unknown) {\n41\t  return spawnSync('jq', ['-e', '--arg', 'source', sha, filter().jq], {\n42\t    input: JSON.stringify(body), encoding: 'utf8', env: { PATH: '/usr/bin:/bin', NODE_ENV: 'test' }\n43\t  });\n44\t}\n45\t\n46\tfunction fixtureTool(name: string, body: string) {\n47\t  const path = join(bin, name);\n48\t  writeFileSync(path, `#!${process.execPath}\\nconst fs=require('node:fs'),args=process.argv.slice(2),env=process.env;\\nfs.appendFileSync(env.CALLS,JSON.stringify([${JSON.stringify(name)},...args])+'\\\\n');\\nif(env.LOCALES)fs.appendFileSync(env.LOCALES,JSON.stringify(env.LC_ALL)+'\\\\n');\\n${body}\\n`);\n49\t  chmodSync(path, 0o755);\n50\t}\n51\t\n52\tfunction snapshot(directory = deploy): unknown {\n53\t  return readdirSync(directory).sort().map((name) => {\n54\t    const path = join(directory, name), stat = statSync(path);\n55\t    return [name, stat.mode, stat.isDirectory() ? snapshot(path) : readFileSync(path).toString('hex')];\n56\t  });\n57\t}\n58\t\n59\tfunction execute(output = 'v2.35.1\\n', options: { code?: number; pipelineCode?: number; hang?: boolean; early?: boolean; source?: string; locale?: string; home?: string } = {}) {\n60\t  const callPath = join(root, 'calls');\n61\t  const localePath = join(root, 'locales');\n62\t  if (existsSync(callPath)) rmSync(callPath);\n63\t  if (existsSync(localePath)) rmSync(localePath);\n64\t  const env: NodeJS.ProcessEnv = {\n65\t    NODE_ENV: 'test', PATH: `${bin}:/usr/bin:/bin`, CALLS: callPath, LOCALES: localePath, CANARY: canary, OUTPUT: Buffer.from(output).toString('base64'),\n66\t    CODE: String(options.code ?? 0), PIPELINE_CODE: options.pipelineCode === undefined ? '' : String(options.pipelineCode),\n67\t    HANG: options.hang ? '1' : '', EARLY: options.early ? '1' : '', LC_ALL: options.locale ?? 'en_US.UTF-8'\n68\t  };\n69\t  if (options.home !== undefined) env.HOME = options.home;\n70\t  const before = snapshot();\n71\t  const result = spawnSync('/bin/bash', [options.source ?? join(process.cwd(), scriptPath), deploy, sha], {\n72\t    encoding: 'utf8', env, timeout: 10_000\n73\t  });\n74\t  expect(result.error).toBeUndefined();\n75\t  expect(result.stderr).toBe('');\n76\t  expect(result.stdout).not.toContain(canary);\n77\t  expect(result.stdout).not.toContain(homeCanary);\n78\t  expect(snapshot()).toEqual(before);\n79\t  const body = JSON.parse(result.stdout);\n80\t  const calls: string[][] = existsSync(callPath) ? readFileSync(callPath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line)) : [];\n81\t  if (existsSync(localePath)) expect(readFileSync(localePath, 'utf8').trim().split('\\n').map((line) => JSON.parse(line)))\n82\t    .toEqual(Array.from({ length: calls.length }, () => env.LC_ALL));\n83\t  if (!options.source) expect(gate(body).status, `${gate(body).stderr}\\n${result.stdout}`).toBe(0);\n84\t  return { result, body, calls };\n85\t}\n86\t\n87\tfunction refusal(value: ReturnType<typeof execute>) {\n88\t  expect(value.result.status).toBe(1);\n89\t  expect(value.body).toMatchObject({ outcome: 'refused', reason: 'compose_unavailable', versions: { compose: 'unknown' }, files: {} });\n90\t  expect(value.calls.filter(([tool]) => tool === 'timeout')).toEqual([\n91\t    ['timeout', '--signal=KILL', '5s', 'uname', '-s'], ['timeout', '--signal=KILL', '5s', 'uname', '-m'],\n92\t    ['timeout', '--signal=KILL', '5s', 'df', '-Pk', '--', deploy],\n93\t    ['timeout', '--signal=KILL', '5s', 'docker', 'version', '--format', '{{.Server.Version}}'],\n94\t    ['timeout', '--signal=KILL', '5s', 'docker', 'compose', 'version', '--short']\n95\t  ]);\n96\t  expect(value.calls.filter(([tool]) => tool === 'docker')).toEqual([\n97\t    ['docker', 'version', '--format', 