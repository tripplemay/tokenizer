esult = runBoundedSubprocess(process.execPath, [\"--import\", \"tsx\", probe], {\n38\t    cwd: repo, env: probeEnv, timeoutMs: 7_000, maxOutputBytes: 4_096\n39\t  });\n40\t  expect(result.status, result.stderr).toBe(0);\n41\t  return JSON.parse(result.stdout);\n42\t}\n43\t\n44\tit(\"captures the actual install checkout SHA\", () => {\n45\t  const expected = execFileSync(realGit, [\"rev-parse\", \"--short=12\", \"HEAD\"], { cwd: repo, env, encoding: \"utf8\", timeout: 2_000 }).trim();\n46\t  expect(readVersion()).toMatchObject({ first: expected, second: expected });\n47\t});\n48\t\n49\tit.each([\"stall\", \"overflow\", \"invalid\", \"short\", \"nonzero\", \"signal\"])(\"bounds real startup executable mode %s and returns null\", (mode) => {\n50\t  const result = readVersion({ ...makeGitShim(root, env), PB_GIT_MODE: mode });\n51\t  expect(result).toMatchObject({ first: null, second: null });\n52\t  expect(result.elapsedMs).toBeLessThan(process.platform === \"win32\" ? 5_000 : 4_000);\n53\t  console.log(\"STARTUP_BOUND\", JSON.stringify({ mode, elapsedMs: result.elapsedMs, version: result.first }));\n54\t}, 10_000);\n55\t\n56\tit(\"keeps its import-time SHA even after the install checkout advances\", () => {\n57\t  const snapshot = join(root, \"snapshot\");\n58\t  const module = join(snapshot, \"src/cli/agent-version.ts\");\n59\t  mkdirSync(dirname(module), { recursive: true });\n60\t  for (const name of [\"agent-version.ts\", \"bounded-subprocess.ts\", \"bounded-subprocess-worker.mjs\"]) {\n61\t    copyFileSync(join(repo, \"src/cli\", name), join(snapshot, \"src/cli\", name));\n62\t  }\n63\t  for (const args of [[\"init\", \"-q\"], [\"-c\", \"user.name=Fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"commit\", \"--allow-empty\", \"-qm\", \"first\"]]) {\n64\t    execFileSync(realGit, args, { cwd: snapshot, env, timeout: 2_000, stdio: \"pipe\" });\n65\t  }\n66\t  const result = readVersion({ ...env, PB_VERSION_MODULE: module, PB_SNAPSHOT_ROOT: snapshot });\n67\t  expect(result.first).toMatch(/^[0-9a-f]{12}$/);\n68\t  expect(result.second).toBe(result.first);\n69\t  expect(result.disk).not.toBe(result.first);\n70\t});\n71\t\n72\tit.skipIf(process.platform !== \"win32\")(\"uses native git.exe rather than .cmd resolution on Windows\", () => {\n73\t  expect(readVersion({ ...makeGitShim(root, env), PB_GIT_MODE: \"valid\" }).first).toBe(\"a\".repeat(12));\n74\t});"}
{"role":"tool","tool_call_id":"tool_bbTjcgdhNb4WD9Q0SZiAWj7Y","content":"1\timport { execFileSync } from \"node:child_process\";\n2\timport { chmodSync, copyFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from \"node:fs\";\n3\timport { join } from \"node:path\";\n4\timport { fileURLToPath } from \"node:url\";\n5\t\n6\texport function makeGitShim(root: string, env: NodeJS.ProcessEnv): NodeJS.ProcessEnv {\n7\t  const bin = join(root, \"bin\");\n8\t  mkdirSync(bin, { recursive: true });\n9\t  const script = fileURLToPath(new URL(\"../../fixtures/process-bounds/git-shim.mjs\", import.meta.url));\n10\t  const inheritedPath = env.PATH ?? env.Path ?? process.env.PATH ?? \"\";\n11\t  const result = { ...env, PATH: `${bin}${process.platform === \"win32\" ? \";\" : \":\"}${inheritedPath}`, PB_NODE: process.execPath, PB_GIT_SCRIPT: script };\n12\t  if (process.platform === \"win32\") {\n13\t    const csc = join(env.SystemRoot ?? \"C:\\\\Windows\", \"Microsoft.NET\", \"Framework64\", \"v4.0.30319\", \"csc.exe\");\n14\t    if (!existsSync(csc)) throw new Error(\"Windows executable fixture requires the native .NET C# compiler\");\n15\t    execFileSync(csc, [\"/nologo\", \"/target:exe\", `/out:${join(bin, \"git.exe\")}`,\n16\t      fileURLToPath(new URL(\"../../fixtures/process-bounds/windows-git-shim.cs\", import.meta.url))], {\n17\t      env, timeout: 10_000, killSignal: \"SIGKILL\", stdio: \"pipe\"\n18\t    });\n19\t  } else {\n20\t    const executable = join(bin, \"git\");\n21\t    copyFileSync(script, executable);\n22\t    writeFileSync(executable, `#!${process.execPath}\\n${readFileSync(executable, \"utf8\")}`);\n23\t    chmodSync(executable, 0o755);\n24\t  }\n25\t  return result;\n26\t}"}
{"role":"tool","tool_call_id":"tool_z2lXUaxjk2v2V8CclFcMMoFY","content":"1\timport { spawn } from \"node:child_process\";\n2\timport { appendFileSync } from \"node:fs\";\n3\timport { fileURLToPath } from \"node:url\";\n4\t\n5\tconst [mode, pidFile] = process.argv.slice(2);\n6\tif (pidFile) appendFileSync(pidFile, `${process.pid}\\n`);\n7\t// Independent lifetime cap also protects failed/aborted test harnesses.\n8\tsetTimeout(() => process.exit(91), 15_000).unref();\n9\t\n10\tif (mode === \"normal\") {\n11\t  process.stdout.write(JSON.stringify({ argv: process.argv.slice(4), cwd: process.cwd(), home: process.env.HOME }));\n12\t  process.stderr.write(\"stderr-control\");\n13\t} else if (mode === \"nonzero\") {\n14\t  process.stdout.write(\"ordinary-failure\");\n15\t  process.exitCode = 23;\n16\t} else if (mode === \"signal\") {\n17\t  process.kill(process.pid, \"SIGTERM\");\n18\t} else if (mode === \"combined\") {\n19\t  process.stdout.write(\"a\".repeat(600));\n20\t  process.stderr.write(\"b\".repeat(600));\n21\t} else {\n22\t  process.on(\"SIGTERM\", () => {});\n23\t  if (mode === \"descendant\" || mode === \"inherited-pipes\") {\n24\t    spawn(process.execPath, [fileURLToPath(import.meta.url), \"resistant\", pidFile], { stdio: \"inherit\" });\n25\t    if (mode === \"inherited-pipes\") setTimeout(() => process.exit(0), 200);\n26\t  }\n27\t  if (mode === \"overflow\") {\n28\t    process.stderr.write(\"RAW-STDERR-CANARY\\n\");\n29\t    setInterval(() => process.stdout.write(Buffer.alloc(4_096, 65)), 5);\n30\t  } else {\n31\t    setInterval(() => {}, 100);\n32\t  }\n33\t}"}
{"role":"tool","tool_call_id":"tool_4iTg7NqoIhWd438btnSWasbF","content":"1\timport { spawn, spawnSync } from \"node:child_process\";\n2\timport { appendFileSync } from \"node:fs\";\n3\t\n4\tif (process.env.PB_PID_FILE) appendFileSync(process.env.PB_PID_FILE, `${process.pid}\\n`);\n5\tconst mode = process.env.PB_GIT_MODE;\n6\tsetTimeout(() => process.exit(91), 15_000).unref();\n7\tif (mode === \"stall\") {\n8\t  process.on(\"SIGTERM\", () => {});\n9\t  if (process.env.PB_DESCENDANT_FIXTURE) {\n10\t    spawn(process.execPath, [process.env.PB_DESCENDANT_FIXTURE, \"resistant\", process.env.PB_PID_FILE], { stdio: \"inherit\" });\n11\t  }\n12\t  setInterval(() => {}, 100);\n13\t} else if (mode === \"overflow\") {\n14\t  process.stderr.write(\"RAW-GIT-STDERR-CANARY\\n\");\n15\t  process.stdout.write(\"a\".repeat(128 * 1_024));\n16\t} else if (mode === \"invalid\") {\n17\t  process.stdout.write(\"not-a-git-sha\\n\");\n18\t} else if (mode === \"short\") {\n19\t  process.stdout.write(\"abc123\\n\");\n20\t} else if (mode === \"nonzero\") {\n21\t  process.stdout.write(\"a\".repeat(12));\n22\t  process.exitCode = 1;\n23\t} else if (mode === \"signal\") {\n24\t  process.kill(process.pid, \"SIGTERM\");\n25\t} else if (mode === \"valid\") {\n26\t  process.stdout.write(\"a\".repeat(12));\n27\t} else {\n28\t  if (process.env.PB_GIT_DELAY_MS) Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, Number(process.env.PB_GIT_DELAY_MS));\n29\t  const result = spawnSync(process.env.PB_REAL_GIT, process.argv.slice(2), { encoding: \"utf8\" });\n30\t  process.stdout.write(result.stdout ?? \"\");\n31\t  process.stderr.write(result.stderr ?? \"\");\n32\t  process.exitCode = result.status ?? 1;\n33\t}"}
