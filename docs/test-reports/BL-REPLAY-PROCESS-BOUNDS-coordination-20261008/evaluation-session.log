{"role":"tool","tool_call_id":"tool_okZ6D8CrfR6ED722Dun9l3Mu","content":"1\timport { afterEach, beforeEach, expect, it } from \"vitest\";\n2\timport { execFileSync } from \"node:child_process\";\n3\timport { existsSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from \"node:fs\";\n4\timport { tmpdir } from \"node:os\";\n5\timport { join } from \"node:path\";\n6\timport { fileURLToPath } from \"node:url\";\n7\timport { makeGitShim } from \"./fixtures\";\n8\timport { runBoundedSubprocess } from \"../../../src/cli/bounded-subprocess\";\n9\t\n10\tconst repo = fileURLToPath(new URL(\"../../../\", import.meta.url));\n11\tconst probe = fileURLToPath(new URL(\"../../fixtures/process-bounds/replay-probe.mjs\", import.meta.url));\n12\tconst descendant = fileURLToPath(new URL(\"../../fixtures/process-bounds/child.mjs\", import.meta.url));\n13\tlet root: string;\n14\tlet env: NodeJS.ProcessEnv;\n15\tlet request: Record<string, unknown>;\n16\tlet config: Record<string, unknown>;\n17\tlet queue: string;\n18\tlet protectedPaths: string[];\n19\t\n20\tfunction pids(): number[] {\n21\t  try { return readFileSync(join(root, \"pids\"), \"utf8\").trim().split(\"\\n\").map(Number); } catch { return []; }\n22\t}\n23\t\n24\tbeforeEach(() => {\n25\t  root = realpathSync(mkdtempSync(join(tmpdir(), \"pbr-\")));\n26\t  const home = join(root, \"home\");\n27\t  mkdirSync(join(home, \".tokenizer\"), { recursive: true });\n28\t  mkdirSync(join(root, \"tmp\"));\n29\t  env = { ...process.env, HOME: home, USERPROFILE: home, TMPDIR: join(root, \"tmp\"), PB_PRODUCT_ROOT: repo,\n30\t    PB_REPLAY_MANIFEST: join(root, \"manifest.json\"), PB_PID_FILE: join(root, \"pids\") };\n31\t  env.PB_REAL_GIT = execFileSync(process.platform === \"win32\" ? \"where.exe\" : \"/usr/bin/which\", [\"git\"], { env, encoding: \"utf8\", timeout: 2_000 }).trim().split(/\\r?\\n/)[0];\n32\t  const file = join(root, \"source.jsonl\");\n33\t  writeFileSync(file, JSON.stringify({ type: \"assistant\", uuid: \"replay-bound\", cwd: root, timestamp: \"2026-10-07T12:00:00.000Z\",\n34\t    message: { role: \"assistant\", id: \"replay-bound\", content: \"RAW-MESSAGE-CANARY\", usage: { input_tokens: 3 } } }) + \"\\n\");\n35\t  request = { source: \"claude-code\", file, from: \"2026-10-07T00:00:00.000Z\", to: \"2026-10-08T00:00:00.000Z\", maxBytes: 100_000, maxEvents: 10 };\n36\t  config = { serverUrl: \"http://127.0.0.1:9\", projectRoots: [],\n37\t    sources: { claude: true, codex: false, opencode: false, aider: false, kimicode: false },\n38\t    privacy: { mode: \"local-only\", includePaths: [root], excludePaths: [] } };\n39\t  queue = join(home, \".tokenizer\", \"queue.jsonl\");\n40\t  protectedPaths = [queue, join(home, \".tokenizer\", \"cursor.json\"), join(home, \".tokenizer\", \"config.json\")];\n41\t  writeFileSync(queue, JSON.stringify({ source: \"claude-code\", sourceEventId: \"retained\", occurredAt: \"2026-10-07T12:00:00.000Z\" }) + \"\\n\");\n42\t  writeFileSync(protectedPaths[1], '{\"cursor\":\"unchanged\"}\\n');\n43\t  writeFileSync(protectedPaths[2], JSON.stringify(config));\n44\t});\n45\t\n46\tafterEach(() => {\n47\t  for (const pid of pids()) {\n48\t    try { process.kill(-pid, \"SIGKILL\"); } catch { /* owned group only */ }\n49\t    try { process.kill(pid, \"SIGKILL\"); } catch { /* already exited */ }\n50\t  }\n51\t  rmSync(root, { recursive: true, force: true });\n52\t});\n53\t\n54\tfunction run(mode: string, extra: Partial<NodeJS.ProcessEnv> = {}, confirmation?: string) {\n55\t  writeFileSync(env.PB_REPLAY_MANIFEST!, JSON.stringify({ request, config, queue, mode, confirmation }));\n56\t  const result = runBoundedSubprocess(process.execPath, [\"--import\", \"tsx\", probe], {\n57\t    cwd: repo, env: { ...env, ...extra }, timeoutMs: 13_000, maxOutputBytes: 4_096\n58\t  });\n59\t  expect(result.status, result.stderr).toBe(0);\n60\t  return JSON.parse(result.stdout);\n61\t}\n62\t\n63\tit.each([\"preview\", \"execute\"])(\"refuses %s with a real resistant Git tree and preserves all state\", async (mode) => {\n64\t  const before = protectedPaths.map((path) => readFileSync(path));\n65\t  const confirmation = mode === \"execute\" ? run(\"preview\").result.planDigest : undefined;\n66\t  const result = run(mode, { ...makeGitShim(root, env), PB_GIT_MODE: \"stall\", PB_DESCENDANT_FIXTURE: descendant }, confirmation);\n67\t  expect(result.error).toMatch(/Replay refused: Git enrichment exceeded 10000ms deadline/);\n68\t  expect(result.elapsedMs).toBeLessThan(10_000);\n69\t  expect(protectedPaths.map((path) => readFileSync(path))).toEqual(before);\n70\t  expect(pids().length).toBeGreaterThanOrEqual(2);\n71\t  await expect.poll(() => pids().some((pid) => { try { process.kill(pid, 0); return true; } catch { return false; } }), { timeout: 2_000 }).toBe(false);\n72\t  console.log(\"REPLAY_BOUND\", JSON.stringify({ mode, elapsedMs: result.elapsedMs, trackedProcesses: pids().length, stateUnchanged: true, liveOwnedProcesses: 0 }));\n73\t}, 20_000);\n74\t\n75\tit.each([\"preview\", \"execute\"])(\"refuses %s output overflow without leaking raw stderr\", (mode) => {\n76\t  const before = protectedPaths.map((path) => readFileSync(path));\n77\t  const confirmation = mode === \"execute\" ? run(\"preview\").result.planDigest : undefined;\n78\t  const result = run(mode, { ...makeGitShim(root, env), PB_GIT_MODE: \"overflow\" }, confirmation);\n79\t  expect(result.error).toBe(\"Replay refused: Git enrichment could not complete safely\");\n80\t  expect(JSON.stringify(result)).not.toMatch(/RAW-GIT|RAW-MESSAGE/);\n81\t  expect(protectedPaths.map((path) => readFileSync(path))).toEqual(before);\n82\t});\n83\t\n84\tit(\"does not renew the deadline across successive real Git calls\", () => {\n85\t  for (const args of [[\"init\", \"-q\"], [\"-c\", \"user.name=Fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"commit\", \"--allow-empty\", \"-qm\", \"initial\"]]) {\n86\t    execFileSync(env.PB_REAL_GIT!, args, { cwd: root, env, timeout: 2_000, stdio: \"pipe\" });\n87\t  }\n88\t  const result = run(\"preview\", { ...makeGitShim(root, env), PB_GIT_DELAY_MS: \"2500\" });\n89\t  expect(result.error).toMatch(/deadline/);\n90\t  expect(result.elapsedMs).toBeLessThan(10_000);\n91\t  expect(pids().length).toBeGreaterThan(1);\n92\t  console.log(\"SHARED_GIT_DEADLINE\", JSON.stringify({ elapsedMs: result.elapsedMs, gitInvocations: pids().length }));\n93\t}, 20_000);\n94\t\n95\tit(\"retains the production before-mutate deadline guard under the queue lock\", () => {\n96\t  const before = protectedPaths.map((path) => readFileSync(path));\n97\t  const preview = run(\"preview\");\n98\t  const result = run(\"late-lock\", {}, preview.result.planDigest);\n99\t  expect(result.lockSeen).toBe(true);\n100\t  expect(result.error).toBe(\"Replay refused: queue admission exceeded 10000ms deadline\");\n101\t  expect(existsSync(`${queue}.lock`)).toBe(false);\n102\t  expect(protectedPaths.map((path) => readFileSync(path))).toEqual(before);\n103\t  console.log(\"QUEUE_LOCK_GUARD\", JSON.stringify({ lockSeen: result.lockSeen, error: result.error, stateUnchanged: true }));\n104\t});\n105\t\n106\tit(\"preserves ordinary Git enrichment and read-only preview, then admits a confirmed minimal event\", () => {\n107\t  for (const args of [[\"init\", \"-q\"], [\"-c\", \"user.name=Fixture\", \"-c\", \"user.email=fixture@example.invalid\", \"commit\", \"--allow-empty\", \"-qm\", \"initial\"],\n108\t    [\"remote\", \"add\", \"origin\", \"https://reader:PRIVATE@git.example/team/fixture.git\"]]) {\n109\t    execFileSync(env.PB_REAL_GIT!, args, { cwd: root, env, timeout: 2_000, stdio: \"pipe\" });\n110\t  }\n111\t  const before = protectedPaths.map((path) => readFileSync(path));\n112\t  const preview = run(\"preview\");\n113\t  expect(preview.result.wouldAdmit).toBe(1);\n114\t  expect(protectedPaths.map((path) => readFileSync(path))).toEqual(before);\n115\t  expect(run(\"execute\", {}, preview.result.planDigest).result.admitted).toBe(1);\n116\t  const content = readFileSync(queue, \"utf8\");\n117\t  expect(content).not.toMatch(/RAW-MESSAGE|PRIVATE|reader/);\n118\t  const admitted = content.trim().split(\"\\n\").map((line) => JSON.parse(line)).find((event) => event.sourceEventId !== \"retained\");\n119\t  expect(admitted.gitCommit).toMatch(/^[0-9a-f]{40}$/);\n120\t  expect(admitted.gitRemote).toBe(\"https://git.example/team/fixture.git\");\n121\t  expect(protectedPaths.slice(1).map((path) => readFileSync(path))).toEqual(before.slice(1));\n122\t});"}
{"role":"tool","tool_call_id":"tool_k0YX9037CP6TtExDWYiZYQUV","content":"1\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n2\timport { mkdtempSync, mkdirSync, readFileSync, realpathSync, rmSync } from \"node:fs\";\n3\timport { tmpdir } from \"node:os\";\n4\timport { join } from \"node:path\";\n5\timport { fileURLToPath } from \"node:url\";\n6\timport {\n7\t  BoundedSubprocessLaunchError, BoundedSubprocessOutputError, BoundedSubprocessTimeoutError, BoundedSubprocessSupervisionError,\n8\t  runBoundedSubprocess, SUBPROCESS_TOTAL_ALLOWANCE_MS\n9\t} from \"../../../src/cli/bounded-subprocess\";\n10\t\n11\tconst fixture = fileURLToPath(new URL(\"../../fixtures/process-bounds/child.mjs\", import.meta.url));\n12\tlet root: string;\n13\tlet pidFile: string;\n14\tlet env: NodeJS.ProcessEnv;\n15\t\n16\tfunction pids(): number[] {\n17\t  try { return readFileSync(pidFile, \"utf8\").trim().split(\"\\n\").map(Number); } catch { return []; }\n18\t}\n19\t\n20\tfunction alive(pid: number): boolean {\n21\t  try { process.kill(pid, 0); return true; } catch { return false; }\n22\t}\n23\t\n24\tbeforeEach(() => {\n25\t  root = realpathSync(mkdtempSync(join(tmpdir(), \"pb-\")));\n26\t  mkdirSync(join(root, \"home\"));\n27\t  mkdirSync(join(root, \"tmp\"));\n28\t  pidFile = join(root, \"pids\");\n29\t  env = { ...process.env, HOME: join(root, \"home\"), USERPROFILE: join(root, \"home\"), TMPDIR: join(root, \"tmp\") };\n30\t});\n31\t\n32\tafterEach(() => {\n33\t  for (const pid of pids()) {\n34\t    try { process.kill(-pid, \"SIGKILL\"); } catch { /* only fixture-owned groups */ }\n35\t    try { process.kill(pid, \"SIGKILL\"); } catch { /* fixture already reaped */ }\n36\t  }\n37\t  rmSync(root, { recursive: true, force: true });\n38\t});\n39\t\n40\tfunction run(mode: string, timeoutMs = 500, maxOutputBytes = 1_024) {\n41\t  return runBoundedSubprocess(process.execPath, [fixture, mode, pidFile, \"one;two\", \"three four\"], {\n42\t    cwd: root, env, timeoutMs, maxOutputBytes\n43\t  });\n44\t}\n45\t\n46\tdescribe(\"bounded subprocess primitive\", () => {\n47\t  it(\"preserves explicit argv, cwd/env, stdout/stderr and success\", () => {\n48\t    const result = run(\"normal\", 2_000);\n49\t    expect(result.status).toBe(0);\n50\t    expect(result.signal).toBeNull();\n51\t    expect(result.stderr).toBe(\"stderr-control\");\n52\t    expect(JSON.parse(result.stdout)).toEqual({ argv: [\"one;two\", \"three four\"], cwd: root, home: env.HOME });\n53\t  });\n54\t\n55\t  it(\"preserves ordinary nonzero exit without confusing it with launch failure\", () => {\n56\t    expect(run(\"nonzero\", 2_000)).toMatchObject({ status: 23, signal: null, stdout: \"ordinary-failure\" });\n57\t    expect(() => runBoundedSubprocess(join(root, \"missing\"), [], {\n58\t      cwd: root, env, timeoutMs: 500, maxOutputBytes: 1_024\n59\t    })).toThrow(BoundedSubprocessLaunchError);\n60\t  });\n61\t\n62\t  it(\"distinguishes a missing target cwd from worker supervision failure\", () => {\n63\t    let caught: unknown;\n64\t    try {\n65\t      runBoundedSubprocess(process.execPath, [fixture, \"normal\", pidFile], {\n66\t        cwd: join(root, \"missing\"), env, timeoutMs: 500, maxOutputBytes: 1_024\n67\t      });\n68\t    } catch (error) { caught = error; }\n69\t    expect(caught).toBeInstanceOf(BoundedSubprocessLaunchError);\n70\t    expect(caught).toHaveProperty(\"code\", \"ENOENT\");\n71\t    const preload = new URL(\"../../fixtures/process-bounds/worker-failure.mjs\", import.meta.url).href;\n72\t    try {\n73\t      runBoundedSubprocess(process.execPath, [fixture, \"normal\", pidFile], {\n74\t        cwd: root, env: { ...env, NODE_OPTIONS: `--import=${preload}` }, timeoutMs: 500, maxOutputBytes: 1_024\n75\t      });\n76\t    } catch (error) { caught = error; }\n77\t    expect(caught).toBeInstanceOf(BoundedSubprocessSupervisionError);\n78\t    expect(String(caught)).not.toContain(\"RAW-WORKER\");\n79\t    expect(pids()).toEqual([]);\n80\t  });\n81\t\n82\t  it.skipIf(process.platform === \"win32\")(\"preserves termination signal\", () => {\n83\t    expect(run(\"signal\", 2_000)).toMatchObject({ status: null, signal: \"SIGTERM\" });\n84\t  });\n85\t\n86\t  it.each([0, -1, NaN, Infinity, 0.5, 2 ** 32])(\"rejects invalid timeout %s before launch\", (timeoutMs) => {\n87\t    expect(() => run(\"normal\", timeoutMs)).toThrow(RangeError);\n88\t    expect(pids()).toEqual([]);\n89\t  });\n90\t\n91\t  it.each([0, -1, NaN, Infinity, 0.5, 2 ** 32])(\"rejects invalid output budget %s before launch\", (maxOutputBytes) => {\n92\t    expect(() => run(\"normal\", 500, maxOutputBytes)).toThrow(RangeError);\n93\t    expect(pids()).toEqual([]);\n94\t  });\n95\t\n96\t  it.each([\"resistant\", \"descendant\", \"inherited-pipes\"])(\"bounds %s and reaps owned native processes\", async (mode) => {\n97\t    const start = Date.now();\n98\t    expect(() => run(mode)).toThrow(BoundedSubprocessTimeoutError);\n99\t    expect(Date.now() - start).toBeLessThan(500 + SUBPROCESS_TOTAL_ALLOWANCE_MS);\n100\t    expect(pids().length).toBe(mode === \"resistant\" ? 1 : 2);\n101\t    await expect.poll(() => pids().some(alive), { timeout: 2_000 }).toBe(false);\n102\t  });\n103\t\n104\t  it(\"caps combined streams, omits raw stderr from errors and cleans overflow child\", async () => {\n105\t    let caught: unknown;\n106\t    try { run(\"overflow\", 2_000, 2_048); } catch (error) { caught = error; }\n107\t    expect(caught).toBeInstanceOf(BoundedSubprocessOutputError);\n108\t    expect(String(caught)).not.toContain(\"RAW-STDERR-CANARY\");\n109\t    await expect.poll(() => pids().some(alive), { timeout: 2_000 }).toBe(false);\n110\t  });\n111\t\n112\t  it(\"accounts stdout and stderr against one combined byte budget\", () => {\n113\t    expect(() => run(\"combined\", 2_000, 1_024)).toThrow(BoundedSubprocessOutputError);\n114\t    const result = run(\"combined\", 2_000, 1_200);\n115\t    expect(result.stdout.length + result.stderr.length).toBe(1_200);\n116\t  });\n117\t\n118\t  it.skipIf(process.platform !== \"win32\")(\"uses a real Windows executable for tree cleanup\", async () => {\n119\t    expect(() => run(\"descendant\")).toThrow(BoundedSubprocessTimeoutError);\n120\t    await expect.poll(() => pids().some(alive), { timeout: 2_000 }).toBe(false);\n121\t  });\n122\t});"}
