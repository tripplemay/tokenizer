{"role":"tool","tool_call_id":"tool_Zr3tHAmymCMO1pJhZ4hbbWub","content":"1\timport { existsSync, readFileSync } from \"node:fs\";\n2\timport { join } from \"node:path\";\n3\timport { pathToFileURL } from \"node:url\";\n4\t\n5\tconst { request, config, queue, mode, confirmation } = JSON.parse(readFileSync(process.env.PB_REPLAY_MANIFEST, \"utf8\"));\n6\tif (queue !== join(process.env.HOME, \".tokenizer\", \"queue.jsonl\") || process.env.HOME !== process.env.USERPROFILE) {\n7\t  throw new Error(\"fixture requires an explicit synthetic queue and isolated home before import\");\n8\t}\n9\tconst root = process.env.PB_PRODUCT_ROOT;\n10\tconst { queuePath } = await import(pathToFileURL(join(root, \"src/cli/config.ts\")).href);\n11\tif (queuePath !== queue) throw new Error(\"unexpected fixture queue path\");\n12\tconst { dryRunBoundedReplay, executeBoundedReplay } = await import(pathToFileURL(join(root, \"src/cli/replay.ts\")).href);\n13\tconst { planBoundedReplay } = await import(pathToFileURL(join(root, \"src/cli/replay-contract.ts\")).href);\n14\tlet lockSeen = false;\n15\tconst now = Date.now;\n16\tif (mode === \"late-lock\") {\n17\t  Date.now = () => {\n18\t    if (existsSync(`${queue}.lock`)) { lockSeen = true; return now() + 11_000; }\n19\t    return now();\n20\t  };\n21\t}\n22\tconst started = now();\n23\ttry {\n24\t  const result = mode === \"preview\"\n25\t    ? dryRunBoundedReplay(planBoundedReplay(request), config)\n26\t    : executeBoundedReplay(planBoundedReplay({ ...request, dryRun: false }), config, confirmation, { readCurrentConfig: () => config });\n27\t  console.log(JSON.stringify({ result, elapsedMs: now() - started, lockSeen }));\n28\t} catch (error) {\n29\t  console.log(JSON.stringify({ error: error.message, elapsedMs: now() - started, lockSeen }));\n30\t} finally {\n31\t  Date.now = now;\n32\t}"}
