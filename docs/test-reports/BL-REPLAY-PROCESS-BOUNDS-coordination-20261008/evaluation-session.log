{"role":"tool","tool_call_id":"tool_QbqLNHTgVjYRzgUa9XXS2nez","content":"1\timport { execFileSync } from \"node:child_process\";\n2\timport { parseGitRemote } from \"@/shared/git-remote\";\n3\timport { UsageEventInput } from \"@/shared/usage\";\n4\timport { normalizeWorkspacePath, pathCacheKey } from \"@/shared/path\";\n5\timport { BoundedSubprocessLaunchError, BoundedSubprocessSupervisionError, runBoundedSubprocess, SUBPROCESS_TOTAL_ALLOWANCE_MS } from \"./bounded-subprocess\";\n6\t\n7\ttype GitInfo = {\n8\t  localWorkspacePath: string;\n9\t  repoKey: string | null;\n10\t  gitRemote: string | null;\n11\t  gitBranch: string | null;\n12\t  gitCommit: string | null;\n13\t};\n14\t\n15\tconst cache = new Map<string, GitInfo | null>();\n16\t// Leave time for child termination and replay refusal propagation inside the\n17\t// operation-wide deadline rather than using the full budget in execFileSync.\n18\tconst DEADLINE_TERMINATION_MARGIN_MS = SUBPROCESS_TOTAL_ALLOWANCE_MS;\n19\t\n20\texport type GitEnrichmentOptions = { deadlineMs?: number };\n21\t\n22\tfunction remainingTimeout(options: GitEnrichmentOptions): number | undefined {\n23\t  if (options.deadlineMs === undefined) return undefined;\n24\t  const remaining = options.deadlineMs - Date.now();\n25\t  if (remaining <= DEADLINE_TERMINATION_MARGIN_MS) throw new Error(\"Replay Git enrichment deadline exceeded\");\n26\t  return Math.max(1, Math.floor(remaining - DEADLINE_TERMINATION_MARGIN_MS));\n27\t}\n28\t\n29\tfunction git(args: string[], cwd: string, options: GitEnrichmentOptions): string | null {\n30\t  if (options.deadlineMs !== undefined) {\n31\t    const timeoutMs = remainingTimeout(options)!;\n32\t    try {\n33\t      const result = runBoundedSubprocess(\"git\", args, { cwd, timeoutMs, maxOutputBytes: 64 * 1024 });\n34\t      if (result.signal !== null) throw new BoundedSubprocessSupervisionError(\"Replay Git process terminated unexpectedly\");\n35\t      if (Date.now() >= options.deadlineMs) throw new Error(\"Replay Git enrichment deadline exceeded\");\n36\t      return result.status === 0 ? result.stdout.trim() || null : null;\n37\t    } catch (error) {\n38\t      // A missing executable remains compatible with ordinary non-Git source\n39\t      // files. Timeout/output/supervision errors must never cache partial data.\n40\t      if (error instanceof BoundedSubprocessLaunchError && error.code === \"ENOENT\") return null;\n41\t      throw error;\n42\t    }\n43\t  }\n44\t  try {\n45\t    return execFileSync(\"git\", args, {\n46\t      cwd,\n47\t      encoding: \"utf8\",\n48\t      stdio: [\"ignore\", \"pipe\", \"ignore\"]\n49\t    }).trim() || null;\n50\t  } catch {\n51\t    return null;\n52\t  }\n53\t}\n54\t\n55\texport function normalizeGitRemote(remote: string | null): string | null {\n56\t  return parseGitRemote(remote)?.repoKey ?? null;\n57\t}\n58\t\n59\tfunction getGitInfo(workspacePath?: string | null, options: GitEnrichmentOptions = {}): GitInfo | null {\n60\t  remainingTimeout(options);\n61\t  if (!workspacePath) return null;\n62\t  const cacheKey = pathCacheKey(workspacePath);\n63\t  if (cache.has(cacheKey)) return cache.get(cacheKey) ?? null;\n64\t\n65\t  const root = git([\"rev-parse\", \"--show-toplevel\"], workspacePath, options);\n66\t  if (!root) {\n67\t    cache.set(cacheKey, null);\n68\t    return null;\n69\t  }\n70\t\n71\t  const remote = git([\"remote\", \"get-url\", \"origin\"], root, options);\n72\t  const parsedRemote = parseGitRemote(remote);\n73\t  const info = {\n74\t    // git prints \"C:/Users/me/proj\" even on Windows, while the agent logs\n75\t    // record \"C:\\Users\\me\\proj\". Unnormalized, the same directory keys as two\n76\t    // different projects server-side.\n77\t    localWorkspacePath: normalizeWorkspacePath(root),\n78\t    repoKey: parsedRemote?.repoKey ?? null,\n79\t    gitRemote: parsedRemote?.safeRemote ?? null,\n80\t    gitBranch: git([\"branch\", \"--show-current\"], root, options),\n81\t    gitCommit: git([\"rev-parse\", \"HEAD\"], root, options)\n82\t  };\n83\t  cache.set(cacheKey, info);\n84\t  return info;\n85\t}\n86\t\n87\texport function enrichEventsWithGit(events: UsageEventInput[], options: GitEnrichmentOptions = {}): UsageEventInput[] {\n88\t  return events.map((event) => {\n89\t    const info = getGitInfo(event.workspacePath, options);\n90\t    // Normalized on the way out so both the git-backed and the no-git path\n91\t    // agree on one spelling. Identity for POSIX paths, so existing installs\n92\t    // keep hashing to the same userId_workspacePath row.\n93\t    const workspacePath = event.workspacePath ? normalizeWorkspacePath(event.workspacePath) : event.workspacePath;\n94\t    if (!info) {\n95\t      return { ...event, workspacePath, localWorkspacePath: event.localWorkspacePath ?? workspacePath ?? null };\n96\t    }\n97\t    return { ...event, ...info, workspacePath };\n98\t  });\n99\t}"}
{"role":"tool","tool_call_id":"tool_0L1BzP5AwOadT26LDR5kV3ox","content":"1\timport { createHash } from \"node:crypto\";\n2\timport { closeSync, constants, fstatSync, lstatSync, openSync, readSync } from \"node:fs\";\n3\timport { dirname, isAbsolute, parse } from \"node:path\";\n4\timport type { BigIntStats } from \"node:fs\";\n5\timport { parseClaudeJsonlBuffer } from \"@/parsers/claude\";\n6\timport type { UsageEventInput } from \"@/shared/usage\";\n7\timport { minimizeUsageEvent } from \"@/shared/usage-privacy\";\n8\timport { enrichEventsWithGit } from \"./git\";\n9\timport { mergeQueue } from \"./collect\";\n10\timport { readConfig, type TokenizerConfig } from \"./config\";\n11\timport { collectionAdmissionFingerprint, collectionScopeFingerprint, effectivePrivacy, filterUsageEvents, type PrivacyConfig } from \"./privacy\";\n12\timport type { BoundedReplayPlan } from \"./replay-contract\";\n13\timport { runBoundedSubprocess, SUBPROCESS_TOTAL_ALLOWANCE_MS } from \"./bounded-subprocess\";\n14\t\n15\tconst MAX_PHYSICAL_RECORDS = 50_000;\n16\tconst MAX_LINE_BYTES = 1024 * 1024;\n17\tconst MAX_ELAPSED_MS = 10_000;\n18\texport const MAX_REPLAY_SAMPLE = 5;\n19\t\n20\ttype FileIdentity = Readonly<{\n21\t  dev: string;\n22\t  ino: string;\n23\t  size: number;\n24\t  mtimeNs: string;\n25\t  ctimeNs: string;\n26\t  contentSha256: string;\n27\t}>;\n28\t\n29\texport type ReplayFileSnapshot = Readonly<{\n30\t  bytes: Buffer;\n31\t  mtime: Date;\n32\t  records: number;\n33\t  identity: FileIdentity;\n34\t}>;\n35\t\n36\texport type ReplayReadHooks = {\n37\t  afterPathStat?: () => void;\n38\t  afterRead?: () => void;\n39\t};\n40\t\n41\ttype ReplayInspection = {\n42\t  snapshot: ReplayFileSnapshot;\n43\t  planDigest: string;\n44\t  parsed: number;\n45\t  selected: UsageEventInput[];\n46\t  eligible: UsageEventInput[];\n47\t  warningCount: number;\n48\t  scopeFingerprint: string;\n49\t  mode: \"sync\" | \"local-only\" | \"paused\";\n50\t  admissionBinding: string;\n51\t};\n52\t\n53\texport type ReplayDryRunResult = {\n54\t  dryRun: true;\n55\t  planDigest: string;\n56\t  bytes: number;\n57\t  records: number;\n58\t  parsed: number;\n59\t  selected: number;\n60\t  filtered: number;\n61\t  wouldAdmit: number;\n62\t  warningCount: number;\n63\t  sample: Array<{\n64\t    occurredAt: string;\n65\t    model: string | null;\n66\t    inputTokens: number;\n67\t    outputTokens: number;\n68\t    totalTokens: number;\n69\t  }>;\n70\t};\n71\t\n72\texport type ReplayExecutionResult = {\n73\t  dryRun: false;\n74\t  planDigest: string;\n75\t  selected: number;\n76\t  filtered: number;\n77\t  admitted: number;\n78\t  duplicates: number;\n79\t  backlog: number;\n80\t  warningCount: number;\n81\t  upload: string;\n82\t};\n83\t\n84\tfunction fail(message: string): never {\n85\t  throw new Error(`Replay refused: ${message}`);\n86\t}\n87\t\n88\tfunction replayDeadline(): number {\n89\t  return Date.now() + MAX_ELAPSED_MS;\n90\t}\n91\t\n92\tfunction assertWithinDeadline(deadlineMs: number, stage: string): void {\n93\t  if (Date.now() >= deadlineMs) fail(`${stage} exceeded ${MAX_ELAPSED_MS}ms deadline`);\n94\t}\n95\t\n96\tfunction enrichReplayEvents(events: UsageEventInput[], deadlineMs: number): UsageEventInput[] {\n97\t  try {\n98\t    return enrichEventsWithGit(events, { deadlineMs });\n99\t  } catch (error) {\n100\t    if (error instanceof Error && /deadline|timeout/i.test(error.message)) {\n101\t      fail(`Git enrichment exceeded ${MAX_ELAPSED_MS}ms deadline`);\n102\t    }\n103\t    fail(\"Git enrichment could not complete safely\");\n104\t  }\n105\t}\n106\t\n107\tfunction statIdentity(stat: BigIntStats): Omit<FileIdentity, \"contentSha256\"> {\n108\t  return {\n109\t    dev: String(stat.dev),\n110\t    ino: String(stat.ino),\n111\t    size: Number(stat.size),\n112\t    mtimeNs: String(stat.mtimeNs),\n113\t    ctimeNs: String(stat.ctimeNs)\n114\t  };\n115\t}\n116\t\n117\tfunction sameIdentity(left: Omit<FileIdentity, \"contentSha256\">, right: Omit<FileIdentity, \"contentSha256\">): boolean {\n118\t  return left.dev === right.dev && left.ino === right.ino && left.size === right.size &&\n119\t    left.mtimeNs === right.mtimeNs && left.ctimeNs === right.ctimeNs;\n120\t}\n121\t\n122\ttype ParentIdentity = { path: string; dev: string; ino: string };\n123\t\n124\tfunction checkSourcePath(file: string, deadlineMs: number, nativeAttributes = true): ParentIdentity[] {\n125\t  assertWithinDeadline(deadlineMs, \"source inspection\");\n126\t  const segments = file.split(process.platform === \"win32\" ? /[\\\\/]/ : /\\//);\n127\t  if (!isAbsolute(file) || segments.some((segment) => segment === \".\" || segment === \"..\")) {\n128\t    fail(\"source requires an absolute path without dot traversal\");\n129\t  }\n130\t  if (process.platform === \"win32\" && (!/^[a-z]:[\\\\/]/i.test(file) || file.slice(3).includes(\":\"))) {\n131\t    fail(\"source requires a local Windows drive file, not a device, network path or alternate stream\");\n132\t  }\n133\t  const parents: string[] = [];\n134\t  for (let current = dirname(file); ; current = dirname(current)) {\n135\t    parents.unshift(current);\n136\t    if (current === parse(current).root) break;\n137\t  }\n138\t  const identities = parents.map((path) => {\n139\t    const stat = lstatSync(path, { bigint: true });\n140\t    if (!stat.isDirectory() || stat.isSymbolicLink()) fail(\"source parent must be a non-symlink directory\");\n141\t    return { path, dev: String(stat.dev), ino: String(stat.ino) };\n142\t  });\n143\t  if (process.platform === \"win32\") {\n144\t    const leaf = lstatSync(file, { bigint: true });\n145\t    if (!leaf.isFile() || leaf.isSymbolicLink()) fail(\"source must be one regular non-symlink file\");\n146\t  }\n147\t  if (process.platform === \"win32\" && nativeAttributes) {\n148\t    // Node's stat flags do not expose every Windows reparse tag. Check native\n149\t    // attributes before/after reading; unavailable checks fail closed.\n150\t    const script = \"$ErrorActionPreference='Stop'; foreach($p in (ConvertFrom-Json $env:TOKENIZER_REPLAY_PATHS)) { if(([IO.File]::GetAttributes($p) -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'reparse point' } }; 'TOKENIZER_REPLAY_NO_REPARSE_V1'\";\n151\t    const remaining = deadlineMs - Date.now() - SUBPROCESS_TOTAL_ALLOWANCE_MS;\n152\t    if (remaining <= 0) fail(`read exceeded ${MAX_ELAPSED_MS}ms`);\n153\t    const result = runBoundedSubprocess(\"powershell.exe\", [\"-NoLogo\", \"-NoProfile\", \"-NonInteractive\", \"-Command\", script], {\n154\t      env: { ...process.env, TOKENIZER_REPLAY_PATHS: JSON.stringify([...parents, file]) },\n155\t      windowsHide: true, timeoutMs: remaining, maxOutputBytes: 16 * 1024\n156\t    });\n157\t    if (result.status !== 0 || result.signal !== null || result.stdout.trim() !== \"TOKENIZER_REPLAY_NO_REPARSE_V1\") {\n158\t      fail(\"source reparse-point check failed\");\n159\t    }\n160\t  }\n161\t  assertWithinDeadline(deadlineMs, \"source inspection\");\n162\t  return identities;\n163\t}\n164\t\n165\tfunction checkSameParents(before: ParentIdentity[], after: ParentIdentity[]) {\n166\t  if (before.length !== after.length || before.some((parent, index) => {\n167\t    const current = after[index];\n168\t    return parent.path !== current.path || parent.dev !== current.dev || parent.ino !== current.ino;\n169\t  })) fail(\"source parent changed while being read\");\n170\t}\n171\t\n172\tfunction validateRecords(bytes: Buffer): number {\n173\t  let records = 0;\n174\t  let lineStart = 0;\n175\t  for (let index = 0; index < bytes.length; index += 1) {\n176\t    if (bytes[index] !== 0x0a) continue;\n177\t    if (index - lineStart > MAX_LINE_BYTES) fail(`line exceeds ${MAX_LINE_BYTES} bytes`);\n178\t    records += 1;\n179\t    if (records > MAX_PHYSICAL_RECORDS) fail(`physical record limit exceeds ${MAX_PHYSICAL_RECORDS}`);\n180\t    lineStart = index + 1;\n181\t  }\n182\t  if (lineStart < bytes.length) {\n183\t    if (bytes.length - lineStart > MAX_LINE_BYTES) fail(`line exceeds ${MAX_LINE_BYTES} bytes`);\n184\t    records += 1;\n185\t  }\n186\t  if (records > MAX_PHYSICAL_RECORDS) fail(`physical record limit exceeds ${MAX_PHYSICAL_RECORDS}`);\n187\t  return records;\n188\t}\n189\t\n190\texport function readBoundedReplayFile(\n191\t  file: string,\n192\t  maxBytes: number,\n193\t  hooks: ReplayReadHooks = {},\n194\t  deadlineMs = replayDeadline()\n195\t): ReplayFileSnapshot {\n196\t  let descriptor: number | undefined;\n197\t  try {\n198\t    const parents = checkSourcePath(file, deadlineMs);\n199\t    const beforeStat = lstatSync(file, { bigint: true });\n200\t    if (!beforeStat.isFile() || beforeStat.isSymbolicLink()) fail(\"source must be one regular non-symlink file\");\n201\t    const before = statIdentity(beforeStat);\n202\t    if (before.size > maxBytes) fail(`byte limit exceeded (${before.size} > ${maxBytes})`);\n203\t    hooks.afterPathStat?.();\n204\t    assertWithinDeadline(deadlineMs, \"source inspection\");\n205\t    checkSameParents(parents, checkSourcePath(file, deadlineMs, false));\n206\t\n207\t    // O_NOFOLLOW alone still blocks when a regular path is raced into a FIFO.\n208\t    const flags = process.platform === \"win32\" ? 0 : constants.O_NOFOLLOW | constants.O_NONBLOCK;\n209\t    descriptor = openSync(file, constants.O_RDONLY | flags);\n210\t    const openedStat = fstatSync(descriptor, { bigint: true });\n211\t    if (!openedStat.isFile()) fail(\"opened source is not a regular file\");\n212\t    const opened = statIdentity(openedStat);\n213\t    if (!sameIdentity(before, opened)) fail(\"source changed between path check and open\");\n214\t    checkSameParents(parents, checkSourcePath(file, deadlineMs, false));\n215\t\n216\t    const bytes = Buffer.allocUnsafe(maxBytes + 1);\n217\t    let offset = 0;\n218\t    while (offset < bytes.length) {\n219\t      const count = readSync(descriptor, bytes, offset, bytes.length - offset, null);\n220\t      if (count === 0) break;\n221\t      offset += count;\n222\t      assertWithinDeadline(deadlineMs, \"read\");\n223\t    }\n224\t    if (offset > maxBytes) fail(`byte limit exceeded (${offset} > ${maxBytes})`);\n225\t    hooks.afterRead?.();\n226\t\n227\t    assertWithinDeadline(deadlineMs, \"read\");\n228\t    checkSameParents(parents, checkSourcePath(file, deadlineMs));\n229\t\n230\t    const afterHandleStat = fstatSync(descriptor, { bigint: true });\n231\t    const afterPathStat = lstatSync(file, { bigint: true });\n232\t    if (!afterPathStat.isFile() || afterPathStat.isSymbolicLink()) fail(\"source path became non-regular\");\n233\t    const afterHandle = statIdentity(afterHandleStat);\n234\t    const afterPath = statIdentity(afterPathStat);\n235\t    if (!sameIdentity(opened, afterHandle) || !sameIdentity(opened, afterPath)) fail(\"source changed while being read\");\n236\t    assertWithinDeadline(deadlineMs, \"read\");\n237\t\n238\t    const content = bytes.subarray(0, offset);\n239\t    return Object.freeze({\n240\t      bytes: content,\n241\t      mtime: new Date(Number(afterHandleStat.mtimeMs)),\n242\t      records: validateRecords(content),\n243\t      identity: Object.freeze({ ...afterHandle, contentSha256: createHash(\"sha256\").update(content).digest(\"hex\") })\n244\t    });\n245\t  } catch (error) {\n246\t    if (error instanceof Error && error.message.startsWith(\"Replay refused:\")) throw error;\n247\t    fail(\"source could not be opened safely\");\n248\t  } finally {\n249\t    if (descriptor !== undefined) closeSync(descriptor);\n250\t  }\n251\t}\n252\t\n253\tfunction admissionBinding(selected: UsageEventInput[], candidates: UsageEventInput[], privacy: PrivacyConfig): string {\n254\t  return createHash(\"sha256\").update(JSON.stringify({\n255\t    physicalScope: collectionAdmissionFingerprint(selected, privacy),\n256\t    candidates\n257\t  })).digest(\"hex\");\n258\t}\n259\t\n260\tfunction digestPlan(plan: BoundedReplayPlan, identity: FileIdentity, config: TokenizerConfig, binding: string): string {\n261\t  const privacy = effectivePrivacy(config);\n262\t  return createHash(\"sha256\").update(JSON.stringify({\n263\t    schema: \"bounded-replay-confirmation-v1\",\n264\t    source: plan.source,\n265\t    file: plan.file,\n266\t    from: plan.from,\n267\t    to: plan.to,\n268\t    maxBytes: plan.maxBytes,\n269\t    maxEvents: plan.maxEvents,\n270\t    maxFiles: plan.maxFiles,\n271\t    identity,\n272\t    projectRoots: config.projectRoots,\n273\t    admissionBinding: binding,\n274\t    collectionScopeFingerprint: collectionScopeFingerprint(privacy),\n275\t    privacyMode: privacy.mode\n276\t  })).digest(\"hex\");\n277\t}\n278\t\n279\tfunction inspectReplay(plan: BoundedReplayPlan, config: TokenizerConfig, deadlineMs: number): ReplayInspection {\n280\t  assertWithinDeadline(deadlineMs, \"inspection\");\n281\t  const privacy = effectivePrivacy(config);\n282\t  const snapshot = readBoundedReplayFile(plan.file, plan.maxBytes, {}, deadlineMs);\n283\t  const parsed = parseClaudeJsonlBuffer({\n284\t    file: plan.file,\n285\t    bytes: snapshot.bytes,\n286\t    mtime: snapshot.mtime,\n287\t    projectRoots: config.projectRoots\n288\t  });\n289\t  const from = Date.parse(plan.from);\n290\t  const to = Date.parse(plan.to);\n291\t  const selected = parsed.events.filter((event) => {\n292\t    const occurredAt = Date.parse(event.occurredAt);\n293\t    return Number.isFinite(occurredAt) && occurredAt >= from && occurredAt < to;\n294\t  });\n295\t  if (selected.length > plan.maxEvents) fail(`event limit exceeded (${selected.length} > ${plan.maxEvents})`);\n296\t  assertWithinDeadline(deadlineMs, \"parse and scope admission\");\n297\t  const eligible = filterUsageEvents(\n298\t    enrichReplayEvents(filterUsageEvents(selected, privacy), deadlineMs),\n299\t    privacy\n300\t  ).map(minimizeUsageEvent);\n301\t  assertWithinDeadline(deadlineMs, \"Git enrichment and scope admission\");\n302\t  const binding = admissionBinding(selected, eligible, privacy);\n303\t  assertWithinDeadline(deadlineMs, \"inspection\");\n304\t  return {\n305\t    snapshot,\n306\t    planDigest: digestPlan(plan, snapshot.identity, config, binding),\n307\t    parsed: parsed.events.length,\n308\t    selected,\n309\t    eligible,\n310\t    warningCount: parsed.warnings.length,\n311\t    scopeFingerprint: collectionScopeFingerprint(privacy),\n312\t    mode: privacy.mode,\n313\t    admissionBinding: binding\n314\t  };\n315\t}\n316\t\n317\tfunction safeSample(events: UsageEventInput[], count: number): ReplayDryRunResult[\"sample\"] {\n318\t  return events.slice(0, count).map((event) => ({\n319\t    occurredAt: event.occurredAt,\n320\t    model: event.model ?? null,\n321\t    inputTokens: event.inputTokens ?? 0,\n322\t    outputTokens: event.outputTokens ?? 0,\n323\t    totalTokens: event.totalTokens ?? 0\n324\t  }));\n325\t}\n326\t\n327\texport function dryRunBoundedReplay(plan: BoundedReplayPlan, config: TokenizerConfig, sampleCount = 0): ReplayDryRunResult {\n328\t  if (!plan.dryRun) fail(\"execution plan cannot be used as a dry-run\");\n329\t  if (!Number.isSafeInteger(sampleCount) || sampleCount < 0 || sampleCount > MAX_REPLAY_SAMPLE) {\n330\t    fail(`sample limit must be between 0 and ${MAX_REPLAY_SAMPLE}`);\n331\t  }\n332\t  const inspection = inspectReplay(plan, config, replayDeadline());\n333\t  return {\n334\t    dryRun: true,\n335\t    planDigest: inspection.planDigest,\n336\t    bytes: inspection.snapshot.bytes.length,\n337\t    records: inspection.snapshot.records,\n338\t    parsed: inspection.parsed,\n339\t    selected: inspection.selected.length,\n340\t    filtered: inspection.selected.length - inspection.eligible.length,\n341\t    wouldAdmit: inspection.eligible.length,\n342\t    warningCount: inspection.warningCount,\n343\t    sample: safeSample(inspection.eligible, sampleCount)\n344\t  };\n345\t}\n346\t\n347\texport function executeBoundedReplay(\n348\t  plan: BoundedReplayPlan,\n349\t  config: TokenizerConfig,\n350\t  confirmation: string,\n351\t  options: {\n352\t    readCurrentConfig?: () => TokenizerConfig;\n353\t    mergeEvents?: typeof mergeQueue;\n354\t  } = {}\n355\t): ReplayExecutionResult {\n356\t  if (plan.dryRun) fail(\"dry-run plan cannot execute\");\n357\t  if (!/^[0-9a-f]{64}$/.test(confirmation)) fail(\"execution requires an exact lowercase SHA-256 confirmation digest\");\n358\t  if (effectivePrivacy(config).mode === \"paused\") fail(\"execution is disabled while privacy mode is paused\");\n359\t  const deadlineMs = replayDeadline();\n360\t  const inspection = inspectReplay(plan, config, deadlineMs);\n361\t  if (inspection.planDigest !== confirmation) fail(\"confirmation digest does not match the current file, scope, mode, window, or budgets\");\n362\t\n363\t  // Re-open immediately before admission. A file replacement/growth or a\n364\t  // configure change after the preview invalidates the confirmation rather\n365\t  // than admitting a different snapshot.\n366\t  const currentConfig = (options.readCurrentConfig ?? readConfig)();\n367\t  assertWithinDeadline(deadlineMs, \"final config admission\");\n368\t  const confirmationSnapshot = readBoundedReplayFile(plan.file, plan.maxBytes, {}, deadlineMs);\n369\t  if (digestPlan(plan, confirmationSnapshot.identity, currentConfig, inspection.admissionBinding) !== confirmation) {\n370\t    fail(\"confirmation digest became stale before queue admission\");\n371\t  }\n372\t  if (inspection.scopeFingerprint !== collectionScopeFingerprint(effectivePrivacy(currentConfig)) ||\n373\t      inspection.mode !== effectivePrivacy(currentConfig).mode) {\n374\t    fail(\"privacy scope or mode changed before queue admission\");\n375\t  }\n376\t\n377\t  const privacy = effectivePrivacy(currentConfig);\n378\t  const admittedCandidates = filterUsageEvents(\n379\t    enrichReplayEvents(filterUsageEvents(inspection.selected, privacy), deadlineMs),\n380\t    privacy\n381\t  ).map(minimizeUsageEvent);\n382\t  assertWithinDeadline(deadlineMs, \"final Git enrichment and admission\");\n383\t  const finalBinding = admissionBinding(inspection.selected, admittedCandidates, privacy);\n384\t  if (digestPlan(plan, confirmationSnapshot.identity, currentConfig, finalBinding) !== confirmation) {\n385\t    fail(\"physical scope or admitted candidates became stale before queue admission\");\n386\t  }\n387\t  assertWithinDeadline(deadlineMs, \"queue admission\");\n388\t  const remainingMs = Math.max(1, deadlineMs - Date.now());\n389\t  const merged = options.mergeEvents\n390\t    ? options.mergeEvents(admittedCandidates)\n391\t    : mergeQueue(admittedCandidates, undefined, {\n392\t      timeoutMs: remainingMs,\n393\t      beforeMutate: () => assertWithinDeadline(deadlineMs, \"queue admission\")\n394\t    });\n395\t  return {\n396\t    dryRun: false,\n397\t    planDigest: confirmation,\n398\t    selected: inspection.selected.length,\n399\t    filtered: inspection.selected.length - inspection.eligible.length,\n400\t    admitted: merged.added,\n401\t    duplicates: admittedCandidates.length - merged.added,\n402\t    backlog: merged.events.length,\n403\t    warningCount: inspection.warningCount,\n404\t    upload: inspection.mode === \"sync\"\n405\t      ? \"Backlog uploads automatically on the next Agent/run/sync cycle.\"\n406\t      : \"Backlog remains local until sync mode; it then uploads on the next Agent/run/sync cycle.\"\n407\t  };\n408\t}"}
