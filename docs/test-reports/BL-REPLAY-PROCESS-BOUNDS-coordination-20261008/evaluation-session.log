{"role":"tool","tool_call_id":"tool_jnaPc955OYMqB171jKTOIcoH","content":"1\timport { spawn } from \"node:child_process\";\n2\timport { writeSync } from \"node:fs\";\n3\t\n4\tconst { command, args, cwd, timeoutMs, maxOutputBytes, cleanupMs } = JSON.parse(process.argv[2]);\n5\tlet child;\n6\tlet finished = false;\n7\tlet closed = false;\n8\tlet outputBytes = 0;\n9\tconst stdout = [];\n10\tconst stderr = [];\n11\t\n12\tasync function killTree() {\n13\t  if (!child?.pid) return true;\n14\t  const deadline = Date.now() + cleanupMs;\n15\t  let successful = true;\n16\t  if (process.platform !== \"win32\") {\n17\t    try { process.kill(-child.pid, \"SIGKILL\"); } catch (error) { successful = error.code === \"ESRCH\"; }\n18\t  } else {\n19\t    successful = await new Promise((resolve) => {\n20\t      let settled = false;\n21\t      let killer;\n22\t      const done = (ok) => {\n23\t        if (settled) return;\n24\t        settled = true;\n25\t        clearTimeout(limit);\n26\t        resolve(ok);\n27\t      };\n28\t      const limit = setTimeout(() => {\n29\t        try { killer?.kill(\"SIGKILL\"); } catch { /* killer already exited */ }\n30\t        done(false);\n31\t      }, Math.max(1, cleanupMs - 100));\n32\t      try {\n33\t        killer = spawn(\"taskkill.exe\", [\"/pid\", String(child.pid), \"/T\", \"/F\"], {\n34\t          stdio: \"ignore\", windowsHide: true\n35\t        });\n36\t        killer.once(\"error\", () => done(false));\n37\t        killer.once(\"close\", (status) => done(status === 0));\n38\t      } catch {\n39\t        done(false);\n40\t      }\n41\t    });\n42\t  }\n43\t  try { child.kill(\"SIGKILL\"); } catch { /* direct-child fallback */ }\n44\t  while (!closed && Date.now() < deadline) {\n45\t    await new Promise((resolve) => setTimeout(resolve, 10));\n46\t  }\n47\t  child.stdout?.destroy();\n48\t  child.stderr?.destroy();\n49\t  return successful && closed;\n50\t}\n51\t\n52\tasync function finish(result) {\n53\t  if (finished) return;\n54\t  finished = true;\n55\t  clearTimeout(timer);\n56\t  if (result.kind !== \"ok\" && !await killTree()) result = { kind: \"supervision\" };\n57\t  process.stdout.write(JSON.stringify(result), () => process.exit(0));\n58\t}\n59\t\n60\tfunction collect(target, chunk) {\n61\t  if (finished) return;\n62\t  outputBytes += chunk.length;\n63\t  if (outputBytes > maxOutputBytes) {\n64\t    void finish({ kind: \"output\" });\n65\t    return;\n66\t  }\n67\t  target.push(chunk);\n68\t}\n69\t\n70\tconst timer = setTimeout(() => void finish({ kind: \"timeout\" }), timeoutMs);\n71\ttry {\n72\t  child = spawn(command, args, {\n73\t    cwd,\n74\t    stdio: [\"ignore\", \"pipe\", \"pipe\"],\n75\t    detached: process.platform !== \"win32\",\n76\t    windowsHide: true\n77\t  });\n78\t  // Synchronous publication permits the parent watchdog to clean the owned\n79\t  // group if this worker fails after launch. Zero denotes no spawned child.\n80\t  writeSync(1, `${child.pid ?? 0}\\n`);\n81\t  child.stdout.on(\"data\", (chunk) => collect(stdout, chunk));\n82\t  child.stderr.on(\"data\", (chunk) => collect(stderr, chunk));\n83\t  child.on(\"error\", (error) => void finish({ kind: \"launch\", code: error.code }));\n84\t  child.on(\"close\", (status, signal) => {\n85\t    closed = true;\n86\t    void finish({ kind: \"ok\", status, signal,\n87\t      stdout: Buffer.concat(stdout).toString(\"base64\"),\n88\t      stderr: Buffer.concat(stderr).toString(\"base64\")\n89\t    });\n90\t  });\n91\t} catch (error) {\n92\t  if (!child) writeSync(1, \"0\\n\");\n93\t  void finish({ kind: \"launch\", code: error.code });\n94\t}"}
{"role":"tool","tool_call_id":"tool_9XZk0nnNiywhq6DxpHUF9rgE","content":"1\timport { spawnSync, type SpawnSyncOptions } from \"node:child_process\";\n2\timport { fileURLToPath } from \"node:url\";\n3\t\n4\texport class BoundedSubprocessTimeoutError extends Error {}\n5\texport class BoundedSubprocessOutputError extends Error {}\n6\texport class BoundedSubprocessLaunchError extends Error {\n7\t  constructor(public readonly code?: string) { super(\"subprocess failed to start\"); }\n8\t}\n9\texport class BoundedSubprocessSupervisionError extends Error {}\n10\t\n11\t// The worker gets 1 s for tree termination and close notification, plus 1 s\n12\t// for startup/response delivery. These are scheduling allowances, not a hard\n13\t// real-time guarantee under OS suspension, stalled syscalls or escaped groups.\n14\texport const SUBPROCESS_CLEANUP_ALLOWANCE_MS = 1_000;\n15\texport const SUBPROCESS_WATCHDOG_ALLOWANCE_MS = 1_000;\n16\texport const SUBPROCESS_TOTAL_ALLOWANCE_MS = SUBPROCESS_CLEANUP_ALLOWANCE_MS + SUBPROCESS_WATCHDOG_ALLOWANCE_MS +\n17\t  (process.platform === \"win32\" ? SUBPROCESS_CLEANUP_ALLOWANCE_MS : 0);\n18\t\n19\texport type BoundedSubprocessResult = {\n20\t  status: number | null;\n21\t  signal: NodeJS.Signals | null;\n22\t  stdout: string;\n23\t  stderr: string;\n24\t};\n25\t\n26\ttype WorkerResult = {\n27\t  kind: \"ok\" | \"timeout\" | \"output\" | \"launch\" | \"supervision\";\n28\t  status?: number | null;\n29\t  signal?: NodeJS.Signals | null;\n30\t  stdout?: string;\n31\t  stderr?: string;\n32\t  code?: string;\n33\t};\n34\t\n35\tconst worker = fileURLToPath(new URL(\"./bounded-subprocess-worker.mjs\", import.meta.url));\n36\t\n37\t// Only used if the worker watchdog/protocol fails, after it has published its\n38\t// owned child PID. Never discover targets by executable name or process scan.\n39\tfunction cleanupAfterWorkerFailure(pid: number): void {\n40\t  if (process.platform === \"win32\") {\n41\t    spawnSync(\"taskkill.exe\", [\"/pid\", String(pid), \"/T\", \"/F\"], {\n42\t      stdio: \"ignore\", windowsHide: true, timeout: SUBPROCESS_CLEANUP_ALLOWANCE_MS, killSignal: \"SIGKILL\"\n43\t    });\n44\t  } else {\n45\t    try { process.kill(-pid, \"SIGKILL\"); } catch { /* owned group already exited */ }\n46\t  }\n47\t  try { process.kill(pid, \"SIGKILL\"); } catch { /* owned child already exited */ }\n48\t}\n49\t\n50\texport function runBoundedSubprocess(\n51\t  command: string,\n52\t  args: string[],\n53\t  options: Pick<SpawnSyncOptions, \"cwd\" | \"env\" | \"windowsHide\"> & {\n54\t    timeoutMs: number;\n55\t    maxOutputBytes: number;\n56\t  }\n57\t): BoundedSubprocessResult {\n58\t  if (!Number.isSafeInteger(options.timeoutMs) || options.timeoutMs <= 0 ||\n59\t      options.timeoutMs > 2_147_483_647 - SUBPROCESS_TOTAL_ALLOWANCE_MS) {\n60\t    throw new RangeError(\"subprocess timeout must be a positive bounded integer\");\n61\t  }\n62\t  if (!Number.isSafeInteger(options.maxOutputBytes) || options.maxOutputBytes <= 0 ||\n63\t      options.maxOutputBytes > 16 * 1024 * 1024) {\n64\t    throw new RangeError(\"subprocess output limit must be between 1 byte and 16 MiB\");\n65\t  }\n66\t  if (typeof command !== \"string\" || !command || command.includes(\"\\0\") ||\n67\t      !Array.isArray(args) || args.some((arg) => typeof arg !== \"string\" || arg.includes(\"\\0\"))) {\n68\t    throw new TypeError(\"subprocess requires an executable and an explicit string argument array\");\n69\t  }\n70\t  const helper = spawnSync(process.execPath, [worker, JSON.stringify({\n71\t    command, args, timeoutMs: options.timeoutMs, maxOutputBytes: options.maxOutputBytes,\n72\t    cwd: options.cwd instanceof URL ? fileURLToPath(options.cwd) : options.cwd,\n73\t    cleanupMs: SUBPROCESS_CLEANUP_ALLOWANCE_MS\n74\t  })], {\n75\t    env: options.env,\n76\t    encoding: \"utf8\",\n77\t    stdio: [\"ignore\", \"pipe\", \"pipe\"],\n78\t    timeout: options.timeoutMs + SUBPROCESS_CLEANUP_ALLOWANCE_MS + SUBPROCESS_WATCHDOG_ALLOWANCE_MS,\n79\t    killSignal: \"SIGKILL\",\n80\t    maxBuffer: Math.ceil(options.maxOutputBytes * 4 / 3) + 4_096,\n81\t    windowsHide: options.windowsHide ?? true\n82\t  });\n83\t  const lines = (helper.stdout ?? \"\").split(\"\\n\");\n84\t  const pid = /^\\d+$/.test(lines[0]) ? Number(lines[0]) : 0;\n85\t  const ownedPid = Number.isSafeInteger(pid) && pid > 0;\n86\t  let result: WorkerResult;\n87\t  try {\n88\t    if (helper.error || helper.status !== 0 || !/^\\d+$/.test(lines[0]) || lines.length !== 2) throw new Error();\n89\t    result = JSON.parse(lines[1]) as WorkerResult;\n90\t    if (![\"ok\", \"timeout\", \"output\", \"launch\", \"supervision\"].includes(result.kind)) throw new Error();\n91\t    if (result.kind === \"ok\" && (!ownedPid || typeof result.stdout !== \"string\" || typeof result.stderr !== \"string\" ||\n92\t        !(result.status === null || Number.isInteger(result.status)) ||\n93\t        !(result.signal === null || typeof result.signal === \"string\"))) throw new Error();\n94\t  } catch {\n95\t    if (ownedPid) cleanupAfterWorkerFailure(pid);\n96\t    if ((helper.error as NodeJS.ErrnoException | undefined)?.code === \"ETIMEDOUT\") {\n97\t      throw new BoundedSubprocessTimeoutError(\"subprocess worker deadline exceeded\");\n98\t    }\n99\t    throw new BoundedSubprocessSupervisionError(\"subprocess supervision failed\");\n100\t  }\n101\t  if (result.kind === \"timeout\") throw new BoundedSubprocessTimeoutError(\"subprocess deadline exceeded\");\n102\t  if (result.kind === \"output\") throw new BoundedSubprocessOutputError(\"subprocess output limit exceeded\");\n103\t  if (result.kind === \"launch\") throw new BoundedSubprocessLaunchError(result.code);\n104\t  if (result.kind === \"supervision\") throw new BoundedSubprocessSupervisionError(\"subprocess cleanup failed\");\n105\t  const stdout = Buffer.from(result.stdout!, \"base64\");\n106\t  const stderr = Buffer.from(result.stderr!, \"base64\");\n107\t  if (stdout.length + stderr.length > options.maxOutputBytes) {\n108\t    cleanupAfterWorkerFailure(pid);\n109\t    throw new BoundedSubprocessOutputError(\"subprocess response limit exceeded\");\n110\t  }\n111\t  return { status: result.status!, signal: result.signal!, stdout: stdout.toString(\"utf8\"), stderr: stderr.toString(\"utf8\") };\n112\t}"}
