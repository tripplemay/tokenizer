{"role":"tool","tool_call_id":"tool_xoRaVaGoQEtwt3irSSASXFdm","content":"1\timport { spawn, execFileSync } from \"node:child_process\";\n2\timport { copyFileSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from \"node:fs\";\n3\timport { tmpdir } from \"node:os\";\n4\timport { join } from \"node:path\";\n5\timport { fileURLToPath } from \"node:url\";\n6\timport { makeGitShim } from \"../../cli/process-bounds/fixtures\";\n7\t\n8\tconst baseline = \"ba292a059184a36e4bb6c3341ac059606d24f961\";\n9\tconst repo = fileURLToPath(new URL(\"../../../\", import.meta.url));\n10\tconst evidence = process.argv[2];\n11\tif (!evidence || process.env.HOME !== process.env.USERPROFILE || !process.env.HOME?.includes(\"tk-pb-home\")) {\n12\t  throw new Error(\"Run with an explicit evidence directory and synthetic HOME/USERPROFILE before imports\");\n13\t}\n14\tif (process.platform === \"win32\") {\n15\t  console.log(JSON.stringify({ skipped: \"Historical SIGTERM baseline reproduction is POSIX-only; native Windows current controls are retained separately.\" }));\n16\t  process.exit(0);\n17\t}\n18\tconst root = realpathSync(mkdtempSync(join(tmpdir(), \"pbb-\")));\n19\tconst snapshot = join(root, \"snapshot\");\n20\tconst home = join(root, \"home\");\n21\tconst temp = join(root, \"tmp\");\n22\tconst pids = join(root, \"pids\");\n23\tmkdirSync(snapshot);\n24\tmkdirSync(join(home, \".tokenizer\"), { recursive: true });\n25\tmkdirSync(temp);\n26\tlet env: NodeJS.ProcessEnv = { ...process.env, HOME: home, USERPROFILE: home, TMPDIR: temp, PB_PID_FILE: pids };\n27\tconst owned = new Set<number>();\n28\t\n29\tfunction alive(pid: number): boolean {\n30\t  try { process.kill(pid, 0); return true; } catch { return false; }\n31\t}\n32\t\n33\tfunction killOwned(pid: number): void {\n34\t  try { process.kill(-pid, \"SIGKILL\"); } catch { /* owned POSIX group */ }\n35\t  try { process.kill(pid, \"SIGKILL\"); } catch { /* already exited */ }\n36\t}\n37\t\n38\t// Independent of the new product helper. Baseline Git and descendants inherit\n39\t// this supervisor's explicitly owned group; only this group is terminated.\n40\tasync function supervise(command: string, args: string[], timeoutMs: number, cwd = snapshot) {\n41\t  const started = Date.now();\n42\t  const child = spawn(command, args, { cwd, env, detached: true, stdio: [\"ignore\", \"pipe\", \"pipe\"] });\n43\t  if (child.pid) owned.add(child.pid);\n44\t  let output = \"\";\n45\t  let watchdog = false;\n46\t  let capExceeded = false;\n47\t  const timer = setTimeout(() => { watchdog = true; if (child.pid) killOwned(child.pid); }, timeoutMs);\n48\t  for (const stream of [child.stdout, child.stderr]) stream.on(\"data\", (chunk) => {\n49\t    if (output.length + chunk.length <= 1024 * 1024) output += chunk;\n50\t    else { capExceeded = true; if (child.pid) killOwned(child.pid); }\n51\t  });\n52\t  const result = await new Promise<{ status: number | null; signal: string | null; error?: string }>((resolve) => {\n53\t    child.once(\"error\", (error) => resolve({ status: null, signal: null, error: error.message }));\n54\t    child.once(\"close\", (status, signal) => resolve({ status, signal }));\n55\t  });\n56\t  clearTimeout(timer);\n57\t  return { ...result, elapsedMs: Date.now() - started, watchdog, capExceeded, output };\n58\t}\n59\t\n60\ttry {\n61\t  execFileSync(\"git\", [\"archive\", \"--format=tar\", `--output=${join(root, \"baseline.tar\")}`, baseline], { cwd: repo, env, timeout: 20_000 });\n62\t  execFileSync(\"tar\", [\"-xf\", join(root, \"baseline.tar\"), \"-C\", snapshot], { env, timeout: 20_000 });\n63\t  const npm = join(process.execPath, \"..\", \"npm\");\n64\t  const install = await supervise(npm, [\"ci\", \"--cache\", join(root, \"npm-cache\")], 180_000);\n65\t  writeFileSync(join(evidence, \"baseline-npm-ci.log\"), install.output);\n66\t  console.log(JSON.stringify({ stage: \"fresh-baseline-npm-ci\", ...install, output: \"baseline-npm-ci.log\", baseline }));\n67\t  