{"role":"tool","tool_call_id":"tool_qzVCxCKKCtRqgcEsUis9VCdm","content":"1\timport { dirname, resolve } from \"node:path\";\n2\timport { fileURLToPath } from \"node:url\";\n3\timport { runBoundedSubprocess } from \"./bounded-subprocess\";\n4\t\n5\t// Resolves to the install dir (~/.tokenizer/app), which is a clone of the\n6\t// upstream repo. `git rev-parse` gives us the commit the agent is actually\n7\t// running, which is what the server-side diagnostics surface needs.\n8\tfunction installRoot(): string {\n9\t  return resolve(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n10\t}\n11\t\n12\tconst STARTUP_VERSION_TIMEOUT_MS = 2_000;\n13\t\n14\t// Captured at module load (effectively process startup). A long-running\n15\t// daemon that started BEFORE a later `git pull` must keep reporting its\n16\t// startup SHA, not the post-pull on-disk SHA — otherwise stale daemons\n17\t// falsely appear up-to-date on the dashboard. Lazy/first-call evaluation\n18\t// races with install.sh's pull when the first heartbeat lands after the\n19\t// pull but before the daemon is actually restarted.\n20\tconst cached: string | null = (() => {\n21\t  try {\n22\t    const result = runBoundedSubprocess(\"git\", [\"rev-parse\", \"--short=12\", \"HEAD\"], {\n23\t      cwd: installRoot(),\n24\t      timeoutMs: STARTUP_VERSION_TIMEOUT_MS,\n25\t      maxOutputBytes: 128\n26\t    });\n27\t    if (result.status !== 0 || result.signal !== null) return null;\n28\t    const sha = result.stdout.trim();\n29\t    return /^[0-9a-f]{12,64}$/.test(sha) ? sha : null;\n30\t  } catch {\n31\t    return null;\n32\t  }\n33\t})();\n34\t\n35\texport function getAgentVersion(): string | null {\n36\t  return cached;\n37\t}"}
