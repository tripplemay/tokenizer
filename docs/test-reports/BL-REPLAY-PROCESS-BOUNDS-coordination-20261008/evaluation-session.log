{"role":"tool","tool_call_id":"tool_IAQfjJozS6emZ3jkg2CkJiKp","content":"1\timport { existsSync, readFileSync } from \"node:fs\";\n2\timport { withFileLock, writeFileAtomic } from \"@/cli/atomic-file\";\n3\timport type { UsageEventInput } from \"@/shared/usage\";\n4\timport { queuePath } from \"./config\";\n5\timport { normalizeQueueEvent, queueEventVersion } from \"./queue-event-version\";\n6\timport { quarantineUsageEvents } from \"./rejected-events\";\n7\t\n8\texport { queueEventVersion } from \"./queue-event-version\";\n9\t\n10\tconst SECURE_QUEUE_WRITE = { mode: 0o600, directoryMode: 0o700, restrictToOwner: true } as const;\n11\t\n12\tfunction parseQueue(text: string): UsageEventInput[] {\n13\t  return text.split(/\\r?\\n/).filter(Boolean)\n14\t    .map((line) => normalizeQueueEvent(JSON.parse(line) as UsageEventInput));\n15\t}\n16\t\n17\tfunction serializeQueue(events: UsageEventInput[]): string {\n18\t  return events.length ? events.map((event) => JSON.stringify(normalizeQueueEvent(event))).join(\"\\n\") + \"\\n\" : \"\";\n19\t}\n20\t\n21\tfunction readQueueUnlocked(path: string): UsageEventInput[] {\n22\t  return existsSync(path) ? parseQueue(readFileSync(path, \"utf8\")) : [];\n23\t}\n24\t\n25\texport function readQueue(path = queuePath): UsageEventInput[] {\n26\t  return withFileLock(path, () => {\n27\t    const events = readQueueUnlocked(path);\n28\t    const minimized = serializeQueue(events);\n29\t    if (existsSync(path) && minimized !== readFileSync(path, \"utf8\")) {\n30\t      writeFileAtomic(path, minimized, SECURE_QUEUE_WRITE);\n31\t    }\n32\t    return events;\n33\t  });\n34\t}\n35\t\n36\t// Merge exact event versions under the queue lock. Different versions of the\n37\t// same source ID intentionally coexist until the server ACKs each version: an\n38\t// ACK for an in-flight old parse must never delete a concurrently collected\n39\t// correction for that ID.\n40\texport function mergeQueue(\n41\t  events: UsageEventInput[],\n42\t  path = queuePath,\n43\t  options: { timeoutMs?: number; beforeMutate?: () => void } = {}\n44\t): { events: UsageEventInput[]; added: number } {\n45\t  return withFileLock(path, () => {\n46\t    const byVersion = new Map<string, UsageEventInput>();\n47\t    for (const event of readQueueUnlocked(path)) {\n48\t      byVersion.set(queueEventVersion(event), event);\n49\t    }\n50\t    const previousCount = byVersion.size;\n51\t    for (const event of events) {\n52\t      const normalized = normalizeQueueEvent(event);\n53\t      byVersion.set(queueEventVersion(normalized), normalized);\n54\t    }\n55\t    // Keep each identity's first-seen position for existing callers without\n56\t    // collapsing its independently acknowledged correction versions.\n57\t    const byIdentity = new Map<string, UsageEventInput[]>();\n58\t    for (const event of byVersion.values()) {\n59\t      const identity = JSON.stringify([event.source, event.sourceEventId]);\n60\t      const versions = byIdentity.get(identity) ?? [];\n61\t      versions.push(event);\n62\t      byIdentity.set(identity, versions);\n63\t    }\n64\t    const merged = [...byIdentity.values()].flat();\n65\t    const content = serializeQueue(merged);\n66\t    options.beforeMutate?.();\n67\t    writeFileAtomic(path, content, SECURE_QUEUE_WRITE);\n68\t    return { events: merged, added: byVersion.size - previousCount };\n69\t  }, { timeoutMs: options.timeoutMs });\n70\t}\n71\t\n72\texport function mergeQueueEvents(events: UsageEventInput[]): UsageEventInput[] {"}
