{"role":"assistant","tool_calls":[{"type":"function","id":"tool_Whn667V4Rh49DNwkCw7E4qAg","function":{"name":"Write","arguments":"{\"path\":\"tests/evaluator/host-preflight-observability-kimi-support.test.ts\",\"content\":\"import { createHash } from 'node:crypto';\\nimport { spawnSync } from 'node:child_process';\\nimport { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } from 'node:fs';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\\n\\n// Independent supporting-evaluator controls for the F003 Compose refusal\\n// observability candidate at cddb822, derived from scratch from the spec\\n// docs/specs/BL-HOST-PREFLIGHT-OBSERVABILITY-20261009.md, the candidate\\n// script/workflow bytes and the frozen baseline a5ea6e3 (parent commit).\\n// Synthetic local fixtures only: no Docker/SSH/network/credential access.\\n\\nconst BASE = 'a5ea6e3f66ab4b4b831de88a6bcb078f444b2aca';\\nconst CANDIDATE = 'cddb822cc2452c2042309de73064a38f0c4224cf';\\nconst SCRIPT_PATH = 'scripts/ci/vps-host-preflight.sh';\\nconst WORKFLOW_PATH = '.github/workflows/deploy-vps.yml';\\nconst SHA = 'e'.repeat(40);\\nconst SECRET = 'KIMI_SUPPORT_SECRET_CANARY_6f27b9_NEVER_RETAIN';\\nconst HOME_CANARY = '/kimi-support-synthetic-home-canary-3d81_NEVER_RETAIN';\\nconst scriptText = readFileSync(SCRIPT_PATH, 'utf8');\\nconst workflowText = readFileSync(WORKFLOW_PATH, 'utf8');\\n\\nlet root: string, bin: string, deploy: string, callsFile: string;\\n\\ntype Probe = { status: string; pipeline_exit_status: number | null; captured_bytes: number | null; home_present: boolean };\\n\\nfunction gitShow(path: string, ref = BASE): string {\\n  const r = spawnSync('git', ['show', `${ref}:${path}`], { encoding: 'utf8' });\\n  if (r.status !== 0) throw new Error(`git show ${ref}:${path}: ${r.stderr}`);\\n  return r.stdout;\\n}\\n\\nfunction extractValidator(workflow: string) {\\n  const lines = workflow.split('\\\\n');\\n  const start = lines.findIndex((line) => line.includes('if ! jq -e --arg source \\\"$GITHUB_SHA\\\"'));\\n  const end = lines.findIndex((line, i) => i > start && line.includes(\\\"' \\\\\\\"$work/inventory.json\\\\\\\" >/dev/null 2>&1; then\\\"));\\n  if (start < 0 || end < 0) throw new Error('real host report validator not found in workflow');\\n  return {\\n    filterLines: lines.slice(start + 1, end),\\n    filter: lines.slice(start + 1, end).join('\\\\n'),\\n    outside: [...lines.slice(0, start + 1), '<VALIDATOR_FILTER>', ...lines.slice(end)].join('\\\\n')\\n  };\\n}\\n\\nfunction gate(body: unknown, source = SHA) {\\n  return spawnSync('jq', ['-e', '--arg', 'source', source, extractValidator(workflowText).filter], {\\n    input: JSON.stringify(body), encoding: 'utf8', env: { PATH: '/usr/bin:/bin', NODE_ENV: 'test' }\\n  });\\n}\\n\\nfunction stub(name: string, body: string) {\\n  const path = join(bin, name);\\n  writeFileSync(path, `#!${process.execPath}\\\\n'use strict';\\\\nconst fs=require('node:fs');\\\\nconst log=(a)=>fs.appendFileSync(process.env.CALLS,JSON.stringify(a)+'\\\\\\\\n');\\\\n${body}\\\\n`);\\n  chmodSync(path, 0o755);\\n}\\n\\nfunction snap(dir = deploy): string[] {\\n  return readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name)).flatMap((entry) => {\\n    const p = join(dir, entry.name);\\n    if (entry.isDirectory()) return [`d ${entry.name}`, ...snap(p).map((x) => `${entry.name}/${x}`)];\\n    return [`f ${entry.name} ${(statSync(p).mode & 0o7777).toString(8)} ${createHash('sha256').update(readFileSync(p)).digest('hex')}`];\\n  });\\n}\\n\\nfunction readCalls(): string[][] {\\n  return existsSync(callsFile) ? readFileSync(callsFile, 'utf8').trim().split('\\\\n').map((line) => JSON.parse(line)) : [];\\n}\\n\\ninterface RunOptions {\\n  composeOut?: string; composeExit?: number; headExit?: number; hang?: boolean;\\n  unameExit?: number; dockerVersionExit?: number; home?: string; noHome?: boolean;\\n  args?: string[]; source?: string;\\n}\\n\\nfunction run(o: RunOptions = {}) {\\n  const env: NodeJS.ProcessEnv = {\\n    NODE_ENV: 'test',\\n    PATH: `${bin}:/usr/bin:/bin`,\\n    CALLS: callsFile,\\n    TMPDIR: root,\\n    LC_ALL: 'en_US.UTF-8',\\n    SECRET_CANARY: SECRET,\\n    COMPOSE_OUT_B64: Buffer.from(o.composeOut ?? 'v2.35.1\\\\n', 'utf8').toString('base64'),\\n    COMPOSE_EXIT: String(o.composeExit ?? 0),\\n    COMPOSE_HANG: o.hang ? '1' : '',\\n    HEAD_EXIT: o.headExit ? String(o.headExit) : '',\\n    UNAME_EXIT: o.unameExit ? String(o.unameExit) : '',\\n    DOCKER_VERSION_EXIT: o.dockerVersionExit ? String(o.dockerVersionExit) : ''\\n  };\\n  if (!o.noHome) env.HOME = o.home ?? join(root, 'synthetic-home');\\n  const before = snap();\\n  const result = spawnSync('/bin/bash', [o.source ?? join(process.cwd(), SCRIPT_PATH), ...(o.args ?? [deploy, SHA])], {\\n    env, encoding: 'utf8', timeout: 15_000\\n  });\\n  expect(result.error).toBeUndefined();\\n  expect(result.stdout + result.stderr).not.toContain(SECRET);\\n  expect(result.stdout + result.stderr).not.toContain(HOME_CANARY);\\n  expect(result.stderr).toBe('');\\n  expect(snap()).toEqual(before);\\n  const body = JSON.parse(result.stdout);\\n  return { result, body, probe: body.compose_probe as Probe, calls: readCalls() };\\n}\\n\\nfunction expectComposeRefusal(x: ReturnType<typeof run>, probe: Probe) {\\n  expect(x.result.status).toBe(1);\\n  expect(x.body.outcome).toBe('refused');\\n  expect(x.body.reason).toBe('compose_unavailable');\\n  expect(x.body.versions).toEqual({ docker: '29.1.3', compose: 'unknown' });\\n  expect(x.probe).toEqual(probe);\\n  expect(x.body.files).toEqual({});\\n  // No later queries and no mutation-style argv after the Compose refusal.\\n  expect(x.calls.filter((c) => c[0] === 'docker')).toEqual([\\n    ['docker', 'version', '--format', '{{.Server.Version}}'],\\n    ['docker', 'compose', 'version', '--short']\\n  ]);\\n  expect(x.calls.filter((c) => c[0] === 'timeout')).toEqual([\\n    ['timeout', '--signal=KILL', '5s', 'uname', '-s'],\\n    ['timeout', '--signal=KILL', '5s', 'uname', '-m'],\\n    ['timeout', '--signal=KILL', '5s', 'df', '-Pk', '--', deploy],\\n    ['timeout', '--signal=KILL', '5s', 'docker', 'version', '--format', '{{.Server.Version}}'],\\n    ['timeout', '--signal=KILL', '5s', 'docker', 'compose', 'version', '--short']\\n  ]);\\n  expect(x.calls.filter((c) => c[0] === 'head')).toEqual(Array.from({ length: 5 }, () => ['head', '-c', '16385']));\\n  expect(x.calls.some((c) => ['stat', 'sha256sum', 'curl'].includes(c[0]))).toBe(false);\\n  // A valid redacted refusal must still pass the real workflow transport validator.\\n  expect(gate(x.body).status, JSON.stringify(x.body)).toBe(0);\\n}\\n\\ndescribe.skipIf(process.platform === 'win32')('evaluator-independent Compose probe synthetic controls', () => {\\n  beforeEach(() => {\\n    root = mkdtempSync(join(tmpdir(), 'hpo-kimi-'));\\n    bin = join(root, 'bin');\\n    deploy = join(root, 'deploy');\\n    callsFile = join(root, 'calls.jsonl');\\n    mkdirSync(bin);\\n    mkdirSync(deploy);\\n    writeFileSync(join(deploy, '.env'), `AUTH_SECRET=${SECRET}\\\\nDATABASE_URL=postgresql://secret:pw@example/db\\\\n`);\\n    writeFileSync(join(deploy, 'docker-compose.yml'), `# ${SECRET}\\\\nservices: {}\\\\n`);\\n    writeFileSync(join(deploy, 'docker-compose.release.yml'), 'services: {}\\\\n');\\n\\n    stub('timeout', `const {spawnSync}=require('node:child_process');\\n      const a=process.argv.slice(2); log(['timeout',...a]);\\n      if(a.shift()!=='--signal=KILL')process.exit(97);\\n      const limit=a.shift(); if(!/^[0-9]+s$/.test(limit))process.exit(97);\\n      const r=spawnSync(a[0],a.slice(1),{timeout:Number(limit.slice(0,-1))*1000,killSignal:'SIGKILL',maxBuffer:64*1024*1024});\\n      if(r.stdout)process.stdout.write(r.stdout);\\n      if(r.error&&r.error.code==='ETIMEDOUT')process.exit(124);\\n      process.exit(r.status===null||r.status===undefined?1:r.status);`);\\n    stub('head', `const a=process.argv.slice(2); log(['head',...a]);\\n      if(a[0]!=='-c'||!/^[0-9]+$/.test(a[1]))process.exit(97);\\n      const input=fs.readFileSync(0);\\n      process.stdout.write(input.subarray(0,Number(a[1])));\\n      const expected=Buffer.from(process.env.COMPOSE_OUT_B64||'','base64');\\n      if(process.env.HEAD_EXIT&&input.equals(expected))process.exit(Number(process.env.HEAD_EXIT));\\n      process.exit(0);`);\\n    stub('uname', `const a=process.argv.slice(2); log(['uname',...a]);\\n      if(process.env.UNAME_EXIT)process.exit(Number(process.env.UNAME_EXIT));\\n      process.stdout.write(a[0]==='-s'?'Linux\\\\\\\\n':'x86_64\\\\\\\\n');`);\\n    stub('df', `const a=process.argv.slice(2); log(['df',...a]);\\n      process.stdout.write('Filesystem 1024-blocks Used Available Capacity Mounted on\\\\\\\\nfixture 100000 100 99900 1% /scope\\\\\\\\n');`);\\n    stub('docker', `const a=process.argv.slice(2),e=process.env; log(['docker',...a]);\\n      process.stderr.write(e.SECRET_CANARY||'');\\n      if(a[0]==='version'){if(e.DOCKER_VERSION_EXIT)process.exit(Number(e.DOCKER_VERSION_EXIT));process.stdout.write('29.1.3\\\\\\\\n');process.exit(0);}\\n      if(a[0]==='compose'&&a[1]==='version'&&a[2]==='--short'&&a.length===3){\\n        if(e.COMPOSE_HANG==='1'){setTimeout(()=>process.exit(0),60000);return;}\\n        process.stdout.write(Buffer.from(e.COMPOSE_OUT_B64||'','base64'),()=>process.exit(Number(e.COMPOSE_EXIT||'0')));\\n        return;\\n      }\\n      if(a[0]==='ps')process.exit(0);\\n      process.exit(99);`);\\n    stub('stat', `const a=process.argv.slice(2); log(['stat',...a]);\\n      const s=fs.statSync(a[a.length-1]);\\n      process.stdout.write((a[1]==='%s'?s.size:(s.mode&0o7777).toString(8))+'\\\\\\\\n');`);\\n    stub('sha256sum', `const c=require('node:crypto'); const a=process.argv.slice(2); log(['sha256sum',...a]);\\n      process.stdout.write(c.createHash('sha256').update(fs.readFileSync(a[a.length-1])).digest('hex')+'  fixture\\\\\\\\n');`);\\n    stub('curl', `const a=process.argv.slice(2); log(['curl',...a]); process.exit(7);`);\\n  });\\n  afterEach(() => rmSync(root, { recursive: true, force: true }));\\n\\n  it('captures a valid Compose version with unchanged argv/5s/16385 bounds, then proceeds', () => {\\n    const x = run();\\n    expect(x.probe).toEqual({ status: 'ok', pipeline_exit_status: 0, captured_bytes: 7, home_present: true });\\n    expect(x.body.versions.compose).toBe('v2.35.1');\\n    // Pipeline continues past Compose and fails at the next allowlisted query.\\n    expect(x.body.reason).toBe('missing_or_multiple_app');\\n    expect(x.result.status).toBe(1);\\n    expect(gate(x.body).status, JSON.stringify(x.body)).toBe(0);\\n    const composeCalls = x.calls.filter((c) => c[0] === 'timeout' && c.includes('compose'));\\n    expect(composeCalls).toEqual([['timeout', '--signal=KILL', '5s', 'docker', 'compose', 'version', '--short']]);\\n  });\\n\\n  it('strips trailing newlines before counting captured bytes', () => {\\n    const x = run({ composeOut: 'v2.35.1\\\\n\\\\n\\\\n' });\\n    expect(x.probe).toEqual({ status: 'ok', pipeline_exit_status: 0, captured_bytes: 7, home_present: true });\\n    expect(x.body.versions.compose).toBe('v2.35.1');\\n  });\\n\\n  it.each([1, 2, 23, 124, 137, 141, 255])('retains the exact whole pipeline exit status %i (never normalized to 1)', (code) => {\\n    expectComposeRefusal(run({ composeExit: code, composeOut: `${SECRET}\\\\n` }), {\\n      status: 'command_failed', pipeline_exit_status: code, captured_bytes: Buffer.byteLength(SECRET), home_present: true\\n    });\\n  });\\n\\n  it('records the rightmost failing capture stage, not the Docker client exit code', () => {\\n    expectComposeRefusal(run({ composeExit: 7, headExit: 141, composeOut: 'v2.35.1\\\\n' }), {\\n      status: 'command_failed', pipeline_exit_status: 141, captured_bytes: 7, home_present: true\\n    });\\n  });\\n\\n  it('fails closed as command_failed even when captured stdout is a valid semver', () => {\\n    expectComposeRefusal(run({ composeExit: 9, composeOut: '2.35.1\\\\n' }), {\\n      status: 'command_failed', pipeline_exit_status: 9, captured_bytes: 6, home_present: true\\n    });\\n  });\\n\\n  it.each(['', 'garbage\\\\n', `${SECRET}\\\\n`, 'v2.35.1\\\\ninvalid', '2.35\\\\n'])('classifies invalid retained versions with zero disclosure: %#', (out) => {\\n    expectComposeRefusal(run({ composeOut: out }), {\\n      status: 'invalid_version', pipeline_exit_status: 0, captured_bytes: Buffer.byteLength(out.replace(/\\\\n+$/, '')), home_present: true\\n    });\\n  });\\n\\n  it.each([0, 1, 141])('prioritizes the retained-output cap over pipeline status %i', (code) => {\\n    expectComposeRefusal(run({ composeOut: 'x'.repeat(20000), composeExit: code }), {\\n      status: 'output_bound_exceeded', pipeline_exit_status: code, captured_bytes: 16385, home_present: true\\n    });\\n  });\\n\\n  it('counts captured shell bytes (not locale characters) under a multibyte locale', () => {\\n    expectComposeRefusal(run({ composeOut: 'é\\\\n' }), {\\n      status: 'invalid_version', pipeline_exit_status: 0, captured_bytes: 2, home_present: true\\n    });\\n    expectComposeRefusal(run({ composeOut: `${'é'.repeat(8192)}\\\\n` }), {\\n      status: 'invalid_version', pipeline_exit_status: 0, captured_bytes: 16384, home_present: true\\n    });\\n  });\\n\\n  it('refuses a multibyte string truncated mid-codepoint at the 16385 cap', () => {\\n    expectComposeRefusal(run({ composeOut: 'é'.repeat(10000) }), {\\n      status: 'output_bound_exceeded', pipeline_exit_status: 0, captured_bytes: 16385, home_present: true\\n    });\\n  });\\n\\n  it('bounds a hung Compose query with the unchanged 5s kill and records the pipeline status as a number', () => {\\n    const start = Date.now();\\n    const x = run({ hang: true });\\n    expect(Date.now() - start).toBeLessThan(9_000);\\n    expectComposeRefusal(x, { status: 'command_failed', pipeline_exit_status: 124, captured_bytes: 0, home_present: true });\\n  }, 15_000);\\n\\n  it.each([{ unameExit: 4, reason: 'platform_unavailable' }, { dockerVersionExit: 3, reason: 'docker_unavailable' }])(\\n    'keeps not_run null metrics and issues no Compose query on early $reason refusal', (o) => {\\n      const x = run(o);\\n      expect(x.result.status).toBe(1);\\n      expect(x.body.reason).toBe(o.reason);\\n      expect(x.probe).toEqual({ status: 'not_run', pipeline_exit_status: null, captured_bytes: null, home_present: true });\\n      expect(x.calls.some((c) => c.includes('compose'))).toBe(false);\\n      expect(gate(x.body).status, JSON.stringify(x.body)).toBe(0);\\n    });\\n\\n  it('keeps not_run null metrics and runs zero tools on invalid input', () => {\\n    const x = run({ args: ['/opt/tokenizer/../escape', SHA], noHome: true });\\n    expect(x.result.status).toBe(1);\\n    expect(x.body.reason).toBe('invalid_input');\\n    expect(x.probe).toEqual({ status: 'not_run', pipeline_exit_status: null, captured_bytes: null, home_present: false });\\n    expect(x.calls).toEqual([]);\\n    // Deliberately cleared source_sha is foreign to the validator's $source: rejected.\\n    expect(gate(x.body).status).not.toBe(0);\\n  });\\n\\n  it.each([{ home: undefined, present: false }, { home: '', present: true }, { home: HOME_CANARY, present: true }])(\\n    'records only HOME presence (never value/path/emptiness): $present', ({ home, present }) => {\\n      const x = run(home === undefined ? { noHome: true } : { home });\\n      expect(x.probe).toEqual({ status: 'ok', pipeline_exit_status: 0, captured_bytes: 7, home_present: present });\\n      expect(JSON.stringify(x.body)).not.toContain(HOME_CANARY);\\n    });\\n\\n  it('keeps the missing-jq minimal refusal unchanged and outside full transport reports', () => {\\n    const date = join(bin, 'date');\\n    writeFileSync(date, '#!/bin/bash\\\\nprintf \\\"2026-10-09T00:00:00Z\\\\\\\\n\\\"\\\\n');\\n    chmodSync(date, 0o755);\\n    const result = spawnSync('/bin/bash', [join(process.cwd(), SCRIPT_PATH), deploy, SHA], {\\n      env: { PATH: bin, NODE_ENV: 'test' }, encoding: 'utf8', timeout: 10_000\\n    });\\n    expect(result.status).toBe(1);\\n    const body = JSON.parse(result.stdout);\\n    expect(body).toEqual({ schema_version: 1, operation: 'host-preflight', outcome: 'refused', reason: 'missing_tools' });\\n    expect(body).not.toHaveProperty('compose_probe');\\n    expect(gate(body).status).not.toBe(0);\\n  });\\n\\n  it('matches the frozen baseline script byte-for-byte on behavior and report shape minus compose_probe', () => {\\n    const candidate = run();\\n    rmSync(callsFile);\\n    const original = join(root, 'baseline.sh');\\n    writeFileSync(original, gitShow(SCRIPT_PATH));\\n    const result = spawnSync('/bin/bash', [original, deploy, SHA], {\\n      env: {\\n        NODE_ENV: 'test', PATH: `${bin}:/usr/bin:/bin`, CALLS: callsFile, TMPDIR: root, LC_ALL: 'en_US.UTF-8',\\n        SECRET_CANARY: SECRET, COMPOSE_OUT_B64: Buffer.from('v2.35.1\\\\n').toString('base64'), COMPOSE_EXIT: '0',\\n        COMPOSE_HANG: '', HEAD_EXIT: '', UNAME_EXIT: '', DOCKER_VERSION_EXIT: '', HOME: join(root, 'synthetic-home')\\n      },\\n      encoding: 'utf8', timeout: 15_000\\n    });\\n    expect(result.status).toBe(candidate.result.status);\\n    expect(result.stdout + result.stderr).not.toContain(SECRET);\\n    const { compose_probe: _probe, timestamp: _ts, ...candidateBody } = candidate.body;\\n    const { timestamp: _ots, ...originalBody } = JSON.parse(result.stdout);\\n    expect(candidateBody).toEqual(originalBody);\\n    expect(readCalls()).toEqual(candidate.calls);\\n  });\\n});\\n\\ndescribe('evaluator-independent real workflow validator controls', () => {\\n  let rootDir: string, template: Record<string, unknown>, goodProbe: Probe;\\n  const mkdtemp = () => {\\n    const dir = mkdtempSync(join(tmpdir(), 'hpo-kimi-gate-'));\\n    mkdirSync(join(dir, 'deploy'));\\n    return dir;\\n  };\\n\\n  it('builds a real valid refused report via the candidate script for validator controls', () => {\\n    // Minimal standalone fixture (no stubs needed beyond tool fakes) reused from scratch here.\\n    rootDir = mkdtemp();\\n    const binDir = join(rootDir, 'bin');\\n    mkdirSync(binDir);\\n    const mk = (name: string, body: string) => {\\n      writeFileSync(join(binDir, name), `#!${process.execPath}\\\\n${body}\\\\n`);\\n      chmodSync(join(binDir, name), 0o755);\\n    };\\n    mk('timeout', `const{spawnSync}=require('node:child_process');const a=process.argv.slice(2);a.shift();a.shift();\\n      const r=spawnSync(a[0],a.slice(1),{timeout:5000,killSignal:'SIGKILL'});if(r.stdout)process.stdout.write(r.stdout);\\n      process.exit(r.error?.code==='ETIMEDOUT'?124:r.status??1);`);\\n    mk('uname', `process.stdout.write(process.argv[2]==='-s'?'Linux\\\\\\\\n':'x86_64\\\\\\\\n');`);\\n    mk('df', `process.stdout.write('Filesystem 1024-blocks Used Available Capacity Mounted on\\\\\\\\nfixture 100000 100 99900 1% /scope\\\\\\\\n');`);\\n    mk('docker', `const a=process.argv.slice(2);\\n      if(a[0]==='version'){process.stdout.write('29.1.3\\\\\\\\n');process.exit(0);}\\n      if(a[0]==='compose'){process.stdout.write('v2.35.1\\\\\\\\n');process.exit(0);}\\n      process.exit(0);`);\\n    mk('stat', `const fs=require('node:fs');const a=process.argv.slice(2);const s=fs.statSync(a[a.length-1]);\\n      process.stdout.write((a[1]==='%s'?s.size:(s.mode&0o7777).toString(8))+'\\\\\\\\n');`);\\n    mk('sha256sum', `const fs=require('node:fs'),c=require('node:crypto');const a=process.argv.slice(2);\\n      process.stdout.write(c.createHash('sha256').update(fs.readFileSync(a[a.length-1])).digest('hex')+'  f\\\\\\\\n');`);\\n    mk('curl', `process.exit(7);`);\\n    writeFileSync(join(rootDir, 'deploy', '.env'), `AUTH_SECRET=${SECRET}\\\\n`);\\n    const result = spawnSync('/bin/bash', [join(process.cwd(), SCRIPT_PATH), join(rootDir, 'deploy'), SHA], {\\n      env: { PATH: `${binDir}:/usr/bin:/bin`, NODE_ENV: 'test' }, encoding: 'utf8', timeout: 15_000\\n    });\\n    expect(result.status).toBe(1);\\n    template = JSON.parse(result.stdout);\\n    expect(template.outcome).toBe('refused');\\n    goodProbe = template.compose_probe as Probe;\\n    expect(goodProbe).toEqual({ status: 'ok', pipeline_exit_status: 0, captured_bytes: 7, home_present: false });\\n    expect(gate(template).status, JSON.stringify(template)).toBe(0);\\n    rmSync(rootDir, { recursive: true, force: true });\\n  });\\n\\n  it('accepts every fixed classification with consistent null/range relationships', () => {\\n    const valid: Probe[] = [\\n      { status: 'not_run', pipeline_exit_status: null, captured_bytes: null, home_present: true },\\n      { status: 'not_run', pipeline_exit_status: null, captured_bytes: null, home_present: false },\\n      { status: 'ok', pipeline_exit_status: 0, captured_bytes: 0, home_present: false },\\n      { status: 'ok', pipeline_exit_status: 0, captured_bytes: 16384, home_present: true },\\n      { status: 'invalid_version', pipeline_exit_status: 0, captured_bytes: 0, home_present: false },\\n      { status: 'invalid_version', pipeline_exit_status: 0, captured_bytes: 16384, home_present: false },\\n      { status: 'command_failed', pipeline_exit_status: 1, captured_bytes: 0, home_present: false },\\n      { status: 'command_failed', pipeline_exit_status: 255, captured_bytes: 16384, home_present: true },\\n      { status: 'output_bound_exceeded', pipeline_exit_status: 0, captured_bytes: 16385, home_present: false },\\n      { status: 'output_bound_exceeded', pipeline_exit_status: 141, captured_bytes: 16385, home_present: true }\\n    ];\\n    for (const probe of valid) expect(gate({ ...template, compose_probe: probe }).status, JSON.stringify(probe)).toBe(0);\\n  });\\n\\n  it('rejects missing keys, extra keys and non-object compose_probe values', () => {\\n    const bad: unknown[] = [undefined, null, true, 0, 'ok', [], SECRET, {},\\n      { ...goodProbe, extra: 1 }, { ...goodProbe, note: SECRET },\\n      ...Object.keys(goodProbe).map((key) => Object.fromEntries(Object.entries(goodProbe).filter(([k]) => k !== key)))];\\n    for (const probe of bad) expect(gate({ ...template, compose_probe: probe }).status, JSON.stringify(probe)).not.toBe(0);\\n  });\\n\\n  it('rejects invalid status enums, types, ranges, fractions and null-relationship violations', () => {\\n    const bad: unknown[] = [\\n      ...[null, 0, true, [], {}, 'timeout', 'missing_plugin', 'ok ', 'OK', SECRET].map((status) => ({ ...goodProbe, status })),\\n      ...[null, -1, 256, 0.5, '0', false, [], {}].map((pipeline_exit_status) => ({ ...goodProbe, pipeline_exit_status })),\\n      ...[null, -1, 16385, 7.5, '7', true, [], {}].map((captured_bytes) => ({ ...goodProbe, captured_bytes })),\\n      ...[null, 0, 1, 'false', [], {}, HOME_CANARY].map((home_present) => ({ ...goodProbe, home_present })),\\n      { status: 'not_run', pipeline_exit_status: 0, captured_bytes: null, home_present: false },\\n      { status: 'not_run', pipeline_exit_status: null, captured_bytes: 0, home_present: false },\\n      { status: 'command_failed', pipeline_exit_status: null, captured_bytes: 7, home_present: false },\\n      { status: 'command_failed', pipeline_exit_status: 0, captured_bytes: 7, home_present: false },\\n      { status: 'command_failed', pipeline_exit_status: 23, captured_bytes: null, home_present: false },\\n      { status: 'command_failed', pipeline_exit_status: 23, captured_bytes: 16385, home_present: false },\\n      { status: 'ok', pipeline_exit_status: null, captured_bytes: 7, home_present: false },\\n      { status: 'ok', pipeline_exit_status: 1, captured_bytes: 7, home_present: false },\\n      { status: 'ok', pipeline_exit_status: 0, captured_bytes: null, home_present: false },\\n      { status: 'invalid_version', pipeline_exit_status: 1, captured_bytes: 7, home_present: false },\\n      { status: 'output_bound_exceeded', pipeline_exit_status: null, captured_bytes: 16385, home_present: false },\\n      { status: 'output_bound_exceeded', pipeline_exit_status: 256, captured_bytes: 16385, home_present: false },\\n      { status: 'output_bound_exceeded', pipeline_exit_status: 0, captured_bytes: 16384, home_present: false },\\n      { status: 'output_bound_exceeded', pipeline_exit_status: 0, captured_bytes: 16386, home_present: false }\\n    ];\\n    for (const probe of bad) expect(gate({ ...template, compose_probe: probe }).status, JSON.stringify(probe)).not.toBe(0);\\n  });\\n\\n  it('rejects foreign source_sha and raw canary/secret-bearing report additions', () => {\\n    expect(gate(template, 'f'.repeat(40)).status).not.toBe(0);\\n    expect(gate({ ...template, source_sha: 'f'.repeat(40) }).status).not.toBe(0);\\n    expect(gate({ ...template, source_sha: SECRET }).status).not.toBe(0);\\n    for (const addition of [\\n      { ...template, leak: SECRET },\\n      { ...template, compose_probe: { ...goodProbe, leak: SECRET } },\\n      { ...template, versions: { ...template.versions as object, leak: SECRET } },\\n      { ...template, files: { leak: { sha256: SECRET, mode: '600' } } }\\n    ]) expect(gate(addition).status).not.toBe(0);\\n  });\\n\\n  it('does not weaken the pre-existing allowlists (old clauses still reject)', () => {\\n    const t = template as Record<string, any>;\\n    const bad: unknown[] = [\\n      { ...t, extra_top_level: 1 },\\n      Object.fromEntries(Object.entries(t).filter(([k]) => k !== 'app')),\\n      Object.fromEntries(Object.entries(t).filter(([k]) => k !== 'compose_probe')),\\n      { ...t, schema_version: 2 },\\n      { ...t, operation: 'deploy' },\\n      { ...t, outcome: 'approved' },\\n      { ...t, reason: 'pwned' },\\n      { ...t, timestamp: '2026-10-09' },\\n      { ...t, platform: 'Darwin/arm64' },\\n      { ...t, free_kib: '1'.repeat(17) },\\n      { ...t, versions: { docker: 'not a version