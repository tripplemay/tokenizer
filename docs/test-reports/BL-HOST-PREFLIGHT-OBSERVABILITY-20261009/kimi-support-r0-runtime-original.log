{"role":"tool","tool_call_id":"tool_00TzW0mqB6VFGtdGvA9rTU1T","content":"1\timport { createHash } from 'node:crypto';\n2\timport { spawnSync } from 'node:child_process';\n3\timport { chmodSync, copyFileSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, symlinkSync, writeFileSync } from 'node:fs';\n4\timport { tmpdir } from 'node:os';\n5\timport { join } from 'node:path';\n6\timport { afterEach, beforeEach, describe, expect, it } from 'vitest';\n7\t\n8\tconst sha = 'c'.repeat(40), deployed = 'd'.repeat(40);\n9\tconst appId = 'a'.repeat(12), postgresId = 'b'.repeat(12);\n10\tconst imageId = `sha256:${'a'.repeat(64)}`, postgresImageId = `sha256:${'b'.repeat(64)}`;\n11\tconst appImage = `ghcr.io/test/app@${imageId}`, migrateImage = `ghcr.io/test/migrate@sha256:${'e'.repeat(64)}`;\n12\tconst script = join(process.cwd(), 'scripts/ci/vps-host-preflight.sh');\n13\tconst workflow = readFileSync('.github/workflows/deploy-vps.yml', 'utf8');\n14\tconst canary = 'AUTH_SECRET_RAW_CANARY_DO_NOT_DISCLOSE';\n15\tlet root: string, deployPath: string, bin: string;\n16\t\n17\tfunction nodeTool(name: string, body: string) {\n18\t  const path = join(bin, name);\n19\t  writeFileSync(path, `#!${process.execPath}\\n${body}\\n`);\n20\t  chmodSync(path, 0o755);\n21\t}\n22\t\n23\tfunction snapshot(directory = deployPath): unknown {\n24\t  return readdirSync(directory).sort().map((name) => {\n25\t    const path = join(directory, name), stat = statSync(path);\n26\t    return [name, stat.mode, stat.isDirectory() ? snapshot(path) : readFileSync(path).toString('hex')];\n27\t  });\n28\t}\n29\t\n30\tfunction env(overrides: Record<string, string> = {}) {\n31\t  return { ...process.env, PATH: `${bin}:${process.env.PATH}`, CALLS: join(root, 'calls.jsonl'),\n32\t    DEPLOYED_SHA: deployed, APP_ID: appId, POSTGRES_ID: postgresId, IMAGE_ID: imageId,\n33\t    POSTGRES_IMAGE_ID: postgresImageId, SCENARIO: '', SECRET_CANARY: canary, ...overrides };\n34\t}\n35\t\n36\tfunction run(overrides: Record<string, string> = {}, args = [deployPath, sha]) {\n37\t  return spawnSync('bash', [script, ...args], { env: env(overrides), encoding: 'utf8', timeout: 12_000 });\n38\t}\n39\t\n40\tfunction report(result: ReturnType<typeof run>) {\n41\t  expect(result.stdout, result.stderr).not.toContain(canary);\n42\t  expect(result.stderr).not.toContain(canary);\n43\t  return JSON.parse(result.stdout);\n44\t}\n45\t\n46\tfunction calls(): string[][] {\n47\t  return existsSync(join(root, 'calls.jsonl'))\n48\t    ? readFileSync(join(root, 'calls.jsonl'), 'utf8').trim().split('\\n').map((line) => JSON.parse(line)) : [];\n49\t}\n50\t\n51\tfunction assertReadOnly() {\n52\t  for (const args of calls()) {\n53\t    expect(['version', 'compose', 'ps', 'inspect', 'image', 'port', 'network', 'volume']).toContain(args[0]);\n54\t    if (args[0] === 'compose') expect(args).toEqual(['compose', 'version', '--short']);\n55\t    if (['image', 'network', 'volume'].includes(args[0])) expect(args[1]).toBe('inspect');\n56\t    expect(args.join(' ')).not.toMatch(/Config\\.Env|\\b(pull|push|run|exec|stop|start|restart|up|down|kill|login|logout|build|rm|prune)\\b/);\n57\t    if (args[0] === 'ps') {\n58\t      expect(args).toContain('label=com.docker.compose.project=tokenizer');\n59\t      expect(args).toContain('--filter');\n60\t    }\n61\t  }\n62\t}\n63\t\n64\tfunction inventoryStep(): string {\n65\t  const start = workflow.indexOf('      - name: Collect bounded allowlisted inventory over SSH stdin\\n');\n66\t  const body = workflow.indexOf('        run: |\\n', start) + '        run: |\\n'.length;\n67\t  const end = workflow.indexOf('      - name: Retain only redacted allowlisted host inventory\\n', body);\n68\t  if (start < 0 || end < 0) throw new Error('missing host inventory workflow step');\n69\t  return workflow.slice(body, end).split('\\n').map((line) => line.replace(/^ {10}/, '')).join('\\n');\n70\t}\n71\t\n72\tfunction runWorkflow(stdout: string, overrides: Record<string, string> = {}) {\n73\t  const work = join(root, 'runner');\n74\t  mkdirSync(join(work, 'scripts/ci'), { recursive: true });\n75\t  copyFileSync(script, join(work, 'scripts/ci/vps-host-preflight.sh'));\n76\t  nodeTool('ssh-keyscan', `process.stderr.write(process.env.SECRET_CANARY); console.log('fixture-known-host ssh-ed25519 synthetic');`);\n77\t  nodeTool('ssh', `const fs=require('node:fs'),crypto=require('node:crypto');\n78\t    const input=fs.readFileSync(0);\n79\t    if(crypto.createHash('sha256').update(input).digest('hex')!==process.env.STDIN_HASH)process.exit(99);\n80\t    fs.appendFileSync(process.env.SSH_CALLS,JSON.stringify(process.argv.slice(2))+'\\\\n');\n81\t    process.stderr.write(process.env.SECRET_CANARY);\n82\t    process.stdout.write(process.env.SSH_OUTPUT);\n83\t    process.exit(Number(process.env.SSH_STATUS||0));`);\n84\t  const result = spawnSync('bash', ['-c', inventoryStep()], { cwd: work, encoding: 'utf8', timeout: 12_000,\n85\t    env: env({ GITHUB_SHA: sha, VPS_HOST: 'host.example.test', VPS_USER: 'deployer', VPS_SSH_KEY: 'synthetic-private-key',\n86\t      VPS_SSH_PORT: '2222', VPS_DEPLOY_PATH: deployPath,\n87\t      SSH_OUTPUT: stdout, SSH_CALLS: join(root, 'ssh-calls.jsonl'),\n88\t      STDIN_HASH: createHash('sha256').update(readFileSync(script)).digest('hex'), ...overrides }) });\n89\t  return { result, artifact: readFileSync(join(work, 'host-preflight-evidence/inventory.json'), 'utf8') };\n90\t}\n91\t\n92\tdescribe.skipIf(process.platform === 'win32')('read-only allowlisted tokenizer host preflight', () => {\n93\t  beforeEach(() => {\n94\t    root = mkdtempSync(join(tmpdir(), 'hp-'));\n95\t    deployPath = join(root, 'deploy'); bin = join(root, 'bin');\n96\t    mkdirSync(deployPath); mkdirSync(bin); mkdirSync(join(deployPath, '.releases'));\n97\t    const settings = `GIT_COMMIT=${deployed}\\nAPP_IMAGE=${appImage}\\nMIGRATE_IMAGE=${migrateImage}\\nAPP_HOST_PORT=127.0.0.1:3010\\nAUTH_SECRET=${canary}\\nDATABASE_URL=postgresql://secret:password@example/secret\\nHARNESS_CONSOLE_SIGNING_KEY=${canary}\\n`;\n98\t    writeFileSync(join(deployPath, '.env'), settings);\n99\t    writeFileSync(join(deployPath, 'docker-compose.yml'), `services: {}\\n# ${canary}\\n`);\n100\t    writeFileSync(join(deployPath, 'docker-compose.release.yml'), 'services: {}\\n');\n101\t    writeFileSync(join(deployPath, '.releases', `${deployed}.manifest`), `commit=${deployed}\\napp_image=${appImage}\\nmigrate_image=${migrateImage}\\n`);\n102\t    writeFileSync(join(deployPath, '.releases', `${deployed}.activated`), `commit=${deployed}\\napp_image=${appImage}\\napp_id=${imageId}\\n`);\n103\t    nodeTool('timeout', `const {spawnSync}=require('node:child_process');\n104\t      const args=process.argv.slice(2); if(args.shift()!=='--signal=KILL')process.exit(99);\n105\t      const limit=args.shift(); if(!/^[0-9]+s$/.test(limit))process.exit(99);\n106\t      const command=args.shift(),input=command==='ssh'?require('node:fs').readFileSync(0):undefined;\n107\t      const result=spawnSync(command,args,{input,encoding:'utf8',timeout:Number(limit.slice(0,-1))*1000,killSignal:'SIGKILL'});\n108\t      if(result.stdout)process.stdout.write(result.stdout);if(result.stderr)process.stderr.write(result.stderr);\n109\t      process.exit(result.error?.code==='ETIMEDOUT'?124:result.status??1);`);\n110\t    nodeTool('stat', `const fs=require('node:fs');const args=process.argv.slice(2),stat=fs.statSync(args.at(-1));\n111\t      if(args[1]==='%s')console.log(stat.size);else if(args[1]==='%a')console.log((stat.mode&0o7777).toString(8));else process.exit(99);`);\n112\t    nodeTool('uname', `console.log(process.argv[2]==='-s'?'Linux':'x86_64');`);\n113\t    nodeTool('df', `console.log('Filesystem 1024-blocks Used Available Capacity Mounted on\\\\nfixture 100000 100 99900 1% /scope');`);\n114\t    nodeTool('curl', `const e=process.env;\n115\t      process.stderr.write(e.SECRET_CANARY);\n116\t      if(e.SCENARIO==='health-failure')process.exit(7);\n117\t      console.log(JSON.stringify({ok:e.SCENARIO!=='unready',code:e.SCENARIO==='null-health-code'?null:e.SCENARIO==='wrong-health-code'?'db_unavailable':'ready',\n118\t        commit:e.SCENARIO==='wrong-health-sha'?'c'.repeat(40):e.DEPLOYED_SHA,\n119\t        extra_secret:e.SECRET_CANARY}));`);\n120\t    nodeTool('docker', `const fs=require('node:fs');const a=process.argv.slice(2),e=process.env,s=e.SCENARIO;\n121\t      fs.appendFileSync(e.CALLS,JSON.stringify(a)+'\\\\n');\n122\t      process.stderr.write(e.SECRET_CANARY);\n123\t      if(e.DOCKER_HOST||e.DOCKER_CONTEXT||e.COMPOSE_PROJECT_NAME||e.HTTP_PROXY)process.exit(98);\n124\t      if(s==='timeout'&&a[0]==='version'){setTimeout(()=>process.exit(0),60000);return;}\n125\t      if(a[0]==='version'){console.log(s==='raw-canary'?e.SECRET_CANARY:'27.5.1');return;}\n126\t      if(a[0]==='compose'&&a[1]==='version'){console.log('2.35.1');return;}\n127\t      if(a[0]==='ps'){\n128\t        const app=a.some(x=>x.endsWith('service=app'));\n129\t        if(app&&s==='missing-app')return;\n130\t        console.log(app?(s==='duplicate-app'?e.APP_ID+'\\\\n'+'f'.repeat(12):e.APP_ID):e.POSTGRES_ID);return;\n131\t      }\n132\t      if(a[0]==='image'&&a[1]==='inspect'){\n133\t        if(a[3]==='{{.Id}}'){console.log(s==='wrong-image'?'sha256:'+'f'.repeat(64):e.IMAGE_ID);return;}\n134\t        console.log(e.DEPLOYED_SHA+'|'+(s==='raw-user-canary'?e.SECRET_CANARY:'node'));return;\n135\t      }\n136\t      if(a[0]==='inspect'){\n137\t        const app=a.at(-1)===e.APP_ID,format=a[2];\n138\t        if(format.includes('.NetworkSettings.Networks')){console.log(s==='wrong-network'?'personal_network':'tokenizer_default ');return;}\n139\t        if(format.includes('.Mounts')){console.log(s==='wrong-volume'?'personal_volume':'tokenizer_postgres-data ');return;}\n140\t        const project=s==='wrong-project'?'unrelated':'tokenizer',service=app?(s==='wrong-service'?'postgres':'app'):'postgres';\n141\t        const health=app&&s==='unhealthy-app'?'un