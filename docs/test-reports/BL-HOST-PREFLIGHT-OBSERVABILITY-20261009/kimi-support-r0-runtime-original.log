e(0);\n169\t    expect(report(result)).toMatchObject({ baseline: 'legacy_or_unknown', files: { releases: { sha256: 'missing' } } });\n170\t    expect(snapshot()).toEqual(before); assertReadOnly();\n171\t  });\n172\t\n173\t  it.each(['missing-app','duplicate-app','wrong-project','wrong-service','stopped-app','unhealthy-app','wrong-port',\n174\t    'wrong-image','wrong-network','wrong-volume','unready','wrong-health-code','null-health-code','wrong-health-sha','health-failure','raw-canary','raw-user-canary'])\n175\t    ('refuses %s without writes or disclosure', (scenario) => {\n176\t      const before = snapshot(), result = run({ SCENARIO: scenario });\n177\t      expect(result.status).not.toBe(0);\n178\t      expect(report(result).outcome).toBe('refused');\n179\t      expect(snapshot()).toEqual(before); assertReadOnly();\n180\t    });\n181\t\n182\t  it('bounds a hung query to five seconds and suppresses its failed stderr', () => {\n183\t    const before = snapshot(), start = Date.now(), result = run({ SCENARIO: 'timeout' });\n184\t    expect(result.status).not.toBe(0);\n185\t    expect(Date.now() - start).toBeLessThan(9_000);\n186\t    expect(report(result).reason).toBe('docker_unavailable');\n187\t    expect(snapshot()).toEqual(before); assertReadOnly();\n188\t  }, 12_000);\n189\t\n190\t  it('does not execute config content and clears Docker/Compose/proxy environment overrides', () => {\n191\t    writeFileSync(join(deployPath, '.env'), `${readFileSync(join(deployPath, '.env'))}AUTH_SECRET=$(touch injected)\\n`);\n192\t    const before = snapshot(), result = run({ DOCKER_HOST: 'tcp://secret-canary', DOCKER_CONTEXT: canary,\n193\t      COMPOSE_PROJECT_NAME: canary, HTTP_PROXY: 'http://secret-canary' });\n194\t    expect(result.status, result.stderr).toBe(0);\n195\t    report(result); expect(snapshot()).toEqual(before); assertReadOnly();\n196\t    expect(existsSync(join(deployPath, 'injected'))).toBe(false);\n197\t  });\n198\t\n199\t  it.each(['duplicate','malicious-image','symlink','oversized'])('refuses unsafe selected configuration: %s', (kind) => {\n200\t    const path = join(deployPath, '.env'), original = readFileSync(path, 'utf8');\n201\t    if (kind === 'duplicate') writeFileSync(path, `${original}GIT_COMMIT=${deployed}\\n`);\n202\t    if (kind === 'malicious-image') writeFileSync(path, original.replace(appImage, `$(touch ${canary})`));\n203\t    if (kind === 'symlink') { writeFileSync(join(root, 'outside-env'), original); rmSync(path); symlinkSync(join(root, 'outside-env'), path); }\n204\t    if (kind === 'oversized') writeFileSync(path, `${original}${'x'.repeat(1048577)}`);\n205\t    const before = snapshot(), result = run();\n206\t    expect(result.status).not.toBe(0); report(result);\n207\t    expect(snapshot()).toEqual(before); assertReadOnly();\n208\t  });\n209\t\n210\t  it.each([\n211\t    { args: [\"/opt/tokenizer'; touch injected\", sha] }, { args: ['/opt/tokenizer/../other', sha] },\n212\t    { args: ['/opt/tokenizer', canary] }, { args: [] }\n213\t  ])('rejects malicious/missing remote args before queries %#', ({ args }) => {\n214\t    const result = run({}, args);\n215\t    expect(result.status).not.toBe(0);\n216\t    expect(report(result).reason).toBe('invalid_input');\n217\t    expect(calls()).toEqual([]);\n218\t  });\n219\t\n220\t  it('transports the exact reviewed script on stdin and uploads only validated JSON', () => {\n221\t    const remote = run(); expect(remote.status).toBe(0);\n222\t    const step = inventoryStep();\n223\t    const filter = step.slice(step.indexOf('def sha:')).split(/\\n\\s*' \"\\$work\\/inventory\\.json\"/)[0];\n224\t    const gate = spawnSync('jq', ['-e', '--arg', 'source', sha, filter], { input: remote.stdout, encoding: 'utf8' });\n225\t    expect(gate.status, `${gate.stderr}\\n${remote.stdout}`).toBe(0);\n226\t    const before = snapshot(), { result, artifact } = runWorkflow(remote.stdout);\n227\t    expect(result.status, result.stderr).toBe(0);\n228\t    expect(JSON.parse(artifa