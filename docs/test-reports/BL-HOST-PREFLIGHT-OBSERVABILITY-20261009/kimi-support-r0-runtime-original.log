ailed', pipeline_exit_status: 124, captured_bytes: 0, home_present: false });\n194\t    expect(Date.now() - start).toBeLessThan(9_000);\n195\t  }, 12_000);\n196\t\n197\t  it.each(['platform', 'space', 'docker'])('leaves metrics null before Compose on %s refusal', (early) => {\n198\t    const value = run({ early, home: '' });\n199\t    expect(value.probe).toEqual({ status: 'not_run', pipeline_exit_status: null, captured_bytes: null, home_present: true });\n200\t    expect(value.calls.some((args) => args.includes('compose'))).toBe(false);\n201\t    expect(value.result.status).toBe(1);\n202\t  });\n203\t\n204\t  it('keeps the invalid-input full report before all queries', () => {\n205\t    const value = run({ args: ['/invalid/../path', sha], validate: false });\n206\t    // The old invalid-input branch deliberately clears source_sha.\n207\t    expect(value.body.reason).toBe('invalid_input');\n208\t    expect(gate(value.body).status).not.toBe(0);\n209\t    expect(value.calls).toEqual([]);\n210\t    expect(value.probe).toEqual({ status: 'not_run', pipeline_exit_status: null, captured_bytes: null, home_present: false });\n211\t  });\n212\t\n213\t  it('preserves non-Compose query argv, redacted fields and no mutation against the base', () => {\n214\t    const before = snapshot();\n215\t    const candidate = run();\n216\t    rmSync(join(root, 'calls'));\n217\t    const original = join(root, 'baseline.sh'); writeFileSync(original, baseline(scriptPath));\n218\t    // The baseline lacks compose_probe, so its report is not passed to the new validator.\n219\t    const result = spawnSync('/bin/bash', [original, deploy, sha], {\n220\t      env: { NODE_ENV: 'test', PATH: `${bin}:/usr/bin:/bin`, CALLS: join(root, 'calls'),\n221\t        OUTPUT: Buffer.from('v2.35.1\\n').toString('base64'), CODE: '0', PIPELINE_CODE: '', HEAD_CODE: '',\n222\t        HANG: '', EARLY: '', LC_ALL: 'en_US.UTF-8', CANARY: secret },\n223\t      encoding: 'utf8', timeout: 10_000\n224\t    });\n225\t    expect(result.status).toBe(candidate.result.status);\n226\t    expect(result.stdout + result.stderr).not.toContain(secret);\n227\t    const { compose_probe: _probe, timestamp: _timestamp, ...body } = candidate.body;\n228\t    const { timestamp: _originalTimestamp, ...oldBody } = JSON.parse(result.stdout);\n229\t    expect(body).toEqual(oldBody);\n230\t    expect(calls().map((args) => JSON.stringify(args)).sort()).toEqual(candidate.calls.map((args) => JSON.stringify(args)).sort());\n231\t    expect(snapshot()).toEqual(before);\n232\t  });\n233\t\n234\t  it('keeps the missing-jq minimal refusal unchanged and outside full transport reports', () => {\n235\t    const date = join(bin, 'date');\n236\t    writeFileSync(date, '#!/bin/bash\\nprintf \"2026-10-09T00:00:00Z\\\\n\"\\n'); chmodSync(date, 0o755);\n237\t    const result = spawnSync('/bin/bash', [join(process.cwd(), scriptPath), deploy, sha], {\n238\t      env: { PATH: bin, NODE_ENV: 'test' }, encoding: 'utf8', timeout: 10_000\n239\t    });\n240\t    expect(result.status).toBe(1);\n241\t    const body = JSON.parse(result.stdout);\n242\t    expect(body).toEqual({ schema_version: 1, operation: 'host-preflight', outcome: 'refused', reason: 'missing_tools' });\n243\t    expect(gate(body).status).not.toBe(0);\n244\t  });\n245\t\n246\t  it('validates each fixed classification using the actual workflow filter', () => {\n247\t    const body = run().body;\n248\t    for (const probe of [\n249\t      { status: 'not_run', pipeline_exit_status: null, captured_bytes: null, home_present: false },\n250\t      { status: 'ok', pipeline_exit_status: 0, captured_bytes: 0, home_present: true },\n251\t      { status: 'invalid_version', pipeline_exit_status: 0, captured_bytes: 16384, home_present: false },\n252\t      { status: 'command_failed', pipeline_exit_status: 255, captured_bytes: 16384, home_present: false },\n253\t      { status: 'output_bound_exceeded', pipeline_exit_status: 141, captured_bytes: 16385, home_present: true }\n254\t    ]) expect(gate({ ...body, compose_probe: probe }).status, JSON.stringify(probe)).toBe(0);\n255\t  });\n256\t\n257\t  it('rejects missing, extra, wrong type, enum, range and null-relation metadata with the actual filter', () => {\n258\t    const body = run().body, good = body.compose_probe;\n259\t    const bad: unknown[] = [undefined, null, [], secret, 0, true, {}, { ...good, secret },\n260\t      ...Object.keys(good).map((key) => Object.fromEntries(Object.entries(good).filter(([name]) => name !== key))),\n261\t      ...[null, false, 0, secret, 'timeout', 'missing_plugin'].map((status) => ({ ...good, status })),\n262\t      ...[null, -1, 256, 0.5, '0', false, [], {}, secret].map((pipeline_exit_status) => ({ ...good, pipeline_exit_status })),\n263\t      ...[null, -1, 16385, 0.5, '7', true, [], {}, secret].map((captured_bytes) => ({ ...good, captured_bytes })),\n264\t      ...[null, 0, 'false', [], {}, homeCanary].map((home_present) => ({ ...good, home_present })),\n265\t      { ...good, status: 'not_run' }, { ...good, status: 'not_run', pipeline_exit_status: null },\n266\t      { ...good, status: 'not_run', captured_bytes: null }, { ...good, status: 'command_failed' },\n267\t      { ...good, status: 'output_bound_exceeded' },\n268\t      { ...good, status: 'output_bound_exceeded', captured_bytes: 16386 },\n269\t      { ...good, status: 'output_bound_exceeded', captured_bytes: 16385, pipeline_exit_status: null },\n270\t      { ...good, status: 'invalid_version', pipeline_exit_status: 1 }\n271\t    ];\n272\t    for (const compose_probe of bad) expect(gate({ ...body, compose_probe }).status, JSON.stringify(compose_probe)).not.toBe(0);\n273\t    for (const addition of [{ ...body, secret }, { ...body, versions: { ...body.versions, secret } },\n274\t      { ...body, files: { ...body.files, secret: { sha256: secret, mode: '600' } } }]) {\n275\t      expect(gate(addition).status).not.toBe(0);\n276\t    }\n277\t  });\n278\t});\n279\t\n280\tdescribe('byte-frozen host-preflight boundaries', () => {\n281\t  it('pins every workflow byte outside the existing host report validator', () => {\n282\t    expect(validator(workflow).outside).toBe(validator(baseline(workflowPath)).outside);\n283\t  });\n284\t\n285\t  it('pins shared query and all script bytes outside Compose capture and serialization', () => {\n286\t    const original = baseline(scriptPath);\n287\t    expect(script.slice(script.indexOf('query() {'), script.indexOf('valid_sha()')))\n288\t      .toBe(original.slice(original.indexOf('query() {'), original.indexOf('valid_sha()')));\n289\t    const normalized = script\n290\t      .replace('compose_probe_status=not_run compose_pipeline_exit_status=null compose_captured_bytes=null compose_home_present=false\\nif [[ ${HOME+x} == x ]]; then compose_home_present=true; fi\\n', '')\n291\t      .replace('    --arg probe_status \"$compose_probe_status\" --argjson pipeline_status \"$compose_pipeline_exit_status\" \\\\\\n    --argjson captured_bytes \"$compose_captured_bytes\" --argjson home_present \"$compose_home_present\" \\\\\\n', '')\n292\t      .replace('      compose_probe:{status:$probe_status,pipeline_exit_status:$pipeline_status,captured_bytes:$captured_bytes,home_present:$home_present},\\n', '')\n293\t      .replace(/compose_pipeline_exit_status=0\\n[\\s\\S]*?compose_probe_status=ok\\n(?=compose_version=\"\\$value\")/,\n294\t        original.slice(original.indexOf('value=\"$(query docker compose version --short)\"'), original.indexOf('compose_version=\"$value\"')));\n295\t    expect(normalized).toBe(original);\n296\t  });\n297\t\n298\t  it('pins the old host tests and protected state/dependency/rule files to baseline blobs', () => {\n299\t    for (const path of ['tests/ci/vps-host-preflight.test.ts', 'progress.json', 'features.json', 'harness-rules.md',\n300\t      'AGENTS.md', 'CLAUDE.md', 'generator.md', 'package.json', 'package-lock.json', 'vitest.config.ts']) {\n301\t      expect(createHash('sha256').update(readFileSync(path)).digest('hex'), path)\n302\t        .toBe(createHash('sha256').update(baseline(path)).digest('hex'));\n303\t    }\n304\t  });\n305\t});"}
{"role":"tool","tool_call_id":"tool_jkDKddVxboEdfBo4RR8fH9E5","content":"1\t#!/usr/bin/env bash\n2\tset +x\n3\texec 2>/dev/null\n4\tset -euo pipefail\n5\t\n6\t# Only query subprocesses are bounded/killed; no container or service is signalled.\n7\tquery() {\n8\t  local value\n9\t  value=\"$(timeout --signal=KILL 5s \"$@\" 2>/dev/null | head -c 16385)\" || return 1\n10\t  [[ ${#value} -le 16384 ]] || return 1\n11\t  printf '%s' \"$value\"\n12\t}\n13\tvalid_sha() { [[ \"$1\" =~ ^[0-9a-f]{40}$ ]]; }\n14\tvalid_id() { [[ \"$1\" =~ ^[0-9a-f]{12,64}$ ]]; }\n15\tvalid_digest() { [[ \"$1\" =~ ^sha256:[0-9a-f]{64}$ ]]; }\n16\tvalid_image() { [[ \"$1\" =~ ^[a-z0-9][a-z0-9./:_-]{1,240}(@sha256:[0-9a-f]{64})?$ ]]; }\n17\tregular() { [[ -f \"$1\" && ! -L \"$1\" ]]; }\n18\t\n19\tsource_sha=\"${2:-unknown}\"\n20\ttimestamp=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n21\toutcome=refused reason=invalid_input baseline=unknown platform=unknown free_kib=unknown\n22\tdocker_version=unknown compose_version=unknown commit=unknown app_image=unknown migrate_image=unknown host_port=unknown\n23\tapp_id=unknown app_status=unknown app_health=unknown app_image_id=unknown revision=unknown image_user=unknown uid=unknown\n24\tpostgres_id=unknown postgres_status=unknown postgres_health=unknown postgres_image_id=unknown\n25\tapp_network=unknown postgres_network=unknown postgres_volume=unknown\n26\tnetwork_driver=unknown volume_driver=unknown\n27\tfiles='{}'\n28\tcompose_probe_status=not_run compose_pipeline_exit_status=null compose_captured_bytes=null compose_home_present=false\n29\tif [[ ${HOME+x} == x ]]; then compose_home_present=true; fi\n30\t\n31\temit() {\n32\t  if ! command -v jq >/dev/null; then\n33\t    printf '{\"schema_version\":1,\"operation\":\"host-preflight\",\"outcome\":\"refused\",\"reason\":\"missing_tools\"}\\n'\n34\t    return\n35\t  fi\n36\t  jq -n --arg source \"$source_sha\" --arg timestamp \"$timestamp\" --arg outcome \"$outcome\" --arg reason \"$reason\" \\\n37\t    --arg baseline \"$baseline\" --arg platform \"$platform\" --arg free \"$free_kib\" \\\n38\t    --arg docker \"$docker_version\" --arg compose \"$compose_version\" \\\n39\t    --arg probe_status \"$compose_probe_status\" --argjson pipeline_status \"$compose_pipeline_exit_status\" \\\n40\t    --argjson captured_bytes \"$compose_captured_bytes\" --argjson home_present \"$compose_home_present\" \\\n41\t    --arg commit \"$commit\" --arg app_image \"$app_image\" --arg migrate_image \"$migrate_image\" --arg host_port \"$host_port\" \\\n42\t    --arg app_id \"$app_id\" --arg app_status \"$app_status\" --arg app_health \"$app_health\" --arg app_image_id \"$app_image_id\" \\\n43\t    --arg revision \"$revision\" --arg image_user \"$image_user\" --arg uid \"$uid\" --arg app_network \"$app_network\" \\\n44\t    --arg postgres_id \"$postgres_id\" --arg postgres_status \"$postgres_status\" --arg postgres_health \"$postgres_health\" \\\n45\t    --arg postgres_image_id \"$postgres_image_id\" --arg postgres_network \"$postgres_network\" --arg postgres_volume \"$postgres_volume\" \\\n46\t    --arg network_driver \"$network_driver\" --arg volume_driver \"$volume_driver\" --argjson files \"$files\" \\\n47\t    '{schema_version:1,operation:\"host-preflight\",source_sha:$source,timestamp:$timestamp,outcome:$outcome,reason:$reason,\n48\t      project:\"tokenizer\",baseline:$baseline,platform:$platform,free_kib:$free,\n49\t      versions:{docker:$docker,compose:$compose},\n50\t      compose_probe:{status:$probe_status,pipeline_exit_status:$pipeline_status,captured_bytes:$captured_bytes,home_present:$home_present},\n51\t      settings:{GIT_COMMIT:$commit,APP_IMAGE:$app_image,MIGRATE_IMAGE:$migrate_image,APP_HOST_PORT:$host_port},\n52\t      app:{id:$app_id,status:$app_status,health:$app_health,image_id:$app_image_id,revision:$revision,user:$image_user,uid:$uid,port:$host_port,network:$app_network},\n53\t      postgres:{id:$postgres_id,status:$postgres_status,health:$postgres_health,image_id:$postgres_image_