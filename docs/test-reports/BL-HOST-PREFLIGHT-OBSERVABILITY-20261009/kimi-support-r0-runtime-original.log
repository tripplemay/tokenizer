use', () => {\\n    const diff = spawnSync('git', ['diff', `${BASE}..HEAD`, '--unified=0', '--', WORKFLOW_PATH], { encoding: 'utf8' }).stdout;\\n    const removed = diff.split('\\\\n').filter((l) => l.startsWith('-') && !l.startsWith('---')).map((l) => l.slice(1));\\n    const added = diff.split('\\\\n').filter((l) => l.startsWith('+') && !l.startsWith('+++')).map((l) => l.slice(1));\\n    expect(removed.length).toBe(1);\\n    expect(removed[0]).toContain('exact([\\\"schema_version\\\"');\\n    expect(removed[0]).not.toContain('compose_probe');\\n    expect(added.length).toBe(9);\\n    expect(added.some((l) => l.includes('def bounded_integer($max)'))).toBe(true);\\n    expect(added.some((l) => l.includes('exact([\\\"schema_version\\\"') && l.includes('\\\"compose_probe\\\"'))).toBe(true);\\n    for (const line of added) {\\n      expect(/bounded_integer|compose_probe|pipeline_exit_status|captured_bytes|home_present|else false end/.test(line), line).toBe(true);\\n    }\\n  });\\n\\n  it('pins the shared query() implementation and confines the script diff to the Compose capture/serialization', () => {\\n    const original = gitShow(SCRIPT_PATH);\\n    const slice = (text: string) => text.slice(text.indexOf('query() {'), text.indexOf('valid_sha()'));\\n    expect(slice(scriptText)).toBe(slice(original));\\n    const diff = spawnSync('git', ['diff', `${BASE}..HEAD`, '--unified=0', '--', SCRIPT_PATH], { encoding: 'utf8' }).stdout;\\n    const removed = diff.split('\\\\n').filter((l) => l.startsWith('-') && !l.startsWith('---')).map((l) => l.slice(1));\\n    const added = diff.split('\\\\n').filter((l) => l.startsWith('+') && !l.startsWith('+++')).map((l) => l.slice(1));\\n    // Only the old Compose query/validation lines were replaced.\\n    expect(removed.length).toBe(2);\\n    expect(removed[0]).toBe('value=\\\"$(query docker compose version --short)\\\" || fail compose_unavailable');\\n    expect(removed[1]).toContain('=~ ^v?[0-9]+');\\n    expect(removed[1]).toContain('|| fail compose_unavailable');\\n    // Every added line belongs to the fixed metadata block: no new host queries.\\n    expect(added.length).toBe(16);\\n    for (const line of added) {\\n      expect(/compose_probe|compose_pipeline_exit_status|compose_captured_bytes|compose_home_present|HOME\\\\+x|retained shell string|LC_ALL=C/.test(line), line).toBe(true);\\n    }\\n    // The Compose capture keeps the identical bounded argv as the frozen query() path.\\n    expect(added).toContain('value=\\\"$(timeout --signal=KILL 5s docker compose version --short 2>/dev/null | head -c 16385)\\\" || compose_pipeline_exit_status=$?');\\n    expect(scriptText).toContain('value=\\\"$(timeout --signal=KILL 5s \\\"$@\\\" 2>/dev/null | head -c 16385)\\\" || return 1');\\n  });\\n});\\n\"}"}}]}
