--- release-artifact permissions ---
  release-artifact:
    name: Linux OCI and recovery rehearsal
    runs-on: ubuntu-latest
    needs: [verify, verify-windows]
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
    outputs:
      app-image: ${{ steps.refs.outputs.app }}@${{ steps.app.outputs.digest }}
      migrate-image: ${{ steps.refs.outputs.migrate }}@${{ steps.migrate.outputs.digest }}
    steps:
      - uses: actions/checkout@v4
--- deploy permissions ---
  deploy:
    name: Deploy
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: read
    needs: [verify, verify-windows, release-artifact]
    if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch')
    environment: production
    env:
      VPS_HOST: ${{ secrets.VPS_HOST }}
      VPS_USER: ${{ secrets.VPS_USER }}
      VPS_SSH_KEY: ${{ secrets.VPS_SSH_KEY }}
      VPS_SSH_PORT: ${{ secrets.VPS_SSH_PORT }}
      VPS_DEPLOY_PATH: ${{ secrets.VPS_DEPLOY_PATH }}
      ADMIN_TOKEN: ${{ secrets.ADMIN_TOKEN }}
