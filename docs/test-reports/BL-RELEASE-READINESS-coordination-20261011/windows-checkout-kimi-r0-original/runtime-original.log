sha }}\\\\nfetch-depth: 1\\\\npersist-credentials: false')\\n+    throw new Error('checkout inputs changed');\\n+  for (const [i, s] of w.steps.entries()) {\\n+    if (i > 0 && s.envRaw) throw new Error('env leaked to later step ' + i);\\n+    if (s.withRaw.some(l => /^(path|sparse-checkout|sparse-checkout-cone-mode|filter|fetch-tags|set-safe-directory|submodules|clean|lfs|repository|token|ssh-)/.test(l)))\\n+      throw new Error('forbidden checkout input');\\n+  }\\n+  for (const key of ['GIT_CONFIG_COUNT', 'GIT_CONFIG_KEY_0', 'GIT_CONFIG_VALUE_0'])\\n+    if (text.split(key).length - 1 !== 1) throw new Error(key + ' must appear exactly once');\\n+  return w;\\n+}\\n+\\n+const mut = (from: string, to: string) => {\\n+  const i = wfText.indexOf(from);\\n+  if (i < 0) throw new Error('mutation anchor missing: ' + JSON.stringify(from));\\n+  return wfText.slice(0, i) + to + wfText.slice(i + from.length);\\n+};\\n+\\n+describe('r0-checkout-env-positive', () => {\\n+  it('accepts the exact candidate workflow with the confined env triple', () => {\\n+    const w = assertCheckoutScope(wfText);\\n+    expect(w.steps[0].envRaw).toEqual(ENV_LINES.slice(1));\\n+    expect(w.steps.map(s => s.uses ?? s.name)).toEqual([\\n+      'actions/checkout@v4', 'actions/setup-node@v4', 'Prepare exact-candidate provenance',\\n+      'Install locked dependencies', 'Synthetic checks only', 'INITIAL once',\\n+      'Seal safe evidence', 'Verify sealed files immediately', 'actions/upload-artifact@v4']);\\n+  });\\n+  it('matches the unchanged locked ordered commands and 16 explicit upload paths', () => {\\n+    const w = assertCheckoutScope(wfText);\\n+    expect(w.steps.filter(s => s.run).map(s => s.run)).toEqual(p1.BINDINGS.workflow.ordered_commands);\\n+    expect(p1.BINDINGS.output.upload_files).toHaveLength(16);\\n+    const uploadLines = wfText.match(/^            docs\\\\/\\\\S+$/gm)!.map(l => l.trim());\\n+    expect(uploadLines).toEqual(p1.BINDINGS.output.upload_files.map(p => p1.BINDINGS.output.upload_root + p));\\n+  });\\n+  it('pins workflow and binding identities to the exact candidate hashes', () => {\\n+    expect(p1.sha256(fs.readFileSync(join(repo, WF_PATH)))).toBe('1ab508fc704fe8ceb1aecbdb9b630ea748add97dc5a17a960940ab4e9a83a771');\\n+    expect(p1.sha256(fs.readFileSync(join(repo, BJ_PATH)))).toBe('652a11170499b8c03bcd70d65ba4f8cdd1476a318e119b267d33cbf90ed1922d');\\n+    expect(p1.sha256(fs.readFileSync(join(repo, BM_PATH)))).toBe('fc7f4d09915d7200177bf0b4d7c6fc76e95e0423d4e1e2f3f2bc3a1986025ec6');\\n+    expect(p1.sha256(fs.readFileSync(join(repo, CLI_PATH)))).toBe('3028d77985e965d3de58c965b526bfe6adf7ddebced8b9173c89a5fb6c56e4f6');\\n+    expect(p1.validateBindings()).toBe(true);\\n+  });\\n+  it('declares exactly the three-string checkout_env static contract in revised bindings', () => {\\n+    expect(p1.BINDINGS.revision).toBe(2);\\n+    expect(p1.BINDINGS.existing_file_edits_allowed).toEqual([WF_PATH, BM_PATH, BJ_PATH, CLI_PATH]);\\n+    expect(p1.BINDINGS.workflow.checkout_env).toEqual({\\n+      GIT_CONFIG_COUNT: '1', GIT_CONFIG_KEY_0: 'core.longpaths', GIT_CONFIG_VALUE_0: 'true' });\\n+    expect(p1.BINDINGS.workflow.checkout_env_scope)\\n+      .toBe('checkout-action-step-only; no workflow/job/GITHUB_ENV or diagnostic-child propagation');\\n+    expect(p1.BINDINGS.workflow.checkout)\\n+      .toEqual({ ref: '${{ github.sha }}', 'fetch-depth': 1, 'persist-credentials': false });\\n+  });\\n+});\\n+\\n+describe('r0-checkout-env-negative-table', () => {\\n+  const envBlock = ENV_LINES.join('\\\\n') + '\\\\n';\\n+  const laterSteps: [string, string][] = [\\n+    ['setup-node', '      - uses: actions/setup-node@v4\\\\n'],\\n+    ['prepare', '      - name: Prepare exact-candidate provenance\\\\n'],\\n+    ['npm-ci', '      - name: Install locked dependencies\\\\n'],\\n+    ['synthetic', '      - name: Synthetic checks only\\\\n'],\\n+    ['initial', '      - name: INITIAL once\\\\n'],\\n+    ['seal', '      - name: Seal safe evidence\\\\n'],\\n+    ['verify', '      - name: Verify sealed files immediately\\\\n'],\\n+    ['upload', '      - uses: actions/upload-artifact@v4\\\\n'],\\n+  ];\\n+  const cases: [string, string][] = [\\n+    ['missing-env', mut(envBlock, '')],\\n+    ['count0', mut(\\\"GIT_CONFIG_COUNT: '1'\\\", \\\"GIT_CONFIG_COUNT: '0'\\\")],\\n+    ['count2-one-pair', mut(\\\"GIT_CONFIG_COUNT: '1'\\\", \\\"GIT_CONFIG_COUNT: '2'\\\")],\\n+    ['missing-key', mut('          GIT_CONFIG_KEY_0: core.longpaths\\\\n', '')],\\n+    ['missing-value', mut(\\\"          GIT_CONFIG_VALUE_0: 'true'\\\\n\\\", '')],\\n+    ['false-value', mut(\\\"GIT_CONFIG_VALUE_0: 'true'\\\", \\\"GIT_CONFIG_VALUE_0: 'false'\\\")],\\n+    ['nonstring-value', mut(\\\"GIT_CONFIG_VALUE_0: 'true'\\\", 'GIT_CONFIG_VALUE_0: true')],\\n+    ['nonstring-count', mut(\\\"GIT_CONFIG_COUNT: '1'\\\", 'GIT_CONFIG_COUNT: 1')],\\n+    ['extra-key', mut(\\\"          GIT_CONFIG_VALUE_0: 'true'\\\\n\\\", \\\"          GIT_CONFIG_VALUE_0: 'true'\\\\n          GIT_CONFIG_EXTRA: '1'\\\\n\\\")],\\n+    ['second-pair', mut(\\\"GIT_CONFIG_COUNT: '1'\\\", \\\"GIT_CONFIG_COUNT: '2'\\\")\\n+      .replace(\\\"          GIT_CONFIG_VALUE_0: 'true'\\\\n\\\", \\\"          GIT_CONFIG_VALUE_0: 'true'\\\\n          GIT_CONFIG_KEY_1: core.autocrlf\\\\n          GIT_CONFIG_VALUE_1: 'false'\\\\n\\\")],\\n+    ['renamed-key', mut('GIT_CONFIG_KEY_0: core.longpaths', 'GIT_CONFIG_KEY_0: core.LongPaths')],\\n+    ['workflow-level-env', mut('concurrency:', envBlock.replace(/^ {8}/gm, '') + 'concurrency:')],\\n+    ['job-level-env', mut('    steps:\\\\n', envBlock.replace(/^ {8}/gm, '    ') + '    steps:\\\\n')],\\n+    ...laterSteps.map(([name, anchor]): [string, string] => ['env-at-' + name, mut(anchor, anchor + envBlock)]),\\n+    ['github-env-write', mut('run: npm ci', 'run: echo GIT_CONFIG_COUNT=1 >> $GITHUB_ENV && npm ci')],\\n+    ['config-write-global', mut('run: npm ci', 'run: git config --global core.longpaths true && npm ci')],\\n+    ['config-write-system', mut('run: npm ci', 'run: git config --system core.longpaths true && npm ci')],\\n+    ['config-write-local', mut('run: npm ci', 'run: git config --local core.longpaths true && npm ci')],\\n+    ['config-write-worktree', mut('run: npm ci', 'run: git config --worktree core.longpaths true && npm ci')],\\n+    ['sparse-input', mut('          persist-credentials: false\\\\n', '          persist-credentials: false\\\\n          sparse-checkout: docs\\\\n')],\\n+    ['path-input', mut('          persist-credentials: false\\\\n', '          persist-credentials: false\\\\n          path: short\\\\n')],\\n+    ['filter-input', mut('          persist-credentials: false\\\\n', '          persist-credentials: false\\\\n          filter: blob:none\\\\n')],\\n+    ['new-command', mut('      - uses: actions/upload-artifact@v4\\\\n', '      - name: probe\\\\n        run: git --version\\\\n      - uses: actions/upload-artifact@v4\\\\n')],\\n+    ['secrets-usage', mut('  contents: read', '  contents: read\\\\n  secrets: write')],\\n+    ['permissions-widened', mut('  contents: read', '  contents: write')],\\n+    ['continue-on-error', mut('        with:\\\\n          ref:', '        continue-on-error: true\\\\n        with:\\\\n          ref:')],\\n+    ['retry-wrapper', mut('run: npm ci', 'run: npm ci || npm ci')],\\n+    ['extra-event', mut('    branches: [codex/windows-p1-stages-ci-20261010]', '    branches: [codex/windows-p1-stages-ci-20261010]\\\\n  pull_request:')],\\n+  ];\\n+  it.each(cases)('rejects %s', (_name, text) => {\\n+    expect(() => assertCheckoutScope(text)).toThrow();\\n+  });\\n+});\\n+\\n+describe('r0-identity-and-provenance-negatives', () => {\\n+  const cliBytes = fs.readFileSync(join(repo, CLI_PATH));\\n+  const srcCli = cp.spawnSync('git', ['-c', 'core.fileMode=false', 'show', SRC + ':' + CLI_PATH],\\n+    { cwd: repo, maxBuffer: 4 * 1024 * 1024 });\\n+  const provenance = () => {\\n+    const files = [...p1.BINDINGS.future_added_source_paths, BJ_PATH,\\n+      ...p1.BINDINGS.frozen_runtime_sources.map(s => s.path)].sort()\\n+      .map(path => ({ path, sha256: p1.sha256(fs.readFileSync(join(repo, path))) }));\\n+    const value = { format: 'windows-p1-initial-provenance-v1', executionSha: 'c'.repeat(40), expectedSha: 'c'.repeat(40),\\n+      planningBase: p1.BINDINGS.planning_base, timestampUtc: '2026-10-11T00:00:00Z', runId: '1', runAttempt: 1,\\n+      ref: 'refs/heads/codex/windows-p1-stages-ci-20261010',\\n+      runtime: { node: 'v22.22.0', uv: '1.51.0', platform: 'win32', arch: 'x64', osRelease: '10.0.1', imageOS: 'win25', imageVersion: '20261011.1.0' },\\n+      sourceFiles: files, environmentKeyNames: [...p1.BINDINGS.environment.system_keys, ...p1.BINDINGS.environment.synthetic_keys].sort(),\\n+      extraEnvironmentKeys: [], provenanceUnknown: false, releaseReady: false, releaseAcceptance: false };\\n+    return { value, files };\\n+  };\\n+  it('real validateProvenance accepts an exact-C-shaped record and rejects stale bindings/old-source relabel', () => {\\n+    const { value, files } = provenance();\\n+    expect(p1.validateProvenance(value, files, 'c'.repeat(40))).toBe(true);\\n+    const stale = provenance();\\n+    stale.value.sourceFiles = stale.value.sourceFiles.map(s =>\\n+      s.path === BJ_PATH ? { path: s.path, sha256: 'ed24ebf3b4b1890f84f09ba82edd0d71f75a12e35504a84a3fb0f9d8300455fc' } : s);\\n+    stale.files = stale.value.sourceFiles;\\n+    expect(p1.validateProvenance(stale.value, stale.files, 'c'.repeat(40))).toBe(false);\\n+    const relabel = provenance();\\n+    relabel.value.executionSha = relabel.value.expectedSha = SRC;\\n+    expect(p1.validateProvenance(relabel.value, relabel.files, SRC)).toBe(false);\\n+    const mismatchedSha = provenance();\\n+    expect(p1.validateProvenance(mismatchedSha.value, mismatchedSha.files, SRC)).toBe(false);\\n+  });\\n+  it('exact-scope control: masking only the two identity literals yields source888 bytes; one extra byte fails', () => {\\n+    expect(srcCli.status).toBe(0);\\n+    const masked = Buffer.from(cliBytes.toString('utf8')\\n+      .replace('652a11170499b8c03bcd70d65ba4f8cdd1476a318e119b267d33cbf90ed1922d', 'ed24ebf3b4b1890f84f09ba82edd0d71f75a12e35504a84a3fb0f9d8300455fc')\\n+      .replace('fc7f4d09915d7200177bf0b4d7c6fc76e95e0423d4e1e2f3f2bc3a1986025ec6', 'bf60ca426602d00b76515091cc30abd37badea21731b6ad21fe54cd323d7577c'), 'utf8');\\n+    expect(masked.equals(srcCli.stdout)).toBe(true);\\n+    expect(Buffer.concat([masked, Buffer.from('X')]).equals(srcCli.stdout)).toBe(false);\\n+    const oneSided = cliBytes.toString('utf8')\\n+      .replace('fc7f4d09915d7200177bf0b4d7c6fc76e95e0423d4e1e2f3f2bc3a1986025ec6', 'bf60ca426602d00b76515091cc30abd37badea21731b6ad21fe54cd323d7577c');\\n+    expect(Buffer.from(oneSided, 'utf8').equals(srcCli.stdout)).toBe(false);\\n+  });\\n+  it('checksSummary binds the fresh unchanged-suite run to all required controls', () => {\\n+    const raw = JSON.parse(fs.readFileSync(\\n+      join(repo, 'docs/test-reports/BL-WINDOWS-P1-CHECKOUT-kimi-r0-20261011/logs/original-81.raw.json'), 'utf8'));\\n+    const summary = p1.checksSummary(raw);\\n+    expect(summary?.allRequiredControlsPassed).toBe(true);\\n+    expect(summary?.passed).toBe(81);\\n+  });\\n+});\\n+\\n+describe('r0-systemEnvironment-discards-checkout-keys', () => {\\n+  it('unchanged systemEnvironment admits only the five case-insensitive system keys', () => {\\n+    const base = {\\n+      Path: 'owned-path', SYSTEMROOT: 'C:\\\\\\\\Windows', windir: 'C:\\\\\\\\Windows', ComSpec: 'C:\\\\\\\\Windows\\\\\\\\system32\\\\\\\\cmd.exe',\\n+      PATHEXT: '.COM;.EXE', GIT_CONFIG_COUNT: '1', GIT_CONFIG_KEY_0: 'core.longpaths', GIT_CONFIG_VALUE_0: 'true',\\n+      git_config_count: '1', APPDATA: 'forbidden', LOCALAPPDATA: 'forbidden', SystemDrive:"}}]}
