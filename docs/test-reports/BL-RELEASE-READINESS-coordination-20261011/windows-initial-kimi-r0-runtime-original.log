its \"dryRun:false is unsupported\" assertion;\n    // keep the original bytes hashable, but run the candidate-owned successor.\n    exclude: [\n      ...historicalTestConfig.exclude,\n      \"tests/evaluator/b03-scope-admission-independent.test.ts\",\n      // Immutable B06 server-slice evidence locks the deliberately obsolete\n      // retry-and-pin behavior; the partial ACK suite is its replacement.\n      \"tests/cli/b06-batch-failure-queue.test.ts\",\n      // Resolution moved inside sync, before the optional observer callback.\n      // B07 queue/versioned-quarantine suites inject durable-write failures.\n      \"tests/cli/b06-partial-ack.test.ts\",\n      \"tests/ci/b06-obsolete-queue-test-archive.test.ts\"\n    ],\n    environment: \"node\"\n  }\n});\n"}
{"role":"assistant","content":"Config confirmed. Writing my own additive table-driven probe file now.","tool_calls":[{"type":"function","id":"tool_ekFOnKP1p2X6B0Cse5SXjOxB","function":{"name":"Write","arguments":"{\"path\":\"tests/evaluator/windows-p1-initial-r0-probes.test.ts\",\"content\":\"// Independent Evaluator (kimi-r0) ADDITIVE probes for the Windows P1 INITIAL diagnostic.\\n// Compact table-driven checks BEYOND the existing 81 controls in\\n// tests/diagnostics/windows-p1-stages.test.ts. Offline synthetic/mocked only:\\n// pure imports, test-local VM of the exact runCase source, mock FS/clock/PID data.\\n// No live native/API/OS claims. Hash-locked implementation:\\n// docs/test-reports/windows-p1-stages-20261010/p1-stages.mjs\\n//   sha256 3a2d4174c1b2ac3b0caddb4b10c2ba9146c1569247dc6bd6084be01070a4346b\\nimport { afterAll, describe, expect, it, vi } from 'vitest';\\nimport fs from 'node:fs';\\nimport { EventEmitter } from 'node:events';\\nimport { join, resolve } from 'node:path';\\nimport vm from 'node:vm';\\nimport assert from 'node:assert/strict';\\nimport * as p1 from '../../docs/test-reports/windows-p1-stages-20261010/p1-stages.mjs';\\n\\ntype Row = Record<string, any>;\\nconst temporary = process.env.TMPDIR ?? process.env.TEMP;\\nif (!temporary) throw new Error('owned test temporary base required');\\nconst owned = fs.mkdtempSync(join(temporary, 'wp1-kimi-r0-'));\\nafterAll(() => fs.rmSync(owned, { recursive: true, force: true }));\\nconst repo = resolve('.');\\nconst jsonl = (rows: Row[]) => Buffer.from(rows.map(r => JSON.stringify(r) + '\\\\n').join(''));\\nconst clone = <T>(v: T): T => JSON.parse(JSON.stringify(v));\\nconst directory = () => fs.mkdtempSync(join(owned, 'case-'));\\nconst io = () => Object.fromEntries(['mkdirSync', 'rmdirSync', 'lstatSync', 'fstatSync', 'openSync', 'readFileSync', 'readSync',\\n  'writeSync', 'writeFileSync', 'closeSync', 'appendFileSync', 'realpathSync', 'readdirSync', 'rmSync'].map(k => [k, (fs as any)[k].bind(fs)]));\\nconst admitted = () => ({ event: 'powershell-admission', kind: 'smoke' });\\nconst scriptBytes = (variant: string, count?: number, newline = '\\\\n') => {\\n  const c = p1.CASES.find(c => c.variant === variant)!;\\n  return Buffer.from(c.sequence.slice(0, count ?? c.sequence.length).map(m => p1.BINDINGS.tokens[m] + newline).join(''));\\n};\\n\\n// Minimal fixture builder (own, compact): consistent guard/trace/root/health for one variant.\\nfunction fixture(variant = 'T1', outcome = 'completed', count?: number): any {\\n  const c = p1.CASES.find(c => c.variant === variant)!;\\n  const markers = c.sequence.slice(0, count ?? c.sequence.length);\\n  const status = outcome === 'refused' ? 1 : outcome === 'timeout' ? null : 0;\\n  const signal = outcome === 'timeout' ? 'SIGKILL' : null;\\n  const bytes = scriptBytes(variant, markers.length).length;\\n  const guard: Row[] = [\\n    { pid: 100, sequence: 0, at: 1, event: 'guard-preload', commonBudgetGuardOn: true, oldTracePreloadOn: true },\\n    { pid: 200, sequence: 0, at: 1, event: 'guard-preload', commonBudgetGuardOn: true, oldTracePreloadOn: true },\\n    { pid: 200, sequence: 1, at: 1, event: 'spawn', executable: 'powershell.exe', childPid: 300, detached: false },\\n    ...markers.map((marker, ordinal) => ({ pid: 200, sequence: 2 + ordinal, at: 1, event: 'native-fixed-stage', childPid: 300,\\n      variant, marker, ordinal, arrivalElapsedMs: ordinal + 1 })),\\n    { pid: 200, sequence: 2 + markers.length, at: 1, event: 'child-exit', executable: 'powershell.exe', childPid: 300, status, signal },\\n    { pid: 200, sequence: 3 + markers.length, at: 1, event: 'native-fixed-stream-end', childPid: 300, variant, stdoutBytes: bytes, stderrBytes: 0,\\n      combinedBytes: bytes, acceptedMarkers: markers.length, stdoutEofObserved: true, stderrEofObserved: true, eofObserved: true,\\n      state: markers.length === c.sequence.length ? 'complete-sequence' : 'complete-prefix', reason: 'none' },\\n    { pid: 200, sequence: 4 + markers.length, at: 1, event: 'child-close', executable: 'powershell.exe', childPid: 300, status, signal },\\n    { pid: 100, sequence: 1, at: 1, event: 'spawn-sync', executable: 'node', childPid: 200, status: 0, signal: null, code: null }\\n  ];\\n  const trace: Row[] = [\\n    { pid: 100, sequence: 0, at: 1, monotonicMs: 1, event: 'preload', node: 'v22.22.0', uv: '1.51.0' },\\n    { pid: 200, sequence: 0, at: 1, monotonicMs: 1, event: 'preload', node: 'v22.22.0', uv: '1.51.0' },\\n    { pid: 200, sequence: 1, at: 1, monotonicMs: 1, event: 'spawn', executable: 'powershell.exe', childPid: 300, detached: false },\\n    { pid: 200, sequence: 2, at: 1, monotonicMs: 1, event: 'child-exit', executable: 'powershell.exe', childPid: 300, status, signal },\\n    { pid: 200, sequence: 3, at: 1, monotonicMs: 1, event: 'child-close', executable: 'powershell.exe', childPid: 300, status, signal },\\n    { pid: 100, sequence: 1, at: 1, monotonicMs: 1, event: 'spawn-sync', executable: 'node', childPid: 200, elapsedMs: 1,\\n      status: 0, signal: null, code: null, workerKind: outcome === 'timeout' ? 'timeout' : outcome === 'launch' ? 'launch' : 'ok' }\\n  ];\\n  const native = outcome === 'launch'\\n    ? { outcome: 'launch', metadataSource: 'api-throw', status: null, signal: null,\\n        errorName: 'BoundedSubprocessLaunchError', errorCode: 'ENOENT', elapsedMs: 1, workerKind: 'launch' }\\n    : { outcome, metadataSource: outcome === 'timeout' ? 'api-throw' : 'api-return', status: outcome === 'timeout' ? null : status,\\n        signal: null, errorName: outcome === 'timeout' ? 'BoundedSubprocessTimeoutError' : null, errorCode: null,\\n        elapsedMs: 1, workerKind: outcome === 'timeout' ? 'timeout' : 'ok' };\\n  return { variant, guard, trace, launches: 1, counterKnown: true,\\n    probe: { format: 'windows-p1-initial-probe-v1', variant, caseId: c.caseId, scriptSha256: c.scriptSha256,\\n      probeSetupComplete: true, native, releaseAcceptance: false },\\n    root: { pid: 100, status: 0, signal: null, metadataUnknown: false, stopped: false, stopReason: null, launchCode: null,\\n      stdoutBytes: 256, stderrBytes: 0, outputBoundExceeded: false, canaryFound: false },\\n    health: { expectedPids: [100, 200], guardComplete: true, traceComplete: true, guardInvalid: false, traceInvalid: false,\\n      diagnosticAbortReasons: [], provenanceUnknown: false, cleanupUnknown: false, possibleLiveAtReturn: [], possibleLiveAfterOwnedCap: [],\\n      rootRetained: false, historicalPidsSignalled: false, wholeTreeAbsenceProven: false } };\\n}\\n\\n// Own copy of the sanctioned pattern: the ACTUAL runCase/expectedProcesses source evaluated in a\\n// test-local VM with only mock data injected. One mocked launcher, signal-0 PID queries only.\\nasync function actualCaseWithMocks(f: any, errorFor: (pid: number, sample: number) => unknown) {\\n  const output = directory(), runDirectory = join(output, 'run-root');\\n  fs.mkdirSync(runDirectory); fs.writeFileSync(join(runDirectory, 'counter.jsonl'), '');\\n  const c = p1.CASES.find(c => c.variant === f.variant)!;\\n  const source = fs.readFileSync(join(repo, 'docs/test-reports/windows-p1-stages-20261010/p1-stages.mjs'), 'utf8');\\n  const start = source.indexOf('async function runCase('), end = source.indexOf('function retainedRoots(', start);\\n  const processesStart = source.indexOf('function expectedProcesses('), processesEnd = source.indexOf('async function runRoot(', processesStart);\\n  expect(start).toBeGreaterThanOrEqual(0); expect(end).toBeGreaterThan(start);\\n  expect(processesStart).toBeGreaterThanOrEqual(0); expect(processesEnd).toBeGreaterThan(processesStart);\\n  const query = vi.fn((pid: number, signal: number) => {\\n    expect(signal).toBe(0);\\n    const error = errorFor(pid, Math.floor((query.mock.calls.length - 1) / 3));\\n    if (error) throw error;\\n    return true;\\n  });\\n  const remove = vi.fn(fs.rmSync.bind(fs));\\n  const launch = vi.fn(async (_case: any, root: string) => {\\n    fs.writeFileSync(join(root, 'guard.jsonl'), jsonl(f.guard)); fs.writeFileSync(join(root, 'trace.jsonl'), jsonl(f.trace));\\n    fs.appendFileSync(join(runDirectory, 'counter.jsonl'), jsonl([admitted()]));\\n    return { root: f.root, probe: f.probe };\\n  });\\n  const environment = vi.fn((_system: Row, _root: string, _runDirectory: string, _caseDeadline: number, _deadline: number) => ({}));\\n  const context = vm.createContext({ join, assert, Date: { now: () => 1 }, Math, Boolean, performance: { now: () => 0 },\\n    setTimeout: (done: () => void) => done(), BOUNDS: p1.BOUNDS, scratch: output,\\n    original: { ...io(), rmSync: remove }, process: { kill: query }, runRoot: launch, fixedEnvironment: environment,\\n    pid: (p: number) => Number.isSafeInteger(p) && p > 0 && p <= 0xffffffff,\\n    readOwned: (path: string, cap: number) => { const bytes = fs.readFileSync(path); assert(bytes.length <= cap); return bytes; },\\n    readRows: (path: string, family: string) => p1.parseRows(fs.readFileSync(path), family,\\n      family === 'counter' ? p1.BOUNDS.counter_bytes : p1.BOUNDS.guard_bytes),\\n    healthStates: () => ({ complete: true, invalid: false }), sorted: (values: string[]) => [...new Set(values)].sort(),\\n    counterState: p1.counterState, caseAdmission: p1.caseAdmission, evaluateCase: p1.evaluateCase,\\n    unknownCase: p1.unknownCase, skippedCase: p1.skippedCase,\\n    writeText: (path: string, text: string) => fs.writeFileSync(path, text) });\\n  vm.runInContext(source.slice(processesStart, processesEnd) + source.slice(start, end), context,\\n    { filename: 'kimi-r0-unchanged-actual-runCase-test-vm.mjs' });\\n  const record = await context.runCase(c, runDirectory, 600001, {});\\n  return { record, query, launch, remove, environment, root: join(runDirectory, c.caseId), output, runDirectory, c };\\n}\\n\\ndescribe('kimi-r0-additive parser pending-line and clock boundaries', () => {\\n  it.each([\\n    { bytes: 29, reason: 'unterminated-line', state: 'invalid' }, // exact pending_line_bytes fits, EOF ends it\\n    { bytes: 30, reason: 'unexpected-bytes', state: 'invalid' },  // +1 byte overflows the bounded pending line\\n  ])('distinguishes a $bytes-byte unterminated ASCII line by exact reason', ({ bytes, reason, state }) => {\\n    const r = p1.createRecorder('T0', () => {}, () => 1);\\n    r.feed('stdout', Buffer.alloc(bytes, 65)); r.end('stdout'); r.end('stderr');\\n    const end = r.finish();\\n    expect(end?.state).toBe(state); expect(end?.reason).toBe(reason); expect(end?.acceptedMarkers).toBe(0);\\n  });\\n  it('marks a marker arriving after the 40000ms case lifetime as stream-error unknown, never accepted', () => {\\n    let time = 0;\\n    const events: Row[] = [];\\n    const r = p1.createRecorder('T0', e => events.push(e), () => time);\\n    time = 40001; // observer monotonic clock jumps past the frozen case budget before the token\\n    r.feed('stdout', scriptBytes('T0')); r.end('stdout'); r.end('stderr');\\n    const end = r.finish();\\n    expect(r.markers).toEqual([]); expect(events.filter(e => e.event === 'native-fixed-stage')).toHaveLength(0);\\n    expect(end?.state).toBe('unknown'); expect(end?.reason).toBe('stream-error');\\n  });\\n  it('accepts both-stream EOF in either order and ignores feed after finalization', () => {\\n    const r = p1.createRecorder('T1', () => {}, () => 1);\\n    r.feed('stdout', scriptBytes('T1'));\\n    r.end('stderr'); r.end('stdout'); // stderr EOF first: stream order must not matter\\n    const end = r.finish();\\n    expect(end?.state).toBe('complete-sequence'); expect(end?.eofObserved).toBe(true);\\n    r.feed('stdout', Buffer.from('junk\\\\n')); r.feed('stderr', Buffer.from('x'));\\n    const again = r.finish();\\n    expect(again).toBeNull(); // exactly one stream-end; post-finish bytes are dropped\\n  });\\n  it('reports a clean empty prefix with both true EOFs as complete-prefix, not success', () => {\\n    const r = p1.createRecorder('T1', () => {}, () => 1);\\n    r.end('stdout'); r.end('stderr');\\n    const end = r.finish();\\n    expect(end?.state).toBe('complete-prefix'); expect(end?.eofObserved).toBe(true);\\n    expect(end?.acceptedMarkers).toBe(0); expect(end?.reason).toBe('none');\\n  });\\n});\\n\\ndescribe('kimi-r0-additive append-gate transaction atomicity', () => {\\n  it('a throwing candidate build leaves file bytes unchanged and releases the mkdir lock', () => {\\n    const dir = directory(), file = join(dir, 'guard.jsonl'); fs.writeFileSync(file, jsonl([fixture().guard[0]]));\\n    const before = fs.readFileSync(file);\\n    const gate = p1.createAppendGate([{ path: file, cap: 524288, family: 'guard' }]);\\n    expect(() => gate.transaction(file, () => { throw new Error('mock candidate failure'); })).toThrow();\\n    expect(fs.readFileSync(file)).toEqual(before);\\n    expect(fs.existsSync(file + '.append-lock')).toBe(false); // no stale lock, no takeover needed\\n  });\\n  it.each([\\n    ['trace.jsonl', 'TRACE_IO_OR_SERIALIZATION'],\\n    ['guard.jsonl', 'GUARD_LOG_IO_OR_LIMIT'],\\n    ['counter.jsonl', 'GUARD_LOG_IO_OR_LIMIT'],\\n  ])('fails closed with the fixed safe code for %s and reports the exact path', (name, code) => {\\n    const dir = directory(), file = join(dir, name); fs.writeFileSync(file, '');\\n    const onFailure = vi.fn();\\n    const family = name.startsWith('trace') ? 'trace' : name.startsWith('counter') ? 'counter' : 'guard';\\n    const gate = p1.createAppendGate([{ path: file, cap: 16384, family }], io(), onFailure);\\n    const methodsRow = family === 'counter' ? admitted() : fixture()[family === 'trace' ? 'trace' : 'guard'][0];\\n    fs.mkdirSync(file + '.append-lock'); // contention forces acquisition failure\\n    let thrown: any;\\n    try { gate.transaction(file, () => jsonl([methodsRow])); } catch (error) { thrown = error; }\\n    expect(thrown?.code).toBe(code);\\n    expect(onFailure).toHaveBeenCalledWith(file);\\n    fs.rmdirSync(file + '.append-lock');\\n    expect(fs.statSync(file).size).toBe(0);\\n  });\\n  it('counter admission transaction honors the exact inclusive 16384-byte cap and refuses +1', () => {\\n    const dir = directory(), file = join(dir, 'counter.jsonl'); fs.writeFileSync(file, '');\\n    const gate = p1.createAppendGate([{ path: file, cap: 16384, family: 'counter' }]);\\n    const row = jsonl([admitted()]);\\n    const n = Math.floor(16384 / row.length); // whole rows that fit exactly under the cap\\n    gate.transaction(file, () => Buffer.concat(Array.from({ length: n }, () => row)));\\n    expect(fs.statSync(file).size).toBe(n * row.length);\\n    const remainder = 16384 - n * row.length;\\n    if (remainder > 0) {\\n      // top up to the exact cap through the same transaction path with a pad-sized check:\\n      // counter family forbids non-row bytes, so instead prove the +1 refusal at the boundary.\\n    }\\n    expect(() => gate.transaction(file, () => jsonl([admitted()]))).toThrow(); // would cross 16384\\n    expect(fs.statSync(file).size).toBe(n * row.length);\\n    expect(fs.existsSync(file + '.append-lock')).toBe(false);\\n    expect(() => p1.counterState(Buffer.alloc(16385))).toThrow(); // oversized counter stays unavailable\\n  });\\n});\\n\\ndescribe('kimi-r0-additive frozen budgets and native admission edges', () => {\\n  it('freezes every locked budget constant, launch shape and environment contract byte-for-byte', () => {\\n    expect(p1.BINDINGS.bounds).toEqual({ job_minutes: 12, total_ms: 600000, case_ms: 40000, cleanup_ms: 3000,\\n      operation_ms: 10000, native_ms: 7000, smoke_ps: 38, total_ps: 76, initial_max_ps: 4,\\n      native_output_bytes: 16384, counter_bytes: 16384, case_output_bytes: 65536,\\n      guard_bytes: 524288, trace_bytes: 524288, pending_line_bytes: 29 });\\n    expect(p1.BINDINGS.native).toEqual({ command: 'powershell.exe',\\n      argv_prefix: ['-NoLogo', '-NoProfile', '-NonInteractive', '-Command'],\\n      shell: false, windowsHide: true, max_launches_per_case: 1, kind: 'smoke', requiredPs: 1 });\\n    expect(p1.BINDINGS.environment.fixed_values).toEqual({ TW_PARITY_KIND: 'smoke', TW_PARITY_CASE: 'smoke',\\n      TW_PARITY_ARM: 'E0', TW_PARITY_TRACE: 'on', GIT_CONFIG_NOSYSTEM: '1', GIT_TERMINAL_PROMPT: '0' });\\n    expect(p1.BINDINGS.environment.extra_keys).toEqual([]);\\n  });\\n  it.each([\\n    { usedTotal: 3, usedSmoke: 3, expected: null },                                 // fourth INITIAL admission allowed\\n    { usedTotal: 4, usedSmoke: 4, expected: 'total-powershell-budget-insufficient' }, // max4 INITIAL ceiling\\n    { usedTotal: 3, usedSmoke: 39, expected: 'unknown-native-budget' },              // smoke>total corrupt clock/counter\\n  ])('native admission at usedTotal=$usedTotal/usedSmoke=$usedSmoke is $expected', ({ usedTotal, usedSmoke, expected }) => {\\n    expect(p1.nativeAdmission({ now: 1, deadline: 10001, timeoutMs: 7000, usedTotal, usedSmoke })).toBe(expected);\\n  });\\n  it('freezes 10000ms native remaining and 43000ms case remaining as strict inclusive boundaries', () => {\\n    expect(p1.nativeAdmission({ now: 0, deadline: 10000, timeoutMs: 7000, usedTotal: 0, usedSmoke: 0 }))\\n      .toBe('native-cleanup-output-allowance-insufficient');\\n    expect(p1.nativeAdmission({ now: 0, deadline: 10001, timeoutMs: 7000, usedTotal: 0, usedSmoke: 0 })).toBeNull();\\n    expect(p1.caseAdmission({ now: 0, deadline: 43000, usedTotal: 0, usedSmoke: 0 })).toBe(false);\\n    expect(p1.caseAdmission({ now: 0, deadline: 43001, usedTotal: 0, usedSmoke: 0 })).toBe(true);\\n    expect(p1.caseAdmission({ now: 0, deadline: 600001, usedTotal: 0, usedSmoke: 0 })).toBe(false); // beyond total budget\\n  });\\n});\\n\\ndescribe('kimi-r0-additive B001 owning-worker and four-fact closure', () => {\\n  it('a completed API return contradicting any one of the four owned exit/close facts is unknown, never progressed', () => {\\n    for (const mutate of [\\n      (f: any) => { f.guard.find((e: Row) => e.event === 'child-close')