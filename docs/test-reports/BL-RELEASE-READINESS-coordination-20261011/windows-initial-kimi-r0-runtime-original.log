gnal }));\n407\t    let recorder = null;\n408\t    if (exe === 'powershell.exe') {\n409\t      const matched = matchNativeIdentity({ root, command, args, options, argv: process.argv, childPid: child.pid });\n410\t      if (!matched) fail('GUARD_UNSAFE_METADATA');\n411\t      else {\n412\t        recorder = attachNativeRecorder(child, { root, command, args, options, argv: process.argv }, log);\n413\t        recorders.add(recorder);\n414\t        if (!child.stdout || !child.stderr) fail('GUARD_UNSAFE_METADATA');\n415\t      }\n416\t    }\n417\t    child.on('close', (status, signal) => {\n418\t      recorder?.finish(); if (recorder) recorders.delete(recorder);\n419\t      children.delete(child); log({ event: 'child-close', executable: exe, childPid: child.pid ?? null, status, signal });\n420\t    });\n421\t    return child;\n422\t  };\n423\t  cp.spawnSync = function (command, args, options) {\n424\t    if (executable(command) === 'powershell.exe') {\n425\t      log({ event: 'diagnostic-budget-abort', reason: 'unexpected-synchronous-powershell' });\n426\t      throw Object.assign(new Error('diagnostic budget unavailable'), { code: 'TW_PARITY_BUDGET' });\n427\t    }\n428\t    if (command === process.execPath && args?.[0] === workerPath) {\n429\t      try {\n430\t        const p = JSON.parse(args[1]), c = CASES.find(c => basename(root) === c.caseId);\n431\t        assert(c && exact(p, ['command', 'args', 'timeoutMs', 'maxOutputBytes', 'cwd', 'cleanupMs']) &&\n432\t          p.command === 'powershell.exe' && same(p.args, nativeArgs(c)) && p.cwd === root && p.timeoutMs === BOUNDS.native_ms &&\n433\t          p.maxOutputBytes === BOUNDS.native_output_bytes && p.cleanupMs === 1000 && options?.env?.TW_ROOT === root);\n434\t      } catch { fail('GUARD_UNSAFE_METADATA'); throw Object.assign(new Error('diagnostic ownership unavailable'), { code: 'TW_PARITY_BUDGET' }); }\n435\t    }\n436\t    const result = originalSync.call(this, command, args, options), code = safeCode(result.er