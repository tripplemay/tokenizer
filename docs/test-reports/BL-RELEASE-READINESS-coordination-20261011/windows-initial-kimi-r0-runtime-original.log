t(s.record.diagnostic_observation_complete).toBe(false);\\n      expect(p1.selection(s.record).action).toBe('stop-unknown');\\n      expect(s.remove).not.toHaveBeenCalled();\\n      expect(fs.existsSync(s.root)).toBe(true);\\n    }\\n  });\\n  it('recognized ESRCH absence on every observed PID keeps cleanup known and removes the root', async () => {\\n    const s = await actualCaseWithMocks(fixture('T2', 'timeout', 1), () => ({ code: 'ESRCH' }));\\n    expect(s.record.health).toMatchObject({ cleanupUnknown: false, rootRetained: false,\\n      possibleLiveAtReturn: [], possibleLiveAfterOwnedCap: [] });\\n    expect(s.record.diagnostic_observation_complete).toBe(true);\\n    expect(p1.selection(s.record).action).toBe('run-T3');\\n    expect(s.remove).toHaveBeenCalledOnce();\\n    expect(fs.existsSync(s.root)).toBe(false);\\n  });\\n});\\n\\ndescribe('kimi-r0-additive PS003 runRoot symbol path reaches the launcher', () => {\\n  it('the actual runCase passes case, exact owned root path, fixed env and derived deadlines to runRoot', async () => {\\n    const s = await actualCaseWithMocks(fixture('T1', 'refused', 0), () => ({ code: 'ESRCH' }));\\n    expect(s.launch).toHaveBeenCalledOnce();\\n    const [caseArg, rootArg, envArg, caseDeadlineArg, deadlineArg] = s.launch.mock.calls[0];\\n    expect(caseArg).toBe(s.c);                                  // the fixed case row object itself\\n    expect(rootArg).toBe(join(s.runDirectory, s.c.caseId));     // actual root-path symbol, not a fixture shortcut\\n    expect(envArg).toEqual({});                                 // exactly what the fixedEnvironment mock returned\\n    expect(caseDeadlineArg).toBe(Math.min(1 + 40000, 600001 - 3000)); // derived from frozen 40000/3000 budgets\\n    expect(deadlineArg).toBe(600001);\\n    // fixedEnvironment independently observes the same root/run-root pair (no shadowed symbol):\\n    expect(s.environment.mock.calls[0][1]).toBe(join(s.runDirectory, s.c.caseId));\\n    expect(s.environment.m