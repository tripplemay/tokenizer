{"role":"tool","tool_call_id":"tool_Bd4SlcnJ1NKbUrkcudYiuvNw","content":"1\timport { afterAll, describe, expect, it, vi } from 'vitest';\n2\timport fs from 'node:fs';\n3\timport cp from 'node:child_process';\n4\timport { EventEmitter } from 'node:events';\n5\timport { join, resolve } from 'node:path';\n6\timport { pathToFileURL } from 'node:url';\n7\timport vm from 'node:vm';\n8\timport assert from 'node:assert/strict';\n9\timport * as p1 from '../../docs/test-reports/windows-p1-stages-20261010/p1-stages.mjs';\n10\t\n11\ttype Row = Record<string, any>;\n12\tconst temporary = process.env.TMPDIR ?? process.env.TEMP;\n13\tif (!temporary) throw new Error('owned test temporary base required');\n14\tconst owned = fs.mkdtempSync(join(temporary, 'wp1-synthetic-'));\n15\tafterAll(() => fs.rmSync(owned, { recursive: true, force: true }));\n16\tconst repo = resolve('.');\n17\tconst jsonl = (rows: Row[]) => Buffer.from(rows.map(r => JSON.stringify(r) + '\\n').join(''));\n18\tconst clone = <T>(v: T): T => JSON.parse(JSON.stringify(v));\n19\tconst scriptBytes = (variant: string, count?: number, newline = '\\n') => {\n20\t  const c = p1.CASES.find(c => c.variant === variant)!;\n21\t  return Buffer.from(c.sequence.slice(0, count ?? c.sequence.length).map(m => p1.BINDINGS.tokens[m] + newline).join(''));\n22\t};\n23\tfunction recordStream(variant: string, chunks: Buffer[], eof = true) {\n24\t  const events: Row[] = [];\n25\t  let time = 0;\n26\t  const r = p1.createRecorder(variant, event => events.push(event), () => time++);\n27\t  for (const chunk of chunks) r.feed('stdout', chunk);\n28\t  if (eof) { r.end('stdout'); r.end('stderr'); }\n29\t  const end = r.finish();\n30\t  return { events, end, markers: r.markers, recorder: r };\n31\t}\n32\tfunction fixture(variant = 'T1', outcome = 'completed', count?: number): any {\n33\t  const c = p1.CASES.find(c => c.variant === variant)!;\n34\t  const markers = c.sequence.slice(0, count ?? c.sequence.length);\n35\t  const status = outcome === 'refused' ? 1 : outcome === 'timeout' ? null : 0;\n36\t  const signal = outcome === 'timeout' ? 'SIGKILL' : null;\n37\t  const bytes = scriptBytes(variant, markers.length).length;\n38\t  const guard: Row[] = [\n39\t    { pid: 100, sequence: 0, at: 1, event: 'guard-preload', commonBudgetGuardOn: true, oldTracePreloadOn: true },\n40\t    { pid: 200, sequence: 0, at: 1, event: 'guard-preload', commonBudgetGuardOn: true, oldTracePreloadOn: true },\n41\t    { pid: 200, sequence: 1, at: 1, event: 'spawn', executable: 'powershell.exe', childPid: 300, detached: false },\n42\t    ...markers.map((marker, ordinal) => ({ pid: 200, sequence: 2 + ordinal, at: 1, event: 'native-fixed-stage', childPid: 300,\n43\t      variant, marker, ordinal, arrivalElapsedMs: ordinal + 1 })),\n44\t    { pid: 200, sequence: 2 + markers.length, at: 1, event: 'child-exit', executable: 'powershell.exe', childPid: 300, status, signal },\n45\t    { pid: 200, sequence: 3 + markers.length, at: 1, event: 'native-fixed-stream-end', childPid: 300, variant, stdoutBytes: bytes, stderrBytes: 0,\n46\t      combinedBytes: bytes, acceptedMarkers: markers.length, stdoutEofObserved: true, stderrEofObserved: true, eofObserved: true,\n47\t      state: markers.length === c.sequence.length ? 'complete-sequence' : 'complete-prefix', reason: 'none' },\n48\t    { pid: 200, sequence: 4 + markers.length, at: 1, event: 'child-close', executable: 'powershell.exe', childPid: 300, status, signal },\n49\t    { pid: 100, sequence: 1, at: 1, event: 'spawn-sync', executable: 'node', childPid: 200, status: 0, signal: null, code: null }\n50\t  ];\n51\t  const trace: Row[] = [\n52\t    { pid: 100, sequence: 0, at: 1, monotonicMs: 1, event: 'preload', node: 'v22.22.0', uv: '1.51.0' },\n53\t    { pid: 200, sequence: 0, at: 1, monotonicMs: 1, event: 'preload', node: 'v22.22.0', uv: '1.51.0' },\n54\t    { pid: 200, sequence: 1, at: 1, monotonicMs: 1, event: 'spawn', executable: 'powershell.exe', childPid: 300, detached: false },\n55\t    { pid: 200, sequence: 2, at: 1, monotonicMs: 1, event: 'child-exit', executable: 'powershell.exe', childPid: 300, status, signal },\n56\t    { pid: 200, sequence: 3, at: 1, monotonicMs: 1, event: 'child-close', executable: 'powershell.exe', childPid: 300, status, signal },\n57\t    { pid: 100, sequence: 1, at: 1, monotonicMs: 1, event: 'spawn-sync', executable: 'node', childPid: 200, elapsedMs: 1,\n58\t      status: 0, signal: null, code: null, workerKind: outcome === 'timeout' ? 'timeout' : 'ok' }\n59\t  ];\n60\t  const native = { outcome, metadataSource: outcome === 'timeout' ? 'api-throw' : 'api-return', status: outcome === 'timeout' ? null : status,\n61\t    signal: null, errorName: outcome === 'timeout' ? 'BoundedSubprocessTimeoutError' : null, errorCode: null,\n62\t    elapsedMs: 1, workerKind: outcome === 'timeout' ? 'timeout' : 'ok' };\n63\t  return { variant, guard, trace, launches: 1, counterKnown: true,\n64\t    probe: { format: 'windows-p1-initial-probe-v1', variant, caseId: c.caseId, scriptSha256: c.scriptSha256,\n65\t      probeSetupComplete: true, native, releaseAcceptance: false },\n66\t    root: { pid: 100, status: 0, signal: null, metadataUnknown: false, stopped: false, stopReason: null, launchCode: null,\n67\t      stdoutBytes: 256, stderrBytes: 0, outputBoundExceeded: false, canaryFound: false },\n68\t    health: { expectedPids: [100, 200], guardComplete: true, traceComplete: true, guardInvalid: false, traceInvalid: false,\n69\t      diagnosticAbortReasons: [], provenanceUnknown: false, cleanupUnknown: false, possibleLiveAtReturn: [], possibleLiveAfterOwnedCap: [],\n70\t      rootRetained: false, historicalPidsSignalled: false, wholeTreeAbsenceProven: false } };\n71\t}\n72\tconst directory = () => fs.mkdtempSync(join(owned, 'case-'));\n73\tconst io = () => Object.fromEntries(['mkdirSync', 'rmdirSync', 'lstatSync', 'fstatSync', 'openSync', 'readFileSync', 'readSync',\n74\t  'writeSync', 'writeFileSync', 'closeSync', 'appendFileSync', 'realpathSync', 'readdirSync', 'rmSync'].map(k => [k, (fs as any)[k].bind(fs)]));\n75\tconst admitted = () => ({ event: 'powershell-admission', kind: 'smoke' });\n76\t\n77\tasync function actualCaseWithMocks(f: any, errorFor: (pid: number, sample: number) => unknown) {\n78\t  const output = directory(), runDirectory = join(output, 'run-root');\n79\t  fs.mkdirSync(runDirectory); fs.writeFileSync(join(runDirectory, 'counter.jsonl'), '');\n80\t  const c = p1.CASES.find(c => c.variant === f.variant)!;\n81\t  const source = fs.readFileSync(join(repo, 'docs/test-reports/windows-p1-stages-20261010/p1-stages.mjs'), 'utf8');\n82\t  const start = source.indexOf('async function runCase('), end = source.indexOf('function retainedRoots(', start);\n83\t  const processesStart = source.indexOf('function expectedProcesses('), processesEnd = source.indexOf('async function runRoot(', processesStart);\n84\t  expect(start).toBeGreaterThanOrEqual(0); expect(end).toBeGreaterThan(start);\n85\t  expect(processesStart).toBeGreaterThanOrEqual(0); expect(processesEnd).toBeGreaterThan(processesStart);\n86\t  const query = vi.fn((pid: number, signal: number) => {\n87\t    expect(signal).toBe(0);\n88\t    const error = errorFor(pid, Math.floor((query.mock.calls.length - 1) / 3));\n89\t    if (error) throw error;\n90\t    return true;\n91\t  });\n92\t  const remove = vi.fn(fs.rmSync.bind(fs));\n93\t  const launch = vi.fn(async (_case: any, root: string) => {\n94\t    fs.writeFileSync(join(root, 'guard.jsonl'), jsonl(f.guard)); fs.writeFileSync(join(root, 'trace.jsonl'), jsonl(f.trace));\n95\t    fs.appendFileSync(join(runDirectory, 'counter.jsonl'), jsonl([admitted()]));\n96\t    return { root: f.root, probe: f.probe };\n97\t  });\n98\t  const environment = vi.fn((_system: Row, _root: string, _runDirectory: string, _caseDeadline: number, _deadline: number) => ({}));\n99\t  // Dependencies are injected only in the test VM; the actual runCase body is evaluated without transformation.\n100\t  const context = vm.createContext({ join, assert, Date: { now: () => 1 }, Math, Boolean, performance: { now: () => 0 },\n101\t    setTimeout: (done: () => void) => done(), BOUNDS: p1.BOUNDS, scratch: output,\n102\t    original: { ...io(), rmSync: remove }, process: { kill: query }, runRoot: launch, fixedEnvironment: environment,\n103\t    pid: (p: number) => Number.isSafeInteger(p) && p > 0 && p <= 0xffffffff,\n104\t    readOwned: (path: string, cap: number) => { const bytes = fs.readFileSync(path); assert(bytes.length <= cap); return bytes; },\n105\t    readRows: (path: string, family: string) => p1.parseRows(fs.readFileSync(path), family,\n106\t      family === 'counter' ? p1.BOUNDS.counter_bytes : p1.BOUNDS.guard_bytes),\n107\t    healthStates: () => ({ complete: true, invalid: false }), sorted: (values: string[]) => [...new Set(values)].sort(),\n108\t    counterState: p1.counterState, caseAdmission: p1.caseAdmission, evaluateCase: p1.evaluateCase,\n109\t    unknownCase: p1.unknownCase, skippedCase: p1.skippedCase,\n110\t    writeText: (path: string, text: string) => fs.writeFileSync(path, text) });\n111\t  vm.runInContext(source.slice(processesStart, processesEnd) + source.slice(start, end), context,\n112\t    { filename: 'unchanged-actual-runCase-test-vm.mjs' });\n113\t  const record = await context.runCase(c, runDirectory, 600001, {});\n114\t  return { record, query, launch, remove, environment, root: join(runDirectory, c.caseId), output, runDirectory };\n115\t}\n116\t\n117\tdescribe('all-token-chunk-splits-and-LF-CRLF', () => {\n118\t  it('accepts every split of every complete fixed sequence and byte-at-a-time coalescing', () => {\n119\t    for (const c of p1.CASES) for (const newline of ['\\n', '\\r\\n']) {\n120\t      const bytes = scriptBytes(c.variant, undefined, newline);\n121\t      for (let split = 0; split <= bytes.length; split++) {\n122\t        const r = recordStream(c.variant, [bytes.subarray(0, split), bytes.subarray(split)]);\n123\t        expect(r.markers).toEqual(c.sequence); expect(r.end?.state).toBe('complete-sequence');\n124\t      }\n125\t      expect(recordStream(c.variant, [...bytes].map(b => Buffer.from([b]))).markers).toEqual(c.sequence);\n126\t    }\n127\t  });\n128\t  it('keeps arrival ordinals monotonic, enum-only and within the fixed lifetime', () => {\n129\t    const r = recordStream('T3', [scriptBytes('T3')]);\n130\t    expect(r.events.filter(e => e.event === 'native-fixed-stage').map(e => e.ordinal)).toEqual([0, 1, 2, 3, 4]);\n131\t    expect(JSON.stringify(r.events)).not.toContain('TW_P1_STAGE');\n132\t    expect(r.events.every(e => e.arrivalElapsedMs === undefined || e.arrivalElapsedMs <= 40000)).toBe(true);\n133\t  });\n134\t});\n135\t\n136\tdescribe('timeout-prefix-immediate-safe-persistence', () => {\n137\t  it('persists a prefix synchronously before a mock worker timeout discards stdout', () => {\n138\t    const stored: Row[] = [];\n139\t    const r = p1.createRecorder('T2', event => stored.push(event), () => 1);\n140\t    r.feed('stdout', scriptBytes('T2', 1));\n141\t    expect(stored.map(e => e.marker)).toEqual(['json-enter']);\n142\t    const mockWorkerResult = { kind: 'timeout' };\n143\t    expect(mockWorkerResult).not.toHaveProperty('stdout');\n144\t    r.end('stdout'); r.end('stderr'); r.finish();\n145\t    expect(stored.at(-1)?.state).toBe('complete-prefix');\n146\t    expect(p1.evaluateCase(fixture('T2', 'timeout', 1)).native_completed).toBe(false);\n147\t  });\n148\t  it('does not duplicate stream-end at close and safe finalization', () => {\n149\t    const r = recordStream('T0', [scriptBytes('T0')]);\n150\t    expect(r.recorder.finish()).toBeNull();\n151\t    expect(r.events.filter(e => e.event === 'native-fixed-stream-end')).toHaveLength(1);\n152\t  });\n153\t});\n154\t\n155\tdescribe('missing-EOF-event-health-or-stream-error', () => {\n156\t  it.each(['stdout', 'stderr'])('requires actual %s end rather than close or destroy', missing => {\n157\t    const stored: Row[] = [];\n158\t    const r = p1.createRecorder('T0', e => stored.push(e), () => 1);\n159\t    r.feed('stdout', scriptBytes('T0')); r.end(missing === 'stdout' ? 'stderr' : 'stdout');\n160\t    expect(r.finish()?.state).toBe('unknown'); expect(stored.at(-1)?.reason).toBe('eof-not-observed');\n161\t  });\n162\t  it('preserves stream errors even with complete markers and both EOFs', () => {\n163\t    const r = recordStream('T0', [scriptBytes('T0')], false); r.recorder.error();\n164\t    // Finish was already emitted; a fresh error-bearing stream models the pre-close boundary.\n165\t    const x = p1.createRecorder('T0', () => {}, () => 1);\n166\t    x.feed('stdout', scriptBytes('T0')); x.error(); x.end('stdout'); x.end('stderr');\n167\t    expect(x.finish()?.reason).toBe('stream-error');\n168\t  });\n169\t  it('missing stream-end and either health stream block progression independently', () => {\n170\t    for (const mutate of [\n171\t      (f: any) => { f.guard = f.guard.filter((r: Row) => r.event !== 'native-fixed-stream-end'); },\n172\t      (f: any) => { f.health.guardComplete = false; }, (f: any) => { f.health.traceComplete = false; },\n173\t      (f: any) => { f.health.expectedPids = []; }\n174\t    ]) {\n175\t      const f = fixture('T1', 'timeout', 0); mutate(f);\n176\t      const r = p1.evaluateCase(f); expect(r.diagnostic_observation_complete).toBe(false); expect(p1.selection(r).action).toBe('stop-unknown');\n177\t    }\n178\t  });\n179\t  it.each(['stdout', 'stderr'])('retains parser invalidity and actual missing %s EOF as separate facts', missing => {\n180\t    for (const [bytes, reason] of [[Buffer.from('\\n'), 'unexpected-bytes'], [Buffer.alloc(16385, 65), 'native-output-cap']] as const) {\n181\t      const r = p1.createRecorder('T1', () => {}, () => 1);\n182\t      r.feed('stdout', bytes); r.end(missing === 'stdout' ? 'stderr' : 'stdout');\n183\t      const end = r.finish();\n184\t      expect(end.state).toBe('invalid'); expect(end.reason).toBe(reason); expect(end.eofObserved).toBe(false);\n185\t      expect(end.stdoutEofObserved).toBe(missing !== 'stdout'); expect(end.stderrEofObserved).toBe(missing !== 'stderr');\n186\t    }\n187\t  });\n188\t});\n189\t\n190\tdescribe('unsafe-bytes-canaries-stderr-and-order', () => {\n191\t  it.each(['\\uFEFF', '\\n', ' ', 'RAW-STDERR-CANARY', 'TW_RAW_CONTENT_CANARY', 'PRIVATE-reader', '\\u00e9', '\\0', '\\r'])('rejects unsafe literal %j without a raw fallback', value => {\n192\t    const r = recordStream('T2', [Buffer.from(value)]);\n193\t    expect(['invalid', 'unknown']).toContain(r.end?.state);\n194\t    expect(JSON.stringify(r.events)).not.toContain('CANARY'); expect(r.markers).toEqual([]);\n195\t  });\n196\t  it('rejects unterminated, duplicate, reordered and wrong-variant tokens', () => {\n197\t    expect(recordStream('T0', [Buffer.from(p1.BINDINGS.tokens['writer-ok'])]).end?.reason).toBe('unterminated-line');\n198\t    for (const bytes of [scriptBytes('T0'), Buffer.from(p1.BINDINGS.tokens['json-done'] + '\\n'), scriptBytes('T3', 1)])\n199\t      expect(recordStream('T2', [bytes]).end?.state).toBe('invalid');\n200\t    expect(recordStream('T0', [Buffer.concat([scriptBytes('T0'), scriptBytes('T0')])]).end?.reason).toBe('order-or-duplicate');\n201\t  });\n202\t  it('counts all rejected bytes and stderr, stops accepting later markers and retains the first violation', () => {\n203\t    const events: Row[] = [], r = p1.createRecorder('T0', e => events.push(e), () => 1);\n204\t    r.feed('stdout', Buffer.from('\\n')); r.feed('stdout', scriptBytes('T0')); r.feed('stderr', Buffer.from('x'));\n205\t    r.end('stdout'); r.end('stderr'); const end = r.finish();\n206\t    expect(r.markers).toEqual([]); expect(end?.combinedBytes).toBe(scriptBytes('T0').length + 2); expect(end?.stderrBytes).toBe(1);\n207\t    expect(end?.reason).toBe('unexpected-bytes');\n208\t    expect(events.every(e => !Object.hasOwn(e, 'stdout') && !Object.hasOwn(e, 'stderr'))).toBe(true);\n209\t  });\n210\t  it('rejects non-Buffer chunks and oversized pending lines without unbounded accumulation', () => {\n211\t    const r = p1.createRecorder('T0', () => {}, () => 1);\n212\t    r.feed('stdout', 'not-a-Buffer' as any); r.end('stdout'); r.end('stderr'); expect(r.finish()?.state).toBe('unknown');\n213\t    expect(recordStream('T0', [Buffer.alloc(30, 65)]).end?.state).toBe('invalid');\n214\t  });\n215\t});\n216\t\n217\tdescribe('handle-pid-case-script-identity', () => {\n218\t  function context(variant = 'T2'): any {\n219\t    const c = p1.CASES.find(c => c.variant === variant)!;\n220\t    const root = join(owned, c.caseId), args = [...p1.BINDINGS.native.argv_prefix, c.script];\n221\t    return { root, command: 'powershell.exe', args, options: { cwd: root, stdio: ['ignore', 'pipe', 'pipe'], windowsHide: true, detached: false, shell: false },\n222\t      argv: [process.execPath, join(repo, 'src/cli/bounded-subprocess-worker.mjs'), JSON.stringify({ command: 'powershell.exe', args,\n223\t        timeoutMs: 7000, maxOutputBytes: 16384, cwd: root, cleanupMs: 1000 })], childPid: 300 };\n224\t  }\n225\t  it('matches only exact worker/script/case/options/positive owned PID', () => {\n226\t    expect(p1.matchNativeIdentity(context())?.variant).toBe('T2');\n227\t    for (const mutate of [\n228\t      (c: any) => { c.command = 'node'; }, (c: any) => { c.root += '-other'; }, (c: any) => { c.args[4] += ' '; },\n229\t      (c: any) => { c.argv[1] = join(repo, 'other.mjs'); }, (c: any) => { c.childPid = 0; },\n230\t      (c: any) => { c.options.shell = true; }, (c: any) => { c.options.windowsHide = false; },\n231\t      (c: any) => { const p = JSON.parse(c.argv[2]); p.timeoutMs = 7001; c.argv[2] = JSON.stringify(p); },\n232\t      (c: any) => { const p = JSON.parse(c.argv[2]); p.extra = true; c.argv[2] = JSON.stringify(p); }\n233\t    ]) { const c = context(); mutate(c); expect(p1.matchNativeIdentity(c)).toBeNull(); }\n234\t  });\n235\t  it('attaches additive Buffer listeners before returning without touching existing listeners or worker stdout', () => {\n236\t    const child: any = new EventEmitter(); child.pid = 300; child.stdout = new EventEmitter(); child.stderr = new EventEmitter();\n237\t    const existing = vi.fn(); child.stdout.on('data', existing);\n238\t    const persisted: Row[] = [], observer = p1.attachNativeRecorder(child, context(), e => persisted.push(e), () => 1);\n239\t    expect(observer).not.toBeNull(); expect(child.stdout.listeners('data')).toContain(existing);\n240\t    const chunk = scriptBytes('T2', 1); child.stdout.emit('data', chunk);\n241\t    expect(existing).toHaveBeenCalledWith(chunk); expect(persisted[0]?.marker).toBe('json-enter');\n242\t    child.stdout.emit('end'); child.stderr.emit('end'); child.emit('close', null, 'SIGKILL');\n243\t    expect(persisted.at(-1)?.eofObserved).toBe(true);\n244\t    expect(child.stdout).not.toHaveProperty('setEncoding'); expect(child.stdout).not.toHaveProperty('read');\n245\t    const wrong: any = new EventEmitter(); wrong.pid = 0; wrong.stdout = new EventEmitter(); wrong.stderr = new EventEmitter();\n246\t    expect(p1.attachNativeRecorder(wrong, context(), () => {})).toBeNull(); expect(wrong.stdout.listenerCount('data')).toBe(0);\n247\t  });\n248\t});\n249\t\n250\tdescribe('all-inclusive-caps-and-plus-one', () => {\n251\t  it('uses native combined overflow sentinel and independent saturated counts including rejected bytes', () => {\n252\t    for (const length of [16384, 16385, 32768]) {\n253\t      const events: Row[] = [], r = p1.createRecorder('T0', e => events.push(e), () => 1);\n254\t      r.feed('stdout', Buffer.alloc(length, 65)); r.feed('stderr', Buffer.alloc(0)); r.end('stdout'); r.end('stderr');\n255\t      const end = r.finish(); expect(end?.stdoutBytes).toBe(16384); expect(end?.combinedBytes).toBe(Math.min(length, 16385));\n256\t      expect(end?.reason).toBe(length === 16384 ? 'unexpected-bytes' : 'native-output-cap');\n257\t    }\n258\t    const r = p1.createRecorder('T0', () => {}, () => 1);\n259\t    r.feed('stdout', Buffer.alloc(8192)); r.feed('stderr', Buffer.alloc(8193)); r.end('stdout'); r.end('stderr');\n260\t    expect(r.finish()).toMatchObject({ stdoutBytes: 8192, stderrBytes: 8193, combinedBytes: 16385, reason: 'native-output-cap' });\n261\t  });\n262\t  it('keeps exact root/native inclusive count and +1 semantics', () => {\n263\t    for (const cap of [16384, 65536]) {\n264\t      let counts = p1.countBytes({ stdoutBytes: 0, stderrBytes: 0, combinedBytes: 0 }, 'stdout', cap - 1, cap);\n265\t      counts = p1.countBytes(counts, 'stderr', 1, cap); expect(counts.combinedBytes).toBe(cap);\n266\t      counts = p1.countBytes(counts, 'stderr', 1, cap); expect(counts.combinedBytes).toBe(cap + 1);\n267\t    }\n268\t  });\n269\t  it.each(['guard', 'trace', 'counter'])('checks exact %s read cap and cap+1, rather than a pre-append size check', family => {\n270\t    const row = family === 'counter' ? admitted() : fixture().guard[0];\n271\t    const bytes = jsonl([family === 'trace' ? fixture().trace[0] : row]);\n272\t    expect(p1.parseRows(bytes, family, bytes.length).invalid).toBe(false);\n273\t    expect(p1.parseRows(bytes, family, bytes.length - 1).invalid).toBe(true);\n274\t  });\n275\t  it('allows exact aggregate append size and refuses a candidate crossing it', () => {\n276\t    const dir = directory(), file = join(dir, 'guard.jsonl'); fs.writeFileSync(file, '');\n277\t    const a = fixture().guard[0], b = { ...a, sequence: 1 };\n278\t    const bytes = jsonl([a, b]), gate = p1.createAppendGate([{ path: file, cap: bytes.length, family: 'guard' }]);\n279\t    gate.append(file, jsonl([a])); gate.append(file, jsonl([b])); expect(fs.statSync(file).size).toBe(bytes.length);\n280\t    expect(() => gate.append(file, jsonl([{ ...b, sequence: 2 }]))).toThrow(); expect(fs.statSync(file).size).toBe(bytes.length);\n281\t    expect(() => gate.append(join(dir, 'other.jsonl'), 'x')).toThrow();\n282\t  });\n283\t  it.each(['guard', 'trace'])('enforces the actual 524288-byte %s cap with canonical rows', family => {\n284\t    const cap = 524288, rows: Row[] = [];\n285\t    let bytes = 0;\n286\t    for (let sequence = 0; ; sequence++) {\n287\t      const row = family === 'guard' ? { ...fixture().guard[0], sequence, at: 0 } : { ...fixture().trace[0], sequence, at: 0 };\n288\t      const length = jsonl([row]).length;\n289\t      if (bytes + length > cap) break;\n290\t      rows.push(row); bytes += length;\n291\t    }\n292\t    let remainder = cap - bytes;\n293\t    for (const row of rows) {\n294\t      if (!remainder) break;\n295\t      const delta = Math.min(remainder, 15); row.at = Number('1'.repeat(delta + 1)); remainder -= delta;\n296\t    }\n297\t    const input = jsonl(rows); expect(input.length).toBe(cap); expect(remainder).toBe(0);\n298\t    const dir = directory(), file = join(dir, family + '.jsonl'); fs.writeFileSync(file, '');\n299\t    const gate = p1.createAppendGate([{ path: file, cap, family }]); gate.append(file, input); expect(fs.statSync(file).size).toBe(cap);\n300\t    expect(p1.parseRows(input, family).invalid).toBe(false);\n301\t    expect(p1.parseRows(Buffer.concat([input, Buffer.from('x')]), family).invalid).toBe(true);\n302\t    expect(() => gate.append(file, jsonl([{ ...rows[0], sequence: rows.length }]))).toThrow();\n303\t  });\n304\t});\n305\t\n306\tdescribe('concurrent-append-and-lock-failure', () => {\n307\t  it('atomic mkdir contention aborts once, does not wait/retry and does not remove another writer lock', () => {\n308\t    const dir = directory(), file = join(dir, 'guard.jsonl'); fs.writeFileSync(file, '');\n309\t    const methods = io(), mkdir = vi.fn(methods.mkdirSync); methods.mkdirSync = mkdir;\n310\t    const fail = vi.fn(), gate = p1.createAppendGate([{ path: file, cap: 524288, family: 'guard' }], methods, fail);\n311\t    fs.mkdirSync(file + '.append-lock');\n312\t    expect(() => gate.append(file, jsonl([fixture().guard[0]]))).toThrow();\n313\t    expect(mkdir).toHaveBeenCalledTimes(1); expect(fail).toHaveBeenCalledTimes(1); expect(fs.existsSync(file + '.append-lock')).toBe(true);\n314\t    expect(fs.statSync(file).size).toBe(0);\n315\t  });\n316\t  it('reentrant aggregate writer cannot slip past the held lock', () => {\n317\t    const dir = directory(), file = join(dir, 'guard.jsonl'); fs.writeFileSync(file, '');\n318\t    const methods = io(), write = methods.writeSync; let attempted = false; let nested: unknown;\n319\t    const gate = p1.createAppendGate([{ path: file, cap: 524288, family: 'guard' }], methods);\n320\t    methods.writeSync = (...args: any[]) => {\n321\t      if (!attempted) { attempted = true; try { gate.append(file, jsonl([fixture().guard[0]])); } catch (e) { nested = e; } }\n322\t      return write(...args);\n323\t    };\n324\t    gate.append(file, jsonl([fixture().guard[0]])); expect(nested).toBeInstanceOf(Error); expect(p1.parseRows(fs.readFileSync(file), 'guard').rows).toHaveLength(1);\n325\t  });\n326\t  it.each(['partial', 'release', 'identity', 'symlink', 'read'])('fails closed on %s evidence IO with no retry', fault => {\n327\t    const dir = directory(), file = join(dir, 'guard.jsonl'); fs.writeFileSync(file, ''); const methods = io();\n328\t    const fail = vi.fn(), gate = p1.createAppendGate([{ path: file, cap: 524288, family: 'guard' }], methods, fail);\n329\t    if (fault === 'partial') methods.writeSync = () => 1;\n330\t    if (fault === 'release') methods.rmdirSync = () => { throw new Error('mock release failure'); };\n331\t    if (fault === 'read') methods.readSync = () => { throw new Error('mock read failure'); };\n332\t    if (fault === 'identity') { fs.renameSync(file, file + '.original'); fs.writeFileSync(file, ''); }\n333\t    if (fault === 'symlink') {\n334\t      const lstat = methods.lstatSync;\n335\t      methods.lstatSync = (path: string) => { const s = lstat(path); if (path === file) s.isSymbolicLink = () => true; return s; };\n336\t    }\n337\t    expect(() => gate.append(file, jsonl([fixture().guard[0]]))).toThrow(); expect(fail).toHaveBeenCalledTimes(1);\n338\t  });\n339\t  it('keeps counter parsing, limits and append inside the same exact-path transaction', () => {\n340\t    const dir = directory(), file = join(dir, 'counter.jsonl'); fs.writeFileSync(file, '');\n341\t    const gate = p1.createAppendGate([{ path: file, cap: 16384, family: 'counter' }]);\n342\t    gate.transaction(file, bytes => { expect(fs.existsSync(file + '.append-lock')).toBe(true); expect(p1.counterState(bytes).total).toBe(0); return jsonl([admitted()]); });\n343\t    expect(p1.counterState(fs.readFileSync(file)).total).toBe(1);\n344\t    expect(() => gate.append(file, jsonl([admitted()]))).toThrow();\n345\t  });\n346\t  it('old trace captures the installed exact-path append gate while unrelated targets remain untouched', () => {\n347\t    const dir = directory(), file = join(dir, 'trace.jsonl'); fs.writeFileSync(file, '');\n348\t    const row = jsonl([fixture().trace[0]]), gate = p1.createAppendGate([{ path: file, cap: row.length, family: 'trace' }]);\n349\t    const unrelated = vi.fn(), filesystem = { appendFileSync: unrelated }, sync = vi.fn();\n350\t    p1.installAppendWrapper(filesystem, gate, sync); expect(sync).toHaveBeenCalledOnce();\n351\t    const oldTraceCaptured = filesystem.appendFileSync;\n352\t    oldTraceCaptured(file, row); expect(fs.statSync(file).size).toBe(row.length);\n353\t    expect(() => oldTraceCaptured(file, row)).toThrow();\n354\t    oldTraceCaptured(join(dir, 'other.jsonl'), 'untouched'); expect(unrelated).toHaveBeenCalledOnce();\n355\t  });\n356\t});\n357\t\n358\tdescribe('counter-and-clock-admission-boundaries', () => {\n359\t  it('requires 43000ms case and 10000ms native remaining, exact 7000ms child budget and no unknown clock', () => {\n360\t    expect(p1.caseAdmission({ now: 1, deadline: 43001, usedTotal: 0, usedSmoke: 0 })).toBe(true);\n361\t    expect(p1.caseAdmission({ now: 1, deadline: 43000, usedTotal: 0, usedSmoke: 0 })).toBe(false);\n362\t    for (const now of [NaN, Infinity, -1, 0.5]) expect(p1.caseAdmission({ now, deadline: 999999, usedTotal: 0, usedSmoke: 0 })).toBe(false);\n363\t    expect(p1.nativeAdmission({ now: 1, deadline: 10001, timeoutMs: 7000, usedTotal: 0, usedSmoke: 0 })).toBeNull();\n364\t    expect(p1.nativeAdmission({ now: 1, deadline: 10000, timeoutMs: 7000, usedTotal: 0, usedSmoke: 0 })).toBe('native-cleanup-output-allowance-insufficient');\n365\t    for (const timeoutMs of [0, 6999, 7001, NaN]) expect(p1.nativeAdmission({ now: 1, deadline: 10001, timeoutMs, usedTotal: 0, usedSmoke: 0 })).toBe('unknown-native-budget');\n366\t    expect(p1.caseAdmission({ now: 1, deadline: 600002, usedTotal: 0, usedSmoke: 0 })).toBe(false);\n367\t    expect(p1.nativeAdmission({ now: 1, deadline: 40002, timeoutMs: 7000, usedTotal: 0, usedSmoke: 0 })).toBe('unknown-native-budget');\n368\t  });\n369\t  it('preserves 38/76 frozen counters, four INITIAL admissions and rejects corrupt/missing/oversized rows', () => {\n370\t    expect(p1.counterState(jsonl(Array.from({ length: 38 }, admitted))).total).toBe(38);\n371\t    expect(() => p1.counterState(jsonl(Array.from({ length: 39 }, admitted)))).toThrow();\n372\t    for (const bytes of [Buffer.from('{}\\n'), Buffer.from('\\n'), Buffer.from(''), Buffer.alloc(16385)]) {\n373\t      if (!bytes.length) expect(p1.counterState(bytes).total).toBe(0); else expect(() => p1.counterState(bytes)).toThrow();\n374\t    }\n375\t    for (const usedTotal of [4, 38, 76, 77]) expect(p1.caseAdmission({ now: 1, deadline: 43001, usedTotal, usedSmoke: Math.min(usedTotal, 38) })).toBe(false);\n376\t    expect(p1.caseAdmission({ now: 1, deadline: 43001, usedTotal: 3, usedSmoke: 3 })).toBe(true);\n377\t    expect(p1.nativeAdmission({ now: 1, deadline: 10001, timeoutMs: 7000, usedTotal: 76, usedSmoke: 38 })).not.toBeNull();\n378\t  });\n379\t});\n380\t\n381\tdescribe('cleanup-trace-provenance-independent-unknown', () => {\n382\t  it.each(['cleanupUnknown', 'provenanceUnknown', 'guardInvalid', 'traceInvalid', 'rootRetained'])('a %s flag cannot be overridden by a complete terminal', field => {\n383\t    const f = fixture('T1'); f.health[field] = true;\n384\t    const r = p1.evaluateCase(f); expect(r.diagnostic_observation_complete).toBe(false); expect(p1.selection(r).action).toBe('stop-unknown');\n385\t    expect(r.health?.[field]).toBe(true); expect(r.health?.wholeTreeAbsenceProven).toBe(false);\n386\t  });\n387\t  it('forced roots, canaries, stderr, possible-live samples and unknown counters independently block', () => {\n388\t    for (const mutate of [\n389\t      (f: any) => { f.root.stopped = true; f.root.stopReason = 'owned-case-watchdog-expired'; },\n390\t      (f: any) => { f.root.metadataUnknown = true; }, (f: any) => { f.root.canaryFound = true; },\n391\t      (f: any) => { f.root.stderrBytes = 1; }, (f: any) => { f.health.possibleLiveAfterOwnedCap = [300]; },\n392\t      (f: any) => { f.counterKnown = false; }, (f: any) => { f.launches = null; }\n393\t    ]) { const f = fixture(); mutate(f); expect(p1.evaluateCase(f).diagnostic_observation_complete).toBe(false); }\n394\t  });\n395\t  it.each(['T1', 'T2'])('actual %s case reaches the owned launcher once and accepts only ESRCH as known absence', async variant => {\n396\t    const s = await actualCaseWithMocks(fixture(variant, 'refused', variant === 'T1' ? 0 : 1), () => ({ code: 'ESRCH' }));\n397\t    expect(s.launch).toHaveBeenCalledOnce(); expect(s.query.mock.calls.map(([pid, signal]) => [pid, signal])).toEqual(\n398\t      [[100, 0], [200, 0], [300, 0], [100, 0], [200, 0], [300, 0]]);\n399\t    expect(s.environment.mock.calls[0][2]).toBe(s.runDirectory);\n400\t    expect(s.record.diagnostic_observation_complete).toBe(true);\n401\t    expect(p1.selection(s.record).action).toBe(variant === 'T1' ? 'run-T2' : 'run-T3');\n402\t    expect(s.record.health.cleanupUnknown).toBe(false); expect(s.remove).toHaveBeenCalledOnce(); expect(fs.existsSync(s.root)).toBe(false);\n403\t  });\n404\t  it.each(['T1', 'T2'])('actual %s cleanup retains every non-absence sampling error at either sample without extra queries', async variant => {\n405\t    for (const code of ['EPERM', 'EACCES', 'ENOSYS', 'UNKNOWN', undefined]) for (const uncertainSample of [0, 1]) {\n406\t      const s = await actualCaseWithMocks(fixture(variant, 'refused', variant === 'T1' ? 0 : 1),\n407\t        (pid, sample) => ({ code: pid === 300 && sample === uncertainSample ? code : 'ESRCH' }));\n408\t      expect(s.query).toHaveBeenCalledTimes(6); expect(s.query.mock.calls.every(([pid, signal]) => [100, 200, 300].includes(pid) && signal === 0)).toBe(true);\n409\t      expect(s.launch).toHaveBeenCalledOnce(); expect(s.record.health.cleanupUnknown).toBe(true);\n410\t      expect(s.record.health.rootRetained).toBe(true); expect(s.record.health.provenanceUnknown).toBe(false);\n411\t      expect(s.record.diagnostic_observation_complete).toBe(false); expect(p1.selection(s.record).action).toBe('stop-unknown');\n412\t      expect(s.remove).not.toHaveBeenCalled(); expect(fs.existsSync(s.root)).toBe(true);\n413\t    }\n414\t  });\n415\t  it.each(['T1', 'T2'])('actual %s cleanup retains independent missing EOF without erasing invalid/overflow parser facts', async variant => {\n416\t    for (const reason of ['unexpected-bytes', 'native-output-cap']) for (const missing of ['stdout', 'stderr']) {\n417\t      const f = fixture(variant, 'refused', variant === 'T1' ? 0 : 1);\n418\t      const stream = f.guard.find((e: Row) => e.event === 'native-fixed-stream-end');\n419\t      Object.assign(stream, { state: 'invalid', reason, stdoutEofObserved: missing !== 'stdout', stderrEofObserved: missing !== 'stderr', eofObserved: false });\n420\t      if (reason === 'native-output-cap') Object.assign(stream, { stdoutBytes: 16384, stderrBytes: 1, combinedBytes: 16385 });\n421\t      else { stream.stdoutBytes++; stream.combinedBytes++; }\n422\t      const originalStream = clone(stream);\n423\t      const s = await actualCaseWithMocks(f, () => ({ code: 'ESRCH' }));\n424\t      expect(s.record.stream).toEqual(originalStream); expect(s.record.stream.state).toBe('invalid'); expect(s.record.stream.reason).toBe(reason);\n425\t      expect(s.record.health.cleanupUnknown).toBe(true); expect(s.record.health.rootRetained).toBe(true);\n426\t      expect(s.record.diagnostic_observation_complete).toBe(false); expect(p1.selection(s.record).action).toBe('stop-unknown');\n427\t      expect(s.query).toHaveBeenCalledTimes(6); expect(s.launch).toHaveBeenCalledOnce(); expect(s.remove).not.toHaveBeenCalled(); expect(fs.existsSync(s.root)).toBe(true);\n428\t    }\n429\t  });\n430\t});\n431\t\n432\tdescribe('every-selection-row-zero-skipped-launches', () => {\n433\t  it('uses conservative T0/T1/T2 stop/continue rows and terminal T3 once', () => {\n434\t    expect(p1.selection(p1.evaluateCase(fixture('T0'))).action).toBe('run-T1');\n435\t    expect(p1.selection(p1.evaluateCase(fixture('T0', 'timeout', 0))).action).toBe('stop-unknown');\n436\t    expect(p1.selection(p1.evaluateCase(fixture('T1')))).toEqual({ action: 'stop', reason: 'original-p1-complete-no-reproduction' });\n437\t    for (const outcome of ['timeout', 'refused']) {\n438\t      expect(p1.selection(p1.evaluateCase(fixture('T1', outcome, 0))).action).toBe('run-T2');\n439\t      expect(p1.selection(p1.evaluateCase(fixture('T2', outcome, 1))).action).toBe('run-T3');\n440\t      for (const count of [0, 2]) expect(p1.selection(p1.evaluateCase(fixture('T2', outcome, count))).action).toBe('stop-unknown');\n441\t    }\n442\t    expect(p1.selection(p1.evaluateCase(fixture('T2'))).reason).toBe('direct-invoke-complete-no-refinement');\n443\t    expect(p1.selection(p1.unknownCase('T3')).action).toBe('stop');\n444\t  });\n445\t  it('never launches a skipped case and never fabricates zero/start=false for a missing outcome', () => {\n446\t    for (const c of p1.CASES) {\n447\t      const skip = p1.skippedCase(c.variant, 'budget-admission-denied');\n448\t      expect(skip.rootProcessStarted).toBe(false); expect(skip.nativeLaunches).toBe(0); expect(skip.root).toBeNull();\n449\t      const unknown = p1.unknownCase(c.variant); expect(unknown.rootProcessStarted).toBeNull(); expect(unknown.nativeLaunches).toBeNull();\n450\t    }\n451\t    const t0 = p1.evaluateCase(fixture('T0')), t1 = p1.evaluateCase(fixture('T1'));\n452\t    expect(p1.validateSequence([t0, t1, p1.skippedCase('T2', 'original-p1-complete-no-reproduction'), p1.skippedCase('T3', 'original-p1-complete-no-reproduction')])).toBe(true);\n453\t    expect(p1.validateSequence([t0, t1, p1.evaluateCase(fixture('T2')), p1.unknownCase('T3')])).toBe(false);\n454\t  });\n455\t  it('retains safe unknown root-launch metadata without inventing a root PID or a native return', () => {\n456\t    const f = fixture('T0'); f.root.pid = null; f.root.status = null; f.root.metadataUnknown = true; f.root.launchCode = 'ENOENT';\n457\t    f.guard = []; f.trace = []; f.launches = 0; f.probe = null; f.health.expectedPids = [];\n458\t    f.health.guardComplete = f.health.traceComplete = false;\n459\t    const r = p1.evaluateCase(f); expect(r.rootProcessStarted).toBeNull(); expect(r.native.outcome).toBe('unknown');\n460\t    expect(r.health?.rootRetained).toBe(true); expect(p1.validateCaseRecord(r, [], [], true)).toBe(true);\n461\t    const records = [r, ...p1.CASES.slice(1).map(c => p1.skippedCase(c.variant, 'writer-control-not-complete'))];\n462\t    expect(p1.makeSummary({ executionSha: 'a'.repeat(40) }, records, [], 1, 'writer-control-not-complete', true).totalNativeLaunches).toBeNull();\n463\t  });\n464\t});\n465\t\n466\tdescribe('strict-extra-key-rejection', () => {\n467\t  it('rejects every closed schema extra key and malformed raw event/line before rebuilding', () => {\n468\t    const f = fixture(), r = p1.evaluateCase(f);\n469\t    for (const [name, value] of [['native', f.probe.native], ['probe', f.probe], ['root', f.root], ['health', f.health], ['caseRecord', r],\n470\t      ['stage', f.guard.find((e: Row) => e.event === 'native-fixed-stage')], ['streamEnd', f.guard.find((e: Row) => e.event === 'native-fixed-stream-end')]])\n471\t      expect(p1.rebuild(name as string, { ...(value as Row), raw: 'CANARY' })).toBeNull();\n472\t    for (const text of ['{}\\n', JSON.stringify(f.guard[0]) + '\\n\\n', '\\uFEFF' + JSON.stringify(f.guard[0]) + '\\n', JSON.stringify(f.guard[0]),\n473\t      JSON.stringify({ ...f.guard[0], extra: true }) + '\\n', '{\"event\":\"powershell-admission\",\"event\":\"powershell-admission\",\"kind\":\"smoke\"}\\n'])\n474\t      expect(p1.parseRows(Buffer.from(text), 'guard').invalid).toBe(true);\n475\t    expect(p1.parseRows(Buffer.from([0xff, 10]), 'guard').invalid).toBe(true);\n476\t  });\n477\t  it('validates all case cross fields and rejects a terminal-only invented success', () => {\n478\t    const f = fixture('T2'), r = p1.evaluateCase(f);\n479\t    expect(p1.validateCaseRecord(r, f.guard, f.trace, true)).toBe(true);\n480\t    for (const mutate of [(r: any) => { r.caseId = p1.CASES[0].caseId; }, (r: any) => { r.markers = ['terminal-json']; },\n481\t      (r: any) => { r.notObserved = ['json-enter']; }, (r: any) => { r.nativeLaunches = 0; }, (r: any) => { r.stream.eofObserved = false; }]) {\n482\t      const candidate = clone(r); mutate(candidate); expect(p1.validateCaseRecord(candidate, f.guard, f.trace, true)).toBe(false);\n483\t    }\n484\t  });\n485\t  it('requires one canonical root object with no BOM, duplicate key, extra object or raw canary', () => {\n486\t    const probe = fixture().probe, text = JSON.stringify(probe) + '\\n';\n487\t    expect(p1.parseProbeBytes(Buffer.from(text))).toEqual(probe);\n488\t    for (const candidate of ['\\uFEFF' + text, text + text, text.replace('\"releaseAcceptance\":false', '\"releaseAcceptance\":true,\"releaseAcceptance\":false'),\n489\t      text.replace('\"format\":', '\"raw\":\"RAW-STDERR-CANARY\",\"format\":'), text.replace('\"format\":', '\"extra\":true,\"format\":'), text.trimEnd()])\n490\t      expect(p1.parseProbeBytes(Buffer.from(candidate))).toBeNull();\n491\t  });\n492\t});\n493\t\n494\tdescribe('import-without-side-effects', () => {\n495\t  it('a fresh test import performs no spawn, append, mkdir, guard installation or diagnostic main', async () => {\n496\t    const spawn = vi.spyOn(cp, 'spawn'), sync = vi.spyOn(cp, 'spawnSync'), append = vi.spyOn(fs, 'appendFileSync'), mkdir = vi.spyOn(fs, 'mkdirSync');\n497\t    try {\n498\t      const url = pathToFileURL(join(repo, 'docs/test-reports/windows-p1-stages-20261010/p1-stages.mjs')); url.searchParams.set('synthetic-import', '1');\n499\t      const m = await import(/* @vite-ignore */ url.href);\n500\t      expect(m.CASES).toHaveLength(4); expect(spawn).not.toHaveBeenCalled(); expect(sync).not.toHaveBeenCalled();\n501\t      expect(append).not.toHaveBeenCalled(); expect(mkdir).not.toHaveBeenCalled();\n502\t    } finally { spawn.mockRestore(); sync.mockRestore(); append.mockRestore(); mkdir.mockRestore(); }\n503\t  });\n504\t});\n505\t\n506\tdescribe('exact-source-workflow-and-upload-file-set', () => {\n507\t  function sealed(skipAll = false): any {\n508\t    const dir = directory(), executionSha = 'a'.repeat(40);\n509\t    const files = [...p1.BINDINGS.future_added_source_paths, 'docs/specs/BL-WINDOWS-P1-INITIAL-BINDINGS-20261010.json',\n510\t      ...p1.BINDINGS.frozen_runtime_sources.map(s => s.path)].sort().map(path => ({ path, sha256: p1.sha256(fs.readFileSync(join(repo, path))) }));\n511\t    const provenance = { format: 'windows-p1-initial-provenance-v1', executionSha, expectedSha: executionSha,\n512\t      planningBase: p1.BINDINGS.planning_base, timestampUtc: '2026-10-11T00:00:00Z', runId: '1', runAttempt: 1,\n513\t      ref: 'refs/heads/codex/windows-p1-stages-ci-20261010', runtime: { node: 'v22.22.0', uv: '1.51.0', platform: 'win32', arch: 'x64',\n514\t        osRelease: '10.0.1', imageOS: 'win25', imageVersion: '20261011.1.0' }, sourceFiles: clone(files),\n515\t      environmentKeyNames: [...p1.BINDINGS.e