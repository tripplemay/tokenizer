.length, 1);\n463\t    assert.equal(workers[0].status, 0); assert.equal(workers[0].signal, null); assert.equal(workers[0].code, null);\n464\t    assert.equal(guards[0].status, workers[0].status); assert.equal(guards[0].signal, workers[0].signal); assert.equal(guards[0].code, null);\n465\t    assert(['ok', 'timeout', 'output', 'launch', 'supervision'].includes(workers[0].workerKind));\n466\t    const facts = [];\n467\t    for (const rows of [guard, trace]) for (const event of ['child-exit', 'child-close']) {\n468\t      const candidates = rows.filter(e => e.executable === 'powershell.exe' && e.event === event);\n469\t      assert.equal(candidates.length, 1);\n470\t      const fact = candidates[0];\n471\t      assert(fact.pid === spawn.pid && fact.childPid === spawn.childPid && fact.sequence > (rows === guard ? gs[0].sequence : ts[0].sequence));\n472\t      facts.push(fact);\n473\t    }\n474\t    assert(facts.every(f => f.status === facts[0].status && f.signal === facts[0].signal));\n475\t    return { workerPid: spawn.pid, childPid: spawn.childPid, workerKind: workers[0].workerKind,\n476\t      status: facts[0].status, signal: facts[0].signal, spawnSequence: spawn.sequence };\n477\t  } catch { return null; }\n478\t}\n479\texport function reconcileNative(value, guard, trace, rootPid) {\n480\t  const native = rebuild('native', value), facts = workerFacts(guard, trace, rootPid);\n481\t  if (!native || !facts || native.workerKind !== facts.workerKind) return { native: unknownNative(), facts, valid: false };\n482\t  if (native.metadataSource === 'api-return' && (native.status !== facts.status || native.signal !== facts.signal))\n483\t    return { native: unknownNative(), facts, valid: false };\n484\t  if (native.metadataSource === 'api-return' && !['completed', 'refused'].includes(native.outcome))\n485\t    return { native: unknownNative(), facts, valid: false };\n486\t  if (native.metadataSource !== 'api-return' && native.metadataSource !== 'api-throw')\n487\t    return { native: unknownNative(), facts, valid: false };\n488\t  const kindByOutcome = { timeout: 'timeout', output: 'output', launch: 'launch', supervision: 'supervision' };\n489\t  if (native.metadataSource === 'api-throw' && native.outcome === 'output' && !['ok', 'output'].includes(native.workerKind))\n490\t    return { native: unknownNative(), facts, valid: false };\n491\t  if (native.metadataSource === 'api-throw' && native.outcome !== 'output' && native.workerKind !== kindByOutcome[native.outcome])\n492\t    return { native: unknownNative(), facts, valid: false };\n493\t  return { native, facts, valid: true };\n494\t}\n495\texport function stageFacts(variant, guard, facts) {\n496\t  try {\n497\t    const c = caseFor(variant); assert(facts);\n498\t    const stages = guard.filter(e => e.event === 'native-fixed-stage'), ends = guard.filter(e => e.event === 'native-fixed-stream-end');\n499\t    assert.equal(ends.length, 1);\n500\t    const stream = ends[0];\n501\t    assert(evidenceEvent('guard', stream) && stream.pid === facts.workerPid && stream.childPid === facts.childPid && stream.variant === variant);\n502\t    assert(stream.sequence > facts.spawnSequence && stream.acceptedMarkers === stages.length && stages.length <= c.sequence.length);\n503\t    let previous = -1;\n504\t    stages.forEach((s, index) => {\n505\t      assert(rebuild('stage', s) && s.pid === facts.workerPid && s.childPid === facts.childPid && s.variant === variant &&\n506\t        s.ordinal === index && s.marker === c.sequence[index] && s.sequence > facts.spawnSequence && s.sequence < stream.sequence && s.arrivalElapsedMs >= previous);\n507\t      previous = s.arrivalElapsedMs;\n508\t    });\n509\t    const complete = stages.length === c.sequence.length;\n510\t    if (stream.state === 'complete-sequence') assert(complete);\n511\t    if (stream.state === 'complete-prefix') assert(!complete);\n512\t    return { markers: stages.map(s => s.marker), stream, valid: ['complete-prefix', 'complete-sequence'].includes(stream.state) };\n513\t  } catch { return { markers: [], stream: null, valid: false }; }\n514\t}\n515\texport function skippedCase(variant, reason) {\n516\t  const c = caseFor(variant);\n517\t  return { format: 'windows-p1-initial-case-v1', variant, caseId: c.caseId, scriptSha256: c.scriptSha256,\n518\t    decision: 'skipped', reason, rootProcessStarted: false, nativeLaunches: 0, markers: [], notObserved: [...c.sequence],\n519\t    stream: null, native: notStartedNative(), root: null, health: null, prefix_protocol_valid: false,\n520\t    native_completed: false, diagnostic_observation_complete: false, releaseReady: false, releaseAcceptance: false };\n521\t}\n522\texport function unknownCase(variant, reason = 'setup-or-outcome-unknown') {\n523\t  const c = caseFor(variant);\n524\t  return { format: 'windows-p1-initial-case-v1', variant, caseId: c.caseId, scriptSha256: c.scriptSha256,\n525\t    decision: 'unknown', reason, rootProcessStarted: null, nativeLaunches: null, markers: [], notObserved: [...c.sequence],\n526\t    stream: null, native: unknownNative(), root: null, health: null, prefix_protocol_valid: false,\n527\t    native_completed: false, diagnostic_observation_complete: false, releaseReady: false, releaseAcceptance: false };\n528\t}\n529\tfunction healthTrust(h) {\n530\t  return h && h.expectedPids.length > 0 && h.guardComplete && h.traceComplete && !h.guardInvalid && !h.traceInvalid && !h.provenanceUnknown && !h.cleanupUnknown &&\n531\t    !h.diagnosticAbortReasons.length && !h.possibleLiveAfterOwnedCap.length && !h.rootRetained;\n532\t}\n533\tfunction rootTrust(r) {\n534\t  return r && r.status === 0 && r.signal === null && !r.metadataUnknown && !r.stopped && r.launchCode === null &&\n535\t    r.stderrBytes === 0 && !r.outputBoundExceeded && !r.canaryFound && r.stdoutBytes + r.stderrBytes <= BOUNDS.case_output_bytes;\n536\t}\n537\texport function evaluateCase({ variant, probe, root, health, guard, trace, launches, counterKnown }) {\n538\t  const c = caseFor(variant), safeRoot = rebuild('root', root), safeHealth = rebuild('health', health);\n539\t  const safeProbe = rebuild('probe', probe);\n540\t  const identityOK = safeProbe && safeProbe.probeSetupComplete && safeProbe.variant === variant && safeProbe.caseId === c.caseId && safeProbe.scriptSha256 === c.scriptSha256;\n541\t  const closure = reconcileNative(identityOK ? safeProbe.native : null, guard, trace, safeRoot?.pid);\n542\t  const stage = stageFacts(variant, guard, closure.facts);\n543\t  const processes = expectedProcesses(guard, trace, safeRoot?.pid);\n544\t  const processIdentity = !processes.unknown && safeHealth && same(processes.expected, safeHealth.expectedPids);\n545\t  let native = closure.native;\n546\t  const markerComplete = same(stage.markers, c.sequence);\n547\t  if (native.outcome === 'completed' && !markerComplete) { native = unknownNative(); closure.valid = false; }\n548\t  const complete = Boolean(identityOK && safeProbe.probeSetupComplete && safeRoot && safeHealth && closure.valid && stage.valid &&\n549\t    rootTrust(safeRoot) && healthTrust(safeHealth) && processIdentity && counterKnown && launches === 1 && ['completed', 'timeout', 'refused'].includes(native.outcome));\n550\t  const record = { format: 'windows-p1-initial-case-v1', variant, caseId: c.caseId, scriptSha256: c.scriptSha256,\n551\t    decision: closure.valid && identityOK ? 'run' : 'unknown', reason: closure.valid && identityOK ? null : 'prior-observation-unknown',\n552\t    rootProcessStarted: safeRoot?.pid ? true : null, nativeLaunches: [0, 1].includes(launches) ? launches : null,\n553\t    markers: stage.markers, notObserved: c.sequence.slice(stage.markers.length), stream: stage.stream,\n554\t    native, root: safeRoot, health: safeHealth, prefix_protocol_valid: stage.valid,\n555\t    native_completed: closure.valid && native.outcome === 'completed' && markerComplete,\n556\t    diagnostic_observation_complete: complete, releaseReady: false, releaseAcceptance: false };\n557\t  if (!closure.valid || !identityOK || !processIdentity || !stage.stream || stage.stream.state === 'unknown' ||\n558\t    !stage.stream.stdoutEofObserved || !stage.stream.stderrEofObserved || !stage.stream.eofObserved) {\n559\t    if (record.health) {\n560\t      if (!closure.valid || !identityOK || !processIdentity) record.health.provenanceUnknown = true;\n561\t      record.health.cleanupUnknown = true; record.health.rootRetained = true;\n562\t    }\n563\t  }\n564\t  assert(rebuild('caseRecord', record)); return record;\n565\t}\n566\texport function selection(record) {\n567\t  const { variant } = record;\n568\t  if (variant === 'T3') return { action: 'stop', reason: null };\n569\t  if (!record.diagnostic_observation_complete) return { action: 'stop-unknown', reason: variant === 'T0' ? 'writer-control-not-complete' : 'prior-observation-unknown' };\n570\t  if (record.native_completed) return variant === 'T0' ? { action: 'run-T1', reason: null } :\n571\t    { action: 'stop', reason: variant === 'T1' ? 'original-p1-complete-no-reproduction' : 'direct-invoke-complete-no-refinement' };\n572\t  if (['timeout', 'refused'].includes(record.native.outcome) && record.prefix_protocol_valid &&\n573\t    same(record.markers, variant === 'T1' ? [] : ['json-enter'])) {\n574\t    if (variant === 'T1') return { action: 'run-T2', reason: null };\n575\t    if (variant === 'T2') return { action: 'run-T3', reason: null };\n576\t  }\n577\t  return { action: 'stop-unknown', reason: variant === 'T0' ? 'writer-control-not-complete' : 'prior-observation-unknown' };\n578\t}\n579\t\n580\texport function nativeFromApi(api, invoke, now = () => performance.now()) {\n581\t  const start = now();\n582\t  try {\n583\t    const result = invoke();\n584\t    const elapsedMs = now() - start;\n585\t    const outcome = result.status === 0 && result.signal === null ? 'completed' :\n586\t      Number.isSafeInteger(result.status) && result.status !== 0 && result.signal === null ? 'refused' : 'unknown';\n587\t    const value = { outcome, metadataSource: 'api-return', status: result.status, signal: result.signal,\n588\t      errorName: null, errorCode: null, elapsedMs, workerKind: null };\n589\t    return value;\n590\t  } catch (error) {\n591\t    const classes = [['BoundedSubprocessTimeoutError', 'timeout'], ['BoundedSubprocessOutputError', 'output'],\n592\t      ['BoundedSubprocessLaunchError', 'launch'], ['BoundedSubprocessSupervisionError', 'supervision']];\n593\t    const matched = classes.find(([name]) => typeof api[name] === 'function' && error instanceof api[name]);\n594\t    if (!matched) return unknownNative();\n595\t    const [errorName, outcome] = matched;\n596\t    return { outcome, metadataSource: 'api-throw', status: null, signal: null, errorName,\n597\t      errorCode: outcome === 'launch' ? safeCode(error.code) : null, elapsedMs: now() - start, workerKind: null };\n598\t  }\n599\t}\n600\tasync function runProbe(variant) {\n601\t  const c = caseFor(variant), { root } = guardConfiguration();\n602\t  assert.equal(basename(root), c.caseId);\n603\t  const api = await import(pathToFileURL(join(repo, 'src/cli/bounded-subprocess.ts')).href);\n604\t  let native = nativeFromApi(api, () => api.runBoundedSubprocess('powershell.exe', nativeArgs(c), {\n605\t    cwd: root, env: process.env, windowsHide: true, timeoutMs: BOUNDS.native_ms, maxOutputBytes: BOUNDS.native_output_bytes\n606\t  }));\n607\t  const guard = readRows(join(root, 'guard.jsonl'), 'guard'), trace = readRows(join(root, 'trace.jsonl'), 'trace');\n608\t  const facts = workerFacts(guard.rows, trace.rows, process.pid);\n609\t  if (facts) native.workerKind = facts.workerKind;\n610\t  if (!rebuild('native', native)) native = unknownNative();\n611\t  const probe = { format: 'windows-p1-initial-probe-v1', variant, caseId: c.caseId, scriptSha256: c.scriptSha256,\n612\t    probeSetupComplete: true, native, releaseAcceptance: false };\n613\t  assert(rebuild('probe', probe));\n614\t  process.stdout.write(JSON.stringify(probe) + '\\n');\n615\t}\n616\t\n617\tfunction readOwned(path, cap) {\n618\t  const before = safeFile(path);\n619\t  assert(before.size <= cap);\n620\t  const fd = original.openSync(path, 'r');\n621\t  try {\n622\t    const stat = original.fstatSync(fd);\n623\t    assert(equalIdentity(identity(before), identity(stat)) && stat.size === before.size && stat.isFile());\n624\t    const bytes = Buffer.alloc(before.size);\n625\t    assert.equal(original.readSync(fd, bytes, 0, bytes.length, 0), bytes.length);\n626\t    const after = safeFile(path, identity(before));\n627\t    assert(after.size === before.size && original.fstatSync(fd).size === before.size);\n628\t    return bytes;\n629\t  } finally { original.closeSync(fd); }\n630\t}\n631\tfunction readRows(path, family) {\n632\t  try { return parseRows(readOwned(path, family === 'counter' ? BOUNDS.counter_bytes : BOUNDS.guard_bytes), family,\n633\t    family === 'counter' ? BOUNDS.counter_bytes : BOUNDS.guard_bytes); }\n634\t  catch { return { rows: [], text: '', invalid: true }; }\n635\t}\n636\tfunction readJson(path, name) {\n637\t  const bytes = readOwned(path, BINDINGS.output.json_max_bytes);\n638\t  const text = new TextDecoder('utf-8', { fatal: true, ignoreBOM: true }).decode(bytes);\n639\t  assert(!text.startsWith('\\uFEFF') && !canary(text));\n640\t  const value = JSON.parse(text), rebuilt = rebuild(name, value);\n641\t  assert.equal(text.replace(/^[\\x20\\x09\\x0a\\x0d]+|[\\x20\\x09\\x0a\\x0d]+$/g, ''), JSON.stringify(value), 'canonical core JSON');\n642\t  assert(rebuilt, 'safe core schema'); return rebuilt;\n643\t}\n644\texport function parseProbeBytes(bytes) {\n645\t  try {\n646\t    assert(Buffer.isBuffer(bytes) && bytes.length <= BOUNDS.case_output_bytes);\n647\t    const text = new TextDecoder('utf-8', { fatal: true, ignoreBOM: true }).decode(bytes);\n648\t    assert(!text.startsWith('\\uFEFF') && !canary(text));\n649\t    const value = JSON.parse(text); assert.equal(text, JSON.stringify(value) + '\\n');\n650\t    return rebuild('probe', value);\n651\t  } catch { return null; }\n652\t}\n653\tfunction writeJson(path, name, value) {\n654\t  const rebuilt = rebuild(name, value); assert(rebuilt, 'safe output schema');\n655\t  const bytes = Buffer.from(JSON.stringify(rebuilt) + '\\n');\n656\t  assert(bytes.length <= BINDINGS.output.json_max_bytes && !canary(bytes.toString('utf8')));\n657\t  original.writeFileSync(path, bytes, { flag: 'wx' });\n658\t}\n659\tfunction writeText(path, text, cap = BOUNDS.guard_bytes) {\n660\t  assert(Buffer.byteLength(text) <= cap && !canary(text));\n661\t  original.writeFileSync(path, text, { flag: 'wx' });\n662\t}\n663\tfunction sourceFiles() {\n664\t  return [...BINDINGS.future_added_source_paths, bindingPath, ...BINDINGS.frozen_runtime_sources.map(s => s.path)].sort()\n665\t    .map(path => ({ path, sha256: sha256(readOwned(join(repo, path), 1024 * 1024)) }));\n666\t}\n667\tfunction checkoutSha() {\n668\t  const result = cp.spawnSync('git', ['-c', 'core.fileMode=false', 'rev-parse', 'HEAD'], { cwd: repo, encoding: 'utf8', timeout: BOUNDS.operation_ms,\n669\t    maxBuffer: BOUNDS.counter_bytes, windowsHide: true });\n670\t  assert(!result.error && result.status === 0 && result.signal === null && result.stderr === '' && /^[a-f0-9]{40}\\r?\\n$/.test(result.stdout));\n671\t  const sha = result.stdout.trim();\n672\t  const paths = [...BINDINGS.future_added_source_paths, bindingPath, ...BINDINGS.frozen_runtime_sources.map(s => s.path)];\n673\t  const status = cp.spawnSync('git', ['-c', 'core.fileMode=false', 'status', '--porcelain', '--untracked-files=all', '--', ...paths],\n674\t    { cwd: repo, encoding: 'utf8', timeout: BOUNDS.operation_ms, maxBuffer: BOUNDS.counter_bytes, windowsHide: true });\n675\t  assert(!status.error && status.status === 0 && status.signal === null && status.stdout === '' && status.stderr === '', 'source checkout changed');\n676\t  return sha;\n677\t}\n678\texport function validateProvenance(value, files, executionSha) {\n679\t  const v = rebuild('provenance', value);\n680\t  if (!v || v.executionSha !== v.expectedSha || v.executionSha !== executionSha || !same(v.sourceFiles, files)) return false;\n681\t  const paths = [...BINDINGS.future_added_source_paths, bindingPath, ...BINDINGS.frozen_runtime_sources.map(s => s.path)].sort();\n682\t  if (!same(v.sourceFiles.map(s => s.path), paths)) return false;\n683\t  for (const frozen of BINDINGS.frozen_runtime_sources) if (v.sourceFiles.find(s => s.path === frozen.path)?.sha256 !== frozen.sha256) return false;\n684\t  if (v.sourceFiles.find(s => s.path === bindingPath)?.sha256 !== bindingHash) return false;\n685\t  const presentSystem = v.environmentKeyNames.filter(k => BINDINGS.environment.system_keys.includes(k));\n686\t  return same(v.environmentKeyNames, sorted([...presentSystem, ...BINDINGS.environment.synthetic_keys])) && v.extraEnvironmentKeys.length === 0;\n687\t}\n688\tfunction assertWindowsRunner() {\n689\t  assert(process.platform === 'win32' && process.arch === 'x64' && /^v22\\./.test(process.version), 'native Windows Node22 x64 required');\n690\t  assert(process.env.GITHUB_EVENT_NAME === 'push' && process.env.GITHUB_REF === BINDINGS.workflow.job_if.split(\"github.ref == '\")[1].slice(0, -1));\n691\t  assert(/^[a-f0-9]{40}$/.test(process.env.GITHUB_SHA ?? ''), 'expected SHA required');\n692\t}\n693\tfunction prepare() {\n694\t  assertWindowsRunner(); validateBindings();\n695\t  const executionSha = checkoutSha(); assert.equal(executionSha, process.env.GITHUB_SHA);\n696\t  const system = systemEnvironment(process.env);\n697\t  assert(/^[a-z]:[\\\\/]/i.test(system.SystemRoot ?? ''), 'local-drive SystemRoot required');\n698\t  safeDirectory(dirname(scratch)); original.mkdirSync(scratch);\n699\t  const provenance = { format: 'windows-p1-initial-provenance-v1', executionSha, expectedSha: process.env.GITHUB_SHA,\n700\t    planningBase: BINDINGS.planning_base, timestampUtc: new Date().toISOString(), runId: process.env.GI