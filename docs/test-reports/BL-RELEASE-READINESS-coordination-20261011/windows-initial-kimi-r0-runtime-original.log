\n1003\t  catch (error) { if (error?.code !== 'ENOENT') throw error; }\n1004\t  const missing = records.some(r => r.rootProcessStarted === null || r.nativeLaunches === null);\n1005\t  if (!missing) assert(validateSequence(records), 'selection sequence');\n1006\t  else assert(records.every(r => !r.diagnostic_observation_complete || r.rootProcessStarted === true), 'unknown outcome');\n1007\t  let stopReason = missing ? 'setup-or-outcome-unknown' : oldSummary?.stopReason ?? 'setup-or-outcome-unknown';\n1008\t  const summary = makeSummary(provenance, records, counter.invalid ? [] : counter.rows, oldSummary?.diagnosticExitCode ?? null, stopReason, counterKnown,\n1009\t    retainedRoots(join(scratch, 'run-root')));\n1010\t  if (!missing && oldSummary) assert(same(summary, oldSummary), 'summary reconstruction');\n1011\t  safeDirectory(dirname(upload)); original.mkdirSync(upload);\n1012\t  writeJson(join(upload, 'provenance.json'), 'provenance', provenance);\n1013\t  writeJson(join(upload, 'checks-summary.json'), 'checksSummary', checks);\n1014\t  writeJson(join(upload, 'summary.json'), 'summary', summary);\n1015\t  for (const { record, guard, trace } of evidence) {\n1016\t    writeJson(join(upload, record.variant + '.case.json'), 'caseRecord', record);\n1017\t    writeText(join(upload, record.variant + '.guard.jsonl'), guard.invalid ? '' : guard.text);\n1018\t    writeText(join(upload, record.variant + '.trace.jsonl'), trace.invalid ? '' : trace.text);\n1019\t  }\n1020\t  const files = BINDINGS.output.upload_files.filter(p => p !== 'manifest.json').sort().map(path => {\n1021\t    const bytes = readOwned(join(upload, path), path.endsWith('.jsonl') ? BOUNDS.guard_bytes : BINDINGS.output.json_max_bytes);\n1022\t    return { path, bytes: bytes.length, sha256: sha256(bytes) };\n1023\t  });\n1024\t  writeJson(join(upload, 'manifest.json'), 'manifest', { format: 'windows-p1-initial-manifest-v1', executionSha: provenance.executionSha, files, releaseAcceptance: false });\n1025\t  verifyUpload();\n1026\t}\n1027\texport function verifySealedDirectory(directory, files, executionSha) {\n1028\t  safeDirectory(directory);\n1029\t  assert.deepEqual(original.readdirSync(directory).sort(), [...BINDINGS.output.upload_files].sort(), 'exact sealed file set');\n1030\t  const provenance = readJson(join(directory, 'provenance.json'), 'provenance'), checks = readJson(join(directory, 'checks-summary.json'), 'checksSummary');\n1031\t  assert(validateProvenance(provenance, files, executionSha));\n1032\t  assert(checks.allRequiredControlsPassed === (checks.exitCode === 0 && checks.failed === 0 && checks.skipped === 0 && checks.passed > 0));\n1033\t  const summary = readJson(join(directory, 'summary.json'), 'summary'), manifest = readJson(join(directory, 'manifest.json'), 'manifest');\n1034\t  assert(summary.executionSha === executionSha && manifest.executionSha === executionSha);\n1035\t  assert.deepEqual(manifest.files.map(f => f.path), BINDINGS.output.upload_files.filter(p => p !== 'manifest.json').sort());\n1036\t  for (const entry of manifest.files) {\n1037\t    const bytes = readOwned(join(directory, entry.path), entry.path.endsWith('.jsonl') ? BOUNDS.guard_bytes : BINDINGS.output.json_max_bytes);\n1038\t    assert(entry.bytes === bytes.length && entry.sha256 === sha256(bytes), 'sealed digest');\n1039\t  }\n1040\t  const evidence = CASES.map(c => loadSealedCaseEvidence(directory, c.variant));\n1041\t  assert(evidence.every(e => !e.guard.invalid && !e.trace.invalid), 'public streams must be canonical');\n1042\t  const records = evidence.map(e => e.record), known = summary.totalNativeLaunches !== null;\n1043\t  for (const e of evidence) assert(validateCaseRecord(e.record, e.guard.rows, e.trace.rows, known));\n1044\t  const missing = records.some(r => r.rootProcessStarted === null || r.nativeLaunches === null);\n1045\t  if (!missing) assert(validateSequence(records));\n1046\t  else assert(summary.stopReason === 'setup-or-outcome-unknown' && !summary.diagnostic_observation_complete && summary.totalNativeLaunches === null);\n1047\t  for (const row of summary.admissions) assert(evidenceEvent('counter', row));\n1048\t  for (const r of records) if (r.health?.rootRetained) assert(summary.retainedCases.includes(r.caseId));\n1049\t  for (const id of summary.retainedCases) {\n1050\t    const r = records.find(r => r.caseId === id);\n1051\t    assert(r && (r.health?.rootRetained || r.rootProcessStarted === null), 'retained root source');\n1052\t  }\n1053\t  assert(same(summary, makeSummary(provenance, records, summary.admissions, summary.diagnosticExitCode, summary.stopReason, known, summary.retainedCases)));\n1054\t  if (summary.diagnostic_observation_complete) assert(checks.allRequiredControlsPassed);\n1055\t  return true;\n1056\t}\n1057\tfunction verifyUpload() {\n1058\t  assertWindowsRunner(); validateBindings();\n1059\t  const files = sourceFiles(), executionSha = checkoutSha();\n1060\t  assert.equal(executionSha, process.env.GITHUB_SHA);\n1061\t  return verifySealedDirectory(upload, files, executionSha);\n1062\t}\n1063\t\n1064\tif (new URL(import.meta.url).searchParams.get('guard') === '1') installGuard();\n1065\telse if (process.argv[1] && resolve(process.argv[1]) === self) {\n1066\t  const args = process.argv.slice(2);\n1067\t  try {\n1068\t    if (same(args, ['--prepare'])) prepare();\n1069\t    else if (same(args, ['--run'])) await runParent();\n1070\t    else if (args.length === 2 && args[0] === '--probe' && CASES.some(c => c.variant === args[1])) { assertWindowsRunnerForProbe(); await runProbe(args[1]); }\n1071\t    else if (same(args, ['--seal'])) seal();\n1072\t    else if (same(args, ['--verify-upload'])) verifyUpload();\n1073\t    else throw new Error('fixed CLI mode required');\n1074\t  } catch {\n1075\t    if (args.length === 2 && args[0] === '--probe' && CASES.some(c => c.variant === args[1])) {\n1076\t      const c = caseFor(args[1]);\n1077\t      process.stdout.write(JSON.stringify({ format: 'windows-p1-initial