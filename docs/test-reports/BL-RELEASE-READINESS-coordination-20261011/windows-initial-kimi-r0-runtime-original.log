unches', () => {\\n    const records = p1.CASES.map(c => p1.unknownCase(c.variant));\\n    const summary = p1.makeSummary({ executionSha: 'a'.repeat(40) }, records, [], null, 'setup-or-outcome-unknown', false);\\n    expect(summary.totalNativeLaunches).toBeNull();\\n    expect(summary.smokeNativeLaunches).toBeNull();\\n    expect(summary.diagnosticExitCode).toBeNull();\\n    expect(summary.diagnostic_observation_complete).toBe(false);\\n    expect(summary.releaseReady).toBe(false);\\n    expect(summary.formalF005Claim).toBe(false);\\n    expect(records.every(r => r.rootProcessStarted === null && r.nativeLaunches === null && r.decision === 'unknown')).toBe(true);\\n  });\\n  it('upload file set stays exactly sixteen explicit names with a fifteen-entry manifest and no self hash', () => {\\n    expect(p1.BINDINGS.output.upload_files).toHaveLength(16);\\n    expect(p1.BINDINGS.output.manifest_entries).toBe(15);\\n    expect(p1.BINDINGS.output.upload_files.filter(p => p !== 'manifest.json')).toHaveLength(15);\\n    expect(p1.BINDINGS.output.raw_copy_allowed).toBe(false);\\n    expect(p1.BINDINGS.output.symlinks_allowed).toBe(false);\\n    expect(p1.BINDINGS.output.additional_files_allowed).toBe(false);\\n  });\\n});\\n\"}"}}]}
