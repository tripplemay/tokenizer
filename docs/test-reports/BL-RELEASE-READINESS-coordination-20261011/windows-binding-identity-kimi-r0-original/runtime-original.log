rue);\n268\t  });\n269\t  it('one-variable counterfactual: autocrlf=true produces exactly the LF->CRLF transform', () => {\n270\t    fs.rmSync(join(repoA, 'bindings.json'));\n271\t    git(['checkout-index', '-f', '-a'], { ...FIVE_ENV, GIT_CONFIG_VALUE_1: 'true' });\n272\t    const out = fs.readFileSync(join(repoA, 'bindings.json'));\n273\t    const crlf = Buffer.from(sourceBytes.toString('utf8').replace(/\\n/g, '\\r\\n'));\n274\t    expect(out.equals(crlf)).toBe(true);"}
