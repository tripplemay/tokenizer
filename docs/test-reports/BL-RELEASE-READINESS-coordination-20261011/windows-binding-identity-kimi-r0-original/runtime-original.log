{"role":"tool","tool_call_id":"tool_VkV5KNJR48LPqhSTXfRrKOa8","content":"290\t  try {\n291\t    const payload = JSON.parse(argv[2]);\n292\t    if (!exact(payload, ['command', 'args', 'timeoutMs', 'maxOutputBytes', 'cwd', 'cleanupMs']) || payload.command !== command ||\n293\t      !same(payload.args, args) || payload.cwd !== root || payload.timeoutMs !== BOUNDS.native_ms ||\n294\t      payload.maxOutputBytes !== BOUNDS.native_output_bytes || payload.cleanupMs !== 1000) return null;\n295\t    return c;\n296\t  } catch { return null; }\n297\t}\n298\texport function attachNativeRecorder(child, context, persist, now) {\n299\t  const c = matchNativeIdentity({ ...context, childPid: child.pid });\n300\t  if (!c) return null;\n301\t  const recorder = createRecorder(c.variant, event => persist({ childPid: child.pid, ...event }), now);\n302\t  for (const [stream, name] of [[child.stdout, 'stdout'], [child.stderr, 'stderr']]) {\n303\t    if (!stream) { recorder.error(); continue; }\n304\t    stream.on('data', chunk => recorder.feed(name, chunk));\n305\t    stream.on('end', () => recorder.end(name));\n306\t    stream.on(errorMonitor, () => recorder.error());\n307\t  }\n308\t  child.on('close', () => recorder.finish());\n309\t  return recorder;\n310\t}\n311\t\n312\tfunction fixedEnvironment(system, root, runRoot, deadline, totalDeadline) {\n313\t  return { ...system, HOME: join(root, 'home'), USERPROFILE: join(root, 'home'), TEMP: join(root, 'tmp'), TMP: join(root, 'tmp'), TMPDIR: join(root, 'tmp'),\n314\t    GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: join(root, 'home', 'empty-gitconfig'), GIT_TERMINAL_PROMPT: '0',\n315\t    TW_ROOT: root, TW_TRACE: join(root, 'trace.jsonl'), TW_TRACE_HEALTH: join(root, 'trace-health'), TW_PARITY_RUN_ROOT: runRoot,\n316\t    TW_PARITY_COUNTER: join(runRoot, 'counter.jsonl'), TW_PARITY_GUARD_LOG: join(root, 'guard.jsonl'), TW_PARITY_GUARD_HEALTH: join(root, 'guard-health'),\n317\t    TW_PARITY_CASE_DEADLINE: String(deadline), TW_PARITY_TOTAL_DEADLINE: String(totalDeadline), TW_PARITY_KIND: 'smoke', TW_PARITY_ARM: 'E0',\n318\t    TW_PARITY_TRACE: 'on', TW_PARITY_CASE: 'smoke', NODE_OPTIONS: '--import=' + guardUrl.href + ' --import=' + traceUrl };\n319\t}\n320\texport function systemEnvironment(base) {\n321\t  const system = {};\n322\t  for (const key of BINDINGS.environment.system_keys) {\n323\t    const matches = Object.keys(base).filter(k => k.toLowerCase() === key.toLowerCase());\n324\t    assert(matches.length <= 1, 'ambiguous environment key');\n325\t    if (matches.length) { assert(typeof base[matches[0]] === 'string'); system[key] = base[matches[0]]; }\n326\t  }\n327\t  return system;\n328\t}\n329\tfunction guardConfiguration() {\n330\t  const env = process.env, root = env.TW_ROOT, runRoot = env.TW_PARITY_RUN_ROOT;\n331\t  assert(root && runRoot && CASES.some(c => root === join(runRoot, c.caseId)));\n332\t  const caseDeadline = Number(env.TW_PARITY_CASE_DEADLINE), totalDeadline = Number(env.TW_PARITY_TOTAL_DEADLINE);\n333\t  assert(uint(caseDeadline) && uint(totalDeadline) && caseDeadline <= totalDeadline && caseDeadline - Date.now() <= BOUNDS.case_ms);\n334\t  const expected = fixedEnvironment(systemEnvironment(env), root, runRoot, caseDeadline, totalDeadline);\n335\t  assert.deepEqual(sorted(Object.keys(env)), sorted(Object.keys(expected)));\n336\t  for (const key of Object.keys(expected)) assert.equal(env[key], expected[key], 'fixed owned environment');\n337\t  safeDirectory(root); safeDirectory(runRoot);\n338\t  return { env, root, runRoot, caseDeadline, totalDeadline };\n339\t}\n340\tfunction installGuard() {\n341\t  const { env, root, runRoot, caseDeadline, totalDeadline } = guardConfiguration();\n342\t  const healthPath = join(env.TW_PARITY_GUARD_HEALTH, process.pid + '.json');\n343\t  let failed = false, reasonCode = null, sequence = 0, stopping = false, nativeLaunches = 0;\n344\t  const recorders = new Set(), children = new Set();\n345\t  const health = state => { try { original.writeFileSyn