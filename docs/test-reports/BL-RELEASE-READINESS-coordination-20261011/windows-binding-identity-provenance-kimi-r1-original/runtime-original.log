{"role":"tool","tool_call_id":"tool_hBF4OLrouRqZcYxqVf4TIiAh","content":"1\t{\n2\t  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n3\t  \"title\": \"verdict-artifact\",\n4\t  \"description\": \"autonomous-mode.md 机件 #3 的验收工件 schema。verify 每轮必产 docs/test-reports/{BL-id}-verdict.json，喂沉淀引擎（§8.4）。存在≠真实：每 feature 的 evidence / steps_to_reproduce 必须非空，机械拒收空壳 PASS。v1.1 起兼作 dispatch-mode.md 的跨厂商交付契约（deliverable.schema），并承载 waiting 中断态。\",\n5\t  \"type\": \"object\",\n6\t  \"additionalProperties\": false,\n7\t  \"required\": [\"batch_id\", \"fix_round\", \"created_at\", \"verdicts\"],\n8\t  \"properties\": {\n9\t    \"batch_id\": { \"type\": \"string\", \"description\": \"= progress.json.current_sprint（BL-id）\" },\n10\t    \"fix_round\": { \"type\": \"integer\", \"minimum\": 0 },\n11\t    \"created_at\": { \"type\": \"string\", \"format\": \"date-time\" },\n12\t    \"waiting\": {\n13\t      \"type\": [\"string\", \"null\"],\n14\t      \"enum\": [\"auth\", \"adjudication\", null],\n15\t      \"default\": null,\n16\t      \"description\": \"dispatch-mode.md 的中断态降维表达（借 A2A AUTH_REQUIRED / INPUT_REQUIRED 语义）。一次性 CLI 进程无法「挂起等你」，故把中断态编码进产物：撞 L2 边界而未获授权 → 'auth'；规格歧义 / acceptance 无法客观判定 → 'adjudication'。写完照常 exit 0——不要用非零退出码表达「我需要人」，那会被回执推断判成 FAILED 并触发无意义重派。编排者读到非空即硬停交人类。\"\n17\t    },\n18\t    \"waiting_detail\": {\n19\t      \"type\": \"string\",\n20\t      \"minLength\": 1,\n21\t      \"description\": \"waiting 非空时必填：卡在哪条 feature、需要什么授权或裁决。人类据此一眼判断如何解锁\"\n22\t    },\n23\t    \"verdicts\": {\n24\t      \"type\": \"array\",\n25\t      \"items\": {\n26\t        \"type\": \"object\",\n27\t        \"additionalProperties\": false,\n28\t        \"required\": [\"feature_id\", \"result\", \"evidence\", \"steps_to_reproduce\"],\n29\t        \"properties\": {\n30\t          \"feature_id\": { \"type\": \"string\" },\n31\t          \"result\": { \"type\": \"string\", \"enum\": [\"PASS\", \"PARTIAL\", \"FAIL\"] },\n32\t          \"evidence\": { \"type\": \"string\", \"minLength\": 1, \"description\": \"实测证据（测试输出/命令/staging 结果），非空——空 = 空壳，拒收\" },\n33\t          \"steps_to_reproduce\": { \"type\": \"string\", \"minLength\": 1 }\n34\t        }\n35\t      }\n36\t    }\n37\t  },\n38\t  \"if\": {\n39\t    \"properties\": { \"waiting\": { \"type\": \"string\", \"enum\": [\"auth\", \"adjudication\"] } },\n40\t    \"required\": [\"waiting\"]\n41\t  },\n42\t  \"then\": {\n43\t    \"_comment\": \"中断态下允许 verdicts 为空或部分——被授权/裁决卡住时本就验不完，强行要求满额会逼出编造的证据\",\n44\t    \"required\": [\"waiting_detail\"],\n45\t    \"properties\": { \"verdicts\": { \"minItems\": 0 } }\n46\t  },\n47\t  \"else\": {\n48\t    \"_comment\": \"非中断态：verdicts 必须非空，否则这轮验收没有产出，沉淀引擎无燃料\",\n49\t    \"properties\": { \"verdicts\": { \"minItems\": 1 } }\n50\t  }\n51\t}"}
