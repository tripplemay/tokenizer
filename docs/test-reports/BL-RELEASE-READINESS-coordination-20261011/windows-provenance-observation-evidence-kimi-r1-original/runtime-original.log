describe('pins and static negative controls', () => {
  it('pins the CLI, original 81-test file and proposal by sha256, size and LF-only bytes', () => {
    expect(sha(cliSource)).toBe(CLI_SHA256);
    expect(Buffer.byteLength(cliSource)).toBe(77285);
    expect(cliSource.includes('\r')).toBe(false);
    expect(sha(readFileSync(join(repo, 'tests/diagnostics/windows-p1-stages.test.ts'), 'utf8'))).toBe(ORIG_TEST_SHA256);
    expect(sha(readFileSync(join(repo, 'docs/test-reports/BL-WINDOWS-P1-PROVENANCE-FAILURE-plan-20261011/proposal.json'), 'utf8'))).toBe(PROPOSAL_SHA256);
  });
  it('has exactly eighteen fixed four-byte LF reason lines V00-V17 and no dynamic reason text', () => {
    const table = grabFrom('const prepareProvenanceReasonLines = {', '};');
    const entries = [...table.matchAll(/(V\d{2}): '(V\d{2}\\n)'/g)];
    expect(entries.map(e => e[1])).toEqual(Array.from({ length: 18 }, (_, i) => `V${String(i).padStart(2, '0')}`));
    for (const e of entries) { expect(e[1]).toBe(e[2].slice(0, 3)); expect(Buffer.byteLength(e[2].replace('\\n', '\n'))).toBe(4); }
    expect(table).not.toContain('`');
    expect(table).not.toContain('\r');
    expect(Buffer.byteLength(GENERIC)).toBe(51);
    for (let i = 0; i <= 12; i++) expect(Buffer.byteLength(P_LINE(`P${String(i).padStart(2, '0')}`))).toBe(29);
    expect(51 + 29 + 4).toBe(84);
    expect(84).toBeGreaterThan(80); // 84 is a new contract, never an old-80 claim
  });
  it('keeps emission order generic then phase then at most one reason, stderr only, exit 1 retained', () => {
    const g = cliSource.indexOf(`process.stderr.write('windows-p1-initial diagnostic evidence unavailable\\n')`);
    const p = cliSource.indexOf('process.stderr.write(Object.hasOwn(prepareFailureLines');
    const r = cliSource.indexOf('process.stderr.write(Object.hasOwn(prepareProvenanceReasonLines');
    expect(g).toBeGreaterThan(-1); expect(p).toBeGreaterThan(g); expect(r).toBeGreaterThan(p);
    expect(cliSource.split('process.stderr.write(Object.hasOwn(prepareProvenanceReasonLines').length - 1).toBe(1);
    expect(cliSource.split('process.stdout.write(Object.hasOwn(prepareProvenanceReasonLines').length - 1).toBe(0);
    const emission = grabFrom('process.stderr.write(Object.hasOwn(prepareProvenanceReasonLines', 'process.exitCode = 1;');
    expect(emission).not.toContain('stdout');
    expect(emission).toContain('prepareProvenanceReasonLines.V00'); // nonmember/invalid -> V00 unknown
    expect(cliSource.indexOf('process.exitCode = 1;', r)).toBeGreaterThan(r); // earlier original exitCode paths exist
  });
  it('activates observation only in the exact --prepare arm with V00 reset and deactivates after success', () => {
    expect(cliSource.split('prepareProvenanceObservationActive = true').length - 1).toBe(1);
    const arm = cliSource.indexOf("same(args, ['--prepare'])");
    const act = cliSource.indexOf('prepareProvenanceObservationActive = true');
    const reset = cliSource.indexOf("prepareProvenanceReason = 'V00';", act);
    expect(act).toBeGreaterThan(arm);
    expect(reset).toBeGreaterThan(act);
    expect(reset).toBeLessThan(cliSource.indexOf('prepare();', arm));
    expect(cliSource.split('prepareProvenanceObservationActive = false').length - 1).toBe(2); // declaration + success
    const write = cliSource.indexOf("writeJson(join(scratch, 'provenance.json'), 'provenance', provenance);");
    const deact = cliSource.indexOf('prepareProvenanceObservationActive = false;', write);
    expect(deact).toBeGreaterThan(write);
    expect(cliSource).toContain("searchParams.get('guard') === '1') installGuard()");
  });
  it('latches fixed enums immediately before original operations and false returns, never after', () => {
    const at = (s: string) => validateSlice.indexOf(s);
    expect(at("prepareProvenanceReason = 'V01'")).toBeLessThan(at('const v = rebuild'));
    expect(at("prepareProvenanceReason = 'V05'")).toBeLessThan(at('if (!v ||'));
    expect(at("prepareProvenanceReason = 'V06'")).toBeLessThan(at("prepareProvenanceReason = 'V06'") + 1);
    expect(at("prepareProvenanceReason = 'V06'")).toBeGreaterThan(at('if (!v ||'));
    expect(at("prepareProvenanceReason = 'V07'")).toBeLessThan(at('const paths ='));
    expect(at("prepareProvenanceReason = 'V08'")).toBeLessThan(at('if (!same(v.sourceFiles.map'));
    expect(at("prepareProvenanceReason = 'V10'")).toBeLessThan(at('for (const frozen'));
    expect(at("prepareProvenanceReason = 'V12'")).toBeLessThan(at('if (v.sourceFiles.find(s => s.path === bindingPath)'));
    expect(at("prepareProvenanceReason = 'V14'")).toBeLessThan(at('const presentSystem'));
    expect(at("prepareProvenanceReason = 'V15'")).toBeLessThan(at('const valid ='));
    expect(at("'V17' : 'V16'")).toBeLessThan(at('return valid;'));
    for (const code of ['V06', 'V09', 'V11', 'V13']) {
      const latch = at(`prepareProvenanceReason = '${code}';`);
      expect(validateSlice.indexOf('return false;', latch)).toBe(latch + `prepareProvenanceReason = '${code}';`.length + '\n    '.length);
    }
    expect(validateSlice).toContain("&& v) prepareProvenanceReason = 'V05'");
    expect(validateSlice).toContain("&& v) prepareProvenanceReason = 'V06'"); // V02/V03/V04 survive !v
  });
  it('preserves original call counts, catch semantics and adds no schema/env/error/property reads', () => {
    expect(rebuildSlice.split('schemaMatches(').length - 1).toBe(1);
    expect(rebuildSlice.split('JSON.stringify(').length - 1).toBe(1);
    expect(rebuildSlice.split('JSON.parse(').length - 1).toBe(1);
    expect(rebuildSlice).toContain('catch {'); // no caught error binding retained
    expect(rebuildSlice).not.toMatch(/catch \(/);
    expect((rebuildSlice.match(/return null;/g) ?? []).length).toBe(2); // split-ternary schema-false null + caught null both retained
    expect(validateSlice.split('same(').length - 1).toBe(3);
    expect(validateSlice.split('rebuild(').length - 1).toBe(1);
    expect(validateSlice.split('sorted(').length - 1).toBe(1);
    expect(validateSlice.split('.find(').length - 1).toBe(2);
    expect(validateSlice.split('.filter(').length - 1).toBe(1);
    for (const slice of [declSlice, rebuildSlice, validateSlice]) {
      expect(slice).not.toContain('process.env');
      expect(slice).not.toMatch(/\.(message|stack|name|code)\b/);
      expect(slice).not.toContain('\r');
    }
    expect(schemaSlice).not.toContain('prepareProvenance'); // schema untouched
    expect(validateSlice).not.toContain('schemaMatches('); // no extra validator/schema call
    expect(provenanceSlice).not.toContain('Observation'); // no new persisted fields
    expect(declSlice + rebuildSlice + validateSlice).not.toContain('80'); // no old-80 claim
    expect(rebuildSlice).not.toContain('Object.hasOwn(prepareProvenanceReasonLines'); // reason text only at terminal
  });
});

describe('rebuild slice: schema/clone stage classification with exact call order and counts', () => {
  it('schema true returns deep clone, calls schema then stringify then parse exactly once, no latch', () => {
    const h = build();
    h.set('P11', true, 'V00');
    const value = validProvenance();
    const out = h.fns().rebuild('provenance', value);
    expect(out).toEqual(value);
    expect(out).not.toBe(value);
    expect(h.calls).toMatchObject({ schema: 1, stringify: 1, parse: 1 });
    expect(h.order).toEqual(['schema', 'stringify', 'parse']);
    expect(h.state().reason).toBe('V00'); // rebuild alone never emits/latches success
  });
  it('schema false returns null and latches V02, clone never attempted', () => {
    const h = build({ schemaResult: false });
    h.set('P11', true, 'V00');
    expect(h.fns().rebuild('provenance', validProvenance())).toBe(null);
    expect(h.state().reason).toBe('V02');
    expect(h.calls).toMatchObject({ schema: 1, stringify: 0, parse: 0 });
  });
  it('caught schema escape returns null and latches V03 without inspecting the thrown value', () => {
    const err = new Error('hidden');
    Object.defineProperty(err, 'message', { get() { throw new Error('MESSAGE-READ-CANARY'); } });
    let schemaCalls = 0;
    const h = build({ schemaMatches: () => { schemaCalls++; throw err; } });
    h.set('P11', true, 'V00');
    expect(h.fns().rebuild('provenance', validProvenance())).toBe(null);
    expect(h.state().reason).toBe('V03');
    expect(schemaCalls).toBe(1);
    expect(h.calls).toMatchObject({ stringify: 0, parse: 0 });
  });
  it('caught primitive escape also classifies V03 and never serializes the primitive', () => {
    const h = build({ schemaMatches: () => { throw 'PRIMITIVE-CANARY'; } });
    h.set('P11', true, 'V00');
    expect(h.fns().rebuild('provenance', validProvenance())).toBe(null);
    expect(h.state().reason).toBe('V03');
  });
  it('caught clone escape returns null and latches V04, stringify attempted exactly once', () => {
    let toJson = 0;
    const value = { ...validProvenance(), toJSON() { toJson++; throw new Error('TOJSON-SECRET'); } };
    const h = build();
    h.set('P11', true, 'V00');
    expect(h.fns().rebuild('provenance', value)).toBe(null);
    expect(h.state().reason).toBe('V04');
    expect(h.calls).toMatchObject({ schema: 1, stringify: 1, parse: 0 });
    expect(toJson).toBe(1); // original single stringify behaviour preserved, not suppressed/duplicated
  });
  it('inactive observer (not exact prepare P11, or non-provenance name) changes nothing and emits nothing', () => {
    for (const [phase, active, name] of [['P11', false, 'provenance'], ['P12', true, 'provenance'], [null, true, 'provenance'], ['P11', true, 'other']] as any[]) {
      const h = build({ schemaResult: false });
      h.set(phase, active, 'V00');
      expect(h.fns().rebuild(name, validProvenance())).toBe(null); // identical original behaviour
      expect(h.state().reason).toBe('V00');
      expect(h.calls.schema).toBe(1);
    }
  });
});

describe('validateProvenance slice: all eighteen fixed codes distinguished', () => {
  it('V01: rebuild in flight external escape leaves the in-flight enum (anomalous interval, stubbed dependency)', () => {
    const h = build({}, { rebuildSource: "function rebuild() { throw new Error('EXTERNAL-ESCAPE-CANARY'); }" });
    const { thrown } = validateAtP11(h, validProvenance(), VALID_FILES, A40);
    expect(thrown).toBeTruthy();
    expect(h.state().reason).toBe('V01');
    expectTerminal(h, 'P11', 'V01');
    expect(h.stderrText()).not.toContain('EXTERNAL-ESCAPE-CANARY');
  });
  it('V02: schema false -> validator false, latch survives the !v guard, 84-byte terminal', async () => {
    const h = build({ schemaResult: false });
    await h.dispatch();
    expect(h.state().reason).toBe('V02');
    expectTerminal(h, 'P11', 'V02');
    expect(Buffer.byteLength(h.stderrText())).toBe(84);
    expect(h.stderr.length).toBe(3); // generic + phase + at most one reason
  });
