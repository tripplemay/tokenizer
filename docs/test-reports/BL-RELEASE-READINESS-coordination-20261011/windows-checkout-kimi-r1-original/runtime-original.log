{"role":"tool","tool_call_id":"tool_pTykBS6Pkc6CLZYOtQNDkjs4","content":"1\timport fs from 'node:fs';\n2\timport cp from 'node:child_process';\n3\timport { errorMonitor } from 'node:events';\n4\timport { syncBuiltinESMExports } from 'node:module';\n5\timport { basename, dirname, join, resolve, parse } from 'node:path';\n6\timport { fileURLToPath, pathToFileURL } from 'node:url';\n7\timport { release } from 'node:os';\n8\timport { createHash } from 'node:crypto';\n9\timport assert from 'node:assert/strict';\n10\timport { evidenceEvent as baselineEvent, safeCode, rootMetadata } from '../windows-release-diagnosis-20261008/native-runtime-parity.mjs';\n11\t\n12\tconst self = fileURLToPath(new URL('./p1-stages.mjs', import.meta.url));\n13\tconst repo = resolve(dirname(self), '../../..');\n14\tconst bindingPath = 'docs/specs/BL-WINDOWS-P1-INITIAL-BINDINGS-20261010.json';\n15\tconst bindingHash = '652a11170499b8c03bcd70d65ba4f8cdd1476a318e119b267d33cbf90ed1922d';\n16\tconst mdPath = 'docs/specs/BL-WINDOWS-P1-INITIAL-BINDINGS-20261010.md';\n17\tconst mdHash = 'fc7f4d09915d7200177bf0b4d7c6fc76e95e0423d4e1e2f3f2bc3a1986025ec6';\n18\texport const sha256 = value => createHash('sha256').update(value).digest('hex');\n19\tconst bindingBytes = fs.readFileSync(join(repo, bindingPath));\n20\tassert.equal(sha256(bindingBytes), bindingHash, 'binding identity');\n21\texport const BINDINGS = JSON.parse(bindingBytes);\n22\texport const CASES = BINDINGS.cases;\n23\texport const BOUNDS = BINDINGS.bounds;\n24\tconst defs = BINDINGS.schemas.$defs;\n25\tconst scratch = join(repo, BINDINGS.output.scratch_root);\n26\tconst upload = join(repo, BINDINGS.output.upload_root);\n27\tconst workerPath = join(repo, 'src/cli/bounded-subprocess-worker.mjs');\n28\tconst guardUrl = pathToFileURL(self); guardUrl.searchParams.set('guard', '1');\n29\tconst traceUrl = pathToFileURL(join(repo, BINDINGS.environment.old_trace_import)).href;\n30\tconst nativeArgs = c => [...BINDINGS.native.argv_prefix, c.script];\n31\tconst same = (a, b) => JSON.stringify(a) === JSON.stringify(b);\n32\tconst uint = (n, max = Number.MAX_SAFE_INTEGER) => Number.isSafeInteger(n) && n >= 0 && n <= max;\n33\tconst pid = n => uint(n, 0xffffffff) && n > 0;\n34\tconst exact = (v, keys) => v && typeof v === 'object' && !Array.isArray(v) &&\n35\t  keys.length === Object.keys(v).length && keys.every(k => Object.hasOwn(v, k));\n36\tconst caseFor = variant => { const c = CASES.find(c => c.variant === variant); assert(c, 'fixed variant required'); return c; };\n37\tconst sorted = values => [...new Set(values)].sort();\n38\tconst canary = text => /TW_RAW_CONTENT_CANARY|RAW-STDERR-CANARY|PRIVATE|reader/.test(text);\n39\tconst original = Object.fromEntries(['mkdirSync', 'rmdirSync', 'lstatSync', 'fstatSync', 'openSync',\n40\t  'readFileSync', 'readSync', 'writeSync', 'writeFileSync', 'closeSync', 'appendFileSync', 'realpathSync',\n41\t  'readdirSync', 'rmSync'].map(k => [k, fs[k].bind(fs)]));\n42\t\n43\texport function schemaMatches(schema, value) {\n44\t  if (schema.$ref) return schemaMatches(defs[schema.$ref.slice(8)], value);\n45\t  if (schema.const !== undefined && !same(value, schema.const)) return false;\n46\t  if (schema.enum && !schema.enum.some(v => same(v, value))) return false;\n47\t  if (schema.type) {\n48\t    const types = Array.isArray(schema.type) ? schema.type : [schema.type];\n49\t    if (!types.some(t => t === 'null' ? value === null : t === 'array' ? Array.isArray(value) :\n50\t      t === 'object' ? value !== null && typeof value === 'object' && !Array.isArray(value) :\n51\t      t === 'integer' ? Number.isSafeInteger(value) : t === 'number' ? typeof value === 'number' && Number.isFinite(value) : typeof value === t)) return false;\n52\t  }\n53\t  if (schema.anyOf && !schema.anyOf.some(s => schemaMatches(s, value))) return false;\n54\t  if (schema.allOf && !schema.allOf.every(s => schemaMatches(s, value))) return false;\n55\t  if (schema.not && schemaMatches(schema.not, value)) return false;\n56\t  if (schema.if && schemaMatches(schema.if, value) && schema.then && !schemaMatches(schema.then, value)) return false;\n57\t  if (typeof value === 'number' && ((schema.minimum !== undefined && value < schema.minimum) ||\n58\t    (schema.maximum !== undefined && value > schema.maximum))) return false;\n59\t  if (typeof value === 'string' && ((schema.maxLength !== undefined && value.length > schema.maxLength) ||\n60\t    (schema.pattern && !new RegExp(schema.pattern).test(value)))) return false;\n61\t  if (Array.isArray(value)) {\n62\t    if ((schema.minItems !== undefined && value.length < schema.minItems) || (schema.maxItems !== undefined && value.length > schema.maxItems) ||\n63\t      (schema.uniqueItems && new Set(value.map(v => JSON.stringify(v))).size !== value.length)) return false;\n64\t    if (schema.items && !value.every(v => schemaMatches(schema.items, v))) return false;\n65\t  }\n66\t  if (value && typeof value === 'object' && !Array.isArray(value)) {\n67\t    if (schema.required && !schema.required.every(k => Object.hasOwn(value, k))) return false;\n68\t    if (schema.additionalProperties === false && Object.keys(value).some(k => !Object.hasOwn(schema.properties ?? {}, k))) return false;\n69\t    if (schema.properties && !Object.entries(value).every(([k, v]) => !schema.properties[k] || schemaMatches(schema.properties[k], v))) return false;\n70\t  }\n71\t  return true;\n72\t}\n73\texport function rebuild(name, value) {\n74\t  try { return schemaMatches(defs[name], value) ? JSON.parse(JSON.stringify(value)) : null; } catch { return null; }\n75\t}\n76\texport function validateBindings() {\n77\t  assert.equal(sha256(original.readFileSync(join(repo, mdPath))), mdHash);\n78\t  for (const input of [...BINDINGS.prior_inputs, ...BINDINGS.frozen_runtime_sources])\n79\t    assert.equal(sha256(original.readFileSync(join(repo, input.path))), input.sha256, 'frozen input');\n80\t  assert.equal(CASES.length, 4);\n81\t  for (const c of CASES) assert.equal(sha256(c.script), c.scriptSha256);\n82\t  assert.equal(Math.max(...Object.values(BINDINGS.tokens).map(t => Buffer.byteLength(t))) + 2, BOUNDS.pending_line_bytes);\n83\t  assert.deepEqual(CASES.map(c => c.variant), ['T0', 'T1', 'T2', 'T3']);\n84\t  return true;\n85\t}\n86\t\n87\texport function evidenceEvent(family, value) {\n88\t  if (family === 'guard' && value?.event === 'native-fixed-stage') return rebuild('stage', value);\n89\t  if (family === 'guard' && value?.event === 'native-fixed-stream-end') {\n90\t    const v = rebuild('streamEnd', value);\n91\t    if (!v || v.eofObserved !== (v.stdoutEofObserved && v.stderrEofObserved) ||\n92\t      (v.combinedBytes <= BOUNDS.native_output_bytes && v.combinedBytes !== v.stdoutBytes + v.stderrBytes) ||\n93\t      (v.combinedBytes > BOUNDS.native_output_bytes && (v.state !== 'invalid' || v.reason !== 'native-output-cap')) ||\n94\t      (v.reason === 'native-output-cap' && v.combinedBytes !== BOUNDS.native_output_bytes + 1) ||\n95\t      (v.stderrBytes > 0 && v.state !== 'invalid') ||\n96\t      (['complete-prefix', 'complete-sequence'].includes(v.state) && (!v.eofObserved || v.reason !== 'none')) ||\n97\t      (v.state === 'unknown' && !['stream-error', 'eof-not-observed'].includes(v.reason)) ||\n98\t      (v.state === 'invalid' && !['unexpected-bytes', 'order-or-duplicate', 'unterminated-line', 'native-output-cap'].includes(v.reason))) return null;\n99\t    return v;\n100\t  }\n101\t  const v = baselineEvent(family, value);\n102\t  return family === 'counter' && v?.kind !== 'smoke' ? null : v;\n103\t}\n104\texport function parseRows(bytes, family, cap = BOUNDS.guard_bytes) {\n105\t  try {\n106\t    assert(Buffer.isBuffer(bytes) && bytes.length <= cap);\n107\t    if (!bytes.length) return { rows: [], text: '', invalid: false };\n108\t    const text = new TextDecoder('utf-8', { fatal: true, ignoreBOM: true }).decode(bytes);\n109\t    assert(!text.startsWith('\\uFEFF') && text.endsWith('\\n') && !canary(text));\n110\t    const rows = text.slice(0, -1).split('\\n').map(line => {\n111\t      assert(line.length);\n112\t      const v = JSON.parse(line), rebuilt = evidenceEvent(family, v);\n113\t      assert(rebuilt && JSON.stringify(v) === line);\n114\t      return rebuilt;\n115\t    });\n116\t    if (family !== 'counter') {\n117\t      const seq = new Map();\n118\t      for (const row of rows) { assert.equal(row.sequence, seq.get(row.pid) ?? 0); seq.set(row.pid, row.sequence + 1); }\n119\t    }\n120\t    const rebuiltText = rows.map(row => JSON.stringify(row) + '\\n').join('');"}
