{"role":"tool","tool_call_id":"tool_DoK55G6doqaDQ4KKlGsHkpVR","content":"300\t  if (!c) return null;\n301\t  const recorder = createRecorder(c.variant, event => persist({ childPid: child.pid, ...event }), now);\n302\t  for (const [stream, name] of [[child.stdout, 'stdout'], [child.stderr, 'stderr']]) {\n303\t    if (!stream) { recorder.error(); continue; }\n304\t    stream.on('data', chunk => recorder.feed(name, chunk));\n305\t    stream.on('end', () => recorder.end(name));\n306\t    stream.on(errorMonitor, () => recorder.error());\n307\t  }\n308\t  child.on('close', () => recorder.finish());\n309\t  return recorder;\n310\t}\n311\t\n312\tfunction fixedEnvironment(system, root, runRoot, deadline, totalDeadline) {\n313\t  return { ...system, HOME: join(root, 'home'), USERPROFILE: join(root, 'home'), TEMP: join(root, 'tmp'), TMP: join(root, 'tmp'), TMPDIR: join(root, 'tmp'),\n314\t    GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: join(root, 'home', 'empty-gitconfig'), GIT_TERMINAL_PROMPT: '0',\n315\t    TW_ROOT: root, TW_TRACE: join(root, 'trace.jsonl'), TW_TRACE_HEALTH: join(root, 'trace-health'), TW_PARITY_RUN_ROOT: runRoot,\n316\t    TW_PARITY_COUNTER: join(runRoot, 'counter.jsonl'), TW_PARITY_GUARD_LOG: join(root, 'guard.jsonl'), TW_PARITY_GUARD_HEALTH: join(root, 'guard-health'),\n317\t    TW_PARITY_CASE_DEADLINE: String(deadline), TW_PARITY_TOTAL_DEADLINE: String(totalDeadline), TW_PARITY_KIND: 'smoke', TW_PARITY_ARM: 'E0',\n318\t    TW_PARITY_TRACE: 'on', TW_PARITY_CASE: 'smoke', NODE_OPTIONS: '--import=' + guardUrl.href + ' --import=' + traceUrl };\n319\t}\n320\texport function systemEnvironment(base) {\n321\t  const system = {};\n322\t  for (const key of BINDINGS.environment.system_keys) {\n323\t    const matches = Object.keys(base).filter(k => k.toLowerCase() === key.toLowerCase());\n324\t    assert(matches.length <= 1, 'ambiguous environment key');\n325\t    if (matches.length) { assert(typeof base[matches[0]] === 'string'); system[key] = base[matches[0]]; }\n326\t  }\n327\t  return system;\n328\t}\n329\tfunction guardConfiguration() {\n330\t  const env = process.env, root = env.TW_ROOT, runRoot = env.TW_PARITY_RUN_ROOT;\n331\t  assert(root && runRoot && CASES.some(c => root === join(runRoot, c.caseId)));\n332\t  const caseDeadline = Number(env.TW_PARITY_CASE_DEADLINE), totalDeadline = Number(env.TW_PARITY_TOTAL_DEADLINE);\n333\t  assert(uint(caseDeadline) && uint(totalDeadline) && caseDeadline <= totalDeadline && caseDeadline - Date.now() <= BOUNDS.case_ms);\n334\t  const expected = fixedEnvironment(systemEnvironment(env), root, runRoot, caseDeadline, totalDeadline);\n335\t  assert.deepEqual(sorted(Object.keys(env)), sorted(Object.keys(expected)));\n336\t  for (const key of Object.keys(expected)) assert.equal(env[key], expected[key], 'fixed owned environment');\n337\t  safeDirectory(root); safeDirectory(runRoot);\n338\t  return { env, root, runRoot, caseDeadline, totalDeadline };\n339\t}\n340\tfunction installGuard() {\n341\t  const { env, root, runRoot, caseDeadline, totalDeadline } = guardConfiguration();\n342\t  const healthPath = join(env.TW_PARITY_GUARD_HEALTH, process.pid + '.json');\n343\t  let failed = false, reasonCode = null, sequence = 0, stopping = false, nativeLaunches = 0;\n344\t  const recorders = new Set(), children = new Set();\n345\t  const health = state => { try { original.writeFileSync(healthPath, JSON.stringify({ pid: process.pid, state, ...(reasonCode ? { reasonCode } : {}) }) + '\\n'); }\n346\t    catch { failed = true; reasonCode ??= 'GUARD_HEALTH_IO'; } };\n347\t  const fail = code => { failed = true; reasonCode ??= code; health('failed'); };\n348\t  const gate = createAppendGate([\n349\t    { path: env.TW_PARITY_GUARD_LOG, cap: BOUNDS.guard_bytes, family: 'guard' },\n350\t    { path: env.TW_TRACE, cap: BOUNDS.trace_bytes, family: 'trace' },\n351\t    { path: env.TW_PARITY_COUNTER, cap: BOUNDS.counter_bytes, family: 'counter' }\n352\t  ], original, path => fail(path === env.TW_PARITY_COUNTER ? 'GUARD_COUNTER_IO' : 'GUARD_LOG_IO_OR_LIMIT'));\n353\t  installAppendWrapper(fs, gate);\n354\t  const log = event => {\n355\t    try {\n356\t      const rebuilt = evidenceEvent('guard', { pid: process.pid, sequence: sequence++, at: Date.now(), ...event });\n357\t      assert(rebuilt); gate.append(env.TW_PARITY_GUARD_LOG, JSON.stringify(rebuilt) + '\\n');\n358\t    } catch { fail('GUARD_LOG_IO_OR_LIMIT'); }\n359\t  };\n360\t  const originalSpawn = cp.spawn, originalSync = cp.spawnSync;\n361\t  const stop = child => {\n362\t    const m = rootMetadata(child);\n363\t    if (m.unknown || !m.pid || m.status !== null || m.signal !== null) return;\n364\t    try { originalSync('taskkill.exe', ['/pid', String(m.pid), '/T', '/F'], { windowsHide: true, stdio: 'ignore', timeout: 1000, killSignal: 'SIGKILL' }); } catch { /* unknown remains separate */ }\n365\t    try { child.kill('SIGKILL'); } catch { /* only the live owned handle */ }\n366\t  };\n367\t  health('pending');\n368\t  process.once('exit', () => { for (const r of recorders) r.finish(); health(failed ? 'failed' : 'complete'); });\n369\t  const expiry = Math.min(caseDeadline, totalDeadline);\n370\t  const timer = setTimeout(() => {\n371\t    if (stopping) return; stopping = true;\n372\t    log({ event: 'owned-lifetime-expired' }); log({ event: 'diagnostic-budget-abort', reason: 'owned-lifetime-expired' });\n373\t    for (const child of children) stop(child); process.exit(92);\n374\t  }, Math.max(1, Math.min(BOUNDS.case_ms, expiry - Date.now()))); timer.unref();\n375\t  const executable = command => typeof command === 'string' && /^(node(?:\\.exe)?|powershell\\.exe|taskkill\\.exe|git(?:\\.exe)?)$/i.test(basename(command)) ? basename(command).toLowerCase() : 'other';\n376\t  cp.spawn = function (command, args, options) {\n377\t    const exe = executable(command);\n378\t    if (exe === 'powershell.exe') {\n379\t      let reason = null;\n380\t      try {\n381\t        assert(nativeLaunches === 0 && process.argv[1] === workerPath);\n382\t        const payload = JSON.parse(process.argv[2]), c = CASES.find(c => basename(root) === c.caseId);\n383\t        assert(c && same(args, nativeArgs(c)) && command === 'powershell.exe' && payload.command === command && same(payload.args, args));\n384\t        assert(matchNativeIdentity({ root, command, args, options, argv: process.argv, childPid: 1 }));\n385\t        gate.transaction(env.TW_PARITY_COUNTER, bytes => {\n386\t          const used = counterState(bytes);\n387\t          reason = nativeAdmission({ now: Date.now(), deadline: expiry, timeoutMs: payload.timeoutMs, usedTotal: used.total, usedSmoke: used.smoke });\n388\t          if (reason) throw new Error('admission denied');\n389\t          return Buffer.from(JSON.stringify({ event: 'powershell-admission', kind: 'smoke' }) + '\\n');\n390\t        });\n391\t        nativeLaunches++;\n392\t      } catch { reason ??= 'native-budget-counter-unavailable'; fail('GUARD_COUNTER_IO'); }\n393\t      if (reason || failed) {\n394\t        log({ event: 'diagnostic-budget-abort', reason: reason ?? 'native-budget-counter-unavailable' });\n395\t        throw Object.assign(new Error('diagnostic budget unavailable'), { code: 'TW_PARITY_BUDGET' });\n396\t      }\n397\t    }\n398\t    const child = originalSpawn.call(this, command, args, options);\n399\t    children.add(child);\n400\t    log({ event: 'spawn', executable: exe, childPid: child.pid ?? null, detached: options?.detached ?? false });\n401\t    child.on(errorMonitor, error => {\n402\t      const code = safeCode(error?.code);\n403\t      if (code === 'UNRECOGNIZED_ERROR_CODE') fail('GUARD_UNSAFE_METADATA');\n404\t      log({ event: 'child-error', executable: exe, childPid: child.pid ?? null, code });\n405\t    });\n406\t    child.on('exit', (status, signal) => log({ event: 'child-exit', executable: exe, childPid: child.pid ?? null, status, signal }));\n407\t    let recorder = null;\n408\t    if (exe === 'powershell.exe') {\n409\t      const matched = matchNativeIdentity({ root, command, args, options, argv: process.argv, childPid: child.pid });\n410\t      if (!matched) fail('GUARD_UNSAFE_METADATA');\n411\t      else {\n412\t        recorder = attachNativeRecorder(child, { root, command, args, options, argv: process.argv }, log);\n413\t        recorders.add(recorder);\n414\t        if (!child.stdout || !child.stderr) fail('GUARD_UNSAFE_METADATA');\n415\t      }\n416\t    }\n417\t    child.on('close', (status, signal) => {\n418\t      recorder?.finish(); if (recorder) recorders.delete(recorder);\n419\t      children.delete(child); log({ event: 'child-close', executable: exe, childPid: child.pid ?? null, status, signal });"}
