ref\":\"#/$defs/sha\"},\"expectedSha\":{\"$ref\":\"#/$defs/sha\"},\"planningBase\":{\"const\":\"93a61ba69504d6e9c1eee803c5ee4e2750c54640\"},\"timestampUtc\":{\"type\":\"string\",\"pattern\":\"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\\\.[0-9]{3})?Z$\"},\"runId\":{\"type\":\"string\",\"pattern\":\"^[1-9][0-9]{0,19}$\"},\"runAttempt\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":1000000},\"ref\":{\"const\":\"refs/heads/codex/windows-p1-stages-ci-20261010\"},\"runtime\":{\"$ref\":\"#/$defs/runtime\"},\"sourceFiles\":{\"type\":\"array\",\"minItems\":11,\"maxItems\":11,\"items\":{\"$ref\":\"#/$defs/sourceFile\"}},\"environmentKeyNames\":{\"type\":\"array\",\"uniqueItems\":true,\"maxItems\":27,\"items\":{\"type\":\"string\",\"maxLength\":32}},\"extraEnvironmentKeys\":{\"const\":[]},\"provenanceUnknown\":{\"const\":false},\"releaseReady\":{\"const\":false},\"releaseAcceptance\":{\"const\":false}\n176\t      }},\n177\t      \"checksSummary\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"format\",\"testPath\",\"exitCode\",\"passed\",\"failed\",\"skipped\",\"allRequiredControlsPassed\",\"rawReportSuppressed\",\"releaseAcceptance\"],\"properties\":{\n178\t        \"format\":{\"const\":\"windows-p1-initial-checks-v1\"},\"testPath\":{\"const\":\"tests/diagnostics/windows-p1-stages.test.ts\"},\"exitCode\":{\"enum\":[0,1,null]},\"passed\":{\"$ref\":\"#/$defs/uint\"},\"failed\":{\"$ref\":\"#/$defs/uint\"},\"skipped\":{\"$ref\":\"#/$defs/uint\"},\"allRequiredControlsPassed\":{\"type\":\"boolean\"},\"rawReportSuppressed\":{\"const\":true},\"releaseAcceptance\":{\"const\":false}\n179\t      }},\n180\t      \"manifest\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"format\",\"executionSha\",\"files\",\"releaseAcceptance\"],\"properties\":{\n181\t        \"format\":{\"const\":\"windows-p1-initial-manifest-v1\"},\"executionSha\":{\"$ref\":\"#/$defs/sha\"},\"files\":{\"type\":\"array\",\"minItems\":15,\"maxItems\":15,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"path\",\"bytes\",\"sha256\"],\"properties\":{\"path\":{\"enum\":[\"provenance.json\",\"checks-summary.json\",\"summary.json\",\"T0.case.json\",\"T1.case.json\",\"T2.case.json\",\"T3.case.json\",\"T0.guard.jsonl\",\"T1.guard.jsonl\",\"T2.guard.jsonl\",\"T3.guard.jsonl\",\"T0.trace.jsonl\",\"T1.trace.jsonl\",\"T2.trace.jsonl\",\"T3.trace.jsonl\"]},\"bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":524288},\"sha256\":{\"$ref\":\"#/$defs/hash\"}}}},\"releaseAcceptance\":{\"const\":false}\n182\t      }}\n183\t    }\n184\t  },\n185\t  \"schema_resolution\":\"Treat schemas as its own JSON Schema document; all #/$defs references are local to schemas, with no network resolver. Validators must also enforce cross_field_invariants.\",\n186\t  \"cross_field_invariants\": [\n187\t    \"variant/caseId/scriptSha256/root basename/worker payload agree with exactly one cases row; no extra executable script or variant\",\n188\t    \"Guard baseline and old-trace events use frozen native-runtime-parity.mjs evidenceEvent family schemas and SAFE_CODES/SAFE_SIGNALS/ABORT_REASONS unchanged; new stage/end events are guard-only\",\n189\t    \"Guard base pid is the owning worker pid; childPid is the admitted owned live PowerShell handle; event sequence remains per-pid ordered and complete\",\n190\t    \"markers is an exact prefix of variant sequence; ordinal starts at zero; notObserved is exactly its remaining suffix; stream acceptedMarkers equals accepted stage count\",\n191\t    \"stream eofObserved equals stdoutEofObserved && stderrEofObserved; combinedBytes is saturated at 16385; per-stream counts saturated at 16384; without overflow combinedBytes equals their sum\",\n192\t    \"Both EOF flags and no stream error/parser error/stderr are required for complete-prefix or complete-sequence; missing end event is unknown; reasons match state\",\n193\t    \"Root stdout/stderr counters are capped individually at65536; combined nonoverflow bytes never exceed65536; root stderr/nonempty canary/overflow/metadata unknown/stop/abort makes observation incomplete\",\n194\t    \"native completed/refused require actual API-return metadataSource/workerKind ok/errorName null/errorCode null/signal null; completed status0/full sequence; clean refused safe nonzero returned status/permitted prefix\",\n195\t    \"All normal API return status/signal must equal all four unique owned native guard/trace child-exit/child-close facts, identity-bound to admitted childPid/owning worker/case/root/script; Node worker spawn-sync status/signal cannot substitute\",\n196\t    \"Throw/nonreturn API status/signal remain null; errorName/code derive only from actual runBoundedSubprocess thrown API instance; timeout/output/supervision code null, launch safeCode(actual code) or null when absent; no DiagnosticEvidenceError renamed as API error\",\n197\t    \"Throw-path native exit/close ownership and consistency are independent facts only, never copied into unavailable API return fields; timeout cannot fabricate status0/EIO/signal from class or trace\",\n198\t    \"Missing/duplicate/contradictory API source/error/worker/admitted native exit-close tuples make observation unknown and stop T1/T2 progression; reject raw contradictory tuple and safe-rebuild unknown, not clean refusal\",\n199\t    \"native timeout requires actual API-throw metadataSource/timeout class/null return status and signal/null code/workerKind timeout, plus all unchanged EOF/health/cleanup/provenance conditions for clean observation\",\n200\t    \"probe workerKind is reconciled against old trace spawn-sync worker result, never inferred from error class alone\",\n201\t    \"diagnostic_observation_complete requires all original root/guard/trace/cleanup/provenance/counter conditions, valid prefix and clean native outcome; markers never override an unknown\",\n202\t    \"skipped case has rootProcessStarted false/nativeLaunches0/empty markers/null stream/root/health/native not-started; unknown count/start must remain null rather than fabricate skips\",\n203\t    \"Exactly four case records in T0-T3 order; selection table applies once; no launch after stop; each started case at most one native admission\",\n204\t    \"Native admissions sum to total/smoke counts and per-case known counts; counter uses unchanged counter schema; no reset or extra allowance; missing counter makes counts null and observation incomplete\",\n205\t    \"summary diagnosticExitCode0 means complete diagnostic observation, not native/product/release success; incomplete exits1 or remainsnull if outcome unknown\",\n206\t    \"sourceFiles contains exactly future_added_source_paths plus delivery JSON path plus frozen_runtime_sources paths (11), no others; hashes bind exact candidate bytes\",\n207\t    \"provenance executionSha equals expectedSha, actual git HEAD and summary/manifest executionSha; frozen hashes and planning base must match; source commits are not historical run identity\",\n208\t    \"environmentKeyNames equals the sorted set of admitted present E0 system keys plus exactly synthetic_keys; values are never exported; no extra key\",\n209\t    \"checksSummary allRequiredControlsPassed requires scoped report valid/exit0/failed0/skipped0 and every declared control checked; never upload raw Vitest report\",\n210\t    \"manifest has exactly one entry per other upload file, sorted by path, SHA256 and bytes match; JSON cap65536 and JSONL cap524288 apply inclusively; no extra files or symlinks\",\n211\t    \"Public guard/trace JSONL is strictly rebuilt; invalid/missing evidence is suppressed to empty safe file with case incompleteness preserved; never raw-copy fallback\",\n212\t    \"wholeTreeAbsenceProven and all release flags are always false; root retained when cleanup unknown; never signal historical PIDs\"\n213\t  ],\n214\t  \"required_future_controls\": [\"all-token-chunk-splits-and-LF-CRLF\",\"timeout-prefix-immediate-safe-persistence\",\"missing-EOF-event-health-or-stream-error\",\"unsafe-bytes-canaries-stderr-and-order\",\"handle-pid-case-script-identity\",\"all-inclusive-caps-and-plus-one\",\"concurrent-append-and-lock-failure\",\"counter-and-clock-admission-boundaries\",\"cleanup-trace-provenance-independent-unknown\",\"every-selection-row-zero-skipped-launches\",\"strict-extra-key-rejection\",\"import-without-side-effects\",\"exact-source-workflow-and-upload-file-set\",\"B001-actual-API-source-return-throw-and-owned-native-exit-close-counterexamples-at-T1-T2\"],\n215\t  \"performed\":{\"author_static_consistency_checks\":true,\"native_tests\":false,\"functional_tests\":false,\"implementation\":false,\"ci\":false,\"network\":false,\"dependency_install\":false,\"push\":false,\"state_or_memory_edits\":false},\n216\t  \"unresolved_bindings\": [],\n217\t  \"unverified_obligations\":[\"actual additive-listener and inclusive-lock implementation correctness\",\"synthetic controls and independent cross-family functional acceptance\",\"runner provenance and actual clean EOF availability\",\"observer perturbation and original PowerShell internal cause\",\"whole process-tree absence and outstanding release gates\"],\n218\t  \"exclusions\":[\"T4/T5 scripts or executable selectors\",\"module probes\",\"environment arms or command repair\",\"timeout extensions\",\"native retries\",\"P2/downstream/product repair\",\"original source/test/workflow/state/memory edits\",\"keys-age-or-off-host-backup\",\"worker publication or pending_gate decision\"]\n219\t}"}
