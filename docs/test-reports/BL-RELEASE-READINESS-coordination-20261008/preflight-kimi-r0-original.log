n38\t    expect(invoke(report()).status).toBe(0);\n39\t  });\n40\t\n41\t  it(\"rejects another OS even when the target passed\", () => {\n42\t    const result = invoke(report(), \"linux\");\n43\t    expect(result.status).not.toBe(0);\n44\t    expect(result.stderr).toContain(\"requires a native macOS runner\");\n45\t  });\n46\t\n47\t  it(\"makes the exact native fixture an independent prerequisite for artifacts and deploy\", () => {\n48\t    const workflow = readFileSync(\".github/workflows/deploy-vps.yml\", \"utf8\");\n49\t    const job = workflow.slice(workflow.indexOf(\"  verify-macos-agent:\"), workflow.indexOf(\"  verify-db:\"));\n50\t    const fixture = readFileSync(\"tests/cli/agent-release-installer-macos.test.ts\", \"utf8\");\n51\t    expect(job).toContain(\"runs-on: macos-latest\");\n52\t    expect(job).toContain('launchctl print \"gui/$(id -u)\"');\n53\t    expect(job).toContain(\"tests/cli/agent-release-installer-macos.test.ts\");\n54\t    expect(job).toContain(\"node scripts/ci/assert-macos-launchd-installer.mjs\");\n55\t    expect(job).toContain('RUNNER_TEMP=\"$(cd \"$RUNNER_TEMP\" && pwd -P)\"');\n56\t    expect(job).toContain('TMPDIR=\"$RUNNER_TEMP\"');\n57\t    expect(job).toContain(\"export RUNNER_TEMP TMPDIR\");\n58\t    expect(job).toContain('\"$TOKENIZER_FIXTURE_ROOT\" != \"$RUNNER_TEMP\"/tokenizer-macos-launchd-*');\n59\t    expect(fixture).toContain('mkdtempSync(join(tmpdir(), \"tokenizer-macos-launchd-\"))');\n60\t    expect(job).toContain(\"trap cleanup_native_fixture EXIT INT TERM\");\n61\t    expect(job).toContain('\"$TOKENIZER_FIXTURE_LABEL\" != cc.tokenizer.agent.ci.*');\n62\t    expect(job).toContain(\"if-no-files-found: error\");\n63\t    expect(workflow).toContain(\"needs: [verify, verify-windows, verify-macos-agent, verify-db, verify-browser]\");\n64\t    expect(workflow).toContain(\"needs: [verify, verify-windows, verify-macos-agent, verify-db, verify-browser, release-artifact]\");\n65\t  });\n66\t\n67\t  it.each([\n68\t    report({ success: false }),\n69\t    report({ numFailedTests: 1 }),\n70\t    report({ numPassedTests: 0 }),\n71\t    report({ testResults: [{ assertionResults: [{ fullName: exactName, status: \"skipped\" }] }] }),\n72\t    report({ testResults: [{ assertionResults: [{ fullName: `${exactName} renamed`, status: \"passed\" }] }] }),\n73\t    report({ testResults: [{ assertionResults: [\n74\t      { fullName: exactName, status: \"passed\" },\n75\t      { fullName: exactName, status: \"passed\" }\n76\t    ] }] })\n77\t  ])(\"rejects missing, skipped, failed, renamed, or duplicate native evidence %#\", (body) => {\n78\t    expect(invoke(body).status).not.toBe(0);\n79\t  });\n80\t});"}
{"role":"tool","tool_call_id":"tool_V9pNlZhX5WJAGuW2YdlQdiKi","content":"1\timport { spawnSync } from \"node:child_process\";\n2\timport { chmodSync, existsSync, mkdtempSync, mkdirSync, readFileSync, realpathSync, rmSync, writeFileSync } from \"node:fs\";\n3\timport { tmpdir } from \"node:os\";\n4\timport { join } from \"node:path\";\n5\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n6\t\n7\tlet sandbox: string;\n8\t\n9\tfunction nativeStep(bindTemp = true): string {\n10\t  const workflow = readFileSync(\".github/workflows/deploy-vps.yml\", \"utf8\");\n11\t  const name = workflow.indexOf(\"      - name: Verify native macOS launchd pinned installer\\n\");\n12\t  const start = workflow.indexOf(\"        run: |\\n\", name) + \"        run: |\\n\".length;\n13\t  const end = workflow.indexOf(\"      - name: Upload native macOS launchd installer evidence\\n\", start);\n14\t  if (name < 0 || start < \"        run: |\\n\".length || end < 0) throw new Error(\"Native macOS workflow step not found\");\n15\t  const step = workflow.slice(start, end).split(\"\\n\").map((line) => line.replace(/^ {10}/, \"\")).join(\"\\n\");\n16\t  if (bindTemp) return step;\n17\t  const binding = [\n18\t    ': \"${RUNNER_TEMP:?RUNNER_TEMP is required for native fixture cleanup}\"',\n19\t    'RUNNER_TEMP=\"$(cd \"$RUNNER_TEMP\" && pwd -P)\"',\n20\t    'TMPDIR=\"$RUNNER_TEMP\"',\n21\t    \"export RUNNER_TEMP TMPDIR\"\n22\t  ].join(\"\\n\");\n23\t  if (!step.includes(binding)) throw new Error(\"Native fixture temp binding not found\");\n24\t  return step.replace(binding, \"\");\n25\t}\n26\t\n27\tfunction executable(path: string, body: string): void {\n28\t  writeFileSync(path, `#!/usr/bin/env bash\\n${body}\\n`);\n29\t  chmodSync(path, 0o755);\n30\t}\n31\t\n32\tfunction runInterruptedStep(outOfScope = false, bindTemp = true) {\n33\t  const runnerTemp = join(sandbox, \"runner-temp\");\n34\t  const nodeTemp = join(sandbox, \"node-temp\");\n35\t  const outsideTemp = join(sandbox, \"outside-temp\");\n36\t  const fakeBin = join(sandbox, \"fake-bin\");\n37\t  for (const dir of [runnerTemp, nodeTemp, outsideTemp, fakeBin]) mkdirSync(dir);\n38\t  const launchctlCalls = join(sandbox, \"launchctl-calls.txt\");\n39\t  executable(join(fakeBin, \"npx\"), [\n40\t    \"set -euo pipefail\",\n41\t    ...(bindTemp ? [\n42\t      '[[ \"$TMPDIR\" = \"$RUNNER_TEMP\" ]] || exit 65',\n43\t      '[[ \"$(node -p \\'require(\"node:os\").tmpdir()\\')\" = \"$RUNNER_TEMP\" ]] || exit 66'\n44\t    ] : []),\n45\t    'fixture_root=\"$(mktemp -d \"${FIXTURE_ROOT_BASE:-$TMPDIR}/tokenizer-macos-launchd-XXXXXX\")\"',\n46\t    'plist=\"$fixture_root/home/Library/LaunchAgents/cc.tokenizer.agent.ci.probe.plist\"',\n47\t    'mkdir -p \"$(dirname \"$plist\")\"',\n48\t    'touch \"$plist\"',\n49\t    'printf \"TOKENIZER_FIXTURE_ROOT=%s\\\\nTOKENIZER_FIXTURE_PLIST=%s\\\\nTOKENIZER_FIXTURE_LABEL=cc.tokenizer.agent.ci.probe\\\\n\" \"$fixture_root\" \"$plist\" > .ci/macos-launchd-cleanup.env',\n50\t    'printf \"%s\\\\n\" \"$fixture_root\" > observed-root.txt',\n51\t    \"exit 42\"\n52\t  ].join(\"\\n\"));\n53\t  executable(join(fakeBin, \"launchctl\"), 'printf \"%s\\\\n\" \"$*\" >> \"$LAUNCHCTL_CALLS\"');\n54\t  for (const command of [\"ps\", \"sleep\", \"xargs\"]) executable(join(fakeBin, command), \"exit 0\");\n55\t  const run = spawnSync(\"bash\", [\"-c\", nativeStep(bindTemp)], {\n56\t    cwd: sandbox,\n57\t    env: {\n58\t      ...process.env,\n59\t      RUNNER_TEMP: runnerTemp,\n60\t      TMPDIR: nodeTemp,\n61\t      FIXTURE_ROOT_BASE: outOfScope ? outsideTemp : \"\",\n62\t      LAUNCHCTL_CALLS: launchctlCalls,\n63\t      PATH: `${fakeBin}:${process.env.PATH}`\n64\t    },\n65\t    encoding: \"utf8\",\n66\t    timeout: 10_000\n67\t  });\n68\t  const root = readFileSync(join(sandbox, \"observed-root.txt\"), \"utf8\").trim();\n69\t  return { run, root, runnerTemp, nodeTemp, launchctlCalls,\n70\t    cleanupRecord: join(sandbox, \".ci\", \"macos-launchd-cleanup.env\") };\n71\t}\n72\t\n73\tdescribe.skipIf(process.platform === \"win32\")(\"native macOS workflow abnormal-exit cleanup\", () => {\n74\t  beforeEach(() => { sandbox = mkdtempSync(join(tmpdir(), \"b04-macos-trap-\")); });\n75\t  afterEach(() => rmSync(sandbox, { recursive: true, force: true }));\n76\t\n77\t  it(\"overrides a different Node temp directory and cleans the interrupted fixture\", () => {\n78\t    const { run, root, runnerTemp, nodeTemp, launchctlCalls, cleanupRecord } = runInterruptedStep();\n79\t    expect(nodeTemp).not.toBe(runnerTemp);\n80\t    expect(run.status, run.stderr).toBe(42);\n81\t    expect(root.startsWith(`${realpathSync(runnerTemp)}/tokenizer-macos-launchd-`)).toBe(true);\n82\t    expect(existsSync(root)).toBe(false);\n83\t    expect(existsSync(cleanupRecord)).toBe(false);\n84\t    expect(readFileSync(launchctlCalls, \"utf8\")).toContain(\"unload \");\n85\t  });\n86\t\n87\t  it(\"refuses to delete an out-of-scope cleanup record on abnormal exit\", () => {\n88\t    const { run, root, launchctlCalls, cleanupRecord } = runInterruptedStep(true);\n89\t    expect(run.status, run.stderr).toBe(42);\n90\t    expect(run.stderr).toContain(\"Refusing an out-of-scope launchd fixture cleanup record\");\n91\t    expect(existsSync(root)).toBe(true);\n92\t    expect(existsSync(cleanupRecord)).toBe(true);\n93\t    expect(existsSync(launchctlCalls)).toBe(false);\n94\t  });\n95\t\n96\t  it(\"negative control: without the temp binding, an interrupted fixture is orphaned\", () => {\n97\t    const { run, root, launchctlCalls, cleanupRecord } = runInterruptedStep(false, false);\n98\t    expect(run.status, run.stderr).toBe(42);\n99\t    expect(run.stderr).toContain(\"Refusing an out-of-scope launchd fixture cleanup record\");\n100\t    expect(existsSync(root)).toBe(true);\n101\t    expect(existsSync(cleanupRecord)).toBe(true);\n102\t    expect(existsSync(launchctlCalls)).toBe(false);\n103\t  });\n104\t});"}
