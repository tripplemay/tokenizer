e = run({ SCENARIO: 'missing-app' });\n259\t    const { result, artifact } = runWorkflow(remote.stdout, { SSH_STATUS: '1' });\n260\t    expect(result.status).not.toBe(0);\n261\t    expect(JSON.parse(artifact)).toMatchObject({ outcome: 'refused', reason: 'missing_or_multiple_app' });\n262\t    expect(`${artifact}${result.stderr}`).not.toContain(canary);\n263\t  });\n264\t});\n265\t\n266\tdescribe('host-preflight operation separation and preserved release gates', () => {\n267\t  it('dispatches inventory alone even on main, and preserves push/PR/release gates', () => {\n268\t    const gates = ['verify','verify-windows','verify-macos-agent','verify-db','verify-browser','release-artifact'];\n269\t    for (const name of gates) {\n270\t      const job = workflow.slice(workflow.indexOf(`  ${name}:\\n`)).split(/\\n  [a-z][a-z-]+:\\n/)[0];\n271\t      expect(job).toContain(\"if: github.event_name != 'workflow_dispatch' || inputs.operation == 'release'\");\n272\t    }\n273\t    expect(workflow).toContain(\"if: github.event_name == 'workflow_dispatch' && inputs.operation == 'host-preflight'\");\n274\t    expect(workflow).toContain(\"(github.event_name == 'workflow_dispatch' && inputs.operation == 'release')\");\n275\t    for (const [event, operation, release, inventory] of [\n276\t      ['push', undefined, true, false], ['pull_request', undefined, true, false],\n277\t      ['workflow_dispatch', 'release', true, false], ['workflow_dispatch', 'host-preflight', false, true],\n278\t      ['workflow_dispatch', 'unknown', false, false]\n279\t    ]) {\n280\t      expect(event !== 'workflow_dispatch' || operation === 'release').toBe(release);\n281\t      expect(event === 'workflow_dispatch' && operation === 'host-preflight').toBe(inventory);\n282\t    }\n283\t    const job = workflow.slice(workflow.indexOf('  host-preflight:\\n'), workflow.indexOf('  verify:\\n'));\n284\t    expect(job).not.toMatch(/npm ci|build-push|docker\\/login|rsync|\\bscp\\b|rehearse-release|migrate deploy|deploy