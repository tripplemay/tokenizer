{"role":"tool","tool_call_id":"tool_pHhGLzeKRcRBVJLepw8mm2Zj","content":"1\timport { spawnSync } from 'node:child_process';\n2\timport { chmodSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';\n3\timport { tmpdir } from 'node:os';\n4\timport { join } from 'node:path';\n5\timport { afterEach, beforeEach, describe, expect, it } from 'vitest';\n6\t\n7\tconst sha = 'c'.repeat(40), oldSha = 'd'.repeat(40);\n8\tconst imageId = `sha256:${'a'.repeat(64)}`;\n9\tconst app = `ghcr.io/test/app@${imageId}`, migrate = `ghcr.io/test/migrate@sha256:${'b'.repeat(64)}`;\n10\tlet root: string;\n11\tconst script = join(process.cwd(), 'scripts/verify-vps-predecessor.sh');\n12\tconst baseline = `GIT_COMMIT=${oldSha}\\nAPP_IMAGE=${app}\\nMIGRATE_IMAGE=${migrate}\\nAPP_HOST_PORT=127.0.0.1:3010\\nAUTH_SECRET=synthetic-secret-canary\\n`;\n13\t\n14\tfunction executable(name: string, body: string) {\n15\t  const path = join(root, 'bin', name);\n16\t  writeFileSync(path, `#!/usr/bin/env bash\\n${body}\\n`);\n17\t  chmodSync(path, 0o755);\n18\t}\n19\t\n20\tfunction snapshot(directory = root, prefix = ''): Record<string, string> {\n21\t  return Object.fromEntries(readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {\n22\t    if (entry.name === 'calls') return [];\n23\t    const path = join(directory, entry.name), key = `${prefix}${entry.name}`;\n24\t    return entry.isDirectory() ? Object.entries(snapshot(path, `${key}/`)) : [[key, readFileSync(path).toString('hex')]];\n25\t  }));\n26\t}\n27\t\n28\tfunction run(overrides: Record<string, string> = {}) {\n29\t  return spawnSync('bash', [script, 'live', sha, app, migrate], { cwd: root, encoding: 'utf8', timeout: 5_000,\n30\t    env: { ...process.env, PATH: `${join(root, 'bin')}:${process.env.PATH}`, ...overrides } });\n31\t}\n32\t\n33\tdescribe.skipIf(process.platform === 'win32')('additive predecessor fail-closed controls', () => {\n34\t  beforeEach(() => {\n35\t    root = mkdtempSync(join(tmpdir(), 'predecessor-'));\n36\t    mkdirSync(join(root, 'bin'));\n37\t    mkdirSync(join(root, '.releases'));\n38\t    writeFileSync(join(root, '.env'), baseline);\n39\t    writeFileSync(join(root, 'docker-compose.yml'), 'services:\\n  app: {}\\n');\n40\t    writeFileSync(join(root, 'docker-compose.release.yml'), 'services:\\n  app: {}\\n');\n41\t    writeFileSync(join(root, '.releases', `${oldSha}.manifest`), `commit=${oldSha}\\napp_image=${app}\\nmigrate_image=${migrate}\\n`);\n42\t    writeFileSync(join(root, '.releases', `${oldSha}.activated`), `commit=${oldSha}\\napp_image=${app}\\napp_id=${imageId}\\n`);\n43\t    executable('docker', `printf '%s\\\\n' \"$*\" >> calls\n44\tcase \"$*\" in\n45\t  'image inspect --format {{.Id}} '*) printf '%s\\\\n' '${imageId}' ;;\n46\t  *'config --quiet') exit 0 ;;\n47\t  *'config --format json') printf '{\"name\":\"fixture\"}\\\\n' ;;\n48\t  *'ps -q app') printf '%s\\\\n' \"\\${APP_IDS-aaaaaaaaaaaa}\" ;;\n49\t  inspect*) printf '%s\\\\n' \"\\${DETAILS-true|fixture|app|${imageId}}\" ;;\n50\t  'port aaaaaaaaaaaa 3000/tcp') printf '%s\\\\n' \"\\${PORT-127.0.0.1:3010}\" ;;\n51\t  *) echo 'mutation-or-unknown-command' >&2; exit 99 ;;\n52\tesac`);\n53\t    executable('curl', `if [ \"\\${HEALTH_BODY+x}\" = x ]; then printf '%s\\\\n' \"$HEALTH_BODY\"; else printf '%s\\\\n' '{\"ok\":true,\"code\":\"ready\",\"commit\":\"${oldSha}\"}'; fi`);\n54\t  });\n55\t  afterEach(() => rmSync(root, { recursive: true, force: true }));\n56\t\n57\t  it.each([\n58\t    { APP_IDS: '' }, { APP_IDS: 'aaaaaaaaaaaa\\nbbbbbbbbbbbb' },\n59\t    { DETAILS: `false|fixture|app|${imageId}` }, { DETAILS: `true|other|app|${imageId}` },\n60\t    { DETAILS: `true|fixture|postgres|${imageId}` }, { DETAILS: `true|fixture|app|sha256:${'e'.repeat(64)}` },\n61\t    { PORT: '0.0.0.0:3010' },\n62\t    { HEALTH_BODY: `{\"ok\":true,\"code\":\"db_unavailable\",\"commit\":\"${oldSha}\"}` },\n63\t    { HEALTH_BODY: `{\"ok\":true,\"code\":null,\"commit\":\"${oldSha}\"}` },\n64\t    { HEALTH_BODY: `{\"ok\":true,\"code\":\"ready\",\"commit\":\"${sha}\"}` }\n65\t  ])('refuses wrong or missing serving identity without writes %#', (overrides) => {\n66\t    const before = snapshot();\n67\t    const result = run(overrides);\n68\t    expect(result.status, result.stdout).not.toBe(0);\n69\t    expect(snapshot()).toEqual(before);\n70\t    expect(`${result.stdout}${result.stderr}`).not.toContain('synthetic-secret-canary');\n71\t    expect(readFileSync(join(root, 'calls'), 'utf8')).not.toMatch(/pull|\\bup\\b|stop|run|login|exec/);\n72\t  });\n73\t\n74\t  it.each(['legacy-image', 'missing-activation', 'duplicate-sha', 'same-sha', 'manifest-diff', 'activation-diff'])\n75\t    ('refuses incomplete or conflicting predecessor provenance: %s', (kind) => {\n76\t      if (kind === 'legacy-image') writeFileSync(join(root, '.env'), baseline.replace(app, 'tokenizer-app:legacy'));\n77\t      if (kind === 'missing-activation') rmSync(join(root, '.releases', `${oldSha}.activated`));\n78\t      if (kind === 'duplicate-sha') writeFileSync(join(root, '.env'), `${baseline}GIT_COMMIT=${oldSha}\\n`);\n79\t      if (kind === 'same-sha') writeFileSync(join(root, '.env'), baseline.replace(oldSha, sha));\n80\t      if (kind === 'manifest-diff') writeFileSync(join(root, '.releases', `${oldSha}.manifest`), 'wrong\\n');\n81\t      if (kind === 'activation-diff') writeFileSync(join(root, '.releases', `${oldSha}.activated`), 'wrong\\n');\n82\t      const before = snapshot();\n83\t      expect(run().status).not.toBe(0);\n84\t      expect(snapshot()).toEqual(before);\n85\t    });\n86\t\n87\t  it('accepts the old health shape only with exact activated identity and preserves every byte', () => {\n88\t    const before = snapshot();\n89\t    const result = run({ HEALTH_BODY: `{\"ok\":true,\"commit\":\"${oldSha}\"}` });\n90\t    expect(result.status, result.stderr).toBe(0);\n91\t    expect(snapshot()).toEqual(before);\n92\t  });\n93\t});"}
{"role":"tool","tool_call_id":"tool_xcf0GK1uTOb8LlGjJZko1Vd6","content":"1\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n2\timport { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from \"node:fs\";\n3\timport { spawnSync } from \"node:child_process\";\n4\timport { tmpdir } from \"node:os\";\n5\timport { join } from \"node:path\";\n6\t\n7\tconst sha = \"c\".repeat(40);\n8\tconst oldSha = \"d\".repeat(40);\n9\tconst appId = `sha256:${\"a\".repeat(64)}`;\n10\tconst migrateId = `sha256:${\"b\".repeat(64)}`;\n11\tconst appImage = `ghcr.io/test/app@${appId}`;\n12\tconst migrateImage = `ghcr.io/test/migrate@${migrateId}`;\n13\tlet dir: string;\n14\t\n15\tfunction fixture() {\n16\t  dir = mkdtempSync(join(tmpdir(), \"tokenizer-release-\"));\n17\t  const bin = join(dir, \"bin\");\n18\t  mkdirSync(bin);\n19\t  mkdirSync(join(dir, \"scripts\", \"test\"), { recursive: true });\n20\t  for (const name of [\"deploy-vps-release.sh\", \"verify-release-image.sh\", \"verify-vps-predecessor.sh\"]) {\n21\t    symlinkSync(join(process.cwd(), \"scripts\", name), join(dir, \"scripts\", name));\n22\t  }\n23\t  writeFileSync(join(dir, \"scripts\", \"test\", \"rehearse-release.sh\"), `#!/usr/bin/env bash\n24\tprintf 'rehearsal\\\\n' >> \"$CALLS\"\n25\tif [[ \"$MOCK_REHEARSAL_FAIL\" == 1 ]]; then exit 7; fi\n26\tif [[ \"$MOCK_ROLLBACK\" == 1 ]]; then printf 'app_image=${appImage}\\\\n' > \".releases/$EXPECTED_SHA.rollback-approved\"; fi\n27\t`);\n28\t  const env = `GIT_COMMIT=${sha}\\nAPP_IMAGE=${appImage}\\nMIGRATE_IMAGE=${migrateImage}\\nAPP_HOST_PORT=127.0.0.1:3010\\nADMIN_TOKEN=admin-token-with-at-least-thirty-two-characters\\nAUTH_SECRET=auth-secret-with-at-least-thirty-two-characters\\nAUTH_RESEND_KEY=re_test\\nNEXT_PUBLIC_APP_URL=https://token.example.test\\nPOSTGRES_PASSWORD=existing-db-password\\n`;\n29\t  writeFileSync(join(dir, \".env\"), env);\n30\t  writeFileSync(join(dir, \"docker-compose.yml\"), \"services:\\n  app: {}\\n\");\n31\t  writeFileSync(join(dir, \"docker-compose.release.yml\"), \"services:\\n  app: {}\\n\");\n32\t  mkdirSync(join(dir, \".releases\"));\n33\t  writeFileSync(join(dir, \".releases\", `${sha}.previous-env`), env.replace(sha, oldSha));\n34\t  writeFileSync(join(dir, \".releases\", `${oldSha}.manifest`), `commit=${oldSha}\\napp_image=${appImage}\\nmigrate_image=${migrateImage}\\n`);\n35\t  writeFileSync(join(dir, \".releases\", `${oldSha}.activated`), `commit=${oldSha}\\napp_image=${appImage}\\napp_id=${appId}\\n`);\n36\t  writeFileSync(join(bin, \"docker\"), `#!/usr/bin/env bash\n37\tprintf '%s\\\\n' \"$*\" >> \"$CALLS\"\n38\tif [[ \"$1 $2\" == \"image inspect\" ]]; then\n39\t  if [[ \"$*\" != *org.opencontainers.image.revision* ]]; then\n40\t    echo \"$MOCK_APP_ID\"\n41\t  elif [[ \"$*\" == *ghcr.io/test/app* ]]; then\n42\t    printf '%s|%s\\\\n' \"$MOCK_APP_ID\" \"$MOCK_REVISION\"\n43\t  else\n44\t    printf '%s|%s\\\\n' \"$MOCK_MIGRATE_ID\" \"$MOCK_REVISION\"\n45\t  fi\n46\telif [[ \"$*\" == *\"config --format json\"* ]]; then\n47\t  if [[ \"$*\" == *\"--env-file .env\"* && -n \"$MOCK_CANDIDATE_PROJECT\" ]]; then\n48\t    printf '{\"name\":\"%s\"}\\\\n' \"$MOCK_CANDIDATE_PROJECT\"\n49\t  else printf '{\"name\":\"fixture\"}\\\\n'; fi\n50\telif [[ \"$*\" == *\"ps -q app\"* ]]; then\n51\t  if [[ \"$MOCK_NO_APP\" != 1 ]]; then echo aaaaaaaaaaaa; fi\n52\telif [[ \"$1\" == \"inspect\" ]]; then\n53\t  echo \"true|${\"${MOCK_PROJECT:-fixture}\"}|app|$MOCK_APP_ID\"\n54\telif [[ \"$1\" == \"port\" ]]; then\n55\t  echo \"${\"${MOCK_PORT:-127.0.0.1:3010}\"}\"\n56\telif [[ \"$*\" == *\"run --rm migrate\"* && \"$MOCK_MIGRATE_FAIL\" == 1 ]]; then\n57\t  exit 9\n58\tfi\n59\t`);\n60\t  writeFileSync(join(bin, \"curl\"), `#!/usr/bin/env bash\n61\tif ! grep -q 'up --no-deps -d app' \"$CALLS\"; then\n62\t  if [[ \"$MOCK_OLD_HEALTH_BAD\" == 1 ]]; then\n63\t    printf '{\"ok\":false,\"commit\":\"${oldSha}\"}\\\\n'\n64\t  elif [[ \"$MOCK_LEGACY_HEALTH\" == 1 ]]; then\n65\t    printf '{\"ok\":true,\"commit\":\"${oldSha}\"}\\\\n'\n66\t  else printf '{\"ok\":true,\"code\":\"ready\",\"commit\":\"${oldSha}\"}\\\\n'; fi\n67\telif [[ -f \".releases/$EXPECTED_SHA.rollback-approved\" && \"$MOCK_ROLLBACK\" == 1 && \"$MOCK_HEALTH_BODY\" != *'\"code\":\"ready\"'* ]]; then\n68\t  printf '{\"ok\":true,\"commit\":\"${oldSha}\"}\\\\n'\n69\telse printf '%s\\\\n' \"$MOCK_HEALTH_BODY\"; fi\n70\t`);\n71\t  writeFileSync(join(bin, \"sleep\"), \"#!/usr/bin/env bash\\nexit 0\\n\");\n72\t  for (const name of [\"docker\", \"curl\", \"sleep\"]) chmodSync(join(bin, name), 0o755);\n73\t}\n74\t\n75\tfunction runScript(script: string, overrides: Record<string, string> = {}) {\n76\t  return spawnSync(\"bash\", script === \"deploy-vps-release.sh\"\n77\t    ? [\"scripts/deploy-vps-release.sh\"]\n78\t    : [\"scripts/verify-vps-predecessor.sh\", \"live\", sha, appImage, migrateImage], {\n79\t    cwd: dir,\n80\t    encoding: \"utf8\",\n81\t    env: {\n82\t      ...process.env,\n83\t      PATH: `${join(dir, \"bin\")}:${process.env.PATH}`,\n84\t      CALLS: join(dir, \"calls.log\"),\n85\t      EXPECTED_SHA: sha,\n86\t      MOCK_APP_ID: appId,\n87\t      MOCK_MIGRATE_ID: migrateId,\n88\t      MOCK_REVISION: sha,\n89\t      MOCK_HEALTH_BODY: JSON.stringify({ ok: true, code: \"ready\", commit: sha }),\n90\t      MOCK_MIGRATE_FAIL: \"0\",\n91\t      MOCK_REHEARSAL_FAIL: \"0\",\n92\t      MOCK_ROLLBACK: \"0\",\n93\t      MOCK_NO_APP: \"0\",\n94\t      ...overrides\n95\t    }\n96\t  });\n97\t}\n98\t\n99\tconst deploy = (overrides: Record<string, string> = {}) => runScript(\"deploy-vps-release.sh\", overrides);\n100\t\n101\tfunction livePreflight(overrides: Record<string, string> = {}) {\n102\t  return runScript(\"verify-vps-predecessor.sh\", overrides);\n103\t}\n104\t\n105\tdescribe.skipIf(process.platform === \"win32\")(\"release image gate and fault rehearsal\", () => {\n106\t  beforeEach(fixture);\n107\t  afterEach(() => rmSync(dir, { recursive: true, force: true }));\n108\t\n109\t  it(\"deploys CI digests without rebuild and activates only exact readiness SHA\", () => {\n110\t    const result = deploy();\n111\t    expect(result.status).toBe(0);\n112\t    const calls = readFileSync(join(dir, \"calls.log\"), \"utf8\");\n113\t    expect(calls).not.toContain(\"compose build\");\n114\t    expect(calls).toContain(`pull ${appImage}`);\n115\t    expect(calls.indexOf(\"rehearsal\")).toBeLessThan(calls.indexOf(\"run --rm migrate\"));\n116\t    expect(calls.indexOf(\"run --rm migrate\")).toBeLessThan(calls.indexOf(\"up --no-deps -d app\"));\n117\t    expect(readFileSync(join(dir, \".releases\", `${sha}.manifest`), \"utf8\")).toContain(`app_image=${appImage}`);\n118\t    expect(readFileSync(join(dir, \".releases\", `${sha}.activated`), \"utf8\")).toContain(`commit=${sha}`);\n119\t  });\n120\t\n121\t  it(\"rejects an image revision mismatch before migration\", () => {\n122\t    const result = deploy({ MOCK_REVISION: \"d\".repeat(40) });\n123\t    expect(result.status).not.toBe(0);\n124\t    expect(readFileSync(join(dir, \"calls.log\"), \"utf8\")).not.toContain(\"run --rm migrate\");\n125\t  });\n126\t\n127\t  it(\"rejects an absent running Compose app before changing the release manifest\", () => {\n128\t    const result = deploy({ MOCK_NO_APP: \"1\" });\n129\t    expect(result.status).not.toBe(0);\n130\t    expect(result.stderr).toContain(\"exactly one running Compose app\");\n131\t    expect(existsSync(join(dir, \".releases\", `${sha}.manifest`))).toBe(false);\n132\t    expect(readFileSync(join(dir, \"calls.log\"), \"utf8\")).not.toContain(\"pull \");\n133\t  });\n134\t\n135\t  it(\"rejects a wrong Compose project or backend port before changing the release manifest\", () => {\n136\t    for (const overrides of [{ MOCK_PROJECT: \"wrong\" }, { MOCK_PORT: \"127.0.0.1:3999\" }, { MOCK_CANDIDATE_PROJECT: \"other\" }]) {\n137\t      const result = deploy(overrides);\n138\t      expect(result.status).not.toBe(0);\n139\t      expect(existsSync(join(dir, \".releases\", `${sha}.manifest`))).toBe(false);\n140\t    }\n141\t  });\n142\t\n143\t  it(\"runs a read-only live preflight and refuses an absent, wrong-project, or unready app without changing production files\", () => {\n144\t    writeFileSync(join(dir, \".env\"), readFileSync(join(dir, \".releases\", `${sha}.previous-env`)));\n145\t    const productionFiles = [\".env\", \"docker-compose.yml\", \"docker-compose.release.yml\",\n146\t      `.releases/${oldSha}.manifest`, `.releases/${oldSha}.activated`, `.releases/${sha}.previous-env`];\n147\t    for (const [overrides, shouldPass] of [\n148\t      [{}, true],\n149\t      [{ MOCK_LEGACY_HEALTH: \"1\" }, true],\n150\t      [{ MOCK_NO_APP: \"1\" }, false],\n151\t      [{ MOCK_PROJECT: \"other\" }, false],\n152\t      [{ MOCK_PORT: \"127.0.0.1:3999\" }, false],\n153\t      [{ MOCK_OLD_HEALTH_BAD: \"1\" }, false],\n154\t    ] as const) {\n155\t      const before = productionFiles.map((file) => readFileSync(join(dir, file)));\n156\t      const result = livePreflight(overrides);\n157\t      expect(result.status === 0).toBe(shouldPass);\n158\t      productionFiles.forEach((file, index) => expect(readFileSync(join(dir, file))).toEqual(before[index]));\n159\t      expect(existsSync(join(dir, \".releases\", `${sha}.manifest`))).toBe(false);\n160\t    }\n161\t  });\n162\t\n163\t  it(\"refuses a stale same-SHA predecessor snapshot or missing activation ledger before remote mutation\", () => {\n164\t    writeFileSync(join(dir, \".env\"), readFileSync(join(dir, \".releases\", `${sha}.previous-env`)));\n165\t    writeFileSync(join(dir, \".releases\", `${sha}.previous-env`), \"stale previous env\\n\");\n166\t    expect(livePreflight().stderr).toContain(\"does not match the current baseline\");\n167\t    writeFileSync(join(dir, \".releases\", `${sha}.previous-env`), readFileSync(join(dir, \".env\")));\n168\t    rmSync(join(dir, \".releases\", `${oldSha}.activated`));\n169\t    expect(livePreflight().stderr).toContain(\"activated predecessor ledger is missing\");\n170\t  });\n171\t\n172\t  it(\"refuses a conflicting candidate manifest before rsync without rewriting it\", () => {\n173\t    writeFileSync(join(dir, \".env\"), readFileSync(join(dir, \".releases\", `${sha}.previous-env`)));\n174\t    const path = join(dir, \".releases\", `${sha}.manifest`);\n175\t    const stale = `commit=${sha}\\napp_image=ghcr.io/test/wrong@sha256:${\"e\".repeat(64)}\\n`;\n176\t    writeFileSync(path, stale);\n177\t    expect(livePreflight().stderr).toContain(\"immutable candidate manifest differs\");\n178\t    expect(readFileSync(path, \"utf8\")).toBe(stale);\n179\t  });\n180\t\n181\t  it(\"refuses an old explicit Compose project override before rsync\", () => {\n182\t    writeFileSync(join(dir, \".env\"), `${readFileSync(join(dir, \".releases\", `${sha}.previous-env`))}COMPOSE_PROJECT_NAME=custom\\n`);\n183\t    expect(livePreflight().stderr).toContain(\"does not preserve an explicit Compose project override\");\n184\t    expect(existsSync(join(dir, \".releases\", `${sha}.manifest`))).toBe(false);\n185\t  });\n186\t\n187\t  it(\"orders the workflow's remote read-only preflight before rsync and candidate env copy\", () => {\n188\t    const workflow = readFileSync(\".github/workflows/deploy-vps.yml\", \"utf8\");\n189\t    const preflight = workflow.indexOf(\"- name: Verify live digest predecessor before remote mutation\");\n190\t    const sync = workflow.indexOf(\"- name: Sync files to VPS\");\n191\t    const deployStep = workflow.indexOf(\"- name: Deploy on VPS\");\n192\t    const envCopy = workflow.indexOf(\"scp -i ~/.ssh/tokenizer_vps\");\n193\t    expect(preflight).toBeGreaterThan(0);\n194\t    expect(preflight).toBeLessThan(sync);\n195\t    expect(sync).toBeLessThan(deployStep);\n196\t    expect(deployStep).toBeLessThan(envCopy);\n197\t    expect(workflow.slice(preflight, sync)).toContain(\"< scripts/verify-vps-predecessor.sh\");\n198\t  });\n199\t\n200\t  it(\"refuses a changed digest for an