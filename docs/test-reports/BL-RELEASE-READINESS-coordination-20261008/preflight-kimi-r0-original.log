{"role":"tool","tool_call_id":"tool_kEEDyzWMYWApICjUu2xVy5LD","content":"1\timport { execFileSync } from \"node:child_process\";\n2\timport { existsSync, mkdirSync, writeFileSync, rmSync, appendFileSync, readFileSync } from \"node:fs\";\n3\timport { homedir, platform, release, tmpdir } from \"node:os\";\n4\timport { dirname, join, resolve, sep } from \"node:path\";\n5\timport { fileURLToPath } from \"node:url\";\n6\timport { installWindowsService, uninstallWindowsService, windowsServiceStatus } from \"@/cli/service-windows\";\n7\timport { buildCronInstall, buildCronUninstall } from \"@/cli/service-cron\";\n8\t\n9\t// The repo root this agent is running out of (~/.tokenizer/app for a normal\n10\t// install). Task Scheduler needs absolute paths for both the entry script and\n11\t// the working directory.\n12\tfunction installRoot(): string {\n13\t  return resolve(dirname(fileURLToPath(import.meta.url)), \"..\", \"..\");\n14\t}\n15\t\n16\tconst binPath = join(homedir(), \".local\", \"bin\", \"tokenizer\");\n17\tconst logPath = join(homedir(), \".tokenizer\", \"logs\", \"agent.log\");\n18\t\n19\ttype LaunchdIdentity = { label: string; plist: string };\n20\t\n21\texport function resolveLaunchdIdentity(\n22\t  home = homedir(),\n23\t  env: Readonly<Record<string, string | undefined>> = process.env\n24\t): LaunchdIdentity {\n25\t  const defaultLabel = \"cc.tokenizer.agent\";\n26\t  const requested = env.TOKENIZER_LAUNCHD_TEST_LABEL;\n27\t  if (!requested) {\n28\t    return { label: defaultLabel, plist: join(home, \"Library\", \"LaunchAgents\", `${defaultLabel}.plist`) };\n29\t  }\n30\t\n31\t  if (env.TOKENIZER_LAUNCHD_TEST_MODE !== \"1\") {\n32\t    throw new Error(\"TOKENIZER_LAUNCHD_TEST_LABEL requires TOKENIZER_LAUNCHD_TEST_MODE=1\");\n33\t  }\n34\t  if (!/^cc\\.tokenizer\\.agent\\.ci\\.[A-Za-z0-9.-]{1,96}$/.test(requested)) {\n35\t    throw new Error(\"Invalid isolated launchd test label\");\n36\t  }\n37\t  const resolvedHome = resolve(home);\n38\t  const resolvedTmp = resolve(tmpdir());\n39\t  if (resolvedHome !== resolvedTmp && !resolvedHome.startsWith(`${resolvedTmp}${sep}`)) {\n40\t    throw new Error(\"Isolated launchd test HOME must be inside the OS temporary directory\");\n41\t  }\n42\t  return { label: requested, plist: join(home, \"Library\", \"LaunchAgents\", `${requested}.plist`) };\n43\t}\n44\t\n45\tfunction isWsl() {\n46\t  return release().toLowerCase().includes(\"microsoft\") || existsSync(\"/proc/sys/fs/binfmt_misc/WSLInterop\");\n47\t}\n48\t\n49\tfunction hasSystemdUser() {\n50\t  try {\n51\t    execFileSync(\"systemctl\", [\"--user\", \"status\"], { stdio: \"ignore\" });\n52\t    return true;\n53\t  } catch {\n54\t    return false;\n55\t  }\n56\t}\n57\t\n58\texport function installService(options: { heartbeatSeconds: number; syncMinutes: number }) {\n59\t  mkdirSync(dirname(logPath), { recursive: true });\n60\t  // Checked first: on Windows every branch below fails — hasSystemdUser()\n61\t  // throws, and the cron fallback shells out to a `crontab` that does not exist.\n62\t  if (platform() === \"win32\") return installWindowsService(options, installRoot());\n63\t  if (platform() === \"darwin\") return installLaunchd(options);\n64\t  if (!isWsl() && hasSystemdUser()) return installSystemd(options);\n65\t  if (hasSystemdUser()) return installSystemd(options);\n66\t  return installCron(options);\n67\t}\n68\t\n69\tfunction resolveLaunchdPath(): string {\n70\t  // launchd starts processes with a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin),\n71\t  // which means /usr/bin/env can't find a Homebrew-installed `node`. We bake\n72\t  // the actual node parent dir into the plist's PATH so the bin/tokenizer\n73\t  // shebang resolves regardless of launchd's environment.\n74\t  const candidates = [\n75\t    \"/opt/homebrew/bin\",\n76\t    \"/opt/homebrew/opt/node@22/bin\",\n77\t    \"/opt/homebrew/opt/node/bin\",\n78\t    \"/usr/local/bin\",\n79\t    \"/usr/local/opt/node@22/bin\",\n80\t    \"/usr/local/opt/node/bin\",\n81\t    join(homedir(), \".local\", \"bin\")\n82\t  ].filter((dir) => existsSync(dir));\n83\t  let nodeDir: string | null = null;\n84\t  try {\n85\t    const which = execFileSync(\"which\", [\"node\"], { encoding: \"utf8\" }).trim();\n86\t    if (which) nodeDir = dirname(which);\n87\t  } catch {\n88\t    /* fall through to candidates */\n89\t  }\n90\t  const dirs = new Set<string>([...(nodeDir ? [nodeDir] : []), ...candidates, \"/usr/bin\", \"/bin\"]);\n91\t  return Array.from(dirs).join(\":\");\n92\t}\n93\t\n94\t// HTTP/HTTPS proxy env vars from the user's shell get propagated into the\n95\t// launchd/systemd job's environment so Node's fetch (Node 22+ undici\n96\t// EnvHttpProxyAgent) routes outbound traffic through e.g. Clash on macOS or\n97\t// a corporate HTTPS_PROXY on Linux. Without this, launchd starts the agent\n98\t// with a minimal env, fetch tries to connect directly, and DNS-hijacked fake\n99\t// IPs (198.18.0.0/15 etc.) make every heartbeat fail with \"fetch failed\".\n100\tconst PROXY_ENV_KEYS = [\"HTTPS_PROXY\", \"HTTP_PROXY\", \"NO_PROXY\", \"ALL_PROXY\", \"https_proxy\", \"http_proxy\", \"no_proxy\", \"all_proxy\"] as const;\n101\tfunction escapeXml(value: string): string {\n102\t  return value.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\").replace(/'/g, \"&apos;\");\n103\t}\n104\tfunction collectProxyEnv(): Array<[string, string]> {\n105\t  const seen = new Set<string>();\n106\t  const result: Array<[string, string]> = [];\n107\t  for (const key of PROXY_ENV_KEYS) {\n108\t    const value = process.env[key];\n109\t    if (!value) continue;\n110\t    const lower = key.toLowerCase();\n111\t    if (seen.has(lower)) continue;\n112\t    seen.add(lower);\n113\t    result.push([key, value]);\n114\t  }\n115\t  return result;\n116\t}\n117\t\n118\tfunction installLaunchd(options: { heartbeatSeconds: number; syncMinutes: number }) {\n119\t  const { label, plist } = resolveLaunchdIdentity();\n120\t  mkdirSync(dirname(plist), { recursive: true });\n121\t  const path = resolveLaunchdPath();\n122\t  const proxyEntries = collectProxyEnv();\n123\t  const envLines = [\n124\t    `<key>PATH</key><string>${escapeXml(path)}</string>`,\n125\t    `<key>HOME</key><string>${escapeXml(homedir())}</string>`,\n126\t    ...proxyEntries.map(([k, v]) => `<key>${k}</key><string>${escapeXml(v)}</string>`)\n127\t  ].join(\"\\n    \");\n128\t  writeFileSync(\n129\t    plist,\n130\t    `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n131\t<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n132\t<plist version=\"1.0\"><dict>\n133\t  <key>Label</key><string>${escapeXml(label)}</string>\n134\t  <key>ProgramArguments</key><array><string>${binPath}</string><string>agent</string><string>--heartbeat-seconds</string><string>${options.heartbeatSeconds}</string><string>--sync-minutes</string><string>${options.syncMinutes}</string></array>\n135\t  <key>EnvironmentVariables</key><dict>\n136\t    ${envLines}\n137\t  </dict>\n138\t  <key>RunAtLoad</key><true/>\n139\t  <key>KeepAlive</key><true/>\n140\t  <key>ThrottleInterval</key><integer>30</integer>\n141\t  <key>StandardOutPath</key><string>${logPath}</string>\n142\t  <key>StandardErrorPath</key><string>${logPath}</string>\n143\t</dict></plist>\n144\t`\n145\t  );\n146\t  try { execFileSync(\"launchctl\", [\"unload\", plist], { stdio: \"ignore\" }); } catch {}\n147\t  execFileSync(\"launchctl\", [\"load\", plist], { stdio: \"inherit\" });\n148\t  const proxyLine = proxyEntries.length ? `\\nproxy env: ${proxyEntries.map(([k]) => k).join(\", \")}` : \"\";\n149\t  return `Installed launchd agent: ${plist}\\nPATH: ${path}${proxyLine}`;\n150\t}\n151\t\n152\tfunction installSystemd(options: { heartbeatSeconds: number; syncMinutes: number }) {\n153\t  const dir = join(homedir(), \".config\", \"systemd\", \"user\");\n154\t  const service = join(dir, \"tokenizer-agent.service\");\n155\t  mkdirSync(dir, { recursive: true });\n156\t  const proxyEntries = collectProxyEnv();\n157\t  const envLines = proxyEntries\n158\t    .map(([k, v]) => `Environment=\"${k}=${v.replace(/\"/g, '\\\\\"')}\"`)\n159\t    .join(\"\\n\");\n160\t  writeFileSync(\n161\t    service,\n162\t    `[Unit]\n163\tDescription=Tokenizer agent\n164\t\n165\t[Service]\n166\tExecStart=${binPath} agent --heartbeat-seconds ${options.heartbeatSeconds} --sync-minutes ${options.syncMinutes}\n167\tRestart=always\n168\tRestartSec=10\n169\tStandardOutput=append:${logPath}\n170\tStandardError=append:${logPath}\n171\t${envLines}\n172\t\n173\t[Install]\n174\tWantedBy=default.target\n175\t`\n176\t  );\n177\t  execFileSync(\"systemctl\", [\"--user\", \"daemon-reload\"], { stdio: \"inherit\" });\n178\t  execFileSync(\"systemctl\", [\"--user\", \"enable\", \"--now\", \"tokenizer-agent.service\"], { stdio: \"inherit\" });\n179\t  const proxyLine = proxyEntries.length ? `\\nproxy env: ${proxyEntries.map(([k]) => k).join(\", \")}` : \"\";\n180\t  return `Installed systemd user service: ${service}${proxyLine}`;\n181\t}\n182\t\n183\tfunction installCron(options: { syncMinutes: number }) {\n184\t  let current = \"\";\n185\t  try {\n186\t    current = execFileSync(\"crontab\", [\"-l\"], { encoding: \"utf8\", stdio: [\"ignore\", \"pipe\", \"ignore\"] });\n187\t  } catch {\n188\t    current = \"\";\n189\t  }\n190\t  const tmp = join(homedir(), \".tokenizer\", \"crontab.tmp\");\n191\t  writeFileSync(tmp, buildCronInstall(current, { binPath, logPath, syncMinutes: options.syncMinutes }));\n192\t  execFileSync(\"crontab\", [tmp], { stdio: \"inherit\" });\n193\t  return \"Installed cron fallback for tokenizer run + harness\";\n194\t}\n195\t\n196\texport function uninstallService() {\n197\t  const messages: string[] = [];\n198\t  if (platform() === \"win32\") {\n199\t    return uninstallWindowsService() ?? \"No tokenizer service found\";\n200\t  }\n201\t  const { plist } = resolveLaunchdIdentity();\n202\t  if (existsSync(plist)) {\n203\t    try { execFileSync(\"launchctl\", [\"unload\", plist], { stdio: \"ignore\" }); } catch {}\n204\t    rmSync(plist);\n205\t    messages.push(\"Removed launchd agent\");\n206\t  }\n207\t  if (hasSystemdUser()) {\n208\t    try { execFileSync(\"systemctl\", [\"--user\", \"disable\", \"--now\", \"tokenizer-agent.service\"], { stdio: \"ignore\" }); messages.push(\"Removed systemd agent\"); } catch {}\n209\t  }\n210\t  try {\n211\t    const current = execFileSync(\"crontab\", [\"-l\"], { encoding: \"utf8\", stdio: [\"ignore\", \"pipe\", \"ignore\"] });\n212\t    const tmp = join(homedir(), \".tokenizer\", \"crontab.tmp\");\n213\t    writeFileSync(tmp, buildCronUninstall(current, binPath));\n214\t    execFileSync(\"crontab\", [tmp], { stdio: \"ignore\" });\n215\t    messages.push(\"Removed cron fallback\");\n216\t  } catch {}\n217\t  return messages.join(\"\\n\") || \"No tokenizer service found\";\n218\t}\n219\t\n220\texport function serviceStatus() {\n221\t  const lines: string[] = [];\n222\t  if (platform() === \"win32\") {\n223\t    return windowsServiceStatus() ?? \"No tokenizer service detected\";\n224\t  }\n225\t  const { plist } = resolveLaunchdIdentity();\n226\t  if (existsSync(plist)) lines.push(`launchd: ${plist}`);\n227\t  if (hasSystemdUser()) {\n228\t    try { lines.push(execFileSync(\"systemctl\", [\"--user\", \"is-active\", \"tokenizer-agent.service\"], { encoding: \"utf8\" }).trim()); } catch { lines.push(\"systemd: inactive\"); }\n229\t  }\n230\t  try { if (readFileSync(join(homedir(), \".tokenizer\", \"crontab.tmp\"), \"utf8\")) lines.push(\"cron fallback configured\"); } catch {}\n231\t  return lines.join(\"\\n\") || \"No tokenizer service detected\";\n232\t}"}
