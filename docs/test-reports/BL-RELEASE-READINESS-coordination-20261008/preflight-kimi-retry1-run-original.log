{"role":"tool","tool_call_id":"tool_bAZl4NRyqAIgHycYgh28S1Og","content":"1\t// Independent Kimi preflight probes for F003 scripts/ci/vps-host-preflight.sh\n2\t// Evaluator-authored fixtures: stub docker/curl/uname/df/stat/sha256sum/timeout,\n3\t// synthetic deploy tree with canary secrets, byte-snapshot + no-mutation checks.\n4\timport { spawnSync } from 'node:child_process';\n5\timport { chmodSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, symlinkSync, writeFileSync, existsSync } from 'node:fs';\n6\timport { join } from 'node:path';\n7\timport { createHash } from 'node:crypto';\n8\t\n9\tconst BASE = process.env.PROBE_BASE || '/private/tmp/kimi-pf/probes';\n10\tconst script = join(process.cwd(), 'scripts/ci/vps-host-preflight.sh');\n11\tconst SHA = 'c'.repeat(40), DEPLOYED = 'd'.repeat(40);\n12\tconst APP_ID = 'a1b2c3d4e5f6', PG_ID = 'b1c2d3e4f5a6';\n13\tconst APP_IMAGE_ID = `sha256:${'a'.repeat(64)}`, PG_IMAGE_ID = `sha256:${'b'.repeat(64)}`;\n14\tconst APP_IMG = `ghcr.io/probe/app@${APP_IMAGE_ID}`, MIG_IMG = `ghcr.io/probe/migrate@sha256:${'e'.repeat(64)}`;\n15\tconst CANARY = 'KIMI_F003_SECRET_CANARY_DO_NOT_DISCLOSE';\n16\tconst results = [];\n17\tlet root, deployPath;\n18\t\n19\tfunction tool(name, body) {\n20\t  const p = join(root, 'bin', name);\n21\t  writeFileSync(p, `#!/usr/bin/env bash\\n${body}\\n`);\n22\t  chmodSync(p, 0o755);\n23\t}\n24\tfunction snap(dir = deployPath, prefix = '') {\n25\t  const out = {};\n26\t  for (const e of readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {\n27\t    const p = join(dir, e.name), k = prefix + e.name;\n28\t    if (e.isDirectory() && !e.isSymbolicLink()) Object.assign(out, snap(p, `${k}/`));\n29\t    else if (e.isSymbolicLink()) out[k] = 'SYMLINK';\n30\t    else out[k] = createHash('sha256').update(readFileSync(p)).digest('hex') + ':' + (statSync(p).mode & 0o7777).toString(8);\n31\t  }\n32\t  return out;\n33\t}\n34\tfunction fixture() {\n35\t  root = mkdtempSync(join(BASE, 'f003-'));\n36\t  deployPath = join(root, 'deploy');\n37\t  mkdirSync(join(root, 'bin')); mkdirSync(deployPath); mkdirSync(join(deployPath, '.releases'));\n38\t  writeFileSync(join(deployPath, '.env'),\n39\t    `GIT_COMMIT=${DEPLOYED}\\nAPP_IMAGE=${APP_IMG}\\nMIGRATE_IMAGE=${MIG_IMG}\\nAPP_HOST_PORT=127.0.0.1:3010\\nAUTH_SECRET=${CANARY}\\nDATABASE_URL=postgresql://u:${CANARY}@h/db\\n`);\n40\t  writeFileSync(join(deployPath, 'docker-compose.yml'), `services: {}\\n# ${CANARY}\\n`);\n41\t  writeFileSync(join(deployPath, 'docker-compose.release.yml'), 'services: {}\\n');\n42\t  writeFileSync(join(deployPath, '.releases', `${DEPLOYED}.manifest`), `commit=${DEPLOYED}\\napp_image=${APP_IMG}\\nmigrate_image=${MIG_IMG}\\n`);\n43\t  writeFileSync(join(deployPath, '.releases', `${DEPLOYED}.activated`), `commit=${DEPLOYED}\\napp_image=${APP_IMG}\\napp_id=${APP_IMAGE_ID}\\n`);\n44\t\n45\t  tool('timeout', `limit=\"$2\"; shift 2\n46\t\"$@\" & pid=$!\n47\t( sleep \"\\${limit%s}\"; kill -KILL \"$pid\" 2>/dev/null ) >/dev/null 2>&1 &\n48\twatcher=$!\n49\twait \"$pid\" 2>/dev/null; status=$?\n50\tkill -KILL \"$watcher\" 2>/dev/null\n51\texit $status`);\n52\t  tool('uname', 'if [ \"$1\" = -s ]; then echo Linux; else echo x86_64; fi');\n53\t  tool('df', \"printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\\\\nfixture 100000 100 99900 1%% /x\\\\n'\");\n54\t  tool('stat', `fmt=\"$2\"; path=\"$4\"\n55\tif [ \"$fmt\" = %s ]; then /usr/bin/stat -f%z \"$path\"; elif [ \"$fmt\" = %a ]; then /usr/bin/stat -f%Lp \"$path\"; else exit 99; fi`);\n56\t  tool('sha256sum', '/usr/bin/shasum -a 256 \"$@\"');\n57\t  tool('curl', `printf '%s' \"$CANARY\" >&2\n58\tif [ \"\\${SCENARIO:-}\" = health-failure ]; then exit 7; fi\n59\tif [ -n \"\\${HEALTH_RAW:-}\" ]; then printf '%s' \"$HEALTH_RAW\"; exit 0; fi\n60\tprintf '{\"ok\":%s,\"code\":%s,\"commit\":\"%s\",\"leaked\":\"%s\"}' \\\\\n61\t  \"\\${HEALTH_OK:-true}\" \"\\${HEALTH_CODE:-\\\\\"ready\\\\\"}\" \"\\${HEALTH_COMMIT:-${DEPLOYED}}\" \"$CANARY\"`);\n62\t  tool('docker', `printf '%s\\\\n' \"$*\" >> \"$CALLS\"\n63\tprintf '%s' \"$CANARY\" >&2\n64\ts=\"\\${SCENARIO:-}\"\n65\tcase \"$*\" in\n66\t  'version --format {{.Server.Version}}') [ \"$s\" = timeout ] && exec sleep 60; [ \"$s\" = raw-version-canary ] && echo \"$CANARY\" || echo 27.5.1 ;;\n67\t  'compose version --short') echo 2.35.1 ;;\n68\t  *'ps -a --filter label=com.docker.compose.project=tokenizer --filter label=com.docker.compose.service=app'*)\n69\t    [ \"$s\" = missing-app ] && exit 0; [ \"$s\" = duplicate-app ] && { echo ${APP_ID}; echo f1f2f3f4f5f6; exit 0; }; echo ${APP_ID} ;;\n70\t  *'ps -a --filter label=com.docker.compose.project=tokenizer --filter label=com.docker.compose.service=postgres'*)\n71\t    [ \"$s\" = no-postgres ] && exit 0; echo ${PG_ID} ;;\n72\t  'inspect --format {{.State.Running}}|'*)\n73\t    running=true; health=healthy; project=tokenizer; service=app; img=${APP_IMAGE_ID}\n74\t    [ \"$s\" = stopped-app ] && running=false\n75\t    [ \"$s\" = unhealthy-app ] && health=unhealthy\n76\t    [ \"$s\" = wrong-project ] && project=other\n77\t    [ \"$s\" = wrong-service ] && service=postgres\n78\t    [ \"$s\" = legacy-image ] && img=sha256:notdigest\n79\t    printf '%s|%s|%s|%s|%s|%s\\\\n' \"$running\" running \"$health\" \"$project\" \"$service\" \"$img\" ;;\n80\t  'inspect --format {{.State.Status}}|'*)\n81\t    printf 'running|healthy|tokenizer|postgres|%s\\\\n' \"${PG_IMAGE_ID}\" ;;\n82\t  'image inspect --format {{.Id}} '*)\n83\t    [ \"$s\" = wrong-image-id ] && echo \"sha256:$(printf 'f%.0s' {1..64} 2>/dev/null || echo ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)\" || echo \"${APP_IMAGE_ID}\" ;;\n84\t  'image inspect --format {{index .Config.Labels \"org.opencontainers.image.revision\"}}|{{.Config.User}} '*)\n85\t    printf '%s|%s\\\\n' \"\\${IMAGE_REVISION:-$DEPLOYED}\" \"\\${IMAGE_USER:-node}\" ;;\n86\t  'inspect --format {{range $name, $_ := .NetworkSettings.Networks}}'*)\n87\t    [ \"$s\" = wrong-network ] && echo 'personal_net ' || echo 'tokenizer_default ' ;;\n88\t  'inspect --format {{range .Mounts}}'*)\n89\t    [ \"$s\" = wrong-volume ] && echo 'personal_vol ' || echo 'tokenizer_postgres-data ' ;;\n90\t  'port '*)\n91\t    [ \"$s\" = wrong-port ] && echo '0.0.0.0:3010' || echo '127.0.0.1:3010' ;;\n92\t  'network inspect --format '*' tokenizer_default') echo 'tokenizer|bridge' ;;\n93\t  'volume inspect --format '*' tokenizer_postgres-data') echo 'tokenizer|local' ;;\n94\t  *) echo \"UNEXPECTED-DOCKER-OP:$*\" >&2; exit 99 ;;\n95\tesac`);\n96\t}\n97\tfunction spawnBash(args, overrides = {}) {\n98\t  const env = { ...process.env, PATH: `${join(root, 'bin')}:${process.env.PATH}`, CALLS: join(root, 'calls.jsonl'), ...overrides };\n99\t  spawnSync('bash', ['-c', 'true'], { encoding: 'utf8', env });\n100\t  const opts = { encoding: 'utf8', timeout: 20000, maxBuffer: 8 * 1024 * 1024, env };\n101\t  let r = spawnSync('bash', args, opts);\n102\t  if (r.error && r.error.errno === -2) r = spawnSync('bash', args, opts);\n103\t  if (r.error) throw new Error(`spawn error: ${r.error.message}`);\n104\t  return r;\n105\t}\n106\tfunction run(overrides = {}, args = [deployPath, SHA]) {\n107\t  return spawnBash([script, ...args], overrides);\n108\t}\n109\tfunction calls() {\n110\t  return existsSync(join(root, 'calls.jsonl'))\n111\t    ? readFileSync(join(root, 'calls.jsonl'), 'utf8').trim().split('\\n') : [];\n112\t}\n113\tfunction check(name, fn) {\n114\t  fixture();\n115\t  try { fn(); results.push({ name, pass: true }); }\n116\t  catch (e) { results.push({ name, pass: false, error: String(e.message || e) }); }\n117\t  rmSync(root, { recursive: true, force: true });\n118\t}\n119\tfunction expect(cond, msg) { if (!cond) throw new Error(msg); }\n120\tfunction noCanary(r) {\n121\t  expect(!String(r.stdout).includes(CANARY), 'canary in stdout');\n122\t  expect(!String(r.stderr).includes(CANARY), 'canary in stderr');\n123\t}\n124\tfunction assertReadOnly() {\n125\t  for (const line of calls()) {\n126\t    const first = line.split(' ')[0];\n127\t    expect(['version', 'compose', 'ps', 'inspect', 'image', 'port', 'network', 'volume'].includes(first), `unexpected docker op: ${line}`);\n128\t    expect(!/Config\\.Env|\\b(pull|push|run|exec|stop|start|restart|up|down|kill|login|logout|build|rm|prune|cp|create)\\b/.test(line), `mutation op: ${line}`);\n129\t  }\n130\t}\n131\tfunction parse(r) {\n132\t  noCanary(r);\n133\t  return JSON.parse(r.stdout);\n134\t}\n135\t\n136\tcheck('observed digest_activated baseline, allowlisted output, byte-identical state', () => {\n137\t  const before = snap();\n138\t  const r = run();\n139\t  expect(r.status === 0, `exit=${r.status} out=${String(r.stdout).slice(0, 400)}`);\n140\t  const body = parse(r);\n141\t  expect(body.outcome === 'observed' && body.baseline === 'digest_activated', `bad outcome: ${JSON.stringify(body).slice(0, 200)}`);\n142\t  expect(body.source_sha === SHA && body.project === 'tokenizer', 'identity mismatch');\n143\t  expect(body.settings.GIT_COMMIT === DEPLOYED, 'settings commit mismatch');\n144\t  expect(body.app.id === APP_ID && body.app.user === 'node', 'app fields');\n145\t  expect(body.postgres.id === PG_ID && body.postgres.volume === 'tokenizer_postgres-data', 'pg fields');\n146\t  expect(body.files.env.sha256 === createHash('sha256').update(readFileSync(join(deployPath, '.env'))).digest('hex'), 'env hash');\n147\t  expect(!/DATABASE_URL|AUTH_SECRET|leaked|Config\\.Env/.test(r.stdout), 'secret material in report');\n148\t  const allowed = ['schema_version','operation','source_sha','timestamp','outcome','reason','project','baseline','platform','free_kib','versions','settings','app','postgres','storage','files'];\n149\t  expect(JSON.stringify(Object.keys(body).sort()) === JSON.stringify(allowed.sort()), 'unexpected top-level keys');\n150\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed');\n151\t  assertReadOnly();\n152\t});\n153\t\n154\tcheck('healthy legacy source-built serving reports legacy_or_unknown, no ledger created', () => {\n155\t  writeFileSync(join(deployPath, '.env'), readFileSync(join(deployPath, '.env'), 'utf8')\n156\t    .replace(APP_IMG, 'tokenizer-app:local').replace(MIG_IMG, 'tokenizer-migrate:local'));\n157\t  rmSync(join(deployPath, '.releases'), { recursive: true });\n158\t  const before = snap();\n159\t  const r = run();\n160\t  expect(r.status === 0, `exit=${r.status} out=${String(r.stdout).slice(0, 400)}`);\n161\t  const body = parse(r);\n162\t  expect(body.baseline === 'legacy_or_unknown', `baseline=${body.baseline}`);\n163\t  expect(body.files.releases.sha256 === 'missing', 'releases marker');\n164\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed');\n165\t  assertReadOnly();\n166\t});\n167\t\n168\tcheck('explicit null health code refused (backend_unready)', () => {\n169\t  const before = snap();\n170\t  const r = run({ HEALTH_CODE: 'null' });\n171\t  expect(r.status !== 0, 'null code accepted');\n172\t  expect(parse(r).reason === 'backend_unready', `reason=${JSON.parse(r.stdout).reason}`);\n173\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed');\n174\t  assertReadOnly();\n175\t});\n176\t\n177\tcheck('absent health code field accepted only with exact SHA (old format)', () => {\n178\t  const r = run({ HEALTH_RAW: `{\"ok\":true,\"commit\":\"${DEPLOYED}\"}` });\n179\t  expect(r.status === 0, `exit=${r.status} out=${String(r.stdout).slice(0, 200)}`);\n180\t  expect(parse(r).outcome === 'observed', 'not observed');\n181\t});\n182\t\n183\tcheck('wrong health code refused', () => {\n184\t  const r = run({ HEALTH_CODE: '\"db_unavailable\"' });\n185\t  expect(r.status !== 0, 'wrong code accepted');\n186\t});\n187\t\n188\tcheck('health commit mismatch refused (wrong_backend_revision)', () => {\n189\t  const r = run({ HEALTH_COMMIT: 'e'.repeat(40) });\n190\t  expect(r.status !== 0, 'wrong commit accepted');\n191\t  expect(JSON.parse(r.stdout).reason === 'wrong_backend_revision', `reason=${JSON.parse(r.stdout).reason}`);\n192\t});\n193\t\n194\tcheck('duplicate GIT_COMMIT refused as duplicate_setting, byte-identical', () => {\n195\t  writeFileSync(join(deployPath, '.env'), `${readFileSync(join(deployPath, '.env'), 'utf8')}GIT_COMMIT=${DEPLOYED}\\n`);\n196\t  const before = snap();\n197\t  const r = run();\n198\t  expect(r.status !== 0, 'duplicate accepted');\n199\t  expect(JSON.parse(r.stdout).reason === 'duplicate_setting', `reason=${JSON.parse(r.stdout).reason}`);\n200\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed');\n201\t});\n202\t\n203\tcheck('malicious APP_IMAGE value refused, never executed', () => {\n204\t  writeFileSync(join(deployPath, '.env'), readFileSync(join(deployPath, '.env'), 'utf8')\n205\t    .replace(APP_IMG, `$(touch ${join(deployPath, 'PWNED')})`));\n206\t  const before = snap();\n207\t  const r = run();\n208\t  expect(r.status !== 0, 'malicious image accepted');\n209\t  expect(JSON.parse(r.stdout).reason === 'invalid_setting', `reason=${JSON.parse(r.stdout).reason}`);\n210\t  expect(!existsSync(join(deployPath, 'PWNED')), 'command substitution executed');\n211\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed');\n212\t});\n213\t\n214\tcheck('symlinked .env refused as unsafe_config_file', () => {\n215\t  const outside = join(root, 'outside-env');\n216\t  writeFileSync(outside, readFileSync(join(deployPath, '.env'), 'utf8'));\n217\t  rmSync(join(deployPath, '.env'));\n218\t  symlinkSync(outside, join(deployPath, '.env'));\n219\t  const r = run();\n220\t  expect(r.status !== 0, 'symlink accepted');\n221\t  expect(JSON.parse(r.stdout).reason === 'unsafe_config_file', `reason=${JSON.parse(r.stdout).reason}`);\n222\t});\n223\t\n224\tcheck('missing app refused (missing_or_multiple_app)', () => {\n225\t  const before = snap();\n226\t  const r = run({ SCENARIO: 'missing-app' });\n227\t  expect(r.status !== 0, 'missing app accepted');\n228\t  expect(JSON.parse(r.stdout).reason === 'missing_or_multiple_app', `reason=${JSON.parse(r.stdout).reason}`);\n229\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed');\n230\t  assertReadOnly();\n231\t});\n232\t\n233\tcheck('duplicate app refused', () => {\n234\t  const r = run({ SCENARIO: 'duplicate-app' });\n235\t  expect(r.status !== 0, 'duplicate app accepted');\n236\t  expect(JSON.parse(r.stdout).reason === 'missing_or_multiple_app', `reason=${JSON.parse(r.stdout).reason}`);\n237\t});\n238\t\n239\tcheck('wrong port binding refused (wrong_backend_binding)', () => {\n240\t  const r = run({ SCENARIO: 'wrong-port' });\n241\t  expect(r.status !== 0, 'wrong port accepted');\n242\t  expect(JSON.parse(r.stdout).reason === 'wrong_backend_binding', `reason=${JSON.parse(r.stdout).reason}`);\n243\t});\n244\t\n245\tcheck('unhealthy app refused', () => {\n246\t  const r = run({ SCENARIO: 'unhealthy-app' });\n247\t  expect(r.status !== 0, 'unhealthy accepted');\n248\t  expect(JSON.parse(r.stdout).reason === 'unhealthy_app', `reason=${JSON.parse(r.stdout).reason}`);\n249\t});\n250\t\n251\tcheck('stopped app refused (wrong_serving_app)', () => {\n252\t  const r = run({ SCENARIO: 'stopped-app' });\n253\t  expect(r.status !== 0, 'stopped accepted');\n254\t  expect(JSON.parse(r.stdout).reason === 'wrong_serving_app', `reason=${JSON.parse(r.stdout).reason}`);\n255\t});\n256\t\n257\tcheck('raw canary in docker version output fails validation, never emitted', () => {\n258\t  const r = run({ SCENARIO: 'raw-version-canary' });\n259\t  expect(r.status !== 0, 'canary version accepted');\n260\t  expect(JSON.parse(r.stdout).reason === 'docker_unavailable', `reason=${JSON.parse(r.stdout).reason}`);\n261\t  noCanary(r);\n262\t});\n263\t\n264\tcheck('hung docker query bounded by timeout, stderr suppressed', () => {\n265\t  const before = snap();\n266\t  const start = Date.now();\n267\t  const r = run({ SCENARIO: 'timeout' });\n268\t  const elapsed = Date.now() - start;\n269\t  expect(r.status !== 0, 'timeout accepted');\n270\t  expect(JSON.parse(r.stdout).reason === 'docker_unavailable', `reason=${JSON.parse(r.stdout).reason}`);\n271\t  expect(elapsed < 15000, `took ${elapsed}ms`);\n272\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed');\n273\t});\n274\t\n275\tfor (const [label, args] of [\n276\t  ['injection path', [`/opt/tokenizer'; touch ${'PWNED'}`, SHA]],\n277\t  ['dotdot path', ['/opt/tokenizer/../escape', SHA]],\n278\t  ['canary sha', [deployPath, CANARY]],\n279\t  ['missing args', []],\n280\t]) {\n281\t  check(`malicious remote args refused before any query: ${label}`, () => {\n282\t    const r = run({}, args);\n283\t    expect(r.status !== 0, 'bad args accepted');\n284\t    expect(JSON.parse(r.stdout).reason === 'invalid_input', `reason=${JSON.parse(r.stdout).reason}`);\n285\t    expect(calls().length === 0, `docker called: ${calls()}`);\n286\t  });\n287\t}\n288\t\n289\tcheck('ambient DOCKER_HOST/proxy overrides are unset inside the script', () => {\n290\t  const r = run({ DOCKER_HOST: `tcp://${CANARY}`, COMPOSE_PROJECT_NAME: CANARY, HTTP_PROXY: `http://${CANARY}` });\n291\t  expect(r.status === 0, `exit=${r.status}`);\n292\t  noCanary(r);\n293\t});\n294\t\n295\tconst passed = results.filter(r => r.pass).length;\n296\tconsole.log(JSON.stringify({ suite: 'f003-host-preflight-probes', total: results.length, passed, results }, null, 1));\n297\tprocess.exit(passed === results.length ? 0 : 1);"}
