{"role":"tool","tool_call_id":"tool_5Wok3YlmxhaCVZ7KKiuOxoJn","content":"1\t#!/usr/bin/env bash\n2\tset -euo pipefail\n3\t\n4\tfail() { echo \"production predecessor preflight: $1\" >&2; exit 1; }\n5\tvalid_sha() { [[ \"$1\" =~ ^[0-9a-f]{40}$ ]]; }\n6\tvalid_image() { [[ \"$1\" =~ ^[a-z0-9][a-z0-9./:_-]+@sha256:[0-9a-f]{64}$ ]]; }\n7\tread_one() {\n8\t  local count\n9\t  count=\"$(grep -c \"^$1=\" \"$2\" || true)\"\n10\t  [[ \"$count\" == 1 ]] || fail \"missing or duplicate $1 in predecessor configuration\"\n11\t  sed -n \"s/^$1=//p\" \"$2\"\n12\t}\n13\tregular_file() { [[ -f \"$1\" && ! -L \"$1\" ]]; }\n14\t\n15\tmode=\"${1:-}\"\n16\tcandidate_sha=\"${2:-}\"\n17\tcandidate_app=\"${3:-}\"\n18\tcandidate_migrate=\"${4:-}\"\n19\t[[ \"$mode\" == live || \"$mode\" == retained ]] || fail \"expected live or retained mode\"\n20\tvalid_sha \"$candidate_sha\" || fail \"invalid candidate SHA\"\n21\tif ! valid_image \"$candidate_app\" || ! valid_image \"$candidate_migrate\"; then\n22\t  fail \"candidate images must be digest-pinned\"\n23\tfi\n24\tcommand -v jq >/dev/null || fail \"jq is required on the VPS\"\n25\t[[ -d .releases && ! -L .releases ]] || fail \"release ledger directory is missing\"\n26\t\n27\tif [[ \"$mode\" == live ]]; then\n28\t  baseline=.env\n29\t  retained=\".releases/$candidate_sha.previous-env\"\n30\t  regular_file \"$baseline\" || fail \"current production environment is missing\"\n31\t  if grep -q '^COMPOSE_PROJECT_NAME=' \"$baseline\"; then\n32\t    fail \"candidate workflow does not preserve an explicit Compose project override\"\n33\t  fi\n34\t  if [[ -e \"$retained\" || -L \"$retained\" ]]; then\n35\t    if ! regular_file \"$retained\" || ! cmp -s \"$baseline\" \"$retained\"; then\n36\t      fail \"candidate previous-env does not match the current baseline\"\n37\t    fi\n38\t  fi\n39\telse\n40\t  baseline=\".releases/$candidate_sha.previous-env\"\n41\t  regular_file \"$baseline\" || fail \"retained predecessor environment is missing\"\n42\tfi\n43\t\n44\told_sha=\"$(read_one GIT_COMMIT \"$baseline\")\"\n45\told_app=\"$(read_one APP_IMAGE \"$baseline\")\"\n46\told_migrate=\"$(read_one MIGRATE_IMAGE \"$baseline\")\"\n47\thost_port=\"$(read_one APP_HOST_PORT \"$baseline\")\"\n48\tvalid_sha \"$old_sha\" && [[ \"$old_sha\" != \"$candidate_sha\" ]] || fail \"distinct predecessor SHA required\"\n49\tif ! valid_image \"$old_app\" || ! valid_image \"$old_migrate\"; then\n50\t  fail \"predecessor images must be digest-pinned\"\n51\tfi\n52\t[[ \"$host_port\" == 127.0.0.1:3010 ]] || fail \"unexpected predecessor host port\"\n53\t\n54\told_manifest=\".releases/$old_sha.manifest\"\n55\told_activated=\".releases/$old_sha.activated\"\n56\tif ! regular_file \"$old_manifest\" || ! regular_file \"$old_activated\"; then\n57\t  fail \"activated predecessor ledger is missing\"\n58\tfi\n59\tprintf 'commit=%s\\napp_image=%s\\nmigrate_image=%s\\n' \"$old_sha\" \"$old_app\" \"$old_migrate\" |\n60\t  cmp -s - \"$old_manifest\" || fail \"predecessor manifest differs from the running configuration\"\n61\t\n62\told_id=\"$(docker image inspect --format '{{.Id}}' \"$old_app\")\" || fail \"predecessor image is unavailable\"\n63\t[[ \"$old_id\" =~ ^sha256:[0-9a-f]{64}$ ]] || fail \"invalid predecessor image ID\"\n64\tprintf 'commit=%s\\napp_image=%s\\napp_id=%s\\n' \"$old_sha\" \"$old_app\" \"$old_id\" |\n65\t  cmp -s - \"$old_activated\" || fail \"predecessor activation ledger differs from the image\"\n66\t\n67\tcandidate_manifest=\".releases/$candidate_sha.manifest\"\n68\tif [[ -e \"$candidate_manifest\" || -L \"$candidate_manifest\" ]]; then\n69\t  regular_file \"$candidate_manifest\" || fail \"candidate manifest is not a regular file\"\n70\t  printf 'commit=%s\\napp_image=%s\\nmigrate_image=%s\\n' \"$candidate_sha\" \"$candidate_app\" \"$candidate_migrate\" |\n71\t    cmp -s - \"$candidate_manifest\" || fail \"immutable candidate manifest differs\"\n72\tfi\n73\t\n74\t# Shell variables override Compose --env-file values, so use only the retained\n75\t# baseline when resolving the project and service before any candidate mutation.\n76\tunset COMPOSE_PROJECT_NAME COMPOSE_FILE COMPOSE_PROFILES DOCKER_HOST DOCKER_CONTEXT \\\n77\t  APP_IMAGE MIGRATE_IMAGE GIT_COMMIT APP_HOST_PORT POSTGRES_PASSWORD\n78\tcompose=(docker compose --env-file \"$baseline\" -f docker-compose.yml -f docker-compose.release.yml)\n79\t\"${compose[@]}\" config --quiet || fail \"predecessor Compose configuration is invalid\"\n80\tproject=\"$(\"${compose[@]}\" config --format json | jq -er '.name | select(type == \"string\" and test(\"^[a-z0-9][a-z0-9_-]*$\"))')\" ||\n81\t  fail \"cannot resolve predecessor Compose project\"\n82\tcontainer=\"$(\"${compose[@]}\" ps -q app)\" || fail \"cannot inspect Compose app service\"\n83\t[[ \"$container\" =~ ^[0-9a-f]{12,64}$ ]] || fail \"exactly one running Compose app is required\"\n84\tif [[ \"$mode\" == retained ]]; then\n85\t  regular_file .env || fail \"candidate environment is missing\"\n86\t  [[ \"$(read_one APP_HOST_PORT .env)\" == 127.0.0.1:3010 ]] || fail \"candidate backend port differs\"\n87\t  candidate_compose=(docker compose --env-file .env -f docker-compose.yml -f docker-compose.release.yml)\n88\t  \"${candidate_compose[@]}\" config --quiet || fail \"candidate Compose configuration is invalid\"\n89\t  candidate_project=\"$(\"${candidate_compose[@]}\" config --format json | jq -er '.name')\" ||\n90\t    fail \"cannot resolve candidate Compose project\"\n91\t  [[ \"$candidate_project\" == \"$project\" && \"$(\"${candidate_compose[@]}\" ps -q app)\" == \"$container\" ]] ||\n92\t    fail \"candidate Compose project does not select the running app\"\n93\tfi\n94\tdetails=\"$(docker inspect --format '{{.State.Running}}|{{index .Config.Labels \"com.docker.compose.project\"}}|{{index .Config.Labels \"com.docker.compose.service\"}}|{{.Image}}' \"$container\")\" ||\n95\t  fail \"cannot inspect running predecessor container\"\n96\t[[ \"$details\" == \"true|$project|app|$old_id\" ]] || fail \"running app identity, project, service, or image differs\"\n97\t[[ \"$(docker port \"$container\" 3000/tcp)\" == 127.0.0.1:3010 ]] || fail \"running app is not bound to the production backend\"\n98\thealth=\"$(curl -fsS --max-time 3 http://127.0.0.1:3010/api/health)\" || fail \"running app readiness is unavailable\"\n99\tprintf '%s' \"$health\" | jq -e --arg sha \"$old_sha\" '.ok == true and ((has(\"code\") | not) or .code == \"ready\") and .commit == $sha' >/dev/null ||\n100\t  fail \"production backend does not report the activated predecessor\"\n101\tprintf 'production predecessor preflight passed: project=%s commit=%s\\n' \"$project\" \"$old_sha\""}
