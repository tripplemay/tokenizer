{"role":"tool","tool_call_id":"tool_o9lV40wLQ9fiFg2JBTfxjvO8","content":"1\t// Independent Kimi preflight probes for F002 scripts/verify-vps-predecessor.sh\n2\t// Evaluator-authored fixtures: stub docker/curl, synthetic ledger, byte-snapshot checks.\n3\timport { spawnSync } from 'node:child_process';\n4\timport { chmodSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync, existsSync } from 'node:fs';\n5\timport { join } from 'node:path';\n6\timport { createHash } from 'node:crypto';\n7\t\n8\tconst BASE = process.env.PROBE_BASE || '/private/tmp/kimi-pf/probes';\n9\tconst script = join(process.cwd(), 'scripts/verify-vps-predecessor.sh');\n10\tconst CAND = 'c'.repeat(40), OLD = 'd'.repeat(40);\n11\tconst APP_ID = `sha256:${'a'.repeat(64)}`;\n12\tconst APP = `ghcr.io/probe/app@${APP_ID}`, MIG = `ghcr.io/probe/migrate@sha256:${'b'.repeat(64)}`;\n13\tconst CANARY = 'KIMI_PROBE_SECRET_CANARY_NEVER_LEAK';\n14\tconst results = [];\n15\tlet root;\n16\t\n17\tfunction stub(name, body) {\n18\t  const p = join(root, 'bin', name);\n19\t  writeFileSync(p, `#!/usr/bin/env bash\\n${body}\\n`);\n20\t  chmodSync(p, 0o755);\n21\t}\n22\tfunction snap(dir = root, prefix = '') {\n23\t  const out = {};\n24\t  for (const e of readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {\n25\t    if (e.name === 'bin' || e.name === 'calls.log') continue;\n26\t    const p = join(dir, e.name), k = prefix + e.name;\n27\t    if (e.isDirectory()) Object.assign(out, snap(p, `${k}/`));\n28\t    else out[k] = createHash('sha256').update(readFileSync(p)).digest('hex') + ':' + (statSync(p).mode & 0o7777).toString(8);\n29\t  }\n30\t  return out;\n31\t}\n32\tfunction fixture() {\n33\t  root = mkdtempSync(join(BASE, 'f002-'));\n34\t  mkdirSync(join(root, 'bin')); mkdirSync(join(root, '.releases'));\n35\t  const env = `GIT_COMMIT=${OLD}\\nAPP_IMAGE=${APP}\\nMIGRATE_IMAGE=${MIG}\\nAPP_HOST_PORT=127.0.0.1:3010\\nAUTH_SECRET=${CANARY}\\n`;\n36\t  writeFileSync(join(root, '.env'), env);\n37\t  writeFileSync(join(root, 'docker-compose.yml'), 'services:\\n  app: {}\\n');\n38\t  writeFileSync(join(root, 'docker-compose.release.yml'), 'services:\\n  app: {}\\n');\n39\t  writeFileSync(join(root, '.releases', `${OLD}.manifest`), `commit=${OLD}\\napp_image=${APP}\\nmigrate_image=${MIG}\\n`);\n40\t  writeFileSync(join(root, '.releases', `${OLD}.activated`), `commit=${OLD}\\napp_image=${APP}\\napp_id=${APP_ID}\\n`);\n41\t  stub('docker', `printf '%s\\\\n' \"$*\" >> \"$CALLS\"\n42\tcase \"$*\" in\n43\t  'image inspect --format {{.Id}} '*) echo \"$PROBE_APP_ID\" ;;\n44\t  *'config --quiet') exit 0 ;;\n45\t  *'config --format json') printf '{\"name\":\"%s\"}\\\\n' \"\\${PROBE_PROJECT:-tokenizer}\" ;;\n46\t  *'ps -q app') if [ -n \"\\${PROBE_CONTAINER:-}\" ]; then printf '%s\\\\n' \"$PROBE_CONTAINER\"; fi; exit 0 ;;\n47\t  inspect*) printf '%s\\\\n' \"\\${PROBE_DETAILS:-true|tokenizer|app|${APP_ID}}\" ;;\n48\t  'port '*) printf '%s\\\\n' \"\\${PROBE_PORT:-127.0.0.1:3010}\" ;;\n49\t  *) echo 'UNEXPECTED-MUTATION-ATTEMPT' >&2; exit 99 ;;\n50\tesac`);\n51\t  stub('curl', `if [ -n \"\\${PROBE_HEALTH+x}\" ]; then printf '%s' \"$PROBE_HEALTH\"; else printf '{\"ok\":true,\"code\":\"ready\",\"commit\":\"%s\"}' \"\\${OLD_SHA}\"; fi`);\n52\t}\n53\tfunction spawnBash(args, overrides = {}, useCwd = true) {\n54\t  const probeEnv = { ...process.env, PATH: `${join(root, 'bin')}:${process.env.PATH}`, CALLS: join(root, 'calls.log'),\n55\t      OLD_SHA: OLD, PROBE_APP_ID: APP_ID, PROBE_CONTAINER: 'a1b2c3d4e5f6', ...overrides };\n56\t  // macOS sporadically returns ENOENT for a posix_spawn into a freshly created\n57\t  // cwd; warm the spawn path once, then retry a genuine ENOENT exactly once.\n58\t  spawnSync('bash', ['-c', 'true'], { encoding: 'utf8', env: probeEnv });\n59\t  const opts = { encoding: 'utf8', timeout: 15000, maxBuffer: 8 * 1024 * 1024, env: probeEnv };\n60\t  if (useCwd) opts.cwd = root;\n61\t  let r = spawnSync('bash', args, opts);\n62\t  if (r.error && r.error.errno === -2) r = spawnSync('bash', args, opts);\n63\t  if (r.error) throw new Error(`spawn error: ${r.error.message} signal=${r.signal} cwd-exists=${existsSync(root)}`);\n64\t  return r;\n65\t}\n66\tfunction run(mode = 'live', overrides = {}) {\n67\t  return spawnBash([script, mode, CAND, APP, MIG], overrides);\n68\t}\n69\tfunction check(name, fn) {\n70\t  fixture();\n71\t  try { fn(); results.push({ name, pass: true }); }\n72\t  catch (e) { results.push({ name, pass: false, error: String(e.message || e) }); }\n73\t  rmSync(root, { recursive: true, force: true });\n74\t}\n75\tfunction expect(cond, msg) { if (!cond) throw new Error(msg); }\n76\tfunction callsLog() { return existsSync(join(root, 'calls.log')) ? readFileSync(join(root, 'calls.log'), 'utf8') : ''; }\n77\tfunction noMutation() {\n78\t  expect(!/pull|push|\\bup\\b|\\bstop\\b|\\brun\\b|login|logout|exec|build|restart|kill|\\brm\\b/.test(callsLog()), 'mutation command in calls');\n79\t}\n80\tfunction noCanary(r) {\n81\t  expect(!`${r.stdout}${r.stderr}`.includes(CANARY), 'canary leaked');\n82\t}\n83\t\n84\tcheck('live happy path: exact digest predecessor passes, read-only', () => {\n85\t  const before = snap();\n86\t  const r = run();\n87\t  expect(r.status === 0, `exit=${r.status} err=${r.stderr}`);\n88\t  expect(r.stdout.includes('production predecessor preflight passed'), 'missing pass line');\n89\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed on success');\n90\t  noMutation();\n91\t});\n92\t\n93\tcheck('explicit null health code is REFUSED (adjudicated predicate)', () => {\n94\t  const before = snap();\n95\t  const r = run('live', { PROBE_HEALTH: `{\"ok\":true,\"code\":null,\"commit\":\"${OLD}\"}` });\n96\t  expect(r.status !== 0, 'null code accepted');\n97\t  expect(r.stderr.includes('does not report the activated predecessor'), `wrong msg: ${r.stderr}`);\n98\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed on refusal');\n99\t  noMutation(); noCanary(r);\n100\t});\n101\t\n102\tcheck('absent code field with ok=true and exact SHA is accepted (old format)', () => {\n103\t  const r = run('live', { PROBE_HEALTH: `{\"ok\":true,\"commit\":\"${OLD}\"}` });\n104\t  expect(r.status === 0, `exit=${r.status} err=${r.stderr}`);\n105\t});\n106\t\n107\tcheck('wrong health code (db_unavailable) refused', () => {\n108\t  const r = run('live', { PROBE_HEALTH: `{\"ok\":true,\"code\":\"db_unavailable\",\"commit\":\"${OLD}\"}` });\n109\t  expect(r.status !== 0, 'wrong code accepted'); noCanary(r);\n110\t});\n111\t\n112\tcheck('health commit mismatch refused', () => {\n113\t  const r = run('live', { PROBE_HEALTH: `{\"ok\":true,\"code\":\"ready\",\"commit\":\"${'e'.repeat(40)}\"}` });\n114\t  expect(r.status !== 0, 'wrong commit accepted');\n115\t});\n116\t\n117\tcheck('legacy source-built predecessor image refused', () => {\n118\t  writeFileSync(join(root, '.env'), readFileSync(join(root, '.env'), 'utf8').replace(APP, 'tokenizer-app:latest'));\n119\t  const before = snap();\n120\t  const r = run();\n121\t  expect(r.status !== 0, 'legacy image accepted');\n122\t  expect(r.stderr.includes('digest-pinned'), `wrong msg: ${r.stderr}`);\n123\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed'); noCanary(r);\n124\t});\n125\t\n126\tcheck('missing activation ledger refused', () => {\n127\t  rmSync(join(root, '.releases', `${OLD}.activated`));\n128\t  const before = snap();\n129\t  const r = run();\n130\t  expect(r.status !== 0, 'missing ledger accepted');\n131\t  expect(r.stderr.includes('activated predecessor ledger is missing'), `wrong msg: ${r.stderr}`);\n132\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed');\n133\t});\n134\t\n135\tcheck('wrong backend port (0.0.0.0) refused', () => {\n136\t  const r = run('live', { PROBE_PORT: '0.0.0.0:3010' });\n137\t  expect(r.status !== 0, 'wrong port accepted'); noCanary(r);\n138\t});\n139\t\n140\tcheck('duplicate GIT_COMMIT in baseline refused', () => {\n141\t  writeFileSync(join(root, '.env'), `${readFileSync(join(root, '.env'), 'utf8')}GIT_COMMIT=${OLD}\\n`);\n142\t  const before = snap();\n143\t  const r = run();\n144\t  expect(r.status !== 0, 'duplicate accepted');\n145\t  expect(r.stderr.includes('missing or duplicate'), `wrong msg: ${r.stderr}`);\n146\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed');\n147\t});\n148\t\n149\tcheck('missing running app refused before any candidate manifest write', () => {\n150\t  const r = run('live', { PROBE_CONTAINER: '' });\n151\t  expect(r.status !== 0, 'absent app accepted');\n152\t  expect(r.stderr.includes('exactly one running Compose app'), `wrong msg: ${r.stderr}`);\n153\t  expect(!existsSync(join(root, '.releases', `${CAND}.manifest`)), 'candidate manifest created');\n154\t});\n155\t\n156\tcheck('two running apps refused', () => {\n157\t  const r = run('live', { PROBE_CONTAINER: 'a1b2c3d4e5f6\\nf6e5d4c3b2a1' });\n158\t  expect(r.status !== 0, 'multiple apps accepted');\n159\t});\n160\t\n161\tcheck('wrong compose project refused', () => {\n162\t  const r = run('live', { PROBE_DETAILS: `true|otherproject|app|${APP_ID}` });\n163\t  expect(r.status !== 0, 'wrong project accepted');\n164\t});\n165\t\n166\tcheck('wrong service identity refused', () => {\n167\t  const r = run('live', { PROBE_DETAILS: `true|tokenizer|postgres|${APP_ID}` });\n168\t  expect(r.status !== 0, 'wrong service accepted');\n169\t});\n170\t\n171\tcheck('non-running container refused', () => {\n172\t  const r = run('live', { PROBE_DETAILS: `false|tokenizer|app|${APP_ID}` });\n173\t  expect(r.status !== 0, 'stopped app accepted');\n174\t});\n175\t\n176\tcheck('same-SHA predecessor refused', () => {\n177\t  writeFileSync(join(root, '.env'), readFileSync(join(root, '.env'), 'utf8').replaceAll(OLD, CAND));\n178\t  const r = run();\n179\t  expect(r.status !== 0, 'same SHA accepted');\n180\t});\n181\t\n182\tcheck('stale previous-env retention record refused (byte mismatch)', () => {\n183\t  writeFileSync(join(root, '.releases', `${CAND}.previous-env`), 'stale\\n');\n184\t  const r = run();\n185\t  expect(r.status !== 0, 'stale retention accepted');\n186\t  expect(r.stderr.includes('does not match the current baseline'), `wrong msg: ${r.stderr}`);\n187\t});\n188\t\n189\tcheck('conflicting existing candidate manifest refused without rewrite', () => {\n190\t  const stale = `commit=${CAND}\\napp_image=ghcr.io/probe/app@sha256:${'f'.repeat(64)}\\nmigrate_image=${MIG}\\n`;\n191\t  writeFileSync(join(root, '.releases', `${CAND}.manifest`), stale);\n192\t  const r = run();\n193\t  expect(r.status !== 0, 'conflict accepted');\n194\t  expect(r.stderr.includes('immutable candidate manifest differs'), `wrong msg: ${r.stderr}`);\n195\t  expect(readFileSync(join(root, '.releases', `${CAND}.manifest`), 'utf8') === stale, 'manifest rewritten');\n196\t});\n197\t\n198\tcheck('retained mode: candidate env selecting different project refused', () => {\n199\t  // candidate .env = new sha; previous-env holds old sha\n200\t  const oldEnv = readFileSync(join(root, '.env'), 'utf8');\n201\t  writeFileSync(join(root, '.releases', `${CAND}.previous-env`), oldEnv);\n202\t  writeFileSync(join(root, '.env'), oldEnv.replace(OLD, CAND));\n203\t  const before = snap();\n204\t  const r = spawnBash([script, 'retained', CAND, APP, MIG]);\n205\t  expect(r.status === 0, `retained happy path exit=${r.status} err=${r.stderr}`);\n206\t  expect(JSON.stringify(snap()) === JSON.stringify(before), 'state changed');\n207\t  noMutation();\n208\t});\n209\t\n210\tcheck('invalid candidate args refused before any docker call', () => {\n211\t  const r = spawnBash([script, 'live', 'not-a-sha', APP, MIG]);\n212\t  expect(r.status !== 0, 'bad sha accepted');\n213\t  expect(!existsSync(join(root, 'calls.log')), 'docker called on invalid input');\n214\t});\n215\t\n216\tconst passed = results.filter(r => r.pass).length;\n217\tconsole.log(JSON.stringify({ suite: 'f002-predecessor-probes', total: results.length, passed, results }, null, 1));\n218\tprocess.exit(passed === results.length ? 0 : 1);"}
