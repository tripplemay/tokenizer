);\n105\t  const inv = readFileSync('scripts/ci/vps-host-preflight.sh', 'utf8');\n106\t  expect(inv.includes('(has(\"code\") | not) or .code == \"ready\"'), 'F003 inventory does not use the same rule');\n107\t});\n108\t\n109\tawait check('workflow composes macOS gate without dropping accepted release prerequisites', () => {\n110\t  const wf = readFileSync('.github/workflows/deploy-vps.yml', 'utf8');\n111\t  expect(wf.includes('verify-macos-agent:'), 'macOS job missing');\n112\t  expect(wf.includes('runs-on: macos-latest'), 'not native macOS runner');\n113\t  expect(wf.includes('launchctl print \"gui/$(id -u)\"'), 'GUI domain check missing');\n114\t  expect((wf.match(/verify-macos-agent/g) || []).length >= 3, 'macOS gate not wired into needs');\n115\t  for (const token of [\n116\t    'tests/server/b06-batch-db.probe.test.ts', 'tests/server/b07-queue-id-ack-db.probe.test.ts',\n117\t    'postgres:16-alpine', 'assert-vitest-results.mjs .ci/db-probes.json 15',\n118\t    'tests/cli/agent-release-installer-windows.test.ts', 'npm run test:e2e',\n119\t    'attest-build-provenance', 'rehearse-release.sh',\n120\t  ]) {\n121\t    expect(wf.includes(token), `workflow lost prerequisite: ${token}`);\n122\t  }\n123\t});\n124\t\n125\tconst passed = results.filter((r) => r.pass).length;\n126\tconsole.log(JSON.stringify({ suite: 'f001-macos-probes', total: results.length, passed, results }, null, 1));\n127\tprocess.exit(passed === results.length ? 0 : 1);"}
