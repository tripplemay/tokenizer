{"role":"tool","tool_call_id":"tool_OzEZPdLPjOF9iJeEjilbRqdK","content":"1\t// Independent Kimi preflight probes for F003 transport/workflow layer:\n2\t// - extract the actual jq allowlist filter from .github/workflows/deploy-vps.yml and\n3\t//   run it against evaluator-crafted payloads (valid, extra keys, raw canary, wrong types)\n4\t// - static operation-separation checks (host-preflight never deploys; release gates preserved)\n5\timport { spawnSync } from 'node:child_process';\n6\timport { readFileSync } from 'node:fs';\n7\t\n8\tconst workflow = readFileSync('.github/workflows/deploy-vps.yml', 'utf8');\n9\tconst SHA = 'c'.repeat(40);\n10\tconst CANARY = 'KIMI_F003_TRANSPORT_CANARY';\n11\tconst results = [];\n12\t\n13\tfunction check(name, fn) {\n14\t  try { fn(); results.push({ name, pass: true }); }\n15\t  catch (e) { results.push({ name, pass: false, error: String(e.message || e) }); }\n16\t}\n17\tfunction expect(cond, msg) { if (!cond) throw new Error(msg); }\n18\t\n19\t// Extract the jq program from the inventory step verbatim (same anchoring the CI gate uses,\n20\t// derived independently here): starts at 'def sha:' and ends before the closing quote line.\n21\tfunction jqFilter() {\n22\t  const marker = \"if ! jq -e --arg source \\\"$GITHUB_SHA\\\" '\";\n23\t  const start = workflow.indexOf(marker);\n24\t  expect(start > 0, 'jq filter invocation not found in workflow');\n25\t  const bodyStart = workflow.indexOf(\"def sha:\", start);\n26\t  const endMarker = `' \"$work/inventory.json\" >/dev/null 2>&1; then`;\n27\t  const end = workflow.indexOf(endMarker, bodyStart);\n28\t  expect(bodyStart > 0 && end > bodyStart, 'cannot slice jq filter');\n29\t  return workflow.slice(bodyStart, end).replace(/\\n {12}/g, '\\n');\n30\t}\n31\tconst filter = jqFilter();\n32\tfunction runFilter(payload) {\n33\t  const r = spawnSync('jq', ['-e', '--arg', 'source', SHA, filter], { input: payload, encoding: 'utf8', timeout: 5000 });\n34\t  return r.status === 0;\n35\t}\n36\t\n37\tconst validReport = JSON.stringify({\n38\t  schema_version: 1, operation: 'host-preflight', source_sha: SHA, timestamp: '2026-10-08T00:00:00Z',\n39\t  outcome: 'observed', reason: 'none', project: 'tokenizer', baseline: 'digest_activated',\n40\t  platform: 'Linux/x86_64', free_kib: '99900',\n41\t  versions: { docker: '27.5.1', compose: '2.35.1' },\n42\t  settings: { GIT_COMMIT: 'd'.repeat(40), APP_IMAGE: `ghcr.io/x/app@sha256:${'a'.repeat(64)}`, MIGRATE_IMAGE: `ghcr.io/x/migrate@sha256:${'b'.repeat(64)}`, APP_HOST_PORT: '127.0.0.1:3010' },\n43\t  app: { id: 'a1b2c3d4e5f6', status: 'running', health: 'healthy', image_id: `sha256:${'a'.repeat(64)}`, revision: 'd'.repeat(40), user: 'node', uid: 'unknown', port: '127.0.0.1:3010', network: 'tokenizer_default' },\n44\t  postgres: { id: 'b1c2d3e4f5a6', status: 'running', health: 'healthy', image_id: `sha256:${'b'.repeat(64)}`, network: 'tokenizer_default', volume: 'tokenizer_postgres-data' },\n45\t  storage: { network: 'tokenizer_default', network_driver: 'bridge', volume: 'tokenizer_postgres-data', volume_driver: 'local' },\n46\t  files: { env: { sha256: 'a'.repeat(64), mode: '600' } }\n47\t});\n48\t\n49\tcheck('allowlist filter accepts a well-formed observed report', () => {\n50\t  expect(runFilter(validReport), 'valid report rejected');\n51\t});\n52\t\n53\tcheck('allowlist filter rejects unexpected report key carrying canary (Config.Env)', () => {\n54\t  const evil = JSON.parse(validReport);\n55\t  evil['Config.Env'] = [CANARY];\n56\t  expect(!runFilter(JSON.stringify(evil)), 'extra Config.Env key accepted');\n57\t});\n58\t\n59\tcheck('allowlist filter rejects extra nested key under app', () => {\n60\t  const evil = JSON.parse(validReport);\n61\t  evil.app.env = [CANARY];\n62\t  expect(!runFilter(JSON.stringify(evil)), 'extra app.env accepted');\n63\t});\n64\t\n65\tcheck('allowlist filter rejects canary smuggled into a free-form field', () => {\n66\t  const evil = JSON.parse(validReport);\n67\t  evil.reason = CANARY;\n68\t  expect(!runFilter(JSON.stringify(evil)), 'canary reason accepted');\n69\t  evil.reason = 'none'; evil.baseline = CANARY;\n70\t  expect(!runFilter(JSON.stringify(evil)), 'canary baseline accepted');\n71\t});\n72\t\n73\tcheck('allowlist filter rejects wrong source_sha', () => {\n74\t  const evil = JSON.parse(validReport);\n75\t  evil.source_sha = 'd'.repeat(40);\n76\t  expect(!runFilter(JSON.stringify(evil)), 'wrong source accepted');\n77\t});\n78\t\n79\tcheck('allowlist filter rejects malformed SHA / port / uid values', () => {\n80\t  for (const mutate of [\n81\t    (e) => { e.settings.GIT_COMMIT = 'ZZZ'; },\n82\t    (e) => { e.settings.APP_HOST_PORT = '0.0.0.0:3010'; },\n83\t    (e) => { e.app.uid = 'root'; },\n84\t    (e) => { e.postgres.status = 'running\";danger'; },\n85\t    (e) => { e.files.env.sha256 = 'not-a-hash'; },\n86\t  ]) {\n87\t    const evil = JSON.parse(validReport);\n88\t    mutate(evil);\n89\t    expect(!runFilter(JSON.stringify(evil)), `malformed variant accepted: ${mutate}`);\n90\t  }\n91\t});\n92\t\n93\tcheck('host-preflight job cannot reach deploy on any event, release gates preserved', () => {\n94\t  const job = workflow.slice(workflow.indexOf('  host-preflight:\\n'), workflow.indexOf('  verify:\\n'));\n95\t  expect(job.includes(\"if: github.event_name == 'workflow_dispatch' && inputs.operation == 'host-preflight'\"), 'job gate missing');\n96\t  expect(!/npm ci|build-push|docker\\/login|rsync|\\bscp\\b|rehearse-release|deploy-vps-release|verify-vps-predecessor|REGISTRY_TOKEN|AUTH_SECRET|POSTGRES_PASSWORD|attest/.test(job), 'deploy capability inside host-preflight job');\n97\t  expect(job.includes('< scripts/ci/vps-host-preflight.sh'), 'script not piped over stdin');\n98\t  expect(job.includes('timeout --signal=KILL 150s ssh'), 'ssh not bounded');\n99\t  expect(job.includes('StrictHostKeyChecking=yes'), 'host key checking missing');\n100\t  expect(!/scp|rsync/.test(job), 'file upload present');\n101\t  const deployJob = workflow.slice(workflow.indexOf('  deploy:\\n'));\n102\t  expect(deployJob.includes(\"inputs.operation == 'release'\"), 'deploy not restricted to release');\n103\t  for (const gate of ['verify:', 'verify-windows:', 'verify-macos-agent:', 'verify-db:', 'verify-browser:', 'release-artifact:']) {\n104\t    const section = workflow.slice(workflow.indexOf(`  ${gate}`), workflow.indexOf('  ', workflow.indexOf(`  ${gate}`) + 3) + 4000);\n105\t    expect(workflow.includes(`${gate}`), `missing ${gate}`);\n106\t  }\n107\t  expect(workflow.match(/if: github\\.event_name != 'workflow_dispatch' \\|\\| inputs\\.operation == 'release'/g).length >= 6, 'release gating missing on normal jobs');\n108\t  expect(workflow.includes('needs: [verify, verify-windows, verify-macos-agent, verify-db, verify-browser]'), 'release-artifact needs changed');\n109\t  expect(workflow.includes('needs: [verify, verify-windows, verify-macos-agent, verify-db, verify-browser, release-artifact]'), 'deploy needs changed');\n110\t  expect(workflow.includes('EVAL_B07_DB_URL:') && workflow.includes('EVAL_B06_DB_URL:'), 'B06/B07 PG16 env floor lost');\n111\t  expect(workflow.includes('postgres:16-alpine'), 'PG16 service lost');\n112\t  expect(workflow.includes('node scripts/ci/assert-vitest-results.mjs .ci/db-probes.json 15'), 'db probe no-skip floor lost');\n113\t  expect(workflow.includes('host-preflight') && workflow.includes('default: release'), 'dispatch input missing');\n114\t});\n115\t\n116\tcheck('deploy job runs the predecessor guard BEFORE rsync and BEFORE env replacement', () => {\n117\t  const iPreflight = workflow.indexOf('- name: Verify live digest predecessor before remote mutation');\n118\t  const iRsync = workflow.indexOf('- name: Sync files to VPS');\n119\t  const iDeploy = workflow.indexOf('- name: Deploy on VPS');\n120\t  const iScp = workflow.indexOf('scp -i ~/.ssh/tokenizer_vps');\n121\t  const iRecheck = workflow.indexOf('Recheck after rsync');\n122\t  expect(0 < iPreflight && iPreflight < iRsync && iRsync < iDeploy && iDeploy < iScp, 'ordering broken');\n123\t  expect(iDeploy < iRecheck && iRecheck < iScp, 'post-rsync recheck missing before env copy');\n124\t  expect(workflow.slice(iPreflight, iRsync).includes('< scripts/verify-vps-predecessor.sh'), 'live preflight not piped');\n125\t});\n126\t\n127\tconst passed = results.filter(r => r.pass).length;\n128\tconsole.log(JSON.stringify({ suite: 'f003-transport-probes', total: results.length, passed, results }, null, 1));\n129\tprocess.exit(passed === results.length ? 0 : 1);"}
