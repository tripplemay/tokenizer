--- /dev/null
+++ b/tests/ci/vps-compose-version-shape.test.ts
@@ -0,0 +1,310 @@
+import { spawnSync } from 'node:child_process';
+import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+
+const base = '917b60c99af1f733103e307b41925d858b696bb4';
+const sha = 'c'.repeat(40);
+const scriptPath = 'scripts/ci/vps-host-preflight.sh';
+const workflowPath = '.github/workflows/deploy-vps.yml';
+const script = readFileSync(scriptPath, 'utf8');
+const workflow = readFileSync(workflowPath, 'utf8');
+const canary = 'SHAPE_SECRET_CANARY_NEVER_DISCLOSE';
+const homeCanary = '/synthetic/SHAPE_HOME_CANARY_NEVER_DISCLOSE';
+let root: string, bin: string, deploy: string;
+
+type Shape = {
+  prefix: string; core_present: boolean; tail_bytes: number | null; tail_charset: string;
+  has_cr: boolean; has_lf: boolean; has_horizontal_space: boolean; has_escape: boolean; has_non_ascii: boolean;
+};
+const shape = (prefix: string, core_present = false, tail_bytes: number | null = null, tail_charset = 'not_parsed', flags: Partial<Shape> = {}): Shape => ({
+  prefix, core_present, tail_bytes, tail_charset, has_cr: false, has_lf: false,
+  has_horizontal_space: false, has_escape: false, has_non_ascii: false, ...flags
+});
+
+function original(path: string) {
+  const result = spawnSync('git', ['show', `${base}:${path}`], { encoding: 'utf8' });
+  if (result.status !== 0) throw new Error(result.stderr);
+  return result.stdout;
+}
+
+function filter(source = workflow) {
+  const marker = "          if ! jq -e --arg source \"$GITHUB_SHA\" '\n";
+  const start = source.indexOf(marker) + marker.length;
+  const end = source.indexOf("          ' \"$work/inventory.json\" >/dev/null 2>&1; then", start);
+  if (start < marker.length || end < start) throw new Error('missing workflow validator');
+  return { jq: source.slice(start, end), outside: `${source.slice(0, start)}<VALIDATOR>${source.slice(end)}` };
+}
+
+function gate(body: unknown) {
+  return spawnSync('jq', ['-e', '--arg', 'source', sha, filter().jq], {
+    input: JSON.stringify(body), encoding: 'utf8', env: { PATH: '/usr/bin:/bin', NODE_ENV: 'test' }
+  });
+}
+
+function fixtureTool(name: string, body: string) {
+  const path = join(bin, name);
+  writeFileSync(path, `#!${process.execPath}\nconst fs=require('node:fs'),args=process.argv.slice(2),env=process.env;\nfs.appendFileSync(env.CALLS,JSON.stringify([${JSON.stringify(name)},...args])+'\\n');\nif(env.LOCALES)fs.appendFileSync(env.LOCALES,JSON.stringify(env.LC_ALL)+'\\n');\n${body}\n`);
+  chmodSync(path, 0o755);
+}
+
+function snapshot(directory = deploy): unknown {
+  return readdirSync(directory).sort().map((name) => {
+    const path = join(directory, name), stat = statSync(path);
+    return [name, stat.mode, stat.isDirectory() ? snapshot(path) : readFileSync(path).toString('hex')];
+  });
+}
+
+function execute(output = 'v2.35.1\n', options: { code?: number; pipelineCode?: number; hang?: boolean; early?: boolean; source?: string; locale?: string; home?: string } = {}) {
+  const callPath = join(root, 'calls');
+  const localePath = join(root, 'locales');
+  if (existsSync(callPath)) rmSync(callPath);
+  if (existsSync(localePath)) rmSync(localePath);
+  const env: NodeJS.ProcessEnv = {
+    NODE_ENV: 'test', PATH: `${bin}:/usr/bin:/bin`, CALLS: callPath, LOCALES: localePath, CANARY: canary, OUTPUT: Buffer.from(output).toString('base64'),
+    CODE: String(options.code ?? 0), PIPELINE_CODE: options.pipelineCode === undefined ? '' : String(options.pipelineCode),
+    HANG: options.hang ? '1' : '', EARLY: options.early ? '1' : '', LC_ALL: options.locale ?? 'en_US.UTF-8'
+  };
+  if (options.home !== undefined) env.HOME = options.home;
+  const before = snapshot();
+  const result = spawnSync('/bin/bash', [options.source ?? join(process.cwd(), scriptPath), deploy, sha], {
+    encoding: 'utf8', env, timeout: 10_000
+  });
+  expect(result.error).toBeUndefined();
+  expect(result.stderr).toBe('');
+  expect(result.stdout).not.toContain(canary);
+  expect(result.stdout).not.toContain(homeCanary);
+  expect(snapshot()).toEqual(before);
+  const body = JSON.parse(result.stdout);
+  const calls: string[][] = existsSync(callPath) ? readFileSync(callPath, 'utf8').trim().split('\n').map((line) => JSON.parse(line)) : [];
+  if (existsSync(localePath)) expect(readFileSync(localePath, 'utf8').trim().split('\n').map((line) => JSON.parse(line)))
+    .toEqual(Array.from({ length: calls.length }, () => env.LC_ALL));
+  if (!options.source) expect(gate(body).status, `${gate(body).stderr}\n${result.stdout}`).toBe(0);
+  return { result, body, calls };
+}
+
+function refusal(value: ReturnType<typeof execute>) {
+  expect(value.result.status).toBe(1);
+  expect(value.body).toMatchObject({ outcome: 'refused', reason: 'compose_unavailable', versions: { compose: 'unknown' }, files: {} });
+  expect(value.calls.filter(([tool]) => tool === 'timeout')).toEqual([
+    ['timeout', '--signal=KILL', '5s', 'uname', '-s'], ['timeout', '--signal=KILL', '5s', 'uname', '-m'],
+    ['timeout', '--signal=KILL', '5s', 'df', '-Pk', '--', deploy],
+    ['timeout', '--signal=KILL', '5s', 'docker', 'version', '--format', '{{.Server.Version}}'],
+    ['timeout', '--signal=KILL', '5s', 'docker', 'compose', 'version', '--short']
+  ]);
+  expect(value.calls.filter(([tool]) => tool === 'docker')).toEqual([
+    ['docker', 'version', '--format', '{{.Server.Version}}'], ['docker', 'compose', 'version', '--short']
+  ]);
+  expect(value.calls.filter(([tool]) => tool === 'head')).toEqual(Array.from({ length: 5 }, () => ['head', '-c', '16385']));
+  expect(value.calls.some(([tool]) => ['curl', 'stat', 'sha256sum'].includes(tool))).toBe(false);
+}
+
+describe.skipIf(process.platform === 'win32')('independent retained Compose shape controls', () => {
+  beforeEach(() => {
+    root = mkdtempSync(join(tmpdir(), 'cs-')); bin = join(root, 'bin'); deploy = join(root, 'deploy');
+    mkdirSync(bin); mkdirSync(deploy);
+    writeFileSync(join(deploy, '.env'), `AUTH_SECRET=${canary}\n`);
+    writeFileSync(join(deploy, 'docker-compose.yml'), `# ${canary}\nservices: {}\n`);
+    fixtureTool('timeout', `const {spawnSync}=require('node:child_process');
+      if(args.shift()!=='--signal=KILL'||args.shift()!=='5s')process.exit(99);
+      const command=args.shift(),child=spawnSync(command,args,{timeout:5000,killSignal:'SIGKILL'});
+      const code=command==='docker'&&args[0]==='compose'&&env.PIPELINE_CODE!==''?Number(env.PIPELINE_CODE):child.error?.code==='ETIMEDOUT'?124:child.status??1;
+      process.stdout.on('error',()=>process.exit(code));
+      process.stdout.write(child.stdout||Buffer.alloc(0),()=>process.exit(code));`);
+    fixtureTool('head', `const data=fs.readFileSync(0);if(JSON.stringify(args)!==JSON.stringify(['-c','16385']))process.exit(99);process.stdout.write(data.subarray(0,16385));`);
+    fixtureTool('uname', `if(env.EARLY)process.exit(4);console.log(args[0]==='-s'?'Linux':'x86_64');`);
+    fixtureTool('df', `console.log('Filesystem 1024-blocks Used Available Capacity Mounted on\\nfixture 100000 100 99900 1% /scope');`);
+    fixtureTool('stat', `const stat=fs.statSync(args.at(-1));console.log(args[1]==='%s'?stat.size:(stat.mode&0o7777).toString(8));`);
+    fixtureTool('sha256sum', `console.log(require('node:crypto').createHash('sha256').update(fs.readFileSync(args.at(-1))).digest('hex')+'  fixture');`);
+    fixtureTool('curl', 'process.exit(99);');
+    fixtureTool('docker', `process.stderr.write(env.CANARY);
+      if(JSON.stringify(args)===JSON.stringify(['version','--format','{{.Server.Version}}'])){console.log('29.1.3');return;}
+      if(JSON.stringify(args)===JSON.stringify(['compose','version','--short'])){
+        if(env.HANG){setTimeout(()=>process.exit(0),60000);return;}
+        process.stdout.write(Buffer.from(env.OUTPUT,'base64'),()=>process.exit(Number(env.CODE)));return;
+      }
+      if(args[0]==='ps')return;process.exit(99);`);
+  });
+  afterEach(() => rmSync(root, { recursive: true, force: true }));
+
+  it.each([
+    ['', shape('empty')], ['\n\n', shape('empty')], ['2', shape('numeric')], ['v2', shape('v_numeric')],
+    ['Docker Compose version ', shape('docker_compose_version', false, null, 'not_parsed', { has_horizontal_space: true })],
+    ['Docker Compose version invalid', shape('docker_compose_version', false, null, 'not_parsed', { has_horizontal_space: true })],
+    ['Version 2.35.1', shape('other', false, null, 'not_parsed', { has_horizontal_space: true })],
+    ['V2.35.1', shape('other')], ['prefix-v2.35.1', shape('other')], [canary, shape('other')]
+  ])('classifies prefix without disclosing or parsing other text %#', (output, expected) => {
+    const value = execute(output as string);
+    expect(value.body.compose_version_shape).toEqual(expected);
+    refusal(value);
+  });
+
+  it.each([
+    ['2.35.1', shape('numeric', true, 0, 'empty'), true],
+    ['v2.35.1\n\n', shape('v_numeric', true, 0, 'empty'), true],
+    ['2.35.1-rc.2+build', shape('numeric', true, 11, 'legacy'), true],
+    ['2.35.1~deb', shape('numeric', true, 4, 'legacy_plus_tilde'), false],
+    ['v2.35.1_build', shape('v_numeric', true, 6, 'legacy_plus_underscore'), false],
+    ['2.35.1~deb_build', shape('numeric', true, 10, 'legacy_plus_tilde_underscore'), false],
+    ['2.35.1~!', shape('numeric', true, 2, 'other'), false],
+    ['Docker Compose version v2.35.1~deb', shape('docker_compose_version', true, 4, 'legacy_plus_tilde', { has_horizontal_space: true }), false],
+    ['Docker Compose version 2.35.1', shape('docker_compose_version', true, 0, 'empty', { has_horizontal_space: true }), false],
+    ['Docker Compose version V2.35.1', shape('docker_compose_version', false, null, 'not_parsed', { has_horizontal_space: true }), false],
+    ['2.35.1' + 'a'.repeat(33), shape('numeric', true, 33, 'legacy'), false]
+  ])('classifies each tail alphabet without relaxing acceptance %#', (output, expected, valid) => {
+    const value = execute(output as string);
+    expect(value.body.compose_version_shape).toEqual(expected);
+    if (valid) {
+      expect(value.body.compose_probe.status).toBe('ok');
+      expect(value.body.versions.compose).toBe((output as string).replace(/\n+$/, ''));
+      expect(value.body.reason).toBe('missing_or_multiple_app');
+    } else refusal(value);
+  });
+
+  it.each([
+    ['2.35.1\r', { has_cr: true }], ['2.35.1\nrest', { has_lf: true }],
+    ['2.35.1 rest', { has_horizontal_space: true }], ['2.35.1\t', { has_horizontal_space: true }],
+    ['2.35.1\x1b[31m', { has_escape: true }], ['2.35.1\u00e9', { has_non_ascii: true }],
+    ['\x1b\t\u00e9\r\ntext', { has_cr: true, has_lf: true, has_horizontal_space: true, has_escape: true, has_non_ascii: true }]
+  ])('flags exact retained control/non-ASCII bytes %#', (output, flags) => {
+    const value = execute(output as string), numeric = (output as string).startsWith('2');
+    expect(value.body.compose_version_shape).toEqual(shape(numeric ? 'numeric' : 'other', numeric,
+      numeric ? Buffer.byteLength(output as string) - 6 : null, numeric ? 'other' : 'not_parsed', flags as Partial<Shape>));
+    refusal(value);
+  });
+
+  it.each(['C', 'en_US.UTF-8'])('counts a multibyte tail in retained bytes under %s without changing query locale', (locale) => {
+    const value = execute('2.35.1' + '\u00e9'.repeat(8189) + '\n\n', { locale });
+    expect(value.body.compose_probe.captured_bytes).toBe(16384);
+    expect(value.body.compose_version_shape).toEqual(shape('numeric', true, 16378, 'other', { has_non_ascii: true }));
+    refusal(value);
+  });
+
+  it('keeps all old report fields, query argv/order and refusal point byte-equivalent to the base', () => {
+    const baseline = join(root, 'original.sh'); writeFileSync(baseline, original(scriptPath));
+    for (const output of ['v2.35.1\n', '2.35.1~distro\n', canary]) {
+      const candidate = execute(output, { home: homeCanary }), old = execute(output, { source: baseline, home: homeCanary });
+      const { timestamp: _time, compose_version_shape: _shape, ...body } = candidate.body;
+      const { timestamp: _oldTime, ...oldBody } = old.body;
+      expect(body).toEqual(oldBody);
+      // Pipeline head starts concurrently; only its cross-process log interleaving varies.
+      expect(candidate.calls.filter(([tool]) => tool !== 'head')).toEqual(old.calls.filter(([tool]) => tool !== 'head'));
+      expect(candidate.calls.filter(([tool]) => tool === 'head')).toEqual(old.calls.filter(([tool]) => tool === 'head'));
+      expect(candidate.result.status).toBe(old.result.status);
+    }
+  });
