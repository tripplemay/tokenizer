diff --git a/scripts/ci/vps-host-preflight.sh b/scripts/ci/vps-host-preflight.sh
index 9f74a37..5a092eb 100644
--- a/scripts/ci/vps-host-preflight.sh
+++ b/scripts/ci/vps-host-preflight.sh
@@ -27,6 +27,38 @@ network_driver=unknown volume_driver=unknown
 files='{}'
 compose_probe_status=not_run compose_pipeline_exit_status=null compose_captured_bytes=null compose_home_present=false
 if [[ ${HOME+x} == x ]]; then compose_home_present=true; fi
+compose_version_shape=null
+
+classify_compose_version() {
+  local LC_ALL=C retained="$1" candidate="$1" prefix=other core_present=false tail_bytes=null tail_charset=not_parsed tail
+  local has_cr=false has_lf=false has_horizontal_space=false has_escape=false has_non_ascii=false
+  if [[ -z "$retained" ]]; then prefix=empty
+  elif [[ "$retained" == 'Docker Compose version '* ]]; then
+    prefix=docker_compose_version candidate="${retained#'Docker Compose version '}"
+  elif [[ "$retained" =~ ^v[0-9] ]]; then prefix=v_numeric
+  elif [[ "$retained" =~ ^[0-9] ]]; then prefix=numeric
+  fi
+  if [[ "$prefix" != other && "$prefix" != empty && "$candidate" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ ]]; then
+    tail="${candidate:${#BASH_REMATCH[0]}}"
+    core_present=true tail_bytes=${#tail}
+    if [[ -z "$tail" ]]; then tail_charset=empty
+    elif [[ "$tail" =~ ^[a-zA-Z0-9.+-]+$ ]]; then tail_charset=legacy
+    elif [[ "$tail" =~ ^[a-zA-Z0-9.+~_-]+$ ]]; then
+      if [[ "$tail" == *'~'* && "$tail" == *'_'* ]]; then tail_charset=legacy_plus_tilde_underscore
+      elif [[ "$tail" == *'~'* ]]; then tail_charset=legacy_plus_tilde
+      else tail_charset=legacy_plus_underscore
+      fi
+    else tail_charset=other
