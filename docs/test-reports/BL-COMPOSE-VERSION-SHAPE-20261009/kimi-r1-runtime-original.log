{"role":"tool","tool_call_id":"tool_5Z9YBwJWDbsE8JLOYBO1EUmC","content":"1\t#!/usr/bin/env bash\n2\tset +x\n3\texec 2>/dev/null\n4\tset -euo pipefail\n5\t\n6\t# Only query subprocesses are bounded/killed; no container or service is signalled.\n7\tquery() {\n8\t  local value\n9\t  value=\"$(timeout --signal=KILL 5s \"$@\" 2>/dev/null | head -c 16385)\" || return 1\n10\t  [[ ${#value} -le 16384 ]] || return 1\n11\t  printf '%s' \"$value\"\n12\t}\n13\tvalid_sha() { [[ \"$1\" =~ ^[0-9a-f]{40}$ ]]; }\n14\tvalid_id() { [[ \"$1\" =~ ^[0-9a-f]{12,64}$ ]]; }\n15\tvalid_digest() { [[ \"$1\" =~ ^sha256:[0-9a-f]{64}$ ]]; }\n16\tvalid_image() { [[ \"$1\" =~ ^[a-z0-9][a-z0-9./:_-]{1,240}(@sha256:[0-9a-f]{64})?$ ]]; }\n17\tregular() { [[ -f \"$1\" && ! -L \"$1\" ]]; }\n18\t\n19\tsource_sha=\"${2:-unknown}\"\n20\ttimestamp=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n21\toutcome=refused reason=invalid_input baseline=unknown platform=unknown free_kib=unknown\n22\tdocker_version=unknown compose_version=unknown commit=unknown app_image=unknown migrate_image=unknown host_port=unknown\n23\tapp_id=unknown app_status=unknown app_health=unknown app_image_id=unknown revision=unknown image_user=unknown uid=unknown\n24\tpostgres_id=unknown postgres_status=unknown postgres_health=unknown postgres_image_id=unknown\n25\tapp_network=unknown postgres_network=unknown postgres_volume=unknown\n26\tnetwork_driver=unknown volume_driver=unknown\n27\tfiles='{}'\n28\tcompose_probe_status=not_run compose_pipeline_exit_status=null compose_captured_bytes=null compose_home_present=false\n29\tif [[ ${HOME+x} == x ]]; then compose_home_present=true; fi\n30\tcompose_version_shape=null\n31\t\n32\tclassify_compose_version() {\n33\t  local LC_ALL=C retained=\"$1\" candidate=\"$1\" prefix=other core_present=false tail_bytes=null tail_charset=not_parsed tail\n34\t  local has_cr=false has_lf=false has_horizontal_space=false has_escape=false has_non_ascii=false\n35\t  if [[ -z \"$retained\" ]]; then prefix=empty\n36\t  elif [[ \"$retained\" == 'Docker Compose version '* ]]; then\n37\t    prefix=docker_compose_version candidate=\"${retained#'Docker Compose version '}\"\n38\t  elif [[ \"$retained\" =~ ^v[0-9] ]]; then prefix=v_numeric\n39\t  elif [[ \"$retained\" =~ ^[0-9] ]]; then prefix=numeric\n40\t  fi\n41\t  if [[ \"$prefix\" != other && \"$prefix\" != empty && \"$candidate\" =~ ^v?[0-9]+\\.[0-9]+\\.[0-9]+ ]]; then\n42\t    tail=\"${candidate:${#BASH_REMATCH[0]}}\"\n43\t    core_present=true tail_bytes=${#tail}\n44\t    if [[ -z \"$tail\" ]]; then tail_charset=empty\n45\t    elif [[ \"$tail\" =~ ^[a-zA-Z0-9.+-]+$ ]]; then tail_charset=legacy\n46\t    elif [[ \"$tail\" =~ ^[a-zA-Z0-9.+~_-]+$ ]]; then\n47\t      if [[ \"$tail\" == *'~'* && \"$tail\" == *'_'* ]]; then tail_charset=legacy_plus_tilde_underscore\n48\t      elif [[ \"$tail\" == *'~'* ]]; then tail_charset=legacy_plus_tilde\n49\t      else tail_charset=legacy_plus_underscore\n50\t      fi\n51\t    else tail_charset=other\n52\t    fi\n53\t  fi\n54\t  [[ \"$retained\" != *$'\\r'* ]] || has_cr=true\n55\t  [[ \"$retained\" != *$'\\n'* ]] || has_lf=true\n56\t  [[ \"$retained\" != *' '* && \"$retained\" != *$'\\t'* ]] || has_horizontal_space=true\n57\t  [[ \"$retained\" != *$'\\033'* ]] || has_escape=true\n58\t  [[ \"$retained\" != *[$'\\200'-$'\\377']* ]] || has_non_ascii=true\n59\t  printf '{\"prefix\":\"%s\",\"core_present\":%s,\"tail_bytes\":%s,\"tail_charset\":\"%s\",\"has_cr\":%s,\"has_lf\":%s,\"has_horizontal_space\":%s,\"has_escape\":%s,\"has_non_ascii\":%s}' \\\n60\t    \"$prefix\" \"$core_present\" \"$tail_bytes\" \"$tail_charset\" \"$has_cr\" \"$has_lf\" \"$has_horizontal_space\" \"$has_escape\" \"$has_non_ascii\"\n61\t}\n62\t\n63\temit() {\n64\t  if ! command -v jq >/dev/null; then\n65\t    printf '{\"schema_version\":1,\"operation\":\"host-preflight\",\"outcome\":\"refused\",\"reason\":\"missing_tools\"}\\n'\n66\t    return\n67\t  fi\n68\t  jq -n --arg source \"$source_sha\" --arg timestamp \"$timestamp\" --arg outcome 