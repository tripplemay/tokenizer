.stringify(['compose','version','--short'])){\n125\t        if(e.HANG){setTimeout(()=>process.exit(0),60000);return;}\n126\t        process.stdout.write(Buffer.from(e.OUTPUT,'base64'),()=>process.exit(Number(e.CODE)));return;\n127\t      }\n128\t      if(a[0]==='ps')return;\n129\t      process.exit(99);`);\n130\t  });\n131\t  afterEach(() => rmSync(root, { recursive: true, force: true }));\n132\t\n133\t  it.each([undefined, '', homeCanary])('records HOME presence only, including empty HOME %#', (home) => {\n134\t    const value = run({ home, output: 'v2.35.1\\n\\n\\n' });\n135\t    expect(value.probe).toEqual({ status: 'ok', pipeline_exit_status: 0, captured_bytes: 7, home_present: home !== undefined });\n136\t    expect(value.body.versions.compose).toBe('v2.35.1');\n137\t    expect(value.body.reason).toBe('missing_or_multiple_app');\n138\t    expect(value.calls.filter(([name]) => name === 'docker').at(-1)).toEqual([\n139\t      'docker', 'ps', '-a', '--filter', 'label=com.docker.compose.project=tokenizer', '--filter', 'label=com.docker.compose.service=app', '--format', '{{.ID}}'\n140\t    ]);\n141\t  });\n142\t\n143\t  it.each([1, 23, 124, 137, 141, 255])('retains whole bounded pipeline status %i without cause inference', (code) => {\n144\t    expectComposeRefusal(run({ pipelineCode: code, output: `${secret}\\n\\n` }), {\n145\t      status: 'command_failed', pipeline_exit_status: code, captured_bytes: Buffer.byteLength(secret), home_present: false\n146\t    });\n147\t  });\n148\t\n149\t  it('records command failure even when stdout is valid semver', () => {\n150\t    expectComposeRefusal(run({ code: 7, output: '2.35.1\\n' }), {\n151\t      status: 'command_failed', pipeline_exit_status: 7, captured_bytes: 6, home_present: false\n152\t    });\n153\t  });\n154\t\n155\t  it('records the rightmost failing capture stage, not necessarily the Docker exit code', () => {\n156\t    expectComposeRefusal(run({ code: 7, headCode: 141, output: 'v2.35.1\\n' }), {\n157\t      stat