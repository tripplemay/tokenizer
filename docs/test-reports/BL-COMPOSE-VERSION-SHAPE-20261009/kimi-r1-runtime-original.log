join(root, 'bin'); deploy = join(root, 'deploy');\\n    mkdirSync(bin); mkdirSync(deploy);\\n    writeFileSync(join(deploy, '.env'), `AUTH_SECRET=${CANARY}\\\\n`);\\n    writeFileSync(join(deploy, 'docker-compose.yml'), `# ${CANARY}\\\\nservices: {}\\\\n`);\\n    fakeTool('timeout', `const {spawnSync}=require('node:child_process');\\n      if(A.shift()!=='--signal=KILL'||A.shift()!=='5s')process.exit(97);\\n      const cmd=A.shift(),r=spawnSync(cmd,A,{timeout:5000,killSignal:'SIGKILL'});\\n      let code=r.error&&r.error.code==='ETIMEDOUT'?124:(r.status===null?1:r.status);\\n      if(cmd==='docker'&&A[0]==='compose'&&E.OVERRIDE!=='')code=Number(E.OVERRIDE);\\n      process.stdout.write(r.stdout||Buffer.alloc(0),()=>process.exit(code));`);\\n    fakeTool('head', `if(A.length!==2||A[0]!=='-c'||A[1]!=='16385')process.exit(97);\\n      const data=fs.readFileSync(0);process.stdout.write(data.subarray(0,16385),()=>process.exit(0));`);\\n    fakeTool('uname', `if(E.EARLY==='uname')process.exit(4);process.stdout.write(A[0]==='-s'?'Linux\\\\\\\\n':'x86_64\\\\\\\\n');`);\\n    fakeTool('df', `if(E.EARLY==='df'){process.stdout.write('invalid\\\\\\\\n');process.exit(0);}\\n      process.stdout.write('Filesystem 1024-blocks Used Available Capacity Mounted on\\\\\\\\nfixture 100000 100 99900 1% /scope\\\\\\\\n');`);\\n    fakeTool('stat', `const s=fs.statSync(A.at(-1));\\n      process.stdout.write((A[1]==='%s'?String(s.size):(s.mode&0o7777).toString(8))+'\\\\\\\\n');`);\\n    fakeTool('sha256sum', `process.stdout.write(require('node:crypto').createHash('sha256').update(fs.readFileSync(A.at(-1))).digest('hex')+'  fixture\\\\\\\\n');`);\\n    fakeTool('curl', 'process.exit(97);');\\n    fakeTool('docker', `process.stderr.write(E.CANARY);\\n      if(A[0]==='version'&&A[1]==='--format'){if(E.EARLY==='docker')process.exit(3);process.stdout.write('29.1.3\\\\\\\\n');process.exit(0);}\\n      if(A.join('|')==='compose|version|--short'){\\n        if(E.HANG==='1'){setTimeout(()=>process.