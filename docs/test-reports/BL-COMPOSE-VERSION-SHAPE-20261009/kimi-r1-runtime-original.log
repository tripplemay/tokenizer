n.length;\\n  const end = source.indexOf(close, start);\\n  if (start < open.length || end < start) throw new Error('real workflow validator not found');\\n  return { jq: source.slice(start, end), outside: `${source.slice(0, start)}<VALIDATOR/>${source.slice(end)}` };\\n}\\n\\n// Runs the real workflow jq filter against a candidate report body.\\nfunction acceptedByRealValidator(body: unknown): boolean {\\n  const result = spawnSync('jq', ['-e', '--arg', 'source', SHA, workflowValidator().jq], {\\n    input: JSON.stringify(body), encoding: 'utf8', env: { PATH: '/usr/bin:/bin', NODE_ENV: 'test' }\\n  });\\n  if (result.status !== 0 && result.status !== 1) throw new Error(`jq failed: ${result.stderr}`);\\n  return result.status === 0;\\n}\\n\\ntype Shape = {\\n  prefix: string; core_present: boolean; tail_bytes: number | null; tail_charset: string;\\n  has_cr: boolean; has_lf: boolean; has_horizontal_space: boolean; has_escape: boolean; has_non_ascii: boolean;\\n};\\nconst expectShape = (prefix: string, core = false, tailBytes: number | null = null, charset = 'not_parsed', flags: Partial<Shape> = {}): Shape => ({\\n  prefix, core_present: core, tail_bytes: tailBytes, tail_charset: charset,\\n  has_cr: false, has_lf: false, has_horizontal_space: false, has_escape: false, has_non_ascii: false, ...flags\\n});\\n\\ndescribe.skipIf(process.platform === 'win32')('producer controls: real script under fixture tools', () => {\\n  let root: string, bin: string, deploy: string;\\n\\n  function fakeTool(name: string, js: string) {\\n    const path = join(bin, name);\\n    writeFileSync(path, `#!${process.execPath}\\\\nconst fs=require('node:fs'),A=process.argv.slice(2),E=process.env;\\\\nfs.appendFileSync(E.LOG,JSON.stringify([${JSON.stringify(name)},...A])+'\\\\\\\\n');fs.appendFileSync(E.LCLOG,JSON.stringify(E.LC_ALL??null)+'\\\\\\\\n');\\\\n${js}\\\\n`);\\n    chmodSync(path, 0o755);\\n  }\\n\\n  function deployTree(directory = deploy): unknown {\\n    return readdirSync(directory).sort().map((name) => {\\n      const path = join(directory, name), stat = statSync(path);\\n      return [name, stat.mode & 0o7777, stat.isDirectory() ? deployTree(path) : readFileSync(path).toString('hex')];\\n    });\\n  }\\n\\n  type Run = { status: number | null; body: any; calls: string[][]; locales: unknown[]; elapsedMs: number };\\n  function invoke(output: string, options: { exit?: number; override?: string; hang?: boolean; early?: string; locale?: string; home?: string; args?: string[] } = {}): Run {\\n    const log = join(root, 'log'), lclog = join(root, 'lclog');\\n    for (const file of [log, lclog]) if (existsSync(file)) rmSync(file);\\n    const env: NodeJS.ProcessEnv = {\\n      NODE_ENV: 'test', PATH: `${bin}:/usr/bin:/bin`, LOG: log, LCLOG: lclog,\\n      OUT_B64: Buffer.from(output).toString('base64'), EXIT: String(options.exit ?? 0),\\n      OVERRIDE: options.override ?? '', HANG: options.hang ? '1' : '', EARLY: options.early ?? '',\\n      CANARY, LC_ALL: options.locale ?? 'en_US.UTF-8'\\n    };\\n    if (options.home !== undefined) env.HOME = options.home;\\n    const before = deployTree();\\n    const start = Date.now();\\n    const result = spawnSync('/bin/bash', [join(process.cwd(), SCRIPT), ...(options.args ?? [deploy, SHA])], {\\n      env, encoding: 'utf8', timeout: 15_000\\n    });\\n    const elapsedMs = Date.now() - start;\\n    expect(result.error).toBeUndefined();\\n    expect(result.stderr).toBe('');\\n    expect(result.stdout).not.toContain(CANARY);\\n    expect(result.stdout).not.toContain(HOME_CANARY);\\n    expect(result.stdout).not.toContain(root);\\n    expect(deployTree()).toEqual(before);\\n    const body = JSON.parse(result.stdout);\\n    expect(acceptedByRealValidator(body), result.stdout).toBe(true);\\n    const calls = existsSync(log) ? readFileSync(log, 'utf8').trim().split('\\\\n').map((line) => JSON.parse(line)) : [];\\n    const locales = existsSync(lclog) ? readFileSync(lclog, 'utf8').trim().split('\\\\n').map(