{"role":"tool","tool_call_id":"tool_Qi8hksM95c5KVAgEWEzY7Bqt","content":"1\timport { createHash } from 'node:crypto';\n2\timport { spawnSync } from 'node:child_process';\n3\timport { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } from 'node:fs';\n4\timport { tmpdir } from 'node:os';\n5\timport { join } from 'node:path';\n6\timport { afterEach, beforeEach, describe, expect, it } from 'vitest';\n7\t\n8\tconst base = 'a5ea6e3f66ab4b4b831de88a6bcb078f444b2aca';\n9\tconst sha = 'c'.repeat(40);\n10\tconst scriptPath = 'scripts/ci/vps-host-preflight.sh';\n11\tconst workflowPath = '.github/workflows/deploy-vps.yml';\n12\tconst script = readFileSync(scriptPath, 'utf8');\n13\tconst workflow = readFileSync(workflowPath, 'utf8');\n14\tconst secret = 'SECRET_OUTPUT_CANARY_NEVER_RETAIN';\n15\tconst homeCanary = '/synthetic/HOME_PATH_CANARY_NEVER_RETAIN';\n16\tlet root: string, bin: string, deploy: string;\n17\t\n18\tfunction baseline(path: string) {\n19\t  const result = spawnSync('git', ['show', `${base}:${path}`], { encoding: 'utf8' });\n20\t  if (result.status !== 0) throw new Error(result.stderr);\n21\t  return result.stdout;\n22\t}\n23\t\n24\tfunction validator(source: string) {\n25\t  const marker = \"          if ! jq -e --arg source \\\"$GITHUB_SHA\\\" '\\n\";\n26\t  const start = source.indexOf(marker) + marker.length;\n27\t  const end = source.indexOf(\"          ' \\\"$work/inventory.json\\\" >/dev/null 2>&1; then\", start);\n28\t  if (start < marker.length || end < start) throw new Error('missing real host validator');\n29\t  return { filter: source.slice(start, end), outside: `${source.slice(0, start)}<FILTER>${source.slice(end)}` };\n30\t}\n31\t\n32\tfunction gate(body: unknown) {\n33\t  return spawnSync('jq', ['-e', '--arg', 'source', sha, validator(workflow).filter], {\n34\t    input: JSON.stringify(body), encoding: 'utf8', env: { PATH: '/usr/bin:/bin', NODE_ENV: 'test' }\n35\t  });\n36\t}\n37\t\n38\tfun