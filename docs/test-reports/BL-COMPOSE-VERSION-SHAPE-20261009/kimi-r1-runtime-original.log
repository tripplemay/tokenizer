            < scripts/ci/vps-host-preflight.sh 2>/dev/null | head -c 65537 > "$work/inventory.json" || status=$?
          if (( $(wc -c < "$work/inventory.json") > 65536 )); then
            echo 'Host inventory exceeded the report bound' >&2; exit 1
          fi
          if ! jq -e --arg source "$GITHUB_SHA" '
            def sha: test("^([0-9a-f]{40}|unknown)$");
            def id: test("^([0-9a-f]{12,64}|unknown)$");
