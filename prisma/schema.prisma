generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String       @id @default(cuid())
  name          String
  workspacePath String?      @unique
  repoKey       String?      @unique
  repoRemote    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  usageEvents   UsageEvent[]

  @@index([name])
}

model Device {
  id             String       @id
  name           String
  hostname       String?
  platform       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime?
  lastSyncAt     DateTime?
  agentVersion   String?
  queueDepth     Int?
  lastError      String?
  lastErrorAt    DateTime?
  lastSyncStatus String?
  usageEvents    UsageEvent[]
  tokens         DeviceToken[]

  @@index([lastSeenAt])
  @@index([lastSyncAt])
}

model EnrollmentToken {
  id        String    @id @default(cuid())
  label     String?
  tokenHash String    @unique
  prefix    String
  expiresAt DateTime
  usedAt    DateTime?
  usedById  String?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([usedAt])
}

model DeviceToken {
  id         String    @id @default(cuid())
  deviceId   String
  tokenHash  String    @unique
  prefix     String
  metadata   Json?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([lastUsedAt])
  @@index([revokedAt])
}

model UsageEvent {
  id                    String   @id @default(cuid())
  deviceId              String
  source                String
  sourceEventId         String
  projectId             String?
  sessionId             String?
  workspacePath         String?
  localWorkspacePath    String?
  repoKey               String?
  gitRemote             String?
  gitBranch             String?
  gitCommit             String?
  model                 String?
  inputTokens           Int      @default(0)
  outputTokens          Int      @default(0)
  cachedInputTokens     Int      @default(0)
  cacheWriteTokens      Int      @default(0)
  reasoningOutputTokens Int      @default(0)
  totalTokens           Int      @default(0)
  costUsd               Decimal? @db.Decimal(18, 8)
  occurredAt            DateTime
  rawJson               Json?
  createdAt             DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  device  Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, source, sourceEventId])
  @@index([occurredAt])
  @@index([deviceId, occurredAt])
  @@index([source])
  @@index([model])
  @@index([repoKey])
  @@index([projectId, occurredAt])
}

model CollectorState {
  id        String   @id @default(cuid())
  source    String
  key       String
  cursor    Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([source, key])
}
