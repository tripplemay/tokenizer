generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth.js identity tables --------------------------------------------
// Backing tables for next-auth's @auth/prisma-adapter. Field shapes match
// the adapter's expected schema; do not rename without checking the adapter.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          String    @default("user")
  quotaTier     String    @default("free")
  timezone      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  projects            Project[]
  devices             Device[]
  usageEvents         UsageEvent[]
  deviceTokens        DeviceToken[]
  enrollmentTokens    EnrollmentToken[]
  collectorStates     CollectorState[]
  quotaSnapshots      QuotaSnapshot[]
  harnessProjects     HarnessProject[]
  harnessGates        HarnessGate[]
  harnessModeIntents  HarnessModeIntent[]
  harnessDispatchRuns HarnessDispatchRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Business tables (now tenant-scoped via userId) ----------------------

model Project {
  id            String       @id @default(cuid())
  userId        String
  name          String
  workspacePath String?
  repoKey       String?
  repoRemote    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  usageEvents   UsageEvent[]

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  HarnessProject HarnessProject[]

  @@unique([userId, workspacePath])
  @@unique([userId, repoKey])
  @@index([userId])
  @@index([name])
}

model Device {
  id                  String           @id
  userId              String
  name                String
  hostname            String?
  platform            String?
  metadata            Json?
  createdAt           DateTime         @default(now())
  lastSeenAt          DateTime?
  lastSyncAt          DateTime?
  agentVersion        String?
  agentReleaseVersion String?
  agentFeatureVersion Int?
  reporterTokenPrefix String?
  reportedAt          DateTime?
  queueDepth          Int?
  lastError           String?
  lastErrorAt         DateTime?
  lastSyncStatus      String?
  lastHarnessSyncAt   DateTime?
  harnessSyncStatus   String?
  harnessDiagnostics  Json?
  usageEvents         UsageEvent[]
  tokens              DeviceToken[]
  quotaSnapshots      QuotaSnapshot[]
  harnessProjects     HarnessProject[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
  @@index([lastSyncAt])
  @@index([reportedAt])
}

model EnrollmentToken {
  id        String    @id @default(cuid())
  userId    String
  label     String?
  tokenHash String    @unique
  prefix    String
  expiresAt DateTime
  usedAt    DateTime?
  usedById  String?
  metadata  Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model DeviceToken {
  id         String    @id @default(cuid())
  userId     String
  deviceId   String
  tokenHash  String    @unique
  prefix     String
  metadata   Json?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([lastUsedAt])
  @@index([revokedAt])
}

model UsageEvent {
  id                          String   @id @default(cuid())
  userId                      String
  deviceId                    String
  source                      String
  sourceEventId               String
  projectId                   String?
  sessionId                   String?
  workspacePath               String?
  localWorkspacePath          String?
  repoKey                     String?
  gitRemote                   String?
  gitBranch                   String?
  gitCommit                   String?
  model                       String?
  inputTokens                 Int      @default(0)
  outputTokens                Int      @default(0)
  cachedInputTokens           Int      @default(0)
  cacheWriteTokens            Int      @default(0)
  reasoningOutputTokens       Int      @default(0)
  cacheEphemeral5mInputTokens Int      @default(0)
  cacheEphemeral1hInputTokens Int      @default(0)
  webSearchRequests           Int      @default(0)
  webFetchRequests            Int      @default(0)
  serviceTier                 String?
  totalTokens                 Int      @default(0)
  costUsd                     Decimal? @db.Decimal(18, 8)
  // Mid-request model fallback (e.g. claude-fable-5 downgrading to
  // claude-opus-4-8): the final event carries fallbackFromModel, the
  // abandoned-segment event carries fallbackToModel. Both null otherwise.
  fallbackFromModel           String?
  fallbackToModel             String?
  occurredAt                  DateTime
  rawJson                     Json?
  createdAt                   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  device  Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, source, sourceEventId])
  @@index([userId])
  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@index([deviceId, occurredAt])
  @@index([source])
  @@index([model])
  @@index([repoKey])
  @@index([projectId, occurredAt])
  @@index([occurredAt, model])
  @@index([occurredAt, source])
  @@index([occurredAt, deviceId])
  @@index([occurredAt, projectId])
}

model QuotaSnapshot {
  id          String    @id @default(cuid())
  userId      String
  provider    String
  accountKey  String
  windowKey   String
  utilization Decimal?  @db.Decimal(6, 4)
  usedRaw     BigInt?
  limitRaw    BigInt?
  unit        String?
  resetsAt    DateTime?
  capturedAt  DateTime  @default(now())
  capturedBy  String?
  rawJson     Json?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [capturedBy], references: [id], onDelete: SetNull)

  @@index([userId, provider, windowKey, capturedAt])
}

model CollectorState {
  id        String   @id @default(cuid())
  userId    String
  source    String
  key       String
  cursor    Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, key])
  @@index([userId])
}

// Global auto-pricing overlay for the static MODEL_PRICES seed. UNLIKE every
// other business table this is deliberately NOT tenant-scoped: a model's list
// price is identical for all users, so we keep one global row per normalized
// model key (= normalizeModelKey output). The static seed in
// src/shared/model-pricing.ts remains the fallback; this table fills keys the
// seed lacks. Only rows with status IN ('auto_applied','approved') are billable
// (see src/server/model-prices.ts) — everything else (detected/pending_review/
// failed/rejected/ignored) is tracked but does NOT change any reported cost, so
// the "unpriced beats guessed" contract holds until a trusted source or a human
// confirms the price. All four unit prices are USD per 1M tokens.
model ModelPrice {
  id           String    @id @default(cuid())
  modelKey     String    @unique
  input        Decimal?  @db.Decimal(14, 8)
  cacheRead    Decimal?  @db.Decimal(14, 8)
  cacheWrite   Decimal?  @db.Decimal(14, 8)
  output       Decimal?  @db.Decimal(14, 8)
  // detected | auto_applied | pending_review | approved | rejected | failed | ignored
  status       String    @default("detected")
  source       String? // litellm | openrouter | llm-websearch | convention | manual | seed
  sourceUrl    String?
  confidence   String? // high | low
  rawLookup    Json? // raw source payload kept for audit / re-verification
  notes        String?
  firstSeenAt  DateTime  @default(now())
  pricedAt     DateTime?
  verifiedAt   DateTime?
  reviewedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// ---- Harness console ------------------------------------------------------
// harness（Triad Workflow）编排状态的云端只读镜像 + 人闸门。
// ⚠️ 真相源永远是各机器仓库里的 progress.json / features.json——这两张表是镜像，
// 渲染出错不影响状态机。控制台唯一的写操作是给 HarnessGate 签发 decision。

model HarnessProject {
  id        String  @id @default(cuid())
  userId    String
  deviceId  String
  /// 归一化后的 git remote；与 Project.repoKey 同口径，便于把用量与编排进度对上
  repoKey   String
  name      String
  projectId String?

  // ── progress.json 镜像（device agent 上报）──
  status            String?
  batch             String?
  fixRounds         Int       @default(0)
  completedCount    Int       @default(0)
  totalCount        Int       @default(0)
  headSha           String?
  signoff           String?
  dashboardUrl      String?
  autonomyStatus    String?
  lastHaltCondition String?
  lastHaltDetail    String?
  /// features.json 摘要：[{id,title,status,executor}]
  features          Json?
  /// 模式指纹（harness-modes.ts）：框架版本与本地漂移 · 执行形态 · 自主 · dispatch · 闸门校验模式 · 机件在位。
  /// 只读镜像：算错只影响这里的显示，机器上的校验器一道不少。
  modes             Json?
  reportedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device               @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  gates        HarnessGate[]
  modeIntents  HarnessModeIntent[]
  dispatchRuns HarnessDispatchRun[]

  @@unique([deviceId, repoKey])
  @@index([userId])
  @@index([reportedAt])
}

model HarnessGate {
  id               String   @id @default(cuid())
  userId           String
  harnessProjectId String
  /// progress.json 里 pending_gate.id —— 幂等键，decision 必须引用它
  gateId           String
  kind             String
  batch            String
  fromStatus       String?
  toStatus         String?
  detail           String
  /// 取证指针数组（只放路径，不内联正文）
  evidence         Json?
  raisedAt         DateTime
  raisedBy         String

  // ── 决策（唯一的写操作；签名后经 device 通道下发）──
  decisionAction String?
  decisionBy     String?
  decisionAt     DateTime?
  decisionNote   String?
  decisionOnce   Boolean   @default(true)
  /// Ed25519 签名（base64）。载荷 = decision 除 sig 外全部字段，键排序 + 紧凑 JSON。
  /// 机器侧用仓库里的 console.pub 验签——写代码的 agent 伪造不了。
  decisionSig    String?
  /// device agent 取走的时间
  relayedAt      DateTime?
  /// 机器侧消费并清空 pending_gate 的时间
  consumedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  harnessProject HarnessProject @relation(fields: [harnessProjectId], references: [id], onDelete: Cascade)

  @@unique([harnessProjectId, gateId])
  @@index([userId])
  @@index([decisionAt])
  @@index([consumedAt])
}

model HarnessModeIntent {
  id               String    @id @default(cuid())
  userId           String
  harnessProjectId String
  intentId         String
  /// Complete canonical signing payload. The signature is stored separately.
  payload          Json
  signature        String
  /// issued | relayed | staged | applied | failed | superseded | expired
  status           String    @default("issued")
  issuedBy         String
  issuedAt         DateTime
  intentExpiresAt  DateTime
  relayedAt        DateTime?
  stagedAt         DateTime?
  appliedAt        DateTime?
  failedAt         DateTime?
  appliedBatch     String?
  stagedCommitSha  String?
  failureCode      String?
  failureDetail    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  harnessProject HarnessProject @relation(fields: [harnessProjectId], references: [id], onDelete: Cascade)

  @@unique([harnessProjectId, intentId])
  @@index([userId])
  @@index([harnessProjectId, status])
  @@index([intentExpiresAt])
  @@index([issuedAt])
}

model HarnessDispatchRun {
  id               String   @id @default(cuid())
  userId           String
  harnessProjectId String
  runId            String
  taskId           String
  batch            String
  feature          String?
  role             String
  agentId          String
  modelFamily      String
  transport        String
  lockedSha        String
  startedAt        DateTime
  finishedAt       DateTime
  durationMs       Int
  outcome          String
  exitCode         Int?
  verdict          String?
  artifactPath     String?
  artifactSha256   String?
  errorSummary     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  harnessProject HarnessProject @relation(fields: [harnessProjectId], references: [id], onDelete: Cascade)

  @@unique([harnessProjectId, runId])
  @@index([userId])
  @@index([harnessProjectId, startedAt])
  @@index([batch])
  @@index([outcome])
}
