generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth.js identity tables --------------------------------------------
// Backing tables for next-auth's @auth/prisma-adapter. Field shapes match
// the adapter's expected schema; do not rename without checking the adapter.

model User {
  id              String              @id @default(cuid())
  email           String              @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  role            String              @default("user")
  quotaTier       String              @default("free")
  timezone        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  accounts         Account[]
  sessions         Session[]
  projects         Project[]
  devices          Device[]
  usageEvents      UsageEvent[]
  deviceTokens    DeviceToken[]
  enrollmentTokens EnrollmentToken[]
  collectorStates  CollectorState[]
  quotaSnapshots   QuotaSnapshot[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Business tables (now tenant-scoped via userId) ----------------------

model Project {
  id            String       @id @default(cuid())
  userId        String
  name          String
  workspacePath String?
  repoKey       String?
  repoRemote    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  usageEvents   UsageEvent[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspacePath])
  @@unique([userId, repoKey])
  @@index([userId])
  @@index([name])
}

model Device {
  id             String        @id
  userId         String
  name           String
  hostname       String?
  platform       String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  lastSeenAt     DateTime?
  lastSyncAt     DateTime?
  agentVersion         String?
  agentFeatureVersion  Int?
  queueDepth           Int?
  lastError      String?
  lastErrorAt    DateTime?
  lastSyncStatus String?
  usageEvents    UsageEvent[]
  tokens         DeviceToken[]
  quotaSnapshots QuotaSnapshot[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
  @@index([lastSyncAt])
}

model EnrollmentToken {
  id        String    @id @default(cuid())
  userId    String
  label     String?
  tokenHash String    @unique
  prefix    String
  expiresAt DateTime
  usedAt    DateTime?
  usedById  String?
  metadata  Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model DeviceToken {
  id         String    @id @default(cuid())
  userId     String
  deviceId   String
  tokenHash  String    @unique
  prefix     String
  metadata   Json?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([lastUsedAt])
  @@index([revokedAt])
}

model UsageEvent {
  id                    String   @id @default(cuid())
  userId                String
  deviceId              String
  source                String
  sourceEventId         String
  projectId             String?
  sessionId             String?
  workspacePath         String?
  localWorkspacePath    String?
  repoKey               String?
  gitRemote             String?
  gitBranch             String?
  gitCommit             String?
  model                 String?
  inputTokens           Int      @default(0)
  outputTokens          Int      @default(0)
  cachedInputTokens     Int      @default(0)
  cacheWriteTokens      Int      @default(0)
  reasoningOutputTokens Int      @default(0)
  cacheEphemeral5mInputTokens Int     @default(0)
  cacheEphemeral1hInputTokens Int     @default(0)
  webSearchRequests           Int     @default(0)
  webFetchRequests            Int     @default(0)
  serviceTier                 String?
  totalTokens           Int      @default(0)
  costUsd               Decimal? @db.Decimal(18, 8)
  // Mid-request model fallback (e.g. claude-fable-5 downgrading to
  // claude-opus-4-8): the final event carries fallbackFromModel, the
  // abandoned-segment event carries fallbackToModel. Both null otherwise.
  fallbackFromModel     String?
  fallbackToModel       String?
  occurredAt            DateTime
  rawJson               Json?
  createdAt             DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  device  Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, source, sourceEventId])
  @@index([userId])
  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@index([deviceId, occurredAt])
  @@index([source])
  @@index([model])
  @@index([repoKey])
  @@index([projectId, occurredAt])
  @@index([occurredAt, model])
  @@index([occurredAt, source])
  @@index([occurredAt, deviceId])
  @@index([occurredAt, projectId])
}

model QuotaSnapshot {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  accountKey   String
  windowKey    String
  utilization  Decimal?  @db.Decimal(6, 4)
  usedRaw      BigInt?
  limitRaw     BigInt?
  unit         String?
  resetsAt     DateTime?
  capturedAt   DateTime  @default(now())
  capturedBy   String?
  rawJson      Json?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [capturedBy], references: [id], onDelete: SetNull)

  @@index([userId, provider, windowKey, capturedAt])
}

model CollectorState {
  id        String   @id @default(cuid())
  userId    String
  source    String
  key       String
  cursor    Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, key])
  @@index([userId])
}
