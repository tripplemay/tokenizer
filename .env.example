DATABASE_URL=postgresql://tokenizer:tokenizer@localhost:5432/tokenizer
ADMIN_TOKEN=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_HOST_PORT=127.0.0.1:3010

# --- Auto-pricing (optional) ---------------------------------------------
# New models are always detected and queued in /admin/pricing. These vars only
# control the automatic price LOOKUP; leave them unset to price manually.
# Master switch for outbound lookups (LiteLLM / OpenRouter / LLM). Off by default.
PRICING_AUTO_ENABLED=0
# Optional: pin LiteLLM to a commit-SHA raw URL for reproducibility.
# LITELLM_PRICES_URL=
# OPENROUTER_MODELS_URL=
# Optional LLM fallback for models absent from the structured feeds (candidates
# always land as pending_review). OpenAI-compatible /chat/completions endpoint.
# PRICING_LLM_BASE_URL=
# PRICING_LLM_KEY=
# PRICING_LLM_MODEL=
