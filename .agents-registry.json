{
  "_comment": "v2 tool-bound dispatch。Planner 是 proposal-only 的独立 descriptor；Generator 与 Evaluator 分离，且 generator/evaluator 必须使用不同 model family。local-cli 必须配 sandbox.home_dir。",
  "version": "dispatch/1",
  "agents": [
    {
      "id": "planner-claude",
      "tool": "claude-code",
      "priority": 100,
      "roles": [
        "planner"
      ],
      "transport": "subagent",
      "agent_type": "planner-proposal",
      "model_family": "claude",
      "capabilities": [
        "plan"
      ],
      "constraints": {
        "l2": false,
        "write_src": false,
        "push": false
      },
      "notes": "只返回结构化 proposal；Coordinator 负责验签、派发、向人类转交和确认后的落盘。"
    },
    {
      "id": "planner-kimi",
      "tool": "kimi",
      "priority": 100,
      "roles": [
        "planner"
      ],
      "transport": "local-cli",
      "adapter": "kimi",
      "model_family": "kimi",
      "capabilities": [
        "plan"
      ],
      "constraints": {
        "l2": false,
        "write_src": false,
        "push": false
      },
      "sandbox": {
        "home_dir": "~/.harness-sandbox/planner-kimi",
        "env_set": {
          "KIMI_CODE_HOME": "~/.kimi-code"
        },
        "env_allow": []
      },
      "timeout_s": 1800,
      "notes": "只返回受限结构化 Planner proposal；Coordinator 验收回执并在人工确认后物化。"
    },
    {
      "id": "main-claude",
      "tool": "claude-code",
      "priority": 100,
      "roles": [
        "generator"
      ],
      "transport": "subagent",
      "agent_type": "generator-restricted",
      "model_family": "claude",
      "capabilities": [
        "build",
        "fix"
      ],
      "constraints": {
        "l2": false,
        "write_src": true,
        "push": true
      }
    },
    {
      "id": "reviewer-kimi",
      "tool": "kimi",
      "priority": 100,
      "roles": [
        "evaluator"
      ],
      "transport": "local-cli",
      "adapter": "kimi",
      "model_family": "kimi",
      "capabilities": [
        "verify",
        "l1_local"
      ],
      "constraints": {
        "l2": false,
        "write_src": false,
        "push": false
      },
      "sandbox": {
        "home_dir": "~/.harness-sandbox/reviewer-kimi",
        "env_set": {
          "KIMI_CODE_HOME": "~/.kimi-code"
        },
        "env_allow": []
      },
      "timeout_s": 1800
    },
    {
      "id": "reviewer-kimi-a2a",
      "tool": "kimi",
      "priority": 100,
      "roles": [
        "evaluator"
      ],
      "transport": "a2a",
      "endpoint": "http://127.0.0.1:41241",
      "model_family": "kimi",
      "capabilities": [
        "verify",
        "l1_local",
        "e2e",
        "security_audit"
      ],
      "constraints": {
        "l2": false,
        "write_src": false,
        "push": false
      },
      "timeout_s": 2400,
      "notes": "Loopback A2A client descriptor；runner 由 reviewer-kimi local-cli descriptor 承载，临时演练必须配置 --idle-exit。"
    },
    {
      "id": "reviewer-codex",
      "tool": "codex",
      "priority": 100,
      "roles": [
        "evaluator"
      ],
      "transport": "local-cli",
      "adapter": "codex",
      "model_family": "codex",
      "capabilities": [
        "verify",
        "l1_local",
        "code_review"
      ],
      "constraints": {
        "l2": false,
        "write_src": false,
        "push": false
      },
      "sandbox": {
        "home_dir": "~/.harness-sandbox/reviewer-codex",
        "env_set": {
          "CODEX_HOME": "~/.codex"
        },
        "env_allow": []
      },
      "timeout_s": 2400
    },
    {
      "id": "builder-codex",
      "tool": "codex",
      "priority": 100,
      "roles": [
        "generator"
      ],
      "transport": "local-cli",
      "adapter": "codex",
      "model_family": "codex",
      "capabilities": [
        "build",
        "fix"
      ],
      "constraints": {
        "l2": false,
        "write_src": true,
        "push": false
      },
      "sandbox": {
        "home_dir": "~/.harness-sandbox/builder-codex",
        "env_set": {
          "CODEX_HOME": "~/.codex"
        },
        "env_allow": []
      },
      "timeout_s": 2400,
      "notes": "v1.1 放开的外部 generator。四道锁：roles 白名单 + 独立 worktree 无 push + spec-lock 稽核 + L1 全绿硬证据。与之配对的 evaluator 必须非 codex family。"
    }
  ]
}
