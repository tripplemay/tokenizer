{
  "_comment": "tool-integrations/1: the console selects tools and invocation modes; the device resolver chooses concrete runners. A2A exposes Planner/Evaluator only until a source-handoff protocol exists for Generator.",
  "version": "tool-integrations/1",
  "integrations": [
    {
      "id": "claude-code",
      "tool": "claude-code",
      "label": "Claude Code",
      "model_family": "claude",
      "priority": 100,
      "capabilities": ["plan", "build", "fix", "verify", "l1_local", "security_audit"],
      "subagent": true,
      "local_cli": {
        "adapter": "claude-code",
        "sandbox": {
          "home_dir": "~/.harness-sandbox/claude-code",
          "env_set": {},
          "env_allow": ["ANTHROPIC_API_KEY", "CLAUDE_CONFIG_DIR"]
        },
        "timeout_s": 2400
      },
      "notes": "The framework applies fixed planner-proposal, generator-restricted, and evaluator personas. Runtime Claude credentials remain an explicit precondition."
    },
    {
      "id": "kimi",
      "tool": "kimi",
      "label": "Kimi Code",
      "model_family": "kimi",
      "priority": 100,
      "capabilities": ["plan", "build", "fix", "verify", "l1_local", "e2e", "security_audit"],
      "local_cli": {
        "adapter": "kimi",
        "sandbox": {
          "home_dir": "~/.harness-sandbox/kimi",
          "env_set": { "KIMI_CODE_HOME": "~/.kimi-code" },
          "env_allow": []
        },
        "timeout_s": 2400
      }
    },
    {
      "id": "codex",
      "tool": "codex",
      "label": "Codex",
      "model_family": "codex",
      "priority": 100,
      "capabilities": ["plan", "build", "fix", "verify", "l1_local", "code_review"],
      "local_cli": {
        "adapter": "codex",
        "sandbox": {
          "home_dir": "~/.harness-sandbox/codex",
          "env_set": { "CODEX_HOME": "~/.codex" },
          "env_allow": []
        },
        "timeout_s": 2400
      }
    }
  ],
  "a2a_targets": [
    {
      "id": "claude-code-loopback",
      "integration_id": "claude-code",
      "endpoint": "http://127.0.0.1:41243",
      "remote_runner_id": "claude-code-loopback",
      "priority": 100,
      "auth": { "type": "none" },
      "capabilities": ["plan", "verify", "l1_local", "security_audit"],
      "notes": "Start a2a-runner.py with --integration claude-code --runner-id claude-code-loopback."
    },
    {
      "id": "codex-loopback",
      "integration_id": "codex",
      "endpoint": "http://127.0.0.1:41242",
      "remote_runner_id": "codex-loopback",
      "priority": 100,
      "auth": { "type": "none" },
      "capabilities": ["plan", "verify", "l1_local", "code_review"],
      "notes": "Start a2a-runner.py with --integration codex --runner-id codex-loopback."
    },
    {
      "id": "kimi-reviewer-a2a",
      "integration_id": "kimi",
      "endpoint": "http://127.0.0.1:41241",
      "remote_runner_id": "reviewer-kimi",
      "priority": 100,
      "auth": { "type": "none" },
      "capabilities": ["verify", "l1_local", "e2e", "security_audit"],
      "notes": "Start a2a-runner.py with --integration kimi --runner-id reviewer-kimi."
    }
  ]
}
