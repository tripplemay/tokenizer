#!/usr/bin/env node
import { spawn } from "node:child_process";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
let child;
let childExited = false;
let pendingSignal = null;

// `spawnSync` made this wrapper a brittle process boundary: launchd could
// terminate the wrapper while its Node child continued as an orphan. Keep the
// wrapper alive until the child exits, and relay the lifecycle signals the
// service manager sends to both processes. Install before spawn: a child can
// become observable before spawn returns, while the wrapper is still starting.
const relaySignal = (signal) => {
  if (childExited) return;
  if (!child) {
    pendingSignal ??= signal;
    return;
  }
  if (child.killed) return;
  try {
    child.kill(signal);
  } catch {
    // The child's close handler remains the single completion boundary.
  }
};
for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) {
  process.on(signal, () => relaySignal(signal));
}

// cwd MUST point at the installed app root so node can resolve bundled tsx.
child = spawn("node", ["--import", "tsx", resolve(root, "src/cli/index.ts"), ...process.argv.slice(2)], {
  stdio: "inherit",
  cwd: root
});

child.once("error", (error) => {
  console.error(`Failed to start tokenizer: ${error.message}`);
  process.exitCode = 1;
});

child.once("close", (code) => {
  childExited = true;
  // A child that terminates from a signal has no numeric exit code. Preserve a
  // non-zero result without re-signalling this wrapper and risking another
  // orphan during shutdown.
  process.exitCode = code ?? 1;
});

if (pendingSignal) relaySignal(pendingSignal);
