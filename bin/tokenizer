#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
// cwd MUST point at the installed app root so node can resolve the bundled
// `tsx` loader. Without this, running `tokenizer …` from any unrelated cwd
// (including cron's default $HOME) fails with ERR_MODULE_NOT_FOUND for tsx.
const result = spawnSync("node", ["--import", "tsx", resolve(root, "src/cli/index.ts"), ...process.argv.slice(2)], {
  stdio: "inherit",
  cwd: root
});

process.exit(result.status ?? 1);
